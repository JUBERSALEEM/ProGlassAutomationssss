{
  "Database": {
    "DbPath": "%LOCALAPPDATA%\\ProGlassAutomation\\glass.db",
    "MaxPoolSize": 20,
    "CommandTimeout": 45,
    "MaxRetryCount": 5,
    "EnableWAL": true,
    "ForeignKeys": true,
    "CacheSize": -4000
  },
  "Logging": {
    "EnableFileLogging": true,
    "EnableConsoleLogging": false,
    "MinimumLevel": "Error",
    "LogPath": "C:\\ProgramData\\ProGlassAutomation\\logs",
    "RetainDays": 90,
    "MaxFileSizeMB": 50
  },
  "Behavior": {
    "AutoBackup": true,
    "EnableValidation": true,
    "EnableMetrics": true,
    "AutoMigrate": true,
    "DefaultVatPercent": 5.0,
    "SurchargePercent": 25.0,
    "SurchargeThreshold": 4.0
  },
  "Validation": {
    "StrictMode": true,
    "MaxStringLength": 500,
    "RequireMandatoryFields": true
  },
  "Backup": {
    "EnableAutoBackup": true,
    "BackupPath": "C:\\ProgramData\\ProGlassAutomation\\Backups",
    "BackupOnStartup": true,
    "AutoBackupDays": 1
  }
}