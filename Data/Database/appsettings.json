{
  "Database": {
    "DbPath": "%LOCALAPPDATA%\\ProGlassAutomation\\glass.db",
    "MaxPoolSize": 10,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "EnableWAL": true,
    "ForeignKeys": true,
    "CacheSize": -2000
  },
  "Logging": {
    "EnableFileLogging": true,
    "EnableConsoleLogging": false,
    "MinimumLevel": "Warning",
    "LogPath": "logs",
    "RetainDays": 30,
    "MaxFileSizeMB": 10
  },
  "Behavior": {
    "AutoBackup": true,
    "EnableValidation": true,
    "EnableMetrics": true,
    "AutoMigrate": true,
    "DefaultVatPercent": 5.0,
    "SurchargePercent": 20.0,
    "SurchargeThreshold": 4.0
  },
  "Validation": {
    "StrictMode": false,
    "MaxStringLength": 500,
    "RequireMandatoryFields": true
  },
  "Backup": {
    "EnableAutoBackup": true,
    "BackupPath": "%USERPROFILE%\\Desktop\\GlassBackup",
    "BackupOnStartup": false,
    "AutoBackupDays": 7
  }
}