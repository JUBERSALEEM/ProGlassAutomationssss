<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        Title="ProGlass ERP System" Height="950" Width="1650"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Sharp Professional Palette -->
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderSharp" Color="#CBD5E1"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>

        <!-- Header Gradient -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- REFINED CARD STYLE -->
        <Style x:Key="ModuleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSharp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Screenshot Button Style -->
        <Style x:Key="ScreenshotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Screenshot" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- About Button Style -->
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2V7h2v2z" 
                                      Fill="#3B82F6" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="About" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.ColumnSpan="2" Margin="12" CornerRadius="16" Background="{StaticResource HeaderGradient}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Border Grid.Column="0" Margin="16,12" Width="80" Height="88" CornerRadius="14" Background="#FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,3" Margin="0,0,0,5">
                            <TextBlock Text="PROGLASS" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="ERP" FontSize="26" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                        <Border Height="2" Background="#3B82F6" Margin="12,6,12,0"/>
                        <TextBlock Text="SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="PROGLASS ERP SYSTEM" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Glass Processing Automation Platform" FontSize="13" Foreground="#BFDBFE" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Info Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="ScreenshotBtn" Style="{StaticResource ScreenshotButtonStyle}" Click="ScreenshotBtn_Click" Margin="6"/>
                    <Button x:Name="AboutBtn" Style="{StaticResource AboutButtonStyle}" Click="About_Click" Margin="6"/>
                    <Border CornerRadius="12" Padding="16" Margin="6" Effect="{StaticResource CardShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0F9FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="📅 DATE" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="9"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="1" Background="#BFDBFE"/>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="🕐 TIME" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="9"/>
                                <TextBlock x:Name="ClockText" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SIDEBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSharp}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,25">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}" Click="BtnDashboard_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDash" Style="{StaticResource ModuleBorderStyle}" Background="{StaticResource PrimaryBlue}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="22" Margin="0,0,20,0"/>
                                <TextBlock Text="DASHBOARD" Foreground="White" FontWeight="Black" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnSubscription" Style="{StaticResource NavButtonStyle}" Click="BtnSubscription_Click" Margin="0,0,0,30">
                        <Border x:Name="BorderSub" Style="{StaticResource ModuleBorderStyle}" Background="#60A5FA">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="22" Margin="0,0,20,0"/>
                                <TextBlock Text="LICENSING" Foreground="White" FontWeight="Black" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <TextBlock Text="CALCULATORS" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnSGU" Style="{StaticResource NavButtonStyle}" Click="BtnSGU_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderSGU" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧮" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="SGU CALC" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDGU" Style="{StaticResource NavButtonStyle}" Click="BtnDGU_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDGU" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="DGU CALC" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnLam" Style="{StaticResource NavButtonStyle}" Click="BtnLamination_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderLam" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔳" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="LAMINATION" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDguLam" Style="{StaticResource NavButtonStyle}" Click="BtnDguLam_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDguLam" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪟" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="DGU + LAM" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnOpt" Style="{StaticResource NavButtonStyle}" Click="BtnOptimization_Click" Margin="0,0,0,30">
                        <Border x:Name="BorderOpt" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="OPTIMIZER" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnSheetStore" Style="{StaticResource NavButtonStyle}" Click="BtnSheetStore_Click" Margin="0,0,0,8">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="SHEET STORE" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDailyWorks" Style="{StaticResource NavButtonStyle}" Click="BtnDailyWorks_Click" Margin="0,0,0,8">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="DAILY WORKS" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDeliveries" Style="{StaticResource NavButtonStyle}" Click="BtnDeliveries_Click" Margin="0,0,0,30">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚚" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="DELIVERIES" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button x:Name="BtnProfile" Style="{StaticResource NavButtonStyle}" Click="BtnProfile_Click" Margin="0,0,5,0">
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="👤" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PROFILE" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource DeepBlue}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button x:Name="BtnUsers" Style="{StaticResource NavButtonStyle}" Click="BtnUsers_Click">
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="👥" HorizontalAlignment="Center"/>
                                    <TextBlock Text="USERS" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource DeepBlue}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. CONTENT AREA -->
        <Border x:Name="MainContentBorder" Grid.Row="1" Grid.Column="1" Background="White" Margin="12" CornerRadius="16" Effect="{StaticResource CardShadow}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- 4. FOOTER -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="12,0,12,12" CornerRadius="12" Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- License Status -->
                <Border CornerRadius="10" Padding="14" Margin="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#EFF6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E40AF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock FontWeight="Bold" FontSize="10" Foreground="#1E40AF" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="LICENSE INACTIVE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="LICENSE ACTIVE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Calculators Status -->
                <Border Grid.Column="1" CornerRadius="10" Padding="14" Margin="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#EFF6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock FontWeight="Bold" FontSize="10" Foreground="#1E40AF" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CALCULATORS LOCKED"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="CALCULATORS UNLOCKED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- System Status -->
                <Border Grid.Column="2" CornerRadius="10" Padding="14" Margin="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#EFF6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#10B981"/>
                        <TextBlock Text="SYSTEM READY" FontWeight="Bold" FontSize="10" Foreground="#1E40AF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>