<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        Title="ProGlass ERP System" Height="950" Width="1650"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Sharp Professional Palette -->
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderSharp" Color="#CBD5E1"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>

        <!-- REFINED CARD STYLE -->
        <Style x:Key="ModuleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSharp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource DeepBlue}" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="50" Height="50" CornerRadius="10" Background="White">
                        <TextBlock Text="PG" Foreground="{StaticResource DeepBlue}" FontWeight="Black" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PROGLASS ERP SYSTEM" FontSize="22" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="PRODUCTION ENGINE v2.4" FontSize="10" Foreground="#93C5FD" FontWeight="Black"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- SCREENSHOT BUTTON -->
                    <Button x:Name="ScreenshotBtn" Click="ScreenshotBtn_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,12,0">
                        <Border Background="#1D4ED8" CornerRadius="8" Padding="15,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" Margin="0,0,10,0" Foreground="White"/>
                                <TextBlock Text="SCREENSHOT" Foreground="White" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- ABOUT BUTTON -->
                    <Button x:Name="AboutBtn" Click="About_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,12,0">
                        <Border Background="#1D4ED8" CornerRadius="8" Padding="15,10" BorderBrush="#3B82F6" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" Margin="0,0,10,0" Foreground="White"/>
                                <TextBlock Text="ABOUT" Foreground="White" FontWeight="Black" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Border Background="#111827" CornerRadius="10" Padding="18,10" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <Border Width="1" Background="{StaticResource PrimaryBlue}" Margin="15,2"/>
                            <TextBlock x:Name="CurrentDateText" Text="01-MAY-2026" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SIDEBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderSharp}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,25">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}" Click="BtnDashboard_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDash" Style="{StaticResource ModuleBorderStyle}" Background="{StaticResource PrimaryBlue}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="22" Margin="0,0,20,0"/>
                                <TextBlock Text="DASHBOARD" Foreground="White" FontWeight="Black" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnSubscription" Style="{StaticResource NavButtonStyle}" Click="BtnSubscription_Click" Margin="0,0,0,30">
                        <Border x:Name="BorderSub" Style="{StaticResource ModuleBorderStyle}" Background="#60A5FA">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="22" Margin="0,0,20,0"/>
                                <TextBlock Text="LICENSING" Foreground="White" FontWeight="Black" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <TextBlock Text="CALCULATORS" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnSGU" Style="{StaticResource NavButtonStyle}" Click="BtnSGU_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderSGU" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧮" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="SGU CALC" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDGU" Style="{StaticResource NavButtonStyle}" Click="BtnDGU_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDGU" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="DGU CALC" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnLam" Style="{StaticResource NavButtonStyle}" Click="BtnLamination_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderLam" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔳" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="LAMINATION" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDguLam" Style="{StaticResource NavButtonStyle}" Click="BtnDguLam_Click" Margin="0,0,0,8">
                        <Border x:Name="BorderDguLam" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪟" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="DGU + LAM" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnOpt" Style="{StaticResource NavButtonStyle}" Click="BtnOptimization_Click" Margin="0,0,0,30">
                        <Border x:Name="BorderOpt" Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️" FontSize="20" Margin="0,0,20,0" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="OPTIMIZER" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <TextBlock Text="OPERATIONS" FontSize="10" FontWeight="Black" Foreground="{StaticResource DeepBlue}" Margin="12,0,0,12" Opacity="0.5"/>
                    <Button x:Name="BtnSheetStore" Style="{StaticResource NavButtonStyle}" Click="BtnSheetStore_Click" Margin="0,0,0,8">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="SHEET STORE" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDailyWorks" Style="{StaticResource NavButtonStyle}" Click="BtnDailyWorks_Click" Margin="0,0,0,8">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="DAILY WORKS" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button x:Name="BtnDeliveries" Style="{StaticResource NavButtonStyle}" Click="BtnDeliveries_Click" Margin="0,0,0,30">
                        <Border Style="{StaticResource ModuleBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚚" FontSize="20" Margin="0,0,20,0"/>
                                <TextBlock Text="DELIVERIES" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button x:Name="BtnProfile" Style="{StaticResource NavButtonStyle}" Click="BtnProfile_Click" Margin="0,0,5,0">
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="👤" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PROFILE" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource DeepBlue}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button x:Name="BtnUsers" Style="{StaticResource NavButtonStyle}" Click="BtnUsers_Click">
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="👥" HorizontalAlignment="Center"/>
                                    <TextBlock Text="USERS" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource DeepBlue}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. CONTENT AREA -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="20" CornerRadius="20" Effect="{StaticResource CardShadow}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- 4. FOOTER -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource DeepBlue}" Padding="20,10">
            <TextBlock Text="PROGLASS ENGINE: READY" Foreground="White" FontSize="10" FontWeight="Black"/>
        </Border>
    </Grid>
</Window>