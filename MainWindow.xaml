<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5FF">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="15">

            <StackPanel>

                <!-- HEADER -->
                <Border Background="#1F2937"
                        CornerRadius="12"
                        Padding="12"
                        Margin="5">

                    <TextBlock Text="GLASS ERP"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- SGU -->
                <Border x:Name="SGUButton"
                        CornerRadius="10"
                        Margin="5"
                        Background="#2D2D30"
                        MouseDown="SGU_Click">

                    <TextBlock Text="SGU"
                               Foreground="White"
                               Padding="14"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- DGU -->
                <Border x:Name="DGUButton"
                        CornerRadius="10"
                        Margin="5"
                        Background="#2D2D30"
                        MouseDown="DGU_Click">

                    <TextBlock Text="DGU"
                               Foreground="White"
                               Padding="14"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- LAMINATION -->
                <Border x:Name="LAMButton"
                        CornerRadius="10"
                        Margin="5"
                        Background="#2D2D30"
                        MouseDown="LAM_Click">

                    <TextBlock Text="LAMINATION"
                               Foreground="White"
                               Padding="14"
                               FontWeight="SemiBold"/>
                </Border>

            </StackPanel>

        </Border>

        <!-- ================= MAIN PANEL ================= -->
        <Border Grid.Column="1"
                Background="#EEF3FF"
                Padding="15">

            <Border Background="White"
                    CornerRadius="16"
                    Padding="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <ContentControl x:Name="MainPanel"/>

            </Border>

        </Border>

    </Grid>

</Window>