<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        Title="ProGlass ERP System" Height="1000" Width="1700"
        WindowStartupLocation="CenterScreen" Background="#0B1120"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Focusable="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- GPU-Optimized Shadow Effects -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000" Direction="270"/>

        <!-- Dynamic Sidebar Width Trigger Style -->
        <Style x:Key="SidebarBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <!-- When SidebarToggle is Checked (Collapsed state), collapse the left sidebar to 0 width -->
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="True">
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dynamic Visibility Trigger Style for Expanded Menu Elements -->
        <Style x:Key="MenuContentVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Expander Stylish Card Style with Safe Inlined Colors -->
        <Style x:Key="StylishExpanderCard" TargetType="Expander">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="12" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CacheMode="BitmapCache">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="ContentRow" Height="0"/>
                                </Grid.RowDefinitions>

                                <!-- Expander Header Banner -->
                                <ToggleButton Grid.Row="0" 
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Padding="12,10">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                    <Path x:Name="Arrow" 
                                                          Grid.Column="1"
                                                          Data="M 0 0 L 4 4 L 8 0" 
                                                          Stroke="#475569" 
                                                          StrokeThickness="2"
                                                          HorizontalAlignment="Right" 
                                                          VerticalAlignment="Center"
                                                          Width="8" Height="5"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>

                                <!-- Content Body Area -->
                                <Border x:Name="ContentBorder" 
                                        Grid.Row="1" 
                                        Background="Transparent" 
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,1,0,0"
                                        Padding="6">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sub-Menu Flat Action Button with Safe Inlined Colors -->
        <Style x:Key="SidebarSubActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Double-Arrow Collapse Toggle Button Style -->
        <Style x:Key="CollapseArrowButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <Grid>
                                <TextBlock Text="◀◀" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Floating Double-Arrow Expand Toggle Button Style -->
        <Style x:Key="ExpandArrowButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="#FFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="▶▶" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0B1120">
        <Grid.ColumnDefinitions>
            <!-- Column 0: Fixed Left-Side Sidebar (Width controlled dynamically) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Column 1: Maximized Viewport For Active Glass Modules -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== RESPONSIVE NARROW LEFT SIDEBAR PORTION ==================== -->
        <!-- Clicking the left double arrow collapses this completely. Clicking floating double-arrow expands it back. -->
        <Border Grid.Column="0" 
                x:Name="SidebarBorder" 
                Style="{StaticResource SidebarBorderStyle}"
                Background="#F8FAFC" 
                BorderBrush="#E2E8F0" 
                BorderThickness="0,0,1,0">

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <!-- Brand & Collapse Trigger Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scrollable Menu Card Folders Row -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Status utilities Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. SIDEBAR TOP BRAND HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon / Brand Details (Click triggers Logo_Click event to open About Page) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="Logo_Click">
                        <Border Width="45" Height="38" CornerRadius="8" Background="White" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="ERP" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProGlass" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Automation ERP" FontSize="8" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Collapse Left Double-Arrow Button Trigger -->
                    <ToggleButton x:Name="SidebarToggle" 
                                  Grid.Column="1" 
                                  Style="{StaticResource CollapseArrowButtonStyle}" 
                                  VerticalAlignment="Center"/>
                </Grid>

                <!-- 2. SCROLLABLE COLLAPSIBLE MENU CARDS (Dropdown expand pattern) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Vertical">

                        <!-- CARD: DASHBOARD HOME LINK -->
                        <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8" Padding="2" Effect="{StaticResource CardShadow}">
                            <Button Style="{StaticResource SidebarSubActionButton}" Click="BtnHome_Click" Padding="12,10" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📊" Margin="0,0,10,0" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="Dashboard Home" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- CARD: INVOICES & ORDERS -->
                        <Expander Style="{StaticResource StylishExpanderCard}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Invoices &amp; Orders" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="🧾 Proforma Invoice" Click="MenuItem_ProformaInvoice_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="📋 Job Orders" Click="MenuItem_JobOrders_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="🧾 Tax Invoices" Click="MenuItem_TaxInvoice_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="📜 Invoice History"/>
                            </StackPanel>
                        </Expander>

                        <!-- CARD: GLASS ESTIMATION CALCULATORS -->
                        <Expander Style="{StaticResource StylishExpanderCard}" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧮" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Glass Estimators" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="▣ SGU Calculator" Click="MenuItem_SGU_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="◫ DGU Calculator" Click="MenuItem_DGU_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="▤ Lamination Unit" Click="MenuItem_Lamination_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="◈ DGU + Lamination" Click="MenuItem_DguLam_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="✂ Plate Optimizer" Click="MenuItem_Optimizer_Click" Foreground="#2563EB"/>
                            </StackPanel>
                        </Expander>

                        <!-- CARD: SHOP FLOOR OPERATIONS -->
                        <Expander Style="{StaticResource StylishExpanderCard}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Operations Floor" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="▦ Sheet Store Stock" Click="MenuItem_SheetStore_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="☰ Daily Works Pipeline" Click="MenuItem_DailyWorks_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="☘ Deliveries Logistic" Click="MenuItem_Deliveries_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- CARD: SALES PERFORMANCE REPORTS -->
                        <Expander Style="{StaticResource StylishExpanderCard}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Sales &amp; Analytics" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="📈 Sales Analytics" Click="MenuItem_Analytics_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="📊 Sales Report"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="📉 Profit Analysis"/>
                            </StackPanel>
                        </Expander>

                        <!-- CARD: SYSTEM PREFERENCES -->
                        <Expander Style="{StaticResource StylishExpanderCard}" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="System Profile" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Orientation="Vertical">
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="👤 Profile Settings" Click="MenuItem_Profile_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="👥 User Access Role" Click="MenuItem_Users_Click"/>
                                <Button Style="{StaticResource SidebarSubActionButton}" Content="ℹ About Legacy Port" Click="MenuItem_About_Click"/>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. BOTTOM UTILITY BAR -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,0">

                    <!-- Date & Time (Light styled DateTimeBorderStyle) -->
                    <Border Background="#E2E8F0" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="📅 Date" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#CBD5E1" Margin="0,2"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="🕐 Time" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                <TextBlock x:Name="ClockText" FontSize="11" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- License Warning State -->
                    <Border x:Name="LicenseWarningBorder" 
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            MouseLeftButtonDown="LicenseWarningBorder_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activate License" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>

                    <!-- License Active State -->
                    <Border x:Name="LicenseActiveBorder" 
                            Background="#D1FAE5"
                            BorderBrush="#6EE7B7"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Active" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                        </StackPanel>
                    </Border>

                    <!-- Screenshot Button -->
                    <Button x:Name="ScreenshotBtn" 
                            Background="#E2E8F0"
                            Foreground="#0F172A"
                            FontSize="11"
                            FontWeight="Bold"
                            Padding="12,8"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="ScreenshotBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Screenshot (WPF Cache)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ==================== CONTENT VIEWPORT AREA (Grid Column 1) ==================== -->
        <!-- Takes up the absolute maximum screen area. Automatically stretches when sidebar is collapsed. -->
        <Grid Grid.Column="1">

            <!-- Module Viewport Content Box -->
            <Border x:Name="MainContentBorder" Background="#0B1120" Margin="0">
                <ContentControl x:Name="MainContent" Content="{Binding CurrentView}"/>
            </Border>

            <!-- FLOATING EXPAND RIGHT ARROW BUTTON -->
            <!-- Visible ONLY when the sidebar is collapsed (SidebarToggle.IsChecked = True). Clicking it expands the sidebar back -->
            <ToggleButton IsChecked="{Binding IsChecked, ElementName=SidebarToggle, Mode=TwoWay}"
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Top" 
                          Margin="16">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ExpandArrowButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

        </Grid>
    </Grid>
</Window>