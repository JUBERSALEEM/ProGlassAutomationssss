<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP System"
        Height="780"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= HEADER (RESTORED FULL RIGHT CARDS) ================= -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="8"
                CornerRadius="16"
                Background="White"
                Padding="12">

            <DockPanel LastChildFill="True">

                <!-- LEFT TITLE -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="🧮"
                               FontSize="24"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="🏭 GLASS ERP SYSTEM"
                               FontSize="22"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- ================= RESTORED DEVELOPER CARDS (TOP RIGHT) ================= -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- DEVELOPER -->
                    <Border Background="#FFF7ED"
                            CornerRadius="10"
                            Padding="8"
                            Margin="3"
                            Width="140">

                        <StackPanel>
                            <TextBlock Text="👤 Developer" FontWeight="Bold"/>
                            <TextBlock Text="Juber Malik"/>
                        </StackPanel>

                    </Border>

                    <!-- COUNTRY -->
                    <Border Background="#ECFDF5"
                            CornerRadius="10"
                            Padding="8"
                            Margin="3"
                            Width="120">

                        <StackPanel>
                            <TextBlock Text="🌍 Country" FontWeight="Bold"/>
                            <TextBlock Text="India"/>
                        </StackPanel>

                    </Border>

                    <!-- CONTACT -->
                    <Border Background="#EFF6FF"
                            CornerRadius="10"
                            Padding="8"
                            Margin="3"
                            Width="160">

                        <StackPanel>
                            <TextBlock Text="📞 Contact" FontWeight="Bold"/>
                            <TextBlock Text="+971-559117727"/>
                        </StackPanel>

                    </Border>

                    <!-- EMAIL -->
                    <Border Background="#FDF2F8"
                            CornerRadius="10"
                            Padding="8"
                            Margin="3"
                            Width="220">

                        <StackPanel>
                            <TextBlock Text="📧 Email" FontWeight="Bold"/>
                            <TextBlock Text="jubersaleem01@gmail.com"/>
                        </StackPanel>

                    </Border>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#FFF4E1"
                Padding="10">

            <StackPanel>

                <Border Background="#D2691E" Margin="6" CornerRadius="10" MouseDown="SGU_Click">
                    <TextBlock Text="📊 SGU" Foreground="White" Padding="12"/>
                </Border>

                <Border Background="#D2691E" Margin="6" CornerRadius="10" MouseDown="DGU_Click">
                    <TextBlock Text="🧮 DGU" Foreground="White" Padding="12"/>
                </Border>

                <Border Background="#D2691E" Margin="6" CornerRadius="10" MouseDown="LAM_Click">
                    <TextBlock Text="🧪 LAMINATION" Foreground="White" Padding="12"/>
                </Border>

            </StackPanel>

        </Border>

        <!-- ================= MAIN WELCOME SCREEN (CLEAN) ================= -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Background="White"
                CornerRadius="12">

            <ContentControl x:Name="MainPanel">

                <Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="🏭 WELCOME TO GLASS ERP SYSTEM"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="📊 SGU • DGU • LAMINATION CALCULATION SYSTEM"
                                   FontSize="16"
                                   Margin="0,10,0,20"
                                   HorizontalAlignment="Center"/>

                        <!-- MODULE STATUS -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Border Background="#ECFDF5" CornerRadius="10" Padding="15" Margin="5" Width="160">
                                <StackPanel>
                                    <TextBlock Text="📊 SGU"/>
                                    <TextBlock Text="READY" Foreground="Green"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF6FF" CornerRadius="10" Padding="15" Margin="5" Width="160">
                                <StackPanel>
                                    <TextBlock Text="🧮 DGU"/>
                                    <TextBlock Text="READY" Foreground="Green"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FDF2F8" CornerRadius="10" Padding="15" Margin="5" Width="160">
                                <StackPanel>
                                    <TextBlock Text="🧪 LAMINATION"/>
                                    <TextBlock Text="READY" Foreground="Green"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </ContentControl>

        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Grid Grid.Row="2"
              Grid.ColumnSpan="2"
              Margin="10">

            <Border Background="#1F2937"
                    CornerRadius="14"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📅 DATE" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding CurrentDateText}" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="⏰ TIME" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding ClockText}" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="🟢 ERP STATUS" Foreground="#9CA3AF"/>
                        <TextBlock Text="SYSTEM READY" Foreground="#22C55E"/>
                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>