<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP System - SAP Fiori Enterprise"
        Height="780"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <!-- SHADOW -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Opacity="0.18"
                          Color="#000000"/>

        <!-- ================= FIORI CARD STYLE (UNCHANGED ANIMATION) ================= -->
        <Style x:Key="FioriCard" TargetType="Border">

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>

            <Style.Triggers>

                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.04"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.04"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.97"
                                             Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.97"
                                             Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.04"
                                             Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.04"
                                             Duration="0:0:0.08"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- ================= LAYOUT ================= -->
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="10"
                CornerRadius="18"
                Background="#0A6ED1"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <TextBlock Text="🏭 GLASS ERP SYSTEM"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <!-- RIGHT PANEL -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <!-- DATE TIME -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4"
                            Width="220"
                            Height="60"
                            Style="{StaticResource FioriCard}">

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="📅 DATE"
                                           Foreground="#0A6ED1"
                                           FontWeight="Bold"
                                           FontSize="10"/>
                                <TextBlock Text="{Binding CurrentDateText}"
                                           FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="|"
                                       VerticalAlignment="Center"
                                       Foreground="#A0AEC0"
                                       Margin="5,0"/>

                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="⏰ TIME"
                                           Foreground="#0A6ED1"
                                           FontWeight="Bold"
                                           FontSize="10"/>
                                <TextBlock Text="{Binding ClockText}"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                    </Border>

                    <!-- DEV -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4"
                            Width="130"
                            Height="60"
                            Style="{StaticResource FioriCard}">
                        <StackPanel>
                            <TextBlock Text="👤 DEV"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                            <TextBlock Text="JUBER SALEEM"/>
                        </StackPanel>
                    </Border>

                    <!-- COUNTRY -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4"
                            Width="110"
                            Height="60"
                            Style="{StaticResource FioriCard}">
                        <StackPanel>
                            <TextBlock Text="🌍 COUNTRY"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                            <TextBlock Text="India"/>
                        </StackPanel>
                    </Border>

                    <!-- CONTACT -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4"
                            Width="150"
                            Height="60"
                            Style="{StaticResource FioriCard}">
                        <StackPanel>
                            <TextBlock Text="📞 CONTACT"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                            <TextBlock Text="+971-559117727"/>
                        </StackPanel>
                    </Border>

                    <!-- EMAIL -->
                    <Border Background="White"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4"
                            Width="240"
                            Height="60"
                            Style="{StaticResource FioriCard}">
                        <StackPanel>
                            <TextBlock Text="📧 EMAIL"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                            <TextBlock Text="jubersaleem01@gmail.com"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="White"
                Margin="10"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}">

            <StackPanel>

                <Border Background="#0A6ED1"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="SGU_Click"
                        Style="{StaticResource FioriCard}">
                    <TextBlock Text="📊 SGU"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Background="#0854A0"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="DGU_Click"
                        Style="{StaticResource FioriCard}">
                    <TextBlock Text="🧮 DGU"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Background="#0A6ED1"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="LAM_Click"
                        Style="{StaticResource FioriCard}">
                    <TextBlock Text="🧪 LAMINATION"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>

        </Border>

        <!-- ================= MAIN PANEL ================= -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}">
            <ContentControl x:Name="MainPanel"/>
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="10"
                Background="#0A6ED1"
                CornerRadius="14"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="8"
                        Margin="5"
                        Style="{StaticResource FioriCard}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🟢"/>
                        <TextBlock Text="SYSTEM ACTIVE"
                                   Foreground="#0A6ED1"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="8"
                        Margin="5"
                        Style="{StaticResource FioriCard}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚙"/>
                        <TextBlock Text="ERP RUNNING"
                                   Foreground="#0A6ED1"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Padding="8"
                        Margin="5"
                        Style="{StaticResource FioriCard}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛡"/>
                        <TextBlock Text="STABLE MODE"
                                   Foreground="#22C55E"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Border>

    </Grid>
</Window>