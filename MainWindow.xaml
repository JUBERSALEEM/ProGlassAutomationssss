<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        Title="ProGlass ERP System" Height="1000" Width="1700"
        WindowStartupLocation="CenterScreen" Background="#0B1120"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="DarkBg" Color="#0B1120"/>
        <SolidColorBrush x:Key="DarkBg2" Color="#111827"/>
        <SolidColorBrush x:Key="DarkBg3" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1F2937"/>
        <SolidColorBrush x:Key="BorderLight" Color="#334155"/>
        <SolidColorBrush x:Key="BlueAccent" Color="#2563EB"/>
        <SolidColorBrush x:Key="BlueLight" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextGray" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>

        <!-- Menu Item Style -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Margin="0,2">
                            <Grid>
                                <ContentPresenter Margin="14,10" ContentSource="Header"/>
                                <Popup x:Name="PART_Popup"
                                       Placement="Right"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="Fade">
                                    <Border Background="#111827" BorderBrush="#334155" BorderThickness="1"
                                            CornerRadius="12" Padding="6" MinWidth="200">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.4"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Menu Item Style -->
        <Style x:Key="DropdownMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- License Warning Style -->
        <Style x:Key="LicenseWarningStyle" TargetType="Border">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- License Active Style -->
        <Style x:Key="LicenseActiveStyle" TargetType="Border">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="BorderBrush" Value="#065F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Module Button Style -->
        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Screenshot Button Style -->
        <Style x:Key="ScreenshotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📸" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Screenshot" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- =========================
     LEFT : LOGO
========================= -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo Box -->
                    <Border Width="68" Height="58" CornerRadius="10" Background="White" Cursor="Hand"
            Padding="5" MouseLeftButtonDown="Logo_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- PROGLASS Badge -->
                            <Border Grid.Row="0" Background="#2563EB" CornerRadius="4" Padding="5,2" 
                    HorizontalAlignment="Center" Margin="0,2,0,3">
                                <TextBlock Text="PROGLASS" FontSize="8" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- ERP -->
                            <TextBlock Grid.Row="1" Text="ERP" FontSize="22" FontWeight="Bold" 
                       Foreground="#2563EB" HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

                            <!-- SYSTEM -->
                            <TextBlock Grid.Row="2" Text="SYSTEM" FontSize="8" FontWeight="Bold" 
                       Foreground="#1E293B" HorizontalAlignment="Center" 
                       Margin="0,3,0,2"/>
                        </Grid>
                    </Border>

                    <!-- App Name -->
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                        <TextBlock Text="Automation System" FontSize="9" Foreground="Black" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- =========================
                     CENTER : NAVIGATION
                ========================== -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Dashboard Button -->
                    <Border Background="#2563EB" CornerRadius="10" Padding="18,10" Cursor="Hand"
                            MouseLeftButtonDown="BtnHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Dashboard" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Menu -->
                    <Menu Background="Transparent" BorderThickness="0">
                        <Menu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                        </Menu.Resources>

                        <!-- INVOICES -->
                        <MenuItem Header="💰 Invoices ▼" Margin="10,0,0,0">
                            <MenuItem Header="🧾 Proforma Invoice" Click="MenuItem_ProformaInvoice_Click"/>
                            <MenuItem Header="📋 Job Orders" Click="MenuItem_JobOrders_Click"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="📜 Invoice History"/>
                            <MenuItem Header="💵 Pending Payments"/>
                        </MenuItem>

                        <!-- CALCULATORS -->
                        <MenuItem Header="🧮 Calculators ▼" Margin="10,0,0,0">
                            <MenuItem Header="▣ SGU Calculator" Click="MenuItem_SGU_Click"/>
                            <MenuItem Header="◫ DGU Calculator" Click="MenuItem_DGU_Click"/>
                            <MenuItem Header="▤ Lamination" Click="MenuItem_Lamination_Click"/>
                            <MenuItem Header="◈ DGU + Lamination" Click="MenuItem_DguLam_Click"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="✂ Optimizer" Click="MenuItem_Optimizer_Click"/>
                        </MenuItem>

                        <!-- OPERATIONS -->
                        <MenuItem Header="⚙️ Operations ▼" Margin="10,0,0,0">
                            <MenuItem Header="▦ Sheet Store" Click="MenuItem_SheetStore_Click"/>
                            <MenuItem Header="☰ Daily Works" Click="MenuItem_DailyWorks_Click"/>
                            <MenuItem Header="☘ Deliveries" Click="MenuItem_Deliveries_Click"/>
                        </MenuItem>

                        <!-- REPORTS -->
                        <MenuItem Header="📈 Reports ▼" Margin="10,0,0,0">
                            <MenuItem Header="📊 Sales Report"/>
                            <MenuItem Header="📉 Profit Analysis"/>
                            <MenuItem Header="📤 Export Reports"/>
                        </MenuItem>

                        <!-- SETTINGS -->
                        <MenuItem Header="⚙️ Settings ▼" Margin="10,0,0,0">
                            <MenuItem Header="👤 Profile" Click="MenuItem_Profile_Click"/>
                            <MenuItem Header="👥 Users" Click="MenuItem_Users_Click"/>
                            <Separator Background="#334155"/>
                            <MenuItem Header="ℹ About App" Click="MenuItem_About_Click"/>
                        </MenuItem>

                    </Menu>
                </StackPanel>

                <!-- =========================
                     RIGHT SECTION
                ========================== -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- License Status -->
                    <Border x:Name="LicenseWarningBorder" Style="{StaticResource LicenseWarningStyle}" 
                            Margin="0,0,14,0" MouseLeftButtonDown="LicenseWarningBorder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock Text="⚠" FontSize="11" Margin="0,0,4,0" Foreground="#FCA5A5"/>
                            <TextBlock Text="Activate License" FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LicenseActiveBorder" Style="{StaticResource LicenseActiveStyle}" 
                            Margin="0,0,14,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="✓" FontSize="11" Foreground="#6EE7B7" Margin="0,0,4,0"/>
                            <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                        </StackPanel>
                    </Border>

                    <!-- Screenshot Button -->
                    <Button x:Name="ScreenshotBtn" Style="{StaticResource ScreenshotButtonStyle}" 
                            Click="ScreenshotBtn_Click" Margin="0,0,14,0"/>

                    <!-- Date & Time -->
                    <Border Background="#1E293B" CornerRadius="10" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="11" FontWeight="Bold" 
                                           Foreground="White" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Width="1" Background="#334155" Margin="0,2"/>

                            <!-- Time -->
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="🕐" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock x:Name="ClockText" FontSize="11" FontWeight="Bold" 
                                           Foreground="White" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CONTENT AREA ==================== -->
        <Border x:Name="MainContentBorder" Grid.Row="1" Background="#111827" Margin="16" 
                CornerRadius="16" Effect="{StaticResource CardShadow}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>