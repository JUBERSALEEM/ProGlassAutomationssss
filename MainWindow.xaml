<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass ERP System"
        Height="900" Width="1600"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <DropShadowEffect x:Key="CS" BlurRadius="20" ShadowDepth="2" Opacity="0.18"/>

        <LinearGradientBrush x:Key="HG" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A6ED1" Offset="0"/>
            <GradientStop Color="#1E88E5" Offset="0.5"/>
            <GradientStop Color="#0D47A1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GG" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0F9FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- About Button Style -->
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2V7h2v2z" 
                                      Fill="#0A6ED1" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="About" FontSize="11" FontWeight="Bold" Foreground="#0A6ED1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calc Button Style with Lock Overlay -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="lockOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Collapsed">
                                    <TextBlock Text="🔒 LOCKED" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="lockOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="10" CornerRadius="18" Background="{StaticResource HG}" Effect="{StaticResource CS}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait Logo -->
                <Border Grid.Column="0" Margin="15,10,15,10" Width="70" Height="80" CornerRadius="12" Background="#FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="PROGLASS" FontSize="10" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                        <TextBlock Text="ERP" FontSize="18" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                        <Border Height="1" Background="#0A6ED1" Margin="8,4,8,0"/>
                        <TextBlock Text="SYSTEM" FontSize="8" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="PROGLASS ERP SYSTEM" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Glass Processing Automation Platform" FontSize="12" Foreground="#D1E9F9" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Info Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">

                    <!-- About Button -->
                    <Button Style="{StaticResource AboutButtonStyle}" Click="About_Click" Margin="6"/>

                    <!-- Date/Time Card -->
                    <Border Background="White" CornerRadius="12" Padding="12" Margin="6" Width="220" Height="70" Effect="{StaticResource CS}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DATE" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="1" Background="#E5E7EB"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="TIME" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource GG}" Opacity="0.95" Margin="10" CornerRadius="14" Effect="{StaticResource CS}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Dashboard Section -->
                    <Border Margin="10,10,10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#10B981" CornerRadius="12,12,0,0" Padding="12,8">
                                <TextBlock Text="DASHBOARD" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <StackPanel Margin="6,8,6,8">
                                <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                                    <Border Background="#ECFDF5" CornerRadius="8" Padding="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◉" FontSize="14" Foreground="#10B981" VerticalAlignment="Center"/>
                                            <TextBlock Text="Overview" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Subscription" Margin="0,4,0,0">
                                    <Border Background="#FEF3C7" CornerRadius="8" Padding="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◉" FontSize="14" Foreground="#D97706" VerticalAlignment="Center"/>
                                            <TextBlock Text="Subscription Plans" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calculators Section -->
                    <Border Margin="10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#F3F4F6" CornerRadius="12,12,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CALCULATORS" FontSize="10" FontWeight="SemiBold" Foreground="#6A6D70"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                        <Setter Property="Background" Value="#E2F0E6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="8" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔒 LOCKED"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                            <Setter Property="Text" Value="✓ ACTIVE"/>
                                                            <Setter Property="Foreground" Value="#107E3E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,8,6,10">

                                <!-- SGU Calculator -->
                                <Button Style="{StaticResource CalcButton}" Background="#0A6ED1" 
                    Command="{Binding NavigateCommand}" CommandParameter="SGU"
                    IsEnabled="{Binding IsLicensed}">
                                    <TextBlock Text="SGU Calculator" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Button>

                                <!-- DGU Calculator -->
                                <Button Style="{StaticResource CalcButton}" Background="#0854A0" Margin="0,4,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="DGU"
                    IsEnabled="{Binding IsLicensed}">
                                    <TextBlock Text="DGU Calculator" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Button>

                                <!-- Lamination -->
                                <Button Style="{StaticResource CalcButton}" Background="#1E88E5" Margin="0,4,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="Lamination"
                    IsEnabled="{Binding IsLicensed}">
                                    <TextBlock Text="Lamination" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Button>

                                <!-- DGU + Lamination -->
                                <Button Style="{StaticResource CalcButton}" Background="#D32F2F" Margin="0,4,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="DguLam"
                    IsEnabled="{Binding IsLicensed}">
                                    <TextBlock Text="DGU + Lamination" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Button>

                                <!-- Glass Optimization -->
                                <Button Style="{StaticResource CalcButton}" Background="#7C3AED" Margin="0,4,0,0"
                    Command="{Binding NavigateCommand}" CommandParameter="Optimization"
                    IsEnabled="{Binding IsLicensed}">
                                    <TextBlock Text="Optimization" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MANAGEMENT SECTION -->
                    <Border Margin="10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#7C3AED" CornerRadius="12,12,0,0" Padding="12,8">
                                <TextBlock Text="MANAGEMENT" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <StackPanel Margin="6,8,6,10">

                                <!-- Sheet Store -->
                                <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="SheetStore">
                                    <Border Background="#F3F4F6" CornerRadius="10" Padding="14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#7C3AED" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="📦" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Sheet Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Aluminum Store -->
                                <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="AluminumStore" Margin="0,4,0,0">
                                    <Border Background="#F3F4F6" CornerRadius="10" Padding="14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#F59E0B" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="🔩" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Aluminum Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Spacer Store -->
                                <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="SpacerStore" Margin="0,4,0,0">
                                    <Border Background="#F3F4F6" CornerRadius="10" Padding="14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#10B981" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="📏" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Spacer Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Support Card -->
                    <Border Margin="10,6" CornerRadius="10" Padding="14" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SUPPORT AND CONTACT" FontSize="10" FontWeight="SemiBold" Foreground="#6A6D70"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="#E2F0E6">
                                    <TextBlock Text="ONLINE" FontSize="8" FontWeight="Bold" Foreground="#107E3E"/>
                                </Border>
                            </Grid>
                            <Border Background="#F3F4F6" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Jubersaleem01@gmail.com" FontSize="11" Foreground="#0A6ED1"/>
                                    <TextBlock Text="www.proglass.com" FontSize="11" Foreground="#6A6D70" Margin="0,6,0,0"/>
                                    <TextBlock Text="WhatsApp Support" FontSize="11" Foreground="#6A6D70" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Grid.Column="1" Margin="10" CornerRadius="16" Effect="{StaticResource CS}" Background="{StaticResource GG}" Opacity="0.95">
            <Grid>
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="10" Background="#0A6ED1" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- License Status -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="LICENSE INACTIVE"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="LICENSE ACTIVE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Calculators Status -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F59E0B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CALCULATORS LOCKED"/>
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="CALCULATORS UNLOCKED"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Activation Status -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ACTIVATION REQUIRED"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="ACTIVATION COMPLETE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>