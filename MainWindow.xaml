<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass ERP System"
        Height="900" Width="1600"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <DropShadowEffect x:Key="CS" BlurRadius="20" ShadowDepth="2" Opacity="0.18"/>

        <LinearGradientBrush x:Key="HG" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A6ED1" Offset="0"/>
            <GradientStop Color="#1E88E5" Offset="0.5"/>
            <GradientStop Color="#0D47A1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GG" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0F9FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="10" CornerRadius="18" Background="{StaticResource HG}" Effect="{StaticResource CS}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait Logo -->
                <Border Grid.Column="0" Margin="15,10,15,10" Width="70" Height="80" CornerRadius="12" Background="#FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="PROGLASS" FontSize="10" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                        <TextBlock Text="ERP" FontSize="18" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                        <Border Height="1" Background="#0A6ED1" Margin="8,4,8,0"/>
                        <TextBlock Text="SYSTEM" FontSize="8" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="PROGLASS ERP SYSTEM" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Glass Processing Automation Platform" FontSize="12" Foreground="#D1E9F9" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Info Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">

                    <Border Background="White" CornerRadius="12" Padding="12" Margin="6" Width="240" Height="70" Effect="{StaticResource CS}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DATE" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="1" Background="#E5E7EB"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="TIME" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="12" Margin="6" Width="160" Height="70" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="DEVELOPER" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="JUBER SALEEM" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="12" Margin="6" Width="140" Height="70" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="LOCATION" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="DUBAI, UAE" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="12" Margin="6" Width="170" Height="70" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="CONTACT" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="+971-559117727" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource GG}" Opacity="0.95" Margin="10" CornerRadius="14" Effect="{StaticResource CS}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Dashboard Section -->
                    <Border Margin="10,10,10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#10B981" CornerRadius="12,12,0,0" Padding="12,8">
                                <TextBlock Text="DASHBOARD" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <StackPanel Margin="6,8,6,8">
                                <Border Background="#ECFDF5" CornerRadius="8" MouseLeftButtonDown="Dashboard_Click" Cursor="Hand" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="14" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="Overview" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="8" Margin="0,4,0,0" MouseLeftButtonDown="SubscriptionPlan_Click" Cursor="Hand" Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="14" Foreground="#D97706" VerticalAlignment="Center"/>
                                        <TextBlock Text="Subscription Plans" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calculators Section -->
                    <Border x:Name="CalculatorsSection" Margin="10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Opacity="0.5">
                        <StackPanel>
                            <Border Background="#F3F4F6" CornerRadius="12,12,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CALCULATORS" FontSize="10" FontWeight="SemiBold" Foreground="#6A6D70"/>
                                    <Border x:Name="LockedIcon" Grid.Column="1" Background="#FEE2E2" CornerRadius="4" Padding="4,2">
                                        <TextBlock Text="🔒 LOCKED" FontSize="8" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,8,6,10">

                                <!-- SGU Calculator -->
                                <Border x:Name="SGUBorder" Background="#0A6ED1" CornerRadius="10" MouseLeftButtonDown="SGU_Click" Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="SGU Calculator" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14" HorizontalAlignment="Center"/>
                                        <Border x:Name="SGUOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- DGU Calculator -->
                                <Border x:Name="DGUBorder" Background="#0854A0" Margin="0,4" CornerRadius="10" MouseLeftButtonDown="DGU_Click" Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="DGU Calculator" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14" HorizontalAlignment="Center"/>
                                        <Border x:Name="DGUOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- Lamination -->
                                <Border x:Name="LAMBorder" Background="#1E88E5" Margin="0,4" CornerRadius="10" MouseLeftButtonDown="LAM_Click" Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="Lamination" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14" HorizontalAlignment="Center"/>
                                        <Border x:Name="LAMOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- DGU + Lamination -->
                                <Border x:Name="DGULamBorder" Background="#D32F2F" Margin="0,4" CornerRadius="10" MouseLeftButtonDown="DguLam_Click" Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="DGU + Lamination" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14" HorizontalAlignment="Center"/>
                                        <Border x:Name="DGULamOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- Glass Optimization -->
                                <Border x:Name="GlassOptBorder" Background="#7C3AED" Margin="0,4" CornerRadius="10" MouseLeftButtonDown="GlassOpt_Click" Cursor="Hand">
                                    <Grid>
                                        <TextBlock Text="Optimization" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14" HorizontalAlignment="Center"/>
                                        <Border x:Name="GlassOptOverlay" Background="#000000" Opacity="0.3" CornerRadius="10" Visibility="Visible"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MANAGEMENT SECTION -->
                    <Border Margin="10,6" CornerRadius="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#7C3AED" CornerRadius="12,12,0,0" Padding="12,8">
                                <TextBlock Text="MANAGEMENT" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <StackPanel Margin="6,8,6,10">

                                <!-- Sheet Store -->
                                <Border Background="#F3F4F6" CornerRadius="10" MouseLeftButtonDown="SheetStore_Click" Cursor="Hand">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="14">
                                            <Border Background="#7C3AED" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="📦" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Sheet Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#000000" Opacity="0.1" CornerRadius="10" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Aluminum Store -->
                                <Border Background="#F3F4F6" CornerRadius="10" Margin="0,4" MouseLeftButtonDown="AluminumStore_Click" Cursor="Hand">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="14">
                                            <Border Background="#F59E0B" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="🔩" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Aluminum Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Spacer Store -->
                                <Border Background="#F3F4F6" CornerRadius="10" Margin="0,4" MouseLeftButtonDown="SpacerStore_Click" Cursor="Hand">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="14">
                                            <Border Background="#10B981" CornerRadius="6" Padding="6,4">
                                                <TextBlock Text="📏" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Spacer Store" Foreground="#1F1F1F" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Support Card -->
                    <Border Margin="10,6" CornerRadius="10" Padding="14" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SUPPORT AND CONTACT" FontSize="10" FontWeight="SemiBold" Foreground="#6A6D70"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="#E2F0E6">
                                    <TextBlock Text="ONLINE" FontSize="8" FontWeight="Bold" Foreground="#107E3E"/>
                                </Border>
                            </Grid>
                            <Border Background="#F3F4F6" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Jubersaleem01@gmail.com" FontSize="11" Foreground="#0A6ED1"/>
                                    <TextBlock Text="www.proglass.com" FontSize="11" Foreground="#6A6D70" Margin="0,6,0,0"/>
                                    <TextBlock Text="WhatsApp Support" FontSize="11" Foreground="#6A6D70" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Grid.Column="1" Margin="10" CornerRadius="16" Effect="{StaticResource CS}" Background="{StaticResource GG}" Opacity="0.95">
            <Grid>
                <ContentControl x:Name="MainPanel"/>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="10" Background="#0A6ED1" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="SystemActiveDot" Width="12" Height="12" Fill="#DC2626" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SystemStatusText" Text="LICENSE INACTIVE" Foreground="#DC2626" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="CalculatorsStatusDot" Width="12" Height="12" Fill="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CalculatorsStatusText" Text="CALCULATORS LOCKED" Foreground="#D97706" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="ActivationStatusDot" Width="12" Height="12" Fill="#DC2626" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ActivationStatusText" Text="ACTIVATION REQUIRED" Foreground="#DC2626" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>