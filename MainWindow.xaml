<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP System" Height="780" Width="1280" WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Window.Resources>
        <DropShadowEffect x:Key="CS" BlurRadius="20" ShadowDepth="2" Opacity="0.18"/>
        <LinearGradientBrush x:Key="HG" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A6ED1" Offset="0"/>
            <GradientStop Color="#1E88E5" Offset="0.5"/>
            <GradientStop Color="#0D47A1" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GG" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0F9FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Canvas Grid.RowSpan="3" Grid.ColumnSpan="2" Opacity="0.2" IsHitTestVisible="False">
            <Ellipse Width="80" Height="80" Fill="White" Opacity="0.4" Canvas.Left="100" Canvas.Top="600">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="700"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:8" Value="-100"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="50" Height="50" Fill="White" Opacity="0.3" Canvas.Left="300" Canvas.Top="650">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="700"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:10" Value="-100"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="100" Height="100" Fill="White" Opacity="0.25" Canvas.Left="600" Canvas.Top="680">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="700"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:12" Value="-100"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="60" Height="60" Fill="White" Opacity="0.35" Canvas.Left="900" Canvas.Top="620">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="700"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:7" Value="-100"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="40" Height="40" Fill="White" Opacity="0.3" Canvas.Left="1100" Canvas.Top="660">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Canvas.Top)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="700"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:9" Value="-100"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Canvas>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="10" CornerRadius="18" Background="{StaticResource HG}" Effect="{StaticResource CS}">
            <Grid>
                <TextBlock Text="🏭 PROGLASS ERP SYSTEM" Foreground="White" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="4" Width="220" Height="60" Effect="{StaticResource CS}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="📅 DATE" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding CurrentDateText}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="|" VerticalAlignment="Center" FontSize="14"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="⏰ TIME" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                                <TextBlock Text="{Binding ClockText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="4" Width="130" Height="60" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="👤 DEVELOPER" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="JUBER SALEEM" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="4" Width="110" Height="60" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="🌍 LOCATION" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="DUBAI, UAE" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="4" Width="140" Height="60" Effect="{StaticResource CS}">
                        <StackPanel>
                            <TextBlock Text="📞 CONTACT" Foreground="#0A6ED1" FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="+971-559117727" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource GG}" Opacity="0.95" Margin="10" CornerRadius="14" Effect="{StaticResource CS}">
            <StackPanel>
                <Border Background="White" Margin="10,10,10,5" CornerRadius="12" Padding="10" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="80" Height="80" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="2" CornerRadius="40" MouseLeftButtonDown="LogoButton_Click" Cursor="Hand">
                            <Ellipse x:Name="LogoEllipse" Fill="#E5E7EB"/>
                        </Border>
                        <TextBlock Text="📷 Upload Logo" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Margin="10,5,10,5" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏢 COMPANY NAME" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontWeight="Bold" Foreground="#1F2937" TextAlignment="Center" BorderThickness="0" Background="Transparent" Margin="0,5,0,0"/>
                        <TextBlock Text="🔢 TRN NUMBER" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding CompanyTRN, UpdateSourceTrigger=PropertyChanged}" FontSize="11" FontWeight="SemiBold" Foreground="#374151" TextAlignment="Center" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Border Background="#0A6ED1" Margin="6,10,6,4" CornerRadius="12" MouseLeftButtonDown="SGU_Click" Effect="{StaticResource CS}" Cursor="Hand">
                    <TextBlock Text="📊 SGU" Foreground="White" FontWeight="SemiBold" Padding="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#0854A0" Margin="6,4" CornerRadius="12" MouseLeftButtonDown="DGU_Click" Effect="{StaticResource CS}" Cursor="Hand">
                    <TextBlock Text="🧮 DGU" Foreground="White" FontWeight="SemiBold" Padding="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#1E88E5" Margin="6,4" CornerRadius="12" MouseLeftButtonDown="LAM_Click" Effect="{StaticResource CS}" Cursor="Hand">
                    <TextBlock Text="🧪 LAMINATION" Foreground="White" FontWeight="SemiBold" Padding="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#D32F2F" Margin="6,4" CornerRadius="12" MouseLeftButtonDown="DguLam_Click" Effect="{StaticResource CS}" Cursor="Hand">
                    <TextBlock Text="🧩 DGU + LAMINATION" Foreground="White" FontWeight="SemiBold" Padding="14" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#7C3AED" Margin="6,4" CornerRadius="12" MouseLeftButtonDown="GlassOpt_Click" Effect="{StaticResource CS}" Cursor="Hand">
                    <TextBlock Text="📐 OPTIMIZATION" Foreground="White" FontWeight="SemiBold" Padding="14" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainPanel" Margin="10"/>
        <Border Grid.Row="1" Grid.Column="1" Margin="10" CornerRadius="16" Effect="{StaticResource CS}" x:Name="WelcomeScreen" Background="{StaticResource GG}" Opacity="0.95">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏭 WELCOME TO GLASS ERP SYSTEM" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select module from sidebar to continue" FontSize="14" Margin="0,10,0,25" HorizontalAlignment="Center" Foreground="#6B7280"/>
                    <WrapPanel HorizontalAlignment="Center" MaxWidth="700">
                        <Border Background="#F0FDF4" CornerRadius="12" BorderBrush="#86EFAC" BorderThickness="2" Padding="20" Margin="8" Width="180" Height="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊 SGU" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#166534"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="WORKING" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" CornerRadius="12" BorderBrush="#FCD34D" BorderThickness="2" Padding="20" Margin="8" Width="180" Height="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧮 DGU" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#92400E"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="WORKING" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#EFF6FF" CornerRadius="12" BorderBrush="#93C5FD" BorderThickness="2" Padding="20" Margin="8" Width="180" Height="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧪 LAMINATION" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E40AF"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="WORKING" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF2F2" CornerRadius="12" BorderBrush="#FCA5A5" BorderThickness="2" Padding="20" Margin="8" Width="180" Height="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧩 DGU+LAM" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#991B1B"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="WORKING" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#F5F3FF" CornerRadius="12" BorderBrush="#C4B5FD" BorderThickness="2" Padding="20" Margin="8" Width="180" Height="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📐 OPTIMIZATION" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B21A8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="WORKING" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="🟢 ALL SYSTEMS ONLINE" Margin="0,25,0,0" Foreground="#22C55E" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="10" Background="#0A6ED1" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM ACTIVE" Foreground="#059669" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock Text="CALCULATORS READY" Foreground="#D97706" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12" Margin="4" Effect="{StaticResource CS}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#22C55E" Margin="0,0,8,0"/>
                        <TextBlock Text="PRODUCTION LIVE" Foreground="#16A34A" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>