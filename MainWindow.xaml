<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
        Title="ProGlass ERP System" Height="950" Width="1650"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderSharp" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="HoverBlue" Color="#EFF6FF"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>

        <!-- Header Gradient -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- License Warning Style -->
        <Style x:Key="LicenseWarningStyle" TargetType="Border">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- License Active Style -->
        <Style x:Key="LicenseActiveStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Compact Dropdown Button Style -->
        <Style x:Key="CompactDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter/>
                                <TextBlock Text="▼" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Home Button Style -->
        <Style x:Key="CompactHomeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="HOME" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Screenshot Button Style -->
        <Style x:Key="CompactScreenshotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Screenshot" FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSharp}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBlue}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- COMPACT HEADER - Always Visible (Dashboard + Modules) -->
        <Border x:Name="MainHeader" Grid.Row="0" Margin="12,12,12,0" CornerRadius="12" Background="{StaticResource HeaderGradient}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Logo + Nav -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Compact Logo -->
                    <Border Margin="12,8" Width="60" Height="52" CornerRadius="8" Background="#FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#3B82F6" CornerRadius="4" Padding="4,2">
                                <TextBlock Text="PROGLASS" FontSize="6" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="ERP" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                            <Border Height="1" Background="#3B82F6" Margin="8,2,8,0"/>
                            <TextBlock Text="SYSTEM" FontSize="5" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Compact Nav Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">

                        <!-- Home Button -->
                        <Button x:Name="BtnHome" Style="{StaticResource CompactHomeButtonStyle}" Click="BtnHome_Click" Margin="0,0,10,0"/>

                        <!-- Dashboard Button -->
                        <Button x:Name="BtnDashboard" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="DASHBOARD"/>
                            </StackPanel>
                        </Button>

                        <!-- Licensing Button -->
                        <Button x:Name="BtnSubscription" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnSubscription_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="LICENSING"/>
                            </StackPanel>
                        </Button>

                        <!-- Calculators Dropdown -->
                        <Button x:Name="BtnCalculators" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnCalculators_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧮" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="CALCULATORS"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CalculatorsMenu">
                                    <MenuItem Header="🧮 SGU CALC" Click="BtnSGU_Click"/>
                                    <MenuItem Header="📑 DGU CALC" Click="BtnDGU_Click"/>
                                    <MenuItem Header="🔳 LAMINATION" Click="BtnLamination_Click"/>
                                    <MenuItem Header="🪟 DGU + LAM" Click="BtnDguLam_Click"/>
                                    <MenuItem Header="✂️ OPTIMIZER" Click="BtnOptimization_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Operations Dropdown -->
                        <Button x:Name="BtnOperations" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnOperations_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="OPERATIONS"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="OperationsMenu">
                                    <MenuItem Header="📦 SHEET STORE" Click="BtnSheetStore_Click"/>
                                    <MenuItem Header="📋 DAILY WORKS" Click="BtnDailyWorks_Click"/>
                                    <MenuItem Header="🚚 DELIVERIES" Click="BtnDeliveries_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Reports Dropdown -->
                        <Button x:Name="BtnReports" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnReports_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="REPORTS"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ReportsMenu">
                                    <MenuItem Header="📋 DAILY WORKS REPORT" Click="BtnDailyWorks_Click"/>
                                    <MenuItem Header="🚚 DELIVERY REPORT" Click="BtnDeliveries_Click"/>
                                    <MenuItem Header="📦 INVENTORY REPORT" Click="BtnSheetStore_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Settings Dropdown -->
                        <Button x:Name="BtnSettings" Style="{StaticResource CompactDropdownButtonStyle}" Click="BtnSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="SETTINGS"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SettingsMenu">
                                    <MenuItem Header="👤 PROFILE" Click="BtnProfile_Click"/>
                                    <MenuItem Header="👥 USERS" Click="BtnUsers_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- License Status -->
                        <Border x:Name="LicenseWarningBorder" Style="{StaticResource LicenseWarningStyle}" Margin="10,0,0,0" MouseLeftButtonDown="LicenseWarningBorder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,8,0"/>
                                <TextBlock Text="⚠️" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Activate License" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LicenseActiveBorder" Style="{StaticResource LicenseActiveStyle}" Margin="10,0,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0"/>
                                <TextBlock Text="✓" FontSize="10" Foreground="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="#059669"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- RIGHT: Screenshot + Date/Time -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="ScreenshotBtn" Style="{StaticResource CompactScreenshotButtonStyle}" Click="ScreenshotBtn_Click" Margin="4">
                        <TextBlock Text="📷" FontSize="12" Margin="0,0,6,0"/>
                    </Button>
                    <Border CornerRadius="8" Padding="12,6" Margin="4" Effect="{StaticResource CardShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0F9FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="📅" Foreground="#60A5FA" FontSize="8"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Width="1" Background="#BFDBFE"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="🕐" Foreground="#60A5FA" FontSize="8"/>
                                <TextBlock x:Name="ClockText" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT AREA - Full height for modules -->
        <Border x:Name="MainContentBorder" Grid.Row="1" Background="White" Margin="12" CornerRadius="12" Effect="{StaticResource CardShadow}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>