<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sgu="clr-namespace:ProGlassAutomation.Views.SGU"
        Title="ProGlass Automation"
        Height="750"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#FF8C00">

    <Grid>

        <!-- OUTER FRAME -->
        <Border Margin="15"
                Background="#F3F3F3"
                CornerRadius="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Margin="10"
                        Padding="10">

                    <StackPanel>

                        <TextBlock Text="GLASS SYSTEM"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"
                                   Foreground="Black"/>

                        <Button Content="SGU"
                                Height="40"
                                Margin="0,5"
                                Background="#FF8C00"
                                Foreground="Black"
                                Click="SGU_Click"/>

                        <Button Content="DGU"
                                Height="40"
                                Margin="0,5"
                                Background="#FF8C00"
                                Foreground="Black"
                                Click="DGU_Click"/>

                        <Button Content="LAMINATION"
                                Height="40"
                                Margin="0,5"
                                Background="#FF8C00"
                                Foreground="Black"
                                Click="Lamination_Click"/>

                    </StackPanel>

                </Border>

                <!-- MAIN CONTENT AREA (THIS IS WHERE SGU APPEARS) -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="15"
                        Margin="10">

                    <ContentControl x:Name="MainContent"
                                    Margin="10"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>