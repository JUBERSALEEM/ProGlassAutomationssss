<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR (RESTORED STYLE) ================= -->
        <Border Grid.Column="0"
                Background="SandyBrown"
                Padding="15">

            <StackPanel>

                <!-- HEADER (OLD STYLE RESTORED) -->
                <TextBlock Text="GLASS ERP"
                           Foreground="Black"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="10"/>

                <!-- SGU -->
                <Border x:Name="SGUButton"
                        CornerRadius="12"
                        Margin="5"
                        Background="SaddleBrown"
                        MouseDown="SGU_Click">

                    <TextBlock Text="SGU"
                               Foreground="White"
                               Padding="15"/>
                </Border>

                <!-- DGU -->
                <Border x:Name="DGUButton"
                        CornerRadius="12"
                        Margin="5"
                        Background="SaddleBrown"
                        MouseDown="DGU_Click">

                    <TextBlock Text="DGU"
                               Foreground="White"
                               Padding="15"/>
                </Border>

                <!-- LAMINATION (ADDED ONLY - SAFE) -->
                <Border x:Name="LAMButton"
                        CornerRadius="12"
                        Margin="5"
                        Background="SaddleBrown"
                        MouseDown="LAM_Click">

                    <TextBlock Text="LAMINATION"
                               Foreground="White"
                               Padding="15"/>
                </Border>

            </StackPanel>

        </Border>

        <!-- ================= MAIN PANEL (RESTORED STYLE) ================= -->
        <ContentControl x:Name="MainPanel"
                        Grid.Column="1"/>

    </Grid>
</Window>