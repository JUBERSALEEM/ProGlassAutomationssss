<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass ERP System"
        Height="900" Width="1600"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F0F7FF">

    <Window.Resources>
        <!-- Drop Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.12"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>

        <!-- Header Gradient -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.4"/>
            <GradientStop Color="#60A5FA" Offset="0.7"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sidebar Gradient -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#EFF6FF" Offset="0.5"/>
            <GradientStop Color="#DBEAFE" Offset="1"/>
        </LinearGradientBrush>

        <!-- Content Gradient -->
        <LinearGradientBrush x:Key="ContentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8FAFC" Offset="1"/>
        </LinearGradientBrush>

        <!-- Footer Gradient -->
        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Screenshot Button Style -->
        <Style x:Key="ScreenshotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Screenshot" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- About Button Style -->
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2V7h2v2z" 
                                      Fill="#3B82F6" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="About" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calc Button Style -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#1E40AF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="lockOverlay" Background="#000000" Opacity="0.45" CornerRadius="10" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔒" FontSize="14"/>
                                        <TextBlock Text="LOCKED" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="lockOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="12" CornerRadius="16" Background="{StaticResource HeaderGradient}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Border Grid.Column="0" Margin="16,12" Width="80" Height="88" CornerRadius="14" Background="#FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#3B82F6" CornerRadius="6" Padding="6,3" Margin="0,0,0,5">
                            <TextBlock Text="PROGLASS" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="ERP" FontSize="26" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                        <Border Height="2" Background="#3B82F6" Margin="12,6,12,0"/>
                        <TextBlock Text="SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="PROGLASS ERP SYSTEM" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Glass Processing Automation Platform" FontSize="13" Foreground="#BFDBFE" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Info Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Style="{StaticResource ScreenshotButtonStyle}" Click="ScreenshotBtn_Click" Margin="6"/>
                    <Button Style="{StaticResource AboutButtonStyle}" Click="About_Click" Margin="6"/>
                    <Border CornerRadius="12" Padding="16" Margin="6" Effect="{StaticResource ButtonShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0F9FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="DATE" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="9"/>
                                <TextBlock x:Name="CurrentDateText" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Width="1" Background="#BFDBFE"/>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="TIME" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="9"/>
                                <TextBlock x:Name="ClockText" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarGradient}" Margin="10" CornerRadius="14" Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">

                    <!-- Dashboard Section -->
                    <Border CornerRadius="12" Margin="0,0,0,10" Effect="{StaticResource ButtonShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Border CornerRadius="12,12,0,0" Padding="14,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉" FontSize="11" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DASHBOARD" FontSize="10" FontWeight="Bold" Foreground="#D1FAE5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="10,10,10,14">
                                <Button x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" MouseEnter="BtnDashboard_MouseEnter" MouseLeave="BtnDashboard_MouseLeave">
                                    <Border CornerRadius="10" Padding="14" Background="#34D399" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="DashScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Overview" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button x:Name="BtnSubscription" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Subscription" Margin="0,8,0,0" MouseEnter="BtnSubscription_MouseEnter" MouseLeave="BtnSubscription_MouseLeave">
                                    <Border CornerRadius="10" Padding="14" Background="#FBBF24" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SubScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Subscription Plans" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calculators Section -->
                    <Border CornerRadius="12" Margin="0,0,0,10" Effect="{StaticResource ButtonShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Border CornerRadius="12,12,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="12" Foreground="#BFDBFE" VerticalAlignment="Center"/>
                                        <TextBlock Text="CALCULATORS" FontSize="10" FontWeight="Bold" Foreground="#DBEAFE" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="8,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="8" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔒 LOCKED"/>
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                            <Setter Property="Text" Value="✓ ACTIVE"/>
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="8,8,8,12">

                                <!-- SGU Calculator -->
                                <Button x:Name="BtnSGU" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SGU" IsEnabled="{Binding IsLicensed}" MouseEnter="CalcBtn_MouseEnter" MouseLeave="CalcBtn_MouseLeave">
                                    <Border x:Name="BorderSGU" CornerRadius="10" Padding="12" Background="#60A5FA" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleSGU" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬜" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="SGU Calculator" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- DGU Calculator -->
                                <Button x:Name="BtnDGU" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="DGU" IsEnabled="{Binding IsLicensed}" Margin="0,8,0,0" MouseEnter="CalcBtn_MouseEnter" MouseLeave="CalcBtn_MouseLeave">
                                    <Border x:Name="BorderDGU" CornerRadius="10" Padding="12" Background="#3B82F6" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleDGU" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬜" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="⬜" FontSize="16" Foreground="White" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="DGU Calculator" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Lamination -->
                                <Button x:Name="BtnLam" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Lamination" IsEnabled="{Binding IsLicensed}" Margin="0,8,0,0" MouseEnter="CalcBtn_MouseEnter" MouseLeave="CalcBtn_MouseLeave">
                                    <Border x:Name="BorderLam" CornerRadius="10" Padding="12" Background="#2563EB" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleLam" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBlock Text="▬▬▬" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="═════" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="▬▬▬" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Lamination" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- DGU + Lamination -->
                                <Button x:Name="BtnDguLam" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="DguLam" IsEnabled="{Binding IsLicensed}" Margin="0,8,0,0" MouseEnter="CalcBtn_MouseEnter" MouseLeave="CalcBtn_MouseLeave">
                                    <Border x:Name="BorderDguLam" CornerRadius="10" Padding="12" Background="#1E40AF" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleDguLam" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⬜" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="⬜" FontSize="12" Foreground="White" Margin="2,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="═════" FontSize="8" Foreground="White" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⬜" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="⬜" FontSize="12" Foreground="White" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="DGU + Lamination" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <!-- Optimization -->
                                <Button x:Name="BtnOpt" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Optimization" IsEnabled="{Binding IsLicensed}" Margin="0,8,0,0" MouseEnter="CalcBtn_MouseEnter" MouseLeave="CalcBtn_MouseLeave">
                                    <Border x:Name="BorderOpt" CornerRadius="10" Padding="12" Background="#1D4ED8" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ScaleOpt" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✂" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="Optimization" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MANAGEMENT SECTION -->
                    <Border CornerRadius="12" Margin="0,0,0,10" Effect="{StaticResource ButtonShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#6D28D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Border CornerRadius="12,12,0,0" Padding="14,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="12" Foreground="#DDD6FE" VerticalAlignment="Center"/>
                                    <TextBlock Text="MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#EDE9FE" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="10,10,10,14">
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SheetStore">
                                    <Border CornerRadius="10" Padding="14" Background="#8B5CF6" Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="10,8">
                                                <TextBlock Text="📦" FontSize="18"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Sheet Store" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                <TextBlock Text="Glass inventory" FontSize="10" Foreground="#DDD6FE"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AluminumStore" Margin="0,8,0,0">
                                    <Border CornerRadius="10" Padding="14" Background="#FBBF24" Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="10,8">
                                                <TextBlock Text="🔩" FontSize="18"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Aluminum Store" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                <TextBlock Text="Profiles and accessories" FontSize="10" Foreground="#FEF3C7"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SpacerStore" Margin="0,8,0,0">
                                    <Border CornerRadius="10" Padding="14" Background="#34D399" Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="10,8">
                                                <TextBlock Text="📏" FontSize="18"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Spacer Store" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                <TextBlock Text="Spacer bars" FontSize="10" Foreground="#D1FAE5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Support Card -->
                    <Border CornerRadius="12" Padding="16" Effect="{StaticResource ButtonShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F8FAFC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎫" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="SUPPORT" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Background="#D1FAE5">
                                    <TextBlock Text="● ONLINE" FontSize="8" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </Grid>
                            <Border CornerRadius="10" Padding="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F1F5F9" Offset="0"/>
                                        <GradientStop Color="#E2E8F0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📧" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="Jubersaleem01@gmail.com" FontSize="10" Foreground="#2563EB" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="🌐" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="www.proglass.com" FontSize="10" Foreground="#64748B" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="💬" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="WhatsApp Support" FontSize="10" Foreground="#64748B" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT -->
        <Border x:Name="MainContentArea" Grid.Row="1" Grid.Column="1" Margin="10" CornerRadius="14" Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="10" CornerRadius="14" Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- License Status -->
                <Border CornerRadius="12" Padding="16" Margin="6" Effect="{StaticResource ButtonShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F0F9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="LICENSE INACTIVE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="LICENSE ACTIVE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Calculators Status -->
                <Border Grid.Column="1" CornerRadius="12" Padding="16" Margin="6" Effect="{StaticResource ButtonShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F0F9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F59E0B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CALCULATORS LOCKED"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="CALCULATORS UNLOCKED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Activation Status -->
                <Border Grid.Column="2" CornerRadius="12" Padding="16" Margin="6" Effect="{StaticResource ButtonShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F0F9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ACTIVATION REQUIRED"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                            <Setter Property="Text" Value="ACTIVATION COMPLETE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>