<Window x:Class="ProGlassAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass ERP System"
        Height="780"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <!-- SHADOW -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.15"
                          Color="#000000"/>

        <!-- HOVER ANIMATION -->
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.05"
                                             Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.05"
                                             Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= HEADER (FIXED DOCKPANEL PADDING ISSUE) ================= -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="10"
                CornerRadius="16"
                Background="#0A6ED1"
                Effect="{StaticResource CardShadow}">

            <!-- ✅ FIX: Padding moved into Border (NOT DockPanel) -->
            <Border Padding="15"
                    Background="Transparent">

                <DockPanel LastChildFill="True">

                    <!-- TITLE -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="🏭"
                                   FontSize="26"
                                   Foreground="White"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="GLASS ERP SYSTEM"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>

                    <!-- ================= RIGHT INFO CARDS ================= -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <!-- DATE / TIME -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="10"
                                Margin="4"
                                Width="200"
                                Height="65">

                            <StackPanel>
                                <TextBlock Text="📅 DATE / TIME"
                                           FontWeight="Bold"
                                           Foreground="#0A6ED1"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding CurrentDateText}"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding ClockText}"
                                           FontSize="11"/>
                            </StackPanel>

                        </Border>

                        <!-- DEVELOPER -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="10"
                                Margin="4"
                                Width="130"
                                Height="65">

                            <StackPanel>
                                <TextBlock Text="👤 DEV"
                                           FontWeight="Bold"
                                           Foreground="#0A6ED1"
                                           FontSize="11"/>
                                <TextBlock Text="Juber Malik"
                                           FontSize="11"/>
                            </StackPanel>

                        </Border>

                        <!-- COUNTRY -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="10"
                                Margin="4"
                                Width="110"
                                Height="65">

                            <StackPanel>
                                <TextBlock Text="🌍 COUNTRY"
                                           FontWeight="Bold"
                                           Foreground="#0A6ED1"
                                           FontSize="11"/>
                                <TextBlock Text="India"
                                           FontSize="11"/>
                            </StackPanel>

                        </Border>

                        <!-- CONTACT -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="10"
                                Margin="4"
                                Width="150"
                                Height="65">

                            <StackPanel>
                                <TextBlock Text="📞 CONTACT"
                                           FontWeight="Bold"
                                           Foreground="#0A6ED1"
                                           FontSize="11"/>
                                <TextBlock Text="+971-559117727"
                                           FontSize="11"/>
                            </StackPanel>

                        </Border>

                        <!-- EMAIL -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="10"
                                Margin="4"
                                Width="240"
                                Height="65">

                            <StackPanel>
                                <TextBlock Text="📧 EMAIL"
                                           FontWeight="Bold"
                                           Foreground="#0A6ED1"
                                           FontSize="11"/>
                                <TextBlock Text="jubersaleem01@gmail.com"
                                           FontSize="10"/>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </DockPanel>

            </Border>

        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="White"
                Margin="10"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}">

            <StackPanel>

                <Border Background="#0A6ED1"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="SGU_Click"
                        Style="{StaticResource HoverCardStyle}">

                    <TextBlock Text="📊 SGU"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Background="#0854A0"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="DGU_Click"
                        Style="{StaticResource HoverCardStyle}">

                    <TextBlock Text="🧮 DGU"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Background="#0A6ED1"
                        Margin="6"
                        CornerRadius="10"
                        MouseDown="LAM_Click"
                        Style="{StaticResource HoverCardStyle}">

                    <TextBlock Text="🧪 LAMINATION"
                               Foreground="White"
                               Padding="12"
                               HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>

        </Border>

        <!-- ================= MAIN PANEL ================= -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}">

            <ContentControl x:Name="MainPanel"/>

        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Grid Grid.Row="2"
              Grid.ColumnSpan="2"
              Margin="10">

            <Border Background="#0A6ED1"
                    CornerRadius="14"
                    Padding="12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="White"
                            CornerRadius="10"
                            Margin="4"
                            Padding="8">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🟢"/>
                            <TextBlock Text="SYSTEM ACTIVE"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="10"
                            Margin="4"
                            Padding="8">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚙"/>
                            <TextBlock Text="ERP RUNNING"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="10"
                            Margin="4"
                            Padding="8">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🛡"/>
                            <TextBlock Text="STABLE MODE"
                                       Foreground="#0A6ED1"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>