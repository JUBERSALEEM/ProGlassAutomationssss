<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Targeting Windows 7.0 compatibility to align restored package targets and avoid NU1701 warnings -->
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<ApplicationIcon>assets\icons\app.ico</ApplicationIcon>
		<AssemblyName>ProGlassAutomation</AssemblyName>
		<RootNamespace>ProGlassAutomation</RootNamespace>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Company>ProGlass ERP</Company>
		<Product>ProGlass Automation ERP</Product>
		<Description>ProGlass ERP Automation System with License Validation</Description>
		<Copyright>Copyright © 2025 ProGlass ERP</Copyright>
		
		<!-- PUBLISH SETTINGS FOR STANDALONE EXE -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishReadyToRun>true</PublishReadyToRun>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="EPPlus" Version="8.6.0" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
		<PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>