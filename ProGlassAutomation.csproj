<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>assets\icons\app.ico</ApplicationIcon>
		<AssemblyName>ProGlassAutomation</AssemblyName>
		<RootNamespace>ProGlassAutomation</RootNamespace>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Company>ProGlass ERP</Company>
		<Product>ProGlass Automation ERP</Product>
		<Description>ProGlass ERP Automation System with License Validation</Description>
		<Copyright>Copyright © 2025 ProGlass ERP</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="ProGlassAutomation\**" />
		<EmbeddedResource Remove="ProGlassAutomation\**" />
		<None Remove="ProGlassAutomation\**" />
		<Page Remove="ProGlassAutomation\**" />
	</ItemGroup>
</Project>