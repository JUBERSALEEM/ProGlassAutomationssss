<Window x:Class="ProGlassAutomation.Views.Optimization.PartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parts of Glass"
        Height="800" Width="1150"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="AccentNavy" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="DangerBg" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="DangerHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="SuccessBg" Color="#065F46"/>
        <SolidColorBrush x:Key="SuccessHover" Color="#047857"/>

        <!-- Pill-Style Excel Cell (Light Theme) -->
        <Style x:Key="ExcelCell" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="SelectionBrush" Value="#2563EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Delete Button: Dark Red Professional Theme -->
        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card: Light Theme -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <!-- Main container: LIGHT Theme + Inner glassmorphism card -->
    <Border CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER (Light Theme) -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" Background="#FEF3C7" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="▦" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Parts of Glass" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Download Template" Background="#F1F5F9" Foreground="#475569" Padding="15,8" Margin="0,0,8,0" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Import CSV / Excel" Background="#DBEAFE" Foreground="#2563EB" Padding="15,8" Margin="0,0,8,0" BorderBrush="#3B82F6" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="+ Add Part" Click="AddPart_Click" Background="#2563EB" Foreground="White" Padding="20,10" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Click="Close_Click" Margin="15,0,0,0" Background="Transparent" Foreground="#64748B" FontSize="18" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 2. COLUMN HEADERS (Light) -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="10,0,10,12">
                <TextBlock Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Text="REF ID" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Text="PART DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                <TextBlock Text="WIDTH (MM)" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Text="HEIGHT (MM)" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Text="QTY (PCS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                <TextBlock Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
            </UniformGrid>

            <!-- 3. SPREADSHEET ROWS (Light Cards) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icParts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" Margin="0,0,0,8" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                <UniformGrid Columns="7">
                                    <Border Width="22" Height="22" Background="{Binding UI_Color, FallbackValue=#CBD5E1}" CornerRadius="6" HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding Id}" Style="{StaticResource ExcelCell}" Margin="5,0" IsReadOnly="True" Opacity="0.5"/>
                                    <TextBox x:Name="tbLabel" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExcelCell}" Margin="5,0" HorizontalContentAlignment="Left" GotFocus="Cell_GotFocus" PreviewKeyDown="Cell_KeyDown" Tag="{Binding}"/>
                                    <TextBox x:Name="tbL" Text="{Binding L, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExcelCell}" Margin="5,0" GotFocus="Cell_GotFocus" PreviewKeyDown="Cell_KeyDown" Tag="{Binding}"/>
                                    <TextBox x:Name="tbW" Text="{Binding W, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExcelCell}" Margin="5,0" GotFocus="Cell_GotFocus" PreviewKeyDown="Cell_KeyDown" Tag="{Binding}"/>
                                    <TextBox x:Name="tbQty" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ExcelCell}" Margin="5,0" GotFocus="Cell_GotFocus" PreviewKeyDown="Cell_KeyDown" Tag="{Binding}"/>
                                    <!-- ✅ DARK RED Delete Button (light theme overall) -->
                                    <Button Content="Delete" Click="Delete_Click" Style="{StaticResource DeleteButton}" Tag="{Binding}"/>
                                </UniformGrid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. SUMMARY DASHBOARD (Light Cards) -->
            <UniformGrid Grid.Row="3" Columns="4" Margin="0,20,0,0">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="PART TYPES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtPartTypes" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL GLASS PIECES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTotalPieces" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="DEMAND NET AREA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTotalArea" Text="0.000 m²" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="UNIQUE DIMENSIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtUniqueDims" Text="0 sizes" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 5. FOOTER -->
            <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="10" Padding="12" Margin="0,15,0,0">
                <DockPanel>
                    <TextBlock Text="Largest Single Glass Piece:" Foreground="#64748B" FontSize="11"/>
                    <TextBlock x:Name="txtLargest" Text="—" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0F172A" FontSize="11"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>