<Window x:Class="ProGlassAutomation.Views.Optimization.PartsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Parts"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Cutting Parts Management" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Add, edit, or remove glass parts to be cut from stock sheets"
                       FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Label:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="txtLabel" Text="Glass Panel" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Width (mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="txtWidth" Text="1000" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="4" Text="Height (mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="5" x:Name="txtHeight" Text="800" Margin="0,0,16,0"/>

                <Button Grid.Column="6" x:Name="btnAdd" Content="+ Add Part" Click="Add_Click"
                        Background="#10B981" Foreground="White" Padding="14,8" FontWeight="SemiBold" Cursor="Hand"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid x:Name="dgParts" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                    <DataGridTextColumn Header="Width (mm)" Binding="{Binding L}" Width="*"/>
                    <DataGridTextColumn Header="Height (mm)" Binding="{Binding W}" Width="*"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Qty}" Width="100"/>
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Click="Edit_Click" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Content="Delete" Click="Delete_Click" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="Close_Click" Background="White" Foreground="#0F172A" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>