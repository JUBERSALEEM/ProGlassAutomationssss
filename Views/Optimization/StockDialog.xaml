<Window x:Class="ProGlassAutomation.Views.Optimization.StockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Stock Sheets"
        Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Stock Sheets Management" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Add, edit, or remove available raw glass stock sheets"
                       FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Add/Edit Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width (mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtWidth" Text="3210" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Height (mm):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtHeight" Text="2250" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Quantity:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="5" x:Name="txtQty" Text="9999" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="0" Grid.Column="6" Text="Price/m²:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="7" x:Name="txtPrice" Text="1559.86" Margin="0,0,16,0"/>

                <Button Grid.Row="0" Grid.Column="8" x:Name="btnAdd" Content="+ Add Stock" Click="Add_Click"
                        Background="#10B981" Foreground="White" Padding="14,8" FontWeight="SemiBold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid x:Name="dgStock" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                    <DataGridTextColumn Header="Width (mm)" Binding="{Binding L}" Width="*"/>
                    <DataGridTextColumn Header="Height (mm)" Binding="{Binding W}" Width="*"/>
                    <DataGridTextColumn Header="Area (m²)" Binding="{Binding Area, StringFormat=F3}" Width="120"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Qty}" Width="100"/>
                    <DataGridTextColumn Header="Price/m² (USD)" Binding="{Binding PricePerM2, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Unit Price (USD)" Binding="{Binding UnitPrice, StringFormat=N2}" Width="140"/>
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Click="Edit_Click" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Content="Delete" Click="Delete_Click" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="Close_Click" Background="White" Foreground="#0F172A" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>