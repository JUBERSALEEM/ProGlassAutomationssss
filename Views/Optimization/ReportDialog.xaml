<Window x:Class="ProGlassAutomation.Views.Optimization.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimization Report"
        MinHeight="700" MinWidth="1100"
        Height="780" Width="1300"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FB"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#059669"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#047857"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F43F5E" Offset="0"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E1B4B" Offset="0"/>
            <GradientStop Color="#312E81" Offset="0.5"/>
            <GradientStop Color="#4C1D95" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- KPI card style with left accent strip -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.05" BlurRadius="14" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Button -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ DataGrid — fixed selection highlight, proportional widths -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- ✅ FIX: Full cell background highlight on selection -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#4F46E5"/>
                    <Setter Property="BorderBrush" Value="#C7D2FE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HERO HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradient}" Padding="28,22">
            <StackPanel VerticalAlignment="Center">
                <Border Background="#312E81" CornerRadius="5" Padding="10,4"
                        HorizontalAlignment="Left" Margin="0,0,0,8">
                    <TextBlock Text="OPTIMIZATION REPORT" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <TextBlock Text="Performance Report" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtReportSubtitle" Text="Detailed breakdown of optimization result"
                           FontSize="12" Foreground="#C7D2FE" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- KPI CARDS (4 cards) -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="20,16,20,12">
            <Border Style="{StaticResource KpiCard}">
                <Grid>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource AccentGradient}"/>
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="GROSS YIELD" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="txtGrossYield" Text="0%" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Material efficiency" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <Grid>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource DangerGradient}"/>
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="SCRAP" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="txtScrap" Text="0%" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Unused material" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <Grid>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource WarningBrush}"/>
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="SHEETS USED" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="txtSheetsUsed" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="After optimization" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <Grid>
                    <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource PrimaryGradient}"/>
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="RUNTIME" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="txtRuntime" Text="0 ms" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Engine execution" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- REPORT CONTENT -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="20,0,20,12" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Per-Sheet DataGrid -->
                    <TextBlock Text="PER-SHEET BREAKDOWN" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgLayouts" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet #"        Binding="{Binding SheetNum}"                  Width="0.8*"/>
                            <DataGridTextColumn Header="Dimensions"     Binding="{Binding Dimensions}"                Width="2.5*"/>
                            <DataGridTextColumn Header="Pieces"         Binding="{Binding GlassCount}"                Width="1.0*"/>
                            <DataGridTextColumn Header="Rotated 90°"   Binding="{Binding Rotated90}"                 Width="1.2*"/>
                            <DataGridTextColumn Header="Yield %"       Binding="{Binding YieldText}"                 Width="1.2*"/>
                            <DataGridTextColumn Header="Used (m²)"     Binding="{Binding UsedNet, StringFormat=F3}"  Width="1.3*"/>
                            <DataGridTextColumn Header="Scrap (m²)"    Binding="{Binding ScrapWaste, StringFormat=F3}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Text Report Header -->
                    <TextBlock Text="FULL TEXT REPORT" Style="{StaticResource Label}" Margin="0,20,0,10"/>

                    <!-- Console-style report -->
                    <Border Background="#0F172A" CornerRadius="10" Padding="20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <TextBlock x:Name="txtFullReport" Foreground="#94A3B8"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                       Text="No report available"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <Button Content="Copy Report" Click="Copy_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button Content="Save as CSV" Click="Save_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource DarkButton}"/>
        </StackPanel>
    </Grid>
</Window>