<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="#0F172A">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="6"
                Padding="12">
            <TextBlock Text="Optimization Module"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- KPI Section -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Utilization"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"/>
                    <TextBlock x:Name="txtUtilization"
                               Text="0%"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Waste"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"/>
                    <TextBlock x:Name="txtWaste"
                               Text="0%"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Cost"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"/>
                    <TextBlock x:Name="txtCost"
                               Text="0.00"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,12,0">

                <StackPanel>

                    <TextBlock Text="Kerf (mm)"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtKerf" Text="4"/>

                    <TextBlock Text="Trim (mm)"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="txtTrim" Text="15"/>

                    <Button Content="Run Optimization"
                            Background="{StaticResource PrimaryBrush}"
                            Click="RunOptimization_Click"/>

                </StackPanel>

            </Border>

            <!-- Right Panel -->
            <Border Grid.Column="1"
                    Background="#0B1220"
                    CornerRadius="6"
                    Padding="12">

                <Grid>
                    <TextBlock Text="Layout Preview"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold"/>
                    <Canvas x:Name="LayoutCanvas"
                            Margin="0,28,0,0"
                            Background="#0F172A"/>
                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>