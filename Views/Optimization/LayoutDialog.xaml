<Window x:Class="ProGlassAutomation.Views.Optimization.LayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2D Layout Viewer"
        Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtLayoutHeader" Text="Sheet Layout" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="txtLayoutSubtitle" Text="No layout to display" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="← Previous" Click="Prev_Click" Background="White" Foreground="#0F172A" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Next →" Click="Next_Click" Background="#2563EB" Foreground="White" Padding="14,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Row -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="0,0,0,12">
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,4,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GLASS PIECES" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtPieces" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="4,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ROTATED 90°" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtRotated" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="4,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SHEET YIELD" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtYield" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="4,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SCRAP" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtScrap" Text="0 m²" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Canvas -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
            <Canvas x:Name="LayoutCanvas" Background="#FAFAFA" SizeChanged="LayoutCanvas_SizeChanged" ClipToBounds="True"/>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="txtSheetIndicator" Text="Sheet 0 / 0" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Close" Click="Close_Click" Background="White" Foreground="#0F172A" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>