<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             mc:Ignorable="d"
             Background="#F0F4F8">

    <UserControl.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- OCEAN BLUE COLOR PALETTE -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryBlueDark" Color="#0369A1"/>
        <SolidColorBrush x:Key="PrimaryBlueDarker" Color="#075985"/>
        <SolidColorBrush x:Key="LightBlue" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="LightBlueBorder" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="OceanAccent" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="SkyBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="MidBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AmberAccent" Color="#F59E0B"/>
        <SolidColorBrush x:Key="GreenAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="RedAccent" Color="#EF4444"/>
        <SolidColorBrush x:Key="GrayText" Color="#475569"/>
        <SolidColorBrush x:Key="GrayLight" Color="#94A3B8"/>

        <!-- SIMPLE DATA GRID -->
        <Style x:Key="SimpleDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
        </Style>

        <!-- SIMPLE CELL -->
        <Style x:Key="SimpleCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SIMPLE ROW -->
        <Style x:Key="SimpleRow" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SIMPLE HEADER -->
        <Style x:Key="SimpleHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <!-- PRIMARY BUTTON (Ocean Blue) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON (Deep Blue) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TERTIARY BUTTON (Slate) -->
        <Style x:Key="TertiaryButton" TargetType="Button">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTION BUTTONS -->
        <Style x:Key="ViewButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConvertButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN TEXTBOX -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1E2937"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <!-- MODERN COMBOBOX -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E2937"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0284C7" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="10" Padding="12,10" Margin="0,0,14,0">
                        <TextBlock Text="📄" FontSize="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PROFORMA INVOICE" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Manage quotations, confirmations and Job Order conversions" FontSize="12" Foreground="#BAE6FD" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Create PI" Style="{StaticResource PrimaryButton}" Command="{Binding CreateNewPICommand}" Margin="0,0,10,0"/>
                    <Button Content="📊 Export" Style="{StaticResource SecondaryButton}" Command="{Binding ExportReportCommand}" Margin="0,0,10,0"/>
                    <Button Content="🔄 Refresh" Style="{StaticResource TertiaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SEARCH" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedStatus}" BorderThickness="0" Background="Transparent">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Draft"/>
                            <ComboBoxItem Content="Sent"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Confirmed"/>
                            <ComboBoxItem Content="Hold"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Salesman -->
                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SALESMAN" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding SalesmanList}" SelectedItem="{Binding SelectedSalesman}" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Customer -->
                <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding CustomerFilter, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Date From -->
                <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DATE FROM" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Background="Transparent" BorderThickness="0" MinHeight="36"/>
                    </StackPanel>
                </Border>

                <!-- Date To -->
                <Border Grid.Column="5" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DATE TO" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="4,0,0,6"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Background="Transparent" BorderThickness="0" MinHeight="36"/>
                    </StackPanel>
                </Border>

                <!-- Clear Button -->
                <Button Grid.Column="6" Content="Clear" 
                        Command="{Binding ClearFiltersCommand}" 
                        Padding="18,12"
                        MinWidth="90"
                        Background="#475569" 
                        Foreground="White" 
                        FontWeight="SemiBold" 
                        FontSize="12"
                        Cursor="Hand" 
                        VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#334155"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL PI - Blue Gray -->
            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Total PI" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalPICount}" FontSize="30" FontWeight="Bold" Foreground="#1E2937"/>
                    <TextBlock Text="Overall quotations" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONFIRMED - Ocean Blue -->
            <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Confirmed" FontSize="12" Foreground="#0284C7" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConfirmedCount}" FontSize="30" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text="Customer approved" FontSize="11" Foreground="#7DD3FC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONVERTED - Green -->
            <Border Grid.Column="2" Background="#D1FAE5" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Converted" FontSize="12" Foreground="#10B981" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConvertedCount}" FontSize="30" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="Converted to JO" FontSize="11" Foreground="#6EE7B7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- PENDING - Amber -->
            <Border Grid.Column="3" Background="#FEF3C7" CornerRadius="12" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pending" FontSize="12" Foreground="#D97706" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PendingCount}" FontSize="30" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="Waiting confirmation" FontSize="11" Foreground="#FCD34D" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DATA GRID -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding FilteredProformaInvoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      Style="{StaticResource SimpleDataGrid}" 
                      CellStyle="{StaticResource SimpleCell}"
                      RowStyle="{StaticResource SimpleRow}"
                      BorderThickness="0">

                <DataGrid.Columns>
                    <!-- PI No -->
                    <DataGridTemplateColumn Header="PI NO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceNo}" Foreground="#0284C7" FontWeight="Bold" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Date -->
                    <DataGridTemplateColumn Header="DATE" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yy}'}" Foreground="#475569" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Customer -->
                    <DataGridTemplateColumn Header="CUSTOMER" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CustomerName}" Foreground="#1E2937" FontWeight="SemiBold" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Project -->
                    <DataGridTemplateColumn Header="PROJECT" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProjectName}" Foreground="#475569" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Salesman -->
                    <DataGridTemplateColumn Header="SALESMAN" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Salesman}" Foreground="#64748B" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Amount -->
                    <DataGridTemplateColumn Header="AMOUNT (AED)" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0}'}" Foreground="#059669" FontWeight="Bold" FontSize="12" TextAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="StatusComboBox"
                                         SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedValuePath="Content"
                                         Padding="6,4"
                                         FontSize="11"
                                         MinHeight="28"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         SelectionChanged="StatusComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Draft"/>
                                    <ComboBoxItem Content="Sent"/>
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="Confirmed"/>
                                    <ComboBoxItem Content="Hold"/>
                                    <ComboBoxItem Content="Revised"/>
                                    <ComboBoxItem Content="Cancelled"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- JO Ref -->
                    <DataGridTemplateColumn Header="JO REF" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding JobOrderRef}" Foreground="#64748B" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="View" Style="{StaticResource ViewButton}" Command="{Binding DataContext.ViewPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,5,0"/>
                                    <Button Content="Edit" Style="{StaticResource EditButton}" Command="{Binding DataContext.EditPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,5,0"/>
                                    <Button Content="Delete" Style="{StaticResource DeleteButton}" Command="{Binding DataContext.DeletePICommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,5,0"/>
                                    <Button Content="Convert" Style="{StaticResource ConvertButton}" Command="{Binding DataContext.ConvertToJOCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>