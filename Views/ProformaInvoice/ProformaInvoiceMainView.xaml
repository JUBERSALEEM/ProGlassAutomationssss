<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             mc:Ignorable="d"
             Background="#F1F5F9">

    <UserControl.Resources>

        <!-- VALUE CONVERTERS -->
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- HEADER BUTTON STYLE -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LIGHT BUTTON STYLE -->
        <Style x:Key="LightButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACTION BUTTONS -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STATUS MENU BUTTON -->
        <Style x:Key="StatusMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Proforma Invoice List"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>
                <TextBlock Text="Manage quotations, confirmations and Job Order conversions"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- HEADER BUTTONS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="📊 Export"
                        Background="#6366F1"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding ExportReportCommand}"/>
                <Button Content="➕ Create PI"
                        Background="#16A34A"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding CreateNewPICommand}"/>
            </StackPanel>
        </Grid>

        <!-- FILTER SECTION -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="Filter &amp; Search"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Search"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <TextBox Height="36"
                                 Padding="10,0"
                                 FontSize="12"
                                 Text="{Binding SearchText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Search PI number, customer or project"/>
                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Status"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <ComboBox Height="36"
                                  Padding="10,0"
                                  FontSize="12"
                                  SelectedItem="{Binding SelectedStatus}">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Draft"/>
                            <ComboBoxItem Content="Sent"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Confirmed"/>
                            <ComboBoxItem Content="Hold"/>
                            <ComboBoxItem Content="Revised"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- SALESMAN -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Salesman"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <ComboBox Height="36"
                                  Padding="10,0"
                                  FontSize="12"
                                  ItemsSource="{Binding SalesmanList}"
                                  SelectedItem="{Binding SelectedSalesman}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <!-- CUSTOMER -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Customer"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <TextBox Height="36"
                                 Padding="10,0"
                                 FontSize="12"
                                 Text="{Binding CustomerFilter, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <!-- DATE FROM -->
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="Date From"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <DatePicker Height="36"
                                    FontSize="12"
                                    SelectedDate="{Binding FromDate}"/>
                    </StackPanel>

                    <!-- DATE TO -->
                    <StackPanel Grid.Column="5" Margin="0,0,10,0">
                        <TextBlock Text="Date To"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <DatePicker Height="36"
                                    FontSize="12"
                                    SelectedDate="{Binding ToDate}"/>
                    </StackPanel>

                    <!-- CLEAR BUTTON -->
                    <Button Grid.Column="6"
                            Content="Clear"
                            Style="{StaticResource LightButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL PI -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total PI"
                               FontSize="11"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalPICount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Overall quotations"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONFIRMED -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Confirmed"
                               FontSize="11"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding ConfirmedCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Customer approved"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONVERTED -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Converted"
                               FontSize="11"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding ConvertedCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0891B2"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Converted to JO"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- PENDING -->
            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Pending"
                               FontSize="11"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding PendingCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#D97706"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Waiting confirmation"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DATAGRID - MATCHING JOBORDERLISTVIEW STYLE -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="0,0,0,0">

            <DataGrid ItemsSource="{Binding FilteredProformaInvoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      BorderThickness="0"
                      Background="Transparent"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">

                <DataGrid.Resources>
                    <!-- Column Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>

                    <!-- Cell Style -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Row Style -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- PI No -->
                    <DataGridTextColumn Header="PI NO" Binding="{Binding InvoiceNo}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yy}'}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#334155"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Customer -->
                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Project -->
                    <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#334155"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Salesman -->
                    <DataGridTextColumn Header="SALESMAN" Binding="{Binding Salesman}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Amount -->
                    <DataGridTextColumn Header="AMOUNT (AED)" Binding="{Binding GrandTotal, StringFormat='{}{0:N0}'}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#059669"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- STATUS with Dropdown -->
                    <DataGridTemplateColumn Header="STATUS" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Border x:Name="StatusBadge"
                                            Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Cursor="Hand"
                                            Margin="2,0"
                                            PreviewMouseLeftButtonDown="StatusBadge_PreviewMouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <Path Fill="White"
                                                  Data="M 0 0 L 4 3 L 8 0 Z"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.7"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status Dropdown Popup -->
                                    <Popup x:Name="StatusPopup"
                                           AllowsTransparency="True"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=StatusBadge}"
                                           StaysOpen="False"
                                           PopupAnimation="Fade"
                                           Focusable="False">
                                        <Border Background="White"
                                                CornerRadius="8"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.12"
                                                                  Direction="270"/>
                                            </Border.Effect>
                                            <StackPanel Margin="4" MinWidth="130">
                                                <Button Content="Draft"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Draft"/>
                                                <Button Content="Sent"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Sent"/>
                                                <Button Content="Pending"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Pending"/>
                                                <Button Content="Confirmed"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Confirmed"/>
                                                <Button Content="Hold"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Hold"/>
                                                <Button Content="Revised"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Revised"/>
                                                <Separator Margin="4,2"/>
                                                <Button Content="Converted To JO"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Converted To JO"/>
                                                <Button Content="Cancelled"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Cancelled"/>
                                                <Button Content="Voided"
                                                        Style="{StaticResource StatusMenuButtonStyle}"
                                                        Click="StatusOption_Click"
                                                        Tag="Voided"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- JO Ref -->
                    <DataGridTextColumn Header="JO REF" Binding="{Binding JobOrderRef}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="View"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#DBEAFE"
                                            Foreground="#1D4ED8"
                                            Command="{Binding DataContext.ViewPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="View PI"/>
                                    <Button Content="Edit"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#FEF3C7"
                                            Foreground="#92400E"
                                            Command="{Binding DataContext.EditPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Edit PI"/>
                                    <Button Content="Delete"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#FEE2E2"
                                            Foreground="#DC2626"
                                            Command="{Binding DataContext.DeletePICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete PI"/>
                                    <Button Content="Convert"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Background="#DCFCE7"
                                            Foreground="#166534"
                                            Command="{Binding DataContext.ConvertToJOCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Convert to JO"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>