<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ==================== BUTTON STYLES ==================== -->
        <Style x:Key="BtnSuccess" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnView" TargetType="Button" BasedOn="{StaticResource BtnAction}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>

        <Style x:Key="BtnConvert" TargetType="Button" BasedOn="{StaticResource BtnAction}">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="Foreground" Value="#15803D"/>
        </Style>

        <Style x:Key="BtnEdit" TargetType="Button" BasedOn="{StaticResource BtnAction}">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="Foreground" Value="#B45309"/>
        </Style>

        <Style x:Key="BtnDelete" TargetType="Button" BasedOn="{StaticResource BtnAction}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- ==================== CARD STYLE ==================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.06" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== FILTER INPUT ==================== -->
        <Style x:Key="FilterInput" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0,0,14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DBE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DBE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="14,0,30,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="14,0,30,0"
                                             VerticalAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Visibility="Hidden"
                                             FontSize="{TemplateBinding FontSize}"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <Path x:Name="Arrow"
                                      Fill="#64748B"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            CornerRadius="12"
                                            BorderBrush="#DBE2EA"
                                            BorderThickness="1"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterDate" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DBE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="PART_Content"
                                                      Grid.Column="0"
                                                      Margin="14,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="4,0,8,0">
                                        <Path Fill="#64748B" 
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Slide">
                                <StackPanel>
                                    <Border Background="White" 
                                            CornerRadius="12"
                                            BorderBrush="#DBE2EA"
                                            BorderThickness="1"
                                            Margin="0,4,0,0">
                                        <Calendar x:Name="PART_Calendar"/>
                                    </Border>
                                </StackPanel>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TOOLTIP BUTTON ==================== -->
        <Style x:Key="TooltipBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="9"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <TextBlock Text="i" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STATUS COMBOBOX ==================== -->
        <Style x:Key="StatusCombo" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ==================== STATUS BADGE STYLES ==================== -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="StatusDraft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="StatusDraftText" Color="#374151"/>
        <SolidColorBrush x:Key="StatusSent" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="StatusSentText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="StatusPending" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="StatusPendingText" Color="#B45309"/>
        <SolidColorBrush x:Key="StatusConfirmed" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="StatusConfirmedText" Color="#15803D"/>
        <SolidColorBrush x:Key="StatusHold" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="StatusHoldText" Color="#B45309"/>
        <SolidColorBrush x:Key="StatusRevised" Color="#EDE9FE"/>
        <SolidColorBrush x:Key="StatusRevisedText" Color="#6D28D9"/>
        <SolidColorBrush x:Key="StatusInProgress" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="StatusInProgressText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="StatusConverted" Color="#CFFAFE"/>
        <SolidColorBrush x:Key="StatusConvertedText" Color="#0F766E"/>
        <SolidColorBrush x:Key="StatusPartialDelivered" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="StatusPartialDeliveredText" Color="#B45309"/>
        <SolidColorBrush x:Key="StatusDelivered" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="StatusDeliveredText" Color="#15803D"/>
        <SolidColorBrush x:Key="StatusInvoiced" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="StatusInvoicedText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="StatusCompleted" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="StatusCompletedText" Color="#15803D"/>
        <SolidColorBrush x:Key="StatusCancelled" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="StatusCancelledText" Color="#B91C1C"/>
        <SolidColorBrush x:Key="StatusVoided" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="StatusVoidedText" Color="#64748B"/>

    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== PAGE HEADER ==================== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Proforma Invoice List"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Manage quotations, confirmations, revisions, conversions and project workflow."
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="+ Create PI"
                        Style="{StaticResource BtnSuccess}"
                        Command="{Binding CreateNewPICommand}"/>
                <Button Content="Export Report"
                        Style="{StaticResource BtnPrimary}"
                        Margin="12,0,0,0"
                        Command="{Binding ExportReportCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- ==================== FILTER SECTION ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Filter &amp; Search"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Search" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Search using PI number, project name, customer or reference number."/>
                        </Grid>
                        <TextBox Style="{StaticResource FilterInput}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Status" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Filter invoices by workflow stage and project progress."/>
                        </Grid>
                        <ComboBox Style="{StaticResource FilterCombo}"
                                  SelectedItem="{Binding SelectedStatus}">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Draft"/>
                            <ComboBoxItem Content="Sent"/>
                            <ComboBoxItem Content="Confirmed"/>
                            <ComboBoxItem Content="Hold"/>
                            <ComboBoxItem Content="Revised"/>
                            <ComboBoxItem Content="Converted To JO"/>
                            <ComboBoxItem Content="Partial Delivered"/>
                            <ComboBoxItem Content="Delivered"/>
                            <ComboBoxItem Content="Invoiced"/>
                            <ComboBoxItem Content="Cancelled"/>
                            <ComboBoxItem Content="Voided"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Customer -->
                    <StackPanel Grid.Column="2" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Customer" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Filter PI records by customer or company name."/>
                        </Grid>
                        <TextBox Style="{StaticResource FilterInput}"
                                 Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Salesman -->
                    <StackPanel Grid.Column="3" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Salesman" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Filter records created by specific sales staff."/>
                        </Grid>
                        <ComboBox Style="{StaticResource FilterCombo}"
                                  ItemsSource="{Binding SalesmanList}"
                                  SelectedItem="{Binding SelectedSalesman}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <!-- Date From -->
                    <StackPanel Grid.Column="4" Margin="0,0,18,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date From" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Filter records starting from selected date and time."/>
                        </Grid>
                        <DatePicker Style="{StaticResource FilterDate}"
                                    SelectedDate="{Binding FromDate}"/>
                    </StackPanel>

                    <!-- Date To -->
                    <StackPanel Grid.Column="5">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date To" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#475569"/>
                            <Button Content="i" 
                                    Style="{StaticResource TooltipBtn}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Filter records until selected date and time."/>
                        </Grid>
                        <DatePicker Style="{StaticResource FilterDate}"
                                    SelectedDate="{Binding ToDate}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== SUMMARY CARDS ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total PI -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Total PI" 
                               FontSize="14" 
                               Foreground="#64748B"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalPICount}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#1E293B"/>
                    <TextBlock Text="Overall quotations and project entries" 
                               FontSize="12" 
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Confirmed -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Confirmed" 
                               FontSize="14" 
                               Foreground="#64748B"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ConfirmedCount}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#15803D"/>
                    <TextBlock Text="Customer approved quotations" 
                               FontSize="12" 
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Converted To JO -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Converted To JO" 
                               FontSize="14" 
                               Foreground="#64748B"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ConvertedCount}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#0F766E"/>
                    <TextBlock Text="Operational jobs created" 
                               FontSize="12" 
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending Conversion -->
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pending Conversion" 
                               FontSize="14" 
                               Foreground="#64748B"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding PendingCount}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#B45309"/>
                    <TextBlock Text="Confirmed but not converted" 
                               FontSize="12" 
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== TABLE ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Table Header -->
                <Border Background="White" 
                        CornerRadius="18,18,0,0"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Proforma Invoice Records"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"/>
                </Border>

                <!-- Loading Indicator -->
                <Border Background="#FFFFFF" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="1"
                        Margin="0,60,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                        <TextBlock Text="Loading..." 
                                   HorizontalAlignment="Center" 
                                   Margin="0,10,0,0"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasNoRecords, Converter={StaticResource BoolToVis}}"
                            Margin="0,60,0,0">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="No Proforma Invoices Found" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Create a new PI or adjust your filters" 
                               FontSize="14" 
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <Button Content="+ Create PI"
                            Style="{StaticResource BtnSuccess}"
                            Command="{Binding CreateNewPICommand}"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid ItemsSource="{Binding FilteredProformaInvoices}"
                          SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          Margin="0,60,0,0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="15"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#1E3A5F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <!-- PI No -->
                        <DataGridTextColumn Header="PI No" 
                                            Binding="{Binding InvoiceNo}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E3A5F"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Date & Time -->
                        <DataGridTextColumn Header="Date &amp; Time" 
                                            Binding="{Binding InvoiceDate, StringFormat={}{0:dd-MMM-yyyy hh:mm tt}}"
                                            Width="150"/>

                        <!-- Customer -->
                        <DataGridTextColumn Header="Customer" 
                                            Binding="{Binding CustomerName}"
                                            Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Project -->
                        <DataGridTextColumn Header="Project" 
                                            Binding="{Binding ProjectName}"
                                            Width="180"/>

                        <!-- Salesman -->
                        <DataGridTextColumn Header="Salesman" 
                                            Binding="{Binding Salesman}"
                                            Width="100"/>

                        <!-- Total Amount -->
                        <DataGridTextColumn Header="Total Amount" 
                                            Binding="{Binding GrandTotal, StringFormat='{}{0:N2}'}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBorder"
                        Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                        CornerRadius="20"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Opacity="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Draft" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Draft"/>
                                                <MenuItem Header="Sent" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Sent"/>
                                                <MenuItem Header="Pending" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Pending"/>
                                                <MenuItem Header="Hold" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Hold"/>
                                                <MenuItem Header="Confirmed" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Confirmed"/>
                                                <MenuItem Header="Revised" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Revised"/>
                                                <Separator/>
                                                <MenuItem Header="In Progress" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="In Progress"/>
                                                <MenuItem Header="Converted To JO" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Converted To JO"/>
                                                <MenuItem Header="Partial Delivered" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Partial Delivered"/>
                                                <MenuItem Header="Delivered" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Delivered"/>
                                                <MenuItem Header="Invoiced" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Invoiced"/>
                                                <MenuItem Header="Completed" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Completed"/>
                                                <Separator/>
                                                <MenuItem Header="Cancelled" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Cancelled"/>
                                                <MenuItem Header="Voided" 
                                                          Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="Voided"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <Path Fill="White"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- JO Ref -->
                        <DataGridTextColumn Header="JO Ref" 
                                            Binding="{Binding JobOrderRef}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="👁 View"
                                                Style="{StaticResource BtnView}"
                                                Command="{Binding DataContext.ViewPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="View PI Details"
                                                Padding="10,6"/>
                                        <Button Content="🔄 Convert"
                                                Style="{StaticResource BtnConvert}"
                                                Command="{Binding DataContext.ConvertToJOCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Convert to Job Order"
                                                Margin="6,0,0,0"
                                                Padding="10,6"/>
                                        <Button Content="✏️ Edit"
                                                Style="{StaticResource BtnEdit}"
                                                Command="{Binding DataContext.EditPICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Edit PI"
                                                Margin="6,0,0,0"
                                                Padding="10,6"/>
                                        <Button Content="🗑️"
                                                Style="{StaticResource BtnDelete}"
                                                Command="{Binding DataContext.DeletePICommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete PI"
                                                Margin="6,0,0,0"
                                                Padding="10,6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>