<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoicePrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Print Preview" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OrientationCombo" Width="100" Margin="20,0,0,0" SelectedIndex="0" SelectionChanged="OrientationCombo_SelectionChanged">
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Landscape"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="PRINT" Click="Print_Click" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Button Content="CLOSE" Click="Close_Click" Padding="12,6" Background="White" Foreground="#64748B" BorderBrush="#E2E8F0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#CBD5E1">
            <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">

                <!-- White Paper Page -->
                <Border x:Name="PreviewPage" Background="White" BorderBrush="#94A3B8" BorderThickness="1">

                    <!-- Print Area with Excel Margins -->
                    <Grid x:Name="PrintArea" Margin="67,29,67,29">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" BorderBrush="#1E40AF" BorderThickness="0,0,0,2" Padding="0,8,0,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROGLASS AUTOMATION" FontSize="16" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="TRN: 100458979400003" FontSize="8" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="Dubai, UAE | Tel: +971 50 123 4567" FontSize="8" Foreground="#64748B"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="PROFORMA INVOICE" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Date:" FontSize="8" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Invoice.InvoiceDate, StringFormat='dd MMM yyyy'}" FontSize="8" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                        <TextBlock Text="Valid:" FontSize="8" Foreground="#64748B" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Invoice.ValidUntil, StringFormat='dd MMM yyyy'}" FontSize="8" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Invoice Info -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INVOICE NO" FontSize="8" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Invoice.InvoiceNo}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Invoice.CustomerName}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Invoice.CustomerTRN}" FontSize="8" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Project Details -->
                        <Border Grid.Row="2" Background="#F8FAFC" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROJECT" FontSize="8" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="{Binding Invoice.ProjectName}" FontSize="8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LPO NO" FontSize="8" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="{Binding Invoice.LPONo}" FontSize="8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ATTENTION" FontSize="8" FontWeight="Bold" Foreground="#1E40AF"/>
                                    <TextBlock Text="{Binding Invoice.AttentionName}" FontSize="8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Specifications -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Invoice.Specifications}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1E40AF" BorderThickness="1" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Spec Header -->
                                            <Border Grid.Row="0" Background="#1E40AF" Padding="10,5">
                                                <TextBlock Text="{Binding SpecificationName}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Data Grid with proper borders -->
                                            <DataGrid Grid.Row="1"
                                                      ItemsSource="{Binding Items}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      BorderThickness="0"
                                                      Background="White"
                                                      GridLinesVisibility="All"
                                                      HorizontalGridLinesBrush="#334155"
                                                      VerticalGridLinesBrush="#334155"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      FontSize="9"
                                                      RowHeight="20"
                                                      BorderBrush="#334155">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="8"/>
                                                        <Setter Property="Padding" Value="2,4"/>
                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="Padding" Value="2"/>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="25">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="GLASS REF" Binding="{Binding GlassRef}" Width="200">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="W1" Binding="{Binding Width1, StringFormat=N0}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="H1" Binding="{Binding Height1, StringFormat=N0}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="W2" Binding="{Binding Width2, StringFormat=N0}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="H2" Binding="{Binding Height2, StringFormat=N0}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="40">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="SQM" Binding="{Binding SQM, StringFormat=N4}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="T.SQM" Binding="{Binding TotalSQM, StringFormat=N4}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="60">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, StringFormat=N2}" Width="65">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Spec Totals -->
                                            <Border Grid.Row="2" Background="#F1F5F9" Padding="8,4" BorderBrush="#334155" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="" FontSize="8"/>
                                                    <TextBlock Grid.Column="1" Text="" FontSize="8"/>
                                                    <TextBlock Grid.Column="2" Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="Qty:" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding SpecTotalQty}" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="SQM:" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding SpecTotalSQM, StringFormat=N4}" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="AED:" FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding SpecTotalPrice, StringFormat=N2}" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Grand Totals -->
                        <Grid Grid.Row="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TERMS AND CONDITIONS" FontSize="8" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="Prices in AED | Valid 30 days | 5% VAT included" FontSize="7" Foreground="#64748B"/>
                            </StackPanel>

                            <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="1" Padding="8,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SQM:" FontSize="8" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Invoice.TotalSQM, StringFormat=N4}" FontSize="9" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Qty:" FontSize="8" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Invoice.TotalQty}" FontSize="9" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sub Total:" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Invoice.GrandTotal, StringFormat=N2}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="VAT (5%):" FontSize="8" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Invoice.VatAmount, StringFormat=N2}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                                                <!-- Net Total -->
                        <Border Grid.Row="5" Background="#1E40AF" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NET TOTAL (AED):" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotal, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                        </Border>

                        <!-- Footer -->
                        <Border Grid.Row="6" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Thank you for your business!" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="7" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="Portrait | A4 | Margins: T/B 0.75in, L/R 0.7in" FontSize="10" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>