<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoicePrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>

        <!-- Professional Typography -->
        <Style x:Key="CompanyName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
        </Style>

        <Style x:Key="InvoiceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
        </Style>

        <Style x:Key="SectionValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="SpecHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Print Preview" FontSize="13" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OrientationCombo" Width="110" Margin="20,0,0,0" SelectedIndex="0" 
                              SelectionChanged="OrientationCombo_SelectionChanged" Padding="6,4">
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Landscape"/>
                    </ComboBox>
                    <TextBlock Text="A4 Paper" FontSize="9" Foreground="#6B7280" 
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="PRINT" Click="Print_Click" Padding="14,6" 
                            Background="#1E3A5F" Foreground="White" FontWeight="SemiBold" 
                            FontSize="11" Margin="0,0,6,0"/>
                    <Button Content="CLOSE" Click="Close_Click" Padding="14,6" 
                            Background="White" Foreground="#64748B" BorderBrush="#D1D5DB" 
                            FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Area - Full Scrollable -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto" 
                      PanningMode="Both"
                      Background="#94A3B8">
            <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16">
                <Border x:Name="PreviewPage" Background="White" BorderBrush="#64748B" BorderThickness="1">
                    <Grid x:Name="PrintArea" Margin="35,25,35,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header - Company Info -->
                        <Border Grid.Row="0" BorderBrush="#1E3A5F" BorderThickness="0,0,0,2" Padding="0,0,0,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CompanyName}" Style="{StaticResource CompanyName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="TRN: " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding CompanyTRN}" Style="{StaticResource MetaValue}"/>
                                        <TextBlock Text="  |  " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding CompanyLocation}" Style="{StaticResource MetaValue}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="PROFORMA INVOICE" Style="{StaticResource InvoiceTitle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="Date: " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding Invoice.InvoiceDate, StringFormat='dd MMM yyyy'}" 
                                                   Style="{StaticResource MetaValue}" FontWeight="SemiBold"/>
                                        <TextBlock Text="  |  " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="Valid: " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding Invoice.ValidUntil, StringFormat='dd MMM yyyy'}" 
                                                   Style="{StaticResource MetaValue}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Invoice & Customer Info -->
                        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" Background="#F8FAFC" 
                                Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="INVOICE NUMBER" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Invoice.InvoiceNo}" Style="{StaticResource SectionValue}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="BILL TO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Invoice.CustomerName}" Style="{StaticResource SectionValue}" 
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock Text="TRN: " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding Invoice.CustomerTRN}" Style="{StaticResource MetaLabel}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Invoice.CustomerAddress}" FontSize="7" Foreground="#6B7280" 
                                               FontFamily="{StaticResource PrimaryFont}" TextWrapping="Wrap" MaxWidth="200" 
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Project Details -->
                        <Border Grid.Row="2" Background="#EEF2F7" Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROJECT" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Invoice.ProjectName}" Style="{StaticResource SectionValue}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Location: " Style="{StaticResource MetaLabel}"/>
                                        <TextBlock Text="{Binding Invoice.ProjectLocation}" Style="{StaticResource MetaValue}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LPO NUMBER" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Invoice.LPONo}" Style="{StaticResource SectionValue}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ATTENTION" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Invoice.AttentionName}" Style="{StaticResource SectionValue}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="CONTACT" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding Invoice.ContactNo}" Style="{StaticResource SectionValue}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Specifications -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Invoice.Specifications}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,6" CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Spec Header -->
                                            <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="6,4" CornerRadius="3,3,0,0">
                                                <TextBlock Text="{Binding SpecificationName}" FontSize="9" FontWeight="Bold" Foreground="#1F2937" FontFamily="{StaticResource PrimaryFont}"/>
                                            </Border>

                                            <!-- Data Grid - WHITE BACKGROUND, BLACK TEXT -->
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" 
                                                      AutoGenerateColumns="False" 
                                                      IsReadOnly="True" 
                                                      BorderThickness="0" 
                                                      Background="White" 
                                                      GridLinesVisibility="All" 
                                                      HorizontalGridLinesBrush="#E5E7EB" 
                                                      VerticalGridLinesBrush="#E5E7EB" 
                                                      HeadersVisibility="Column" 
                                                      CanUserAddRows="False" 
                                                      FontSize="9" 
                                                      RowHeight="22"
                                                      FontFamily="{StaticResource PrimaryFont}">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#1E3A5F"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="7"/>
                                                        <Setter Property="Padding" Value="2,3"/>
                                                        <Setter Property="BorderBrush" Value="#374151"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="Padding" Value="1,0"/>
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="8"/>
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="White"/>
                                                    </Style>
                                                </DataGrid.RowStyle>

                                                <DataGrid.Columns>
                                                    <!-- SR - 30 -->
                                                    <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="30">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Glass Ref - Flexible (takes remaining width) -->
                                                    <DataGridTextColumn Header="Glass Ref" Binding="{Binding GlassRef}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- W1 - 45 -->
                                                    <DataGridTextColumn Header="W1" Binding="{Binding Width1, StringFormat=N0}" Width="45">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- H1 - 45 -->
                                                    <DataGridTextColumn Header="H1" Binding="{Binding Height1, StringFormat=N0}" Width="45">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- W2 - 45 -->
                                                    <DataGridTextColumn Header="W2" Binding="{Binding Width2, StringFormat=N0}" Width="45">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- H2 - 45 -->
                                                    <DataGridTextColumn Header="H2" Binding="{Binding Height2, StringFormat=N0}" Width="45">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Qty - 35 -->
                                                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=N0}" Width="35">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- SQM - 50 -->
                                                    <DataGridTextColumn Header="SQM" Binding="{Binding SQM, StringFormat=N2}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Total SQM - 50 -->
                                                    <DataGridTextColumn Header="Total SQM" Binding="{Binding TotalSQM, StringFormat=N2}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Price - 50 -->
                                                    <DataGridTextColumn Header="Price" Binding="{Binding DisplayPrice, StringFormat=N2}" Width="50">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="0,0,2,0"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Total - 60 -->
                                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=N2}" Width="60">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Padding" Value="0,0,2,0"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Spec Footer -->
                                            <Border Grid.Row="2" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="6,4" CornerRadius="0,0,3,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="SPEC TOTAL" FontSize="7" FontWeight="Bold" 
                                                               Foreground="#1F2937" VerticalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                                                        <TextBlock Text="Qty:" FontSize="6" Foreground="#6B7280" VerticalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>
                                                        <TextBlock Text="{Binding SpecTotalQty}" FontSize="7" FontWeight="SemiBold" 
                                                                   Foreground="#1F2937" VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                                                        <TextBlock Text="SQM:" FontSize="6" Foreground="#6B7280" VerticalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>
                                                        <TextBlock Text="{Binding SpecTotalSQM, StringFormat=N2}" FontSize="7" FontWeight="SemiBold" 
                                                                   Foreground="#1F2937" VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                                                        <TextBlock Text="LM:" FontSize="6" Foreground="#6B7280" VerticalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>
                                                        <TextBlock Text="{Binding SpecTotalLM, StringFormat=N2}" FontSize="7" FontWeight="SemiBold" 
                                                                   Foreground="#1F2937" VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <TextBlock Text="AED:" FontSize="6" Foreground="#6B7280" VerticalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>
                                                        <TextBlock Text="{Binding SpecTotalPrice, StringFormat=N2}" FontSize="8" FontWeight="Bold" 
                                                                   Foreground="#1F2937" VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Other Charges Section -->
                        <Border Grid.Row="4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FAFAFA" 
                                Padding="8,5" Margin="0,0,0,6" CornerRadius="3"
                                Visibility="{Binding HasOtherCharges, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="OTHER CHARGES" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>

                                <!-- Charges Header -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Charge" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F"/>
                                    <TextBlock Grid.Column="1" Text="Type" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Specs" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Value" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Rate" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="Amount" FontSize="6" FontWeight="Bold" Foreground="#1E3A5F" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Charges List -->
                                <ItemsControl ItemsSource="{Binding AllOtherCharges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" Padding="4,2" Margin="0,0,0,1" Background="White" CornerRadius="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="7" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="6" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding LinkedSpecsDisplay}" FontSize="6" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="3" Background="#DBEAFE" CornerRadius="2" Padding="2,1" Margin="2,0" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding ValueDisplay}" FontSize="6" FontWeight="SemiBold" Foreground="#1E3A5F" HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="4" Text="{Binding Rate, StringFormat=N2}" FontSize="7" Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <Border Grid.Column="5" Background="#1E3A5F" CornerRadius="2" Padding="4,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding AmountDisplay}" FontSize="7" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Charges Total -->
                                <Border Background="#1E3A5F" Padding="5,3" CornerRadius="2" Margin="0,2,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TOTAL OTHER CHARGES" FontSize="7" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalOtherCharges, StringFormat='AED {0:N2}'}" FontSize="8" FontWeight="Bold" Foreground="#60A5FA"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Invoice Summary -->
                        <Border Grid.Row="5" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8,5" CornerRadius="3" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <!-- Terms -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="TERMS AND CONDITIONS" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="- Prices in AED (UAE Dirhams)" FontSize="6" Foreground="#6B7280" Margin="0,2,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                    <TextBlock Text="- Quote valid for 30 days from invoice date" FontSize="6" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                    <TextBlock Text="- 5% VAT included in all prices" FontSize="6" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                </StackPanel>

                                <!-- Totals Box -->
                                <Border Grid.Column="1" BorderBrush="#1E3A5F" BorderThickness="1.5" Background="#F8FAFC" Padding="6,4" Margin="10,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total SQM:" FontSize="7" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalSQM, StringFormat=N2}" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total LM:" FontSize="7" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalLM, StringFormat=N2}" FontSize="7" FontWeight="SemiBold" Foreground="#4A6FA5" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total Qty:" FontSize="7" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalQty}" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                        </Grid>
                                        <Border BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="0,3,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sub Total:" FontSize="8" FontWeight="SemiBold" FontFamily="{StaticResource PrimaryFont}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Invoice.GrandTotal, StringFormat=N2}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Amount Summary -->
                        <Grid Grid.Row="6" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"/>
                            <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6,4" CornerRadius="3">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sub Total" FontSize="8" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                        <TextBlock Text="{Binding Invoice.GrandTotal, StringFormat='AED {0:N2}'}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Other Charges" FontSize="8" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                        <TextBlock Text="{Binding TotalOtherCharges, StringFormat='AED {0:N2}'}" FontSize="8" Foreground="#6B7280" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VAT (5%)" FontSize="8" Foreground="#6B7280" FontFamily="{StaticResource PrimaryFont}"/>
                                        <TextBlock Text="{Binding Invoice.VatAmount, StringFormat='AED {0:N2}'}" FontSize="8" Foreground="#6B7280" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Net Total -->
                        <Border Grid.Row="6" Background="#1E3A5F" Padding="8,6" CornerRadius="3" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NET TOTAL (AED):" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}"/>
                                    <TextBlock Text="{Binding Invoice.NetTotalInWords}" FontSize="7" Foreground="#9CA3AF" FontFamily="{StaticResource PrimaryFont}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotal, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}"/>
                            </Grid>
                        </Border>

                        <!-- Footer -->
                        <Border Grid.Row="6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Thank you for your business!" FontSize="7" Foreground="#6B7280" HorizontalAlignment="Center" FontFamily="{StaticResource PrimaryFont}"/>
                                <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="6" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Text="Portrait | A4 | Margins: T/B 0.75in, L/R 0.7in" FontSize="9" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>