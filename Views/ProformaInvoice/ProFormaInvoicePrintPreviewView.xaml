<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoicePrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Print Preview" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OrientationCombo" Width="110" Margin="20,0,0,0" SelectedIndex="0" 
                              SelectionChanged="OrientationCombo_SelectionChanged" Padding="6,4">
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Landscape"/>
                    </ComboBox>
                    <TextBlock Text="A4 Paper" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="PRINT" Click="Print_Click" Padding="14,6" Background="#1E40AF" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0"/>
                    <Button Content="CLOSE" Click="Close_Click" Padding="14,6" Background="White" Foreground="#64748B" BorderBrush="#CBD5E1" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Area -->
        <Grid Grid.Row="1" x:Name="PrintAreaContainer">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" Background="#94A3B8">
                <ItemsControl x:Name="PagesContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="PreviewPage" Background="White" BorderBrush="#64748B" BorderThickness="1" Margin="0,0,0,16" Width="794" Height="1123">
                                <Grid Margin="67,29,67,29">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Page Badge -->
                                    <Border Grid.Row="0" Background="#1E40AF" Padding="6,2" CornerRadius="2" HorizontalAlignment="Right" Margin="0,0,0,4">
                                        <TextBlock FontSize="7" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}">
                                            <Run Text="PAGE "/><Run Text="{Binding PageNumber}"/><Run Text=" OF "/><Run Text="{Binding TotalPages}"/>
                                        </TextBlock>
                                    </Border>

                                    <!-- FIRST PAGE HEADER -->
                                    <StackPanel Grid.Row="1" Visibility="{Binding IsFirstPage, Converter={StaticResource BoolToVis}}">
                                        <Border BorderBrush="#1E40AF" BorderThickness="0,0,0,2" Padding="0,0,0,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding CompanyName}" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="TRN: " FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding CompanyTRN}" FontSize="8" Foreground="#1E293B"/>
                                                        <TextBlock Text="  |  " FontSize="7" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding CompanyLocation}" FontSize="8" Foreground="#1E293B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="PROFORMA INVOICE" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="Date: " FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding InvoiceDate, StringFormat='dd MMM yyyy'}" FontSize="8" Foreground="#1E293B"/>
                                                        <TextBlock Text="  |  " FontSize="7" Foreground="#64748B"/>
                                                        <TextBlock Text="Valid: " FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding ValidUntil, StringFormat='dd MMM yyyy'}" FontSize="8" Foreground="#1E293B"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="6,4" Margin="0,0,0,6" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="INVOICE NUMBER" FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding InvoiceNo}" FontSize="10" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="RECEIVER" FontSize="7" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="10" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                                        <TextBlock Text="TRN: " FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding CustomerTRN}" FontSize="7" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- LPO/ATTN/CONTACT Section -->
                                        <Border Background="#E0E7FF" Padding="10,6" Margin="0,0,0,6" CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="PROJECT" FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Loc: " FontSize="8" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding ProjectLocation}" FontSize="8" Foreground="#1E293B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0"/>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="LPO NO." FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding LPONo}" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="3" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0"/>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="ATTENTION" FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding AttentionName}" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="5" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0"/>

                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="CONTACT" FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding ContactNo}" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- CONTINUATION PAGE HEADER -->
                                    <Border Grid.Row="1" Background="#F8FAFC" Padding="6,4" Margin="0,0,0,6" CornerRadius="2"
                                            BorderBrush="#CBD5E1" BorderThickness="1"
                                            Visibility="{Binding IsFirstPage, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="PROFORMA INVOICE" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                                <TextBlock Text=" - " FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding InvoiceNo}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Continued from Page " FontSize="8" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviousPageNo}" FontSize="8" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- BALANCE BROUGHT FORWARD -->
                                    <Border Grid.Row="2" BorderBrush="#000000" BorderThickness="1" Background="#F8FAFC" Padding="8,5" CornerRadius="2" Margin="0,0,0,6"
                                            Visibility="{Binding IsFirstPage, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Qty:" FontSize="8" Foreground="#1E293B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding PageTotalQty, StringFormat=N0}" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="SQM:" FontSize="8" Foreground="#1E293B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding PageTotalSQM, StringFormat=N4}" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="LM:" FontSize="8" Foreground="#1E293B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding PageTotalLM, StringFormat=N2}" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="AED:" FontSize="8" Foreground="#1E293B" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding PageTotalPrice, StringFormat=N2}" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- SPECIFICATIONS DATA -->
                                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Specifications}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,3" CornerRadius="2" Background="White">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Spec Header -->
                                                        <Border Grid.Row="0" Background="White" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="5,3" CornerRadius="2,2,0,0">
                                                            <TextBlock Text="{Binding SpecificationName}" FontSize="9" FontWeight="Bold" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                        </Border>

                                                        <!-- DataGrid - Exact Main View Columns -->
                                                        <DataGrid Grid.Row="1" 
                                                                  ItemsSource="{Binding Items}" 
                                                                  AutoGenerateColumns="False" 
                                                                  IsReadOnly="True" 
                                                                  BorderThickness="0" 
                                                                  Background="White" 
                                                                  GridLinesVisibility="All" 
                                                                  HorizontalGridLinesBrush="#000000" 
                                                                  VerticalGridLinesBrush="#000000" 
                                                                  HeadersVisibility="Column" 
                                                                  CanUserAddRows="False" 
                                                                  FontSize="9" 
                                                                  RowHeight="18"
                                                                  FontFamily="{StaticResource PrimaryFont}"
                                                                  EnableRowVirtualization="False"
                                                                  EnableColumnVirtualization="False"
                                                                  VirtualizingPanel.IsVirtualizing="False"
                                                                  VirtualizingPanel.VirtualizationMode="Standard"
                                                                  ScrollViewer.CanContentScroll="False">

                                                            <DataGrid.ColumnHeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}"/>
                                                            </DataGrid.ColumnHeaderStyle>
                                                            <DataGrid.CellStyle>
                                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}"/>
                                                            </DataGrid.CellStyle>

                                                            <DataGrid.Columns>
                                                                <!-- SR -->
                                                                <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="40">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- Glass Ref -->
                                                                <DataGridTextColumn Header="Glass Ref" Binding="{Binding GlassRef}" Width="120">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                            <Setter Property="Padding" Value="4,0"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- W1 -->
                                                                <DataGridTextColumn Header="W1" Binding="{Binding Width1, StringFormat=N0}" Width="50">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- H1 -->
                                                                <DataGridTextColumn Header="H1" Binding="{Binding Height1, StringFormat=N0}" Width="50">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- W2 -->
                                                                <DataGridTextColumn Header="W2" Binding="{Binding Width2, StringFormat=N0}" Width="50">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- H2 -->
                                                                <DataGridTextColumn Header="H2" Binding="{Binding Height2, StringFormat=N0}" Width="50">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- Qty -->
                                                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=N0}" Width="40">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- SQM -->
                                                                <DataGridTextColumn Header="SQM" Binding="{Binding SQM1, StringFormat=N4}" Width="60">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- Total SQM -->
                                                                <DataGridTextColumn Header="Total SQM" Binding="{Binding TotalSQM, StringFormat=N4}" Width="70">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- Price -->
                                                                <DataGridTextColumn Header="Price" Binding="{Binding DisplayPrice, StringFormat=N2}" Width="60">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="Padding" Value="0,0,4,0"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <!-- Total Price -->
                                                                <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, StringFormat=N2}" Width="70">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                            <Setter Property="Padding" Value="0,0,4,0"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>

                                                        <!-- Spec Footer - Exact Column Alignment -->
                                                        <Border Grid.Row="2" Background="#1E40AF" Padding="4,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="TOTAL" 
           FontSize="9" FontWeight="Bold" Foreground="White" 
           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="3" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="4" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="5" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="6" Text="{Binding SpecTotalQty, StringFormat=N0}" 
           FontSize="9" FontWeight="Bold" Foreground="White" 
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="7" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="8" Text="{Binding SpecTotalSQM, StringFormat=N4}" 
           FontSize="9" FontWeight="Bold" Foreground="White" 
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="9" Text="" FontSize="9" Foreground="White"/>
                                                                <TextBlock Grid.Column="10" Text="{Binding SpecTotalPrice, StringFormat=N2}" 
           FontSize="9" FontWeight="Bold" Foreground="White" 
           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- OTHER CHARGES (Last Page Only) -->
                                    <Border Grid.Row="4" BorderBrush="#000000" BorderThickness="1" Background="#F8FAFC" 
                                            Padding="6,4" Margin="0,0,0,4" CornerRadius="2"
                                            Visibility="{Binding IsLastPage, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="OTHER CHARGES" FontSize="7" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>

                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Charge" FontSize="7" FontWeight="Bold" Foreground="Black"/>
                                                <TextBlock Grid.Column="1" Text="Type" FontSize="7" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Specs" FontSize="7" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Value" FontSize="7" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Rate" FontSize="7" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Amount" FontSize="7" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding AllOtherCharges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#000000" BorderThickness="1" Padding="4,2" Margin="0,0,0,1" Background="White" CornerRadius="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="55"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="45"/>
                                                                    <ColumnDefinition Width="65"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="8" Foreground="Black" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="7" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding LinkedSpecsDisplay}" FontSize="7" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding ValueDisplay}" FontSize="8" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding Rate, StringFormat=N2}" FontSize="8" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding AmountDisplay}" FontSize="8" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="#1E40AF" Padding="4,2" CornerRadius="2" Margin="0,2,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="TOTAL OTHER CHARGES" FontSize="7" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalOtherCharges, StringFormat='AED {0:N2}'}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- INVOICE SUMMARY (Last Page Only) -->
                                    <Grid Grid.Row="5" Margin="0,0,0,4"
                                            Visibility="{Binding IsLastPage, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="1" Padding="6,4" CornerRadius="2">
                                            <StackPanel>
                                                <TextBlock Text="TERMS AND CONDITIONS" FontSize="7" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="- Prices in AED (UAE Dirhams)" FontSize="7" Foreground="Black" Margin="0,2,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                                                <TextBlock Text="- Quote valid for 30 days from invoice date" FontSize="7" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                <TextBlock Text="- 5% VAT included in all prices" FontSize="7" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" BorderBrush="#000000" BorderThickness="1" Background="#F8FAFC" Padding="6,4" Margin="6,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Total SQM:" FontSize="8" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalSQM, StringFormat=N4}" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Total LM:" FontSize="8" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalLM1, StringFormat=N2}" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                                </Grid>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Total Qty:" FontSize="8" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalQty}" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                                </Grid>
                                                <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="0,3,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Sub Total:" FontSize="9" FontWeight="Bold" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat=N2}" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="VAT (5%):" FontSize="8" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding VatAmount, StringFormat=N2}" FontSize="8" Foreground="Black" HorizontalAlignment="Right" FontFamily="{StaticResource PrimaryFont}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- NET TOTAL (Last Page Only) -->
                                    <Border Grid.Row="6" Background="#1E40AF" Padding="10,6" CornerRadius="2" Margin="0,0,0,4"
                                            Visibility="{Binding IsLastPage, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="NET TOTAL (AED):" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding NetTotal, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}"/>
                                        </Grid>
                                    </Border>

                                    <!-- FOOTER (All Pages) -->
                                    <Border Grid.Row="7" BorderBrush="#000000" BorderThickness="0,1,0,0" Padding="0,4,0,0"
                                            Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock Text="Thank you for your business!" FontSize="8" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="PROGLASS AUTOMATION" FontSize="7" FontWeight="Bold" Foreground="Black" FontFamily="{StaticResource PrimaryFont}"/>
                                                <TextBlock Text=" | Dubai, UAE" FontSize="7" Foreground="Black" FontFamily="{StaticResource PrimaryFont}" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Text="Portrait | A4 | Margins: T/B 0.3in, L/R 0.7in" FontSize="9" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>