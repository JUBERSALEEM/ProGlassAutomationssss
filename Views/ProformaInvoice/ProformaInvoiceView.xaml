                                                    <TextBlock Grid.Column="4" Text="" FontSize="8" Foreground="#FFFFFF"/>

                                                    <TextBlock Grid.Column="5" Text="{Binding SpecTotalSQM2, Mode=OneWay, StringFormat=N4}" FontSize="9" FontWeight="Bold" Foreground="#FCD34D" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="6" Text="{Binding SpecTotalQty, Mode=OneWay, StringFormat=N0}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

