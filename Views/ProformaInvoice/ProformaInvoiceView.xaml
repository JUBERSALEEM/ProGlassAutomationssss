            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">

                    <!-- MODULE SELECTION CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#1E40AF" CornerRadius="6" Padding="8,6" HorizontalAlignment="Left" Margin="0,0,0,10">
