<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="White">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="DeepBlue" Color="#1E40AF"/>
        <SolidColorBrush x:Key="BorderGray" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Input -->
        <Style x:Key="SmallInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Small ComboBox -->
        <Style x:Key="SmallComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid Header -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DataGrid Cell -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Calculator Input Style -->
        <Style x:Key="CalcInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Calculator Label Style -->
        <Style x:Key="CalcLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== -->
        <!-- LEFT SIDEBAR -->
        <!-- ==================== -->
        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>

                    <!-- File Management Header -->
                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="PROFORMA INVOICES" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock Text="File Manager" FontSize="9" Foreground="#64748B" Margin="0,2,0,10"/>

                            <!-- New/Save Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="+ NEW" 
                    Command="{Binding NewInvoiceCommand}"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="💾 SAVE" 
                    Command="{Binding SaveInvoiceCommand}"/>
                            </Grid>

                            <!-- Open/Delete Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="📂 OPEN" 
                    Command="{Binding OpenInvoiceCommand}"/>
                                <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="🗑️ DELETE" 
                    Command="{Binding DeleteInvoiceCommand}"/>
                            </Grid>

                            <!-- Import/Export Section -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📤 EXPORT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                Content="📄 EXPORT CSV" Command="{Binding ExportCsvCommand}" 
                Padding="8,6" Margin="0,0,0,6"/>

                                    <TextBlock Text="📥 IMPORT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,8,0,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                Content="📄 IMPORT CSV" Command="{Binding ImportCsvCommand}" 
                Padding="8,6" Margin="0,0,0,6"/>

                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                Content="📥 IMPORT ITEMS" Command="{Binding ImportItemsCommand}" 
                Padding="8,6" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SPECS GENERATOR -->
                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#2563EB" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="🔧 SPECS GENERATOR" FontSize="12" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,12"/>

                            <TextBlock Text="Glass Type" Style="{StaticResource CalcLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding GlassTypes}" 
                                      SelectedItem="{Binding SelectedGlassType}" 
                                      Style="{StaticResource SmallComboBoxStyle}" 
                                      Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start SR No" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SpecStartSrNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="No. of Rows" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SpecRowCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Specification Name" Style="{StaticResource CalcLabelStyle}"/>
                            <TextBox Text="{Binding SpecGeneratorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (mm)" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SpecDefaultWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (mm)" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SpecDefaultHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Default Qty" Style="{StaticResource CalcLabelStyle}"/>
                            <TextBox Text="{Binding SpecDefaultQty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}" Margin="0,0,0,12"/>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="⚡ GENERATE SPECS" Command="{Binding GenerateSpecsCommand}" Padding="8,8"/>
                        </StackPanel>
                    </Border>

                    <!-- PRICE CALCULATOR -->
                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#059669" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="🧮 GLASS PRICE CALCULATOR" FontSize="12" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,12"/>

                            <!-- Mode Selector -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="SGU" GroupName="CalcMode" IsChecked="{Binding IsSGUSelected}" Margin="0,0,8,0"/>
                                <RadioButton Content="DGU" GroupName="CalcMode" IsChecked="{Binding IsDGUSelected}" Margin="0,0,8,0"/>
                                <RadioButton Content="LAM" GroupName="CalcMode" IsChecked="{Binding IsLAMSelected}"/>
                            </StackPanel>

                            <!-- SGU Section -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding IsSGUSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Single Glass Unit (SGU)" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness (mm)" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding SelectedThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Sheet Price" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding SGUSheetPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding SGUWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cutting (AED)" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding SGUCutting, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tempering (AED)" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding SGUTempering, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Profit %" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SGUProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>

                            <!-- DGU Section -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding IsDGUSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Double Glass Unit (DGU)" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/>

                                    <TextBlock Text="Outer Glass" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUOuterThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding DGUOuterPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Air Space (ASP)" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,4"/>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Spacer Thickness" Style="{StaticResource CalcLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ASPOptions}" SelectedItem="{Binding DGUASPSpacer}" Style="{StaticResource SmallComboBoxStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="Inner Glass" FontWeight="SemiBold" FontSize="9" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUInnerThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding DGUInnerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding DGUWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Profit %" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding DGUProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- LAM Section -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding IsLAMSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Laminated Glass (LAM)" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Outer Glass Price" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Inner Glass Price" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding LAMInnerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PVB Thickness" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding PVBThicknessOptions}" SelectedItem="{Binding LAMPVBThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PVB Color" Style="{StaticResource CalcLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding PVBColorOptions}" SelectedItem="{Binding LAMPVBColor}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PVB Price (AED)" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource CalcLabelStyle}"/>
                                            <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Profit %" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>

                            <!-- Formula Display -->
                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="📐 FORMULA" Foreground="White" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                                    <TextBlock Text="Answer 1 = Sheet Price ÷ Waste" Foreground="#CBD5E1" FontSize="9"/>
                                    <TextBlock Text="Answer 2 = Answer 1 + Cutting" Foreground="#CBD5E1" FontSize="9"/>
                                    <TextBlock Text="Answer 3 = Answer 2 + Tempering" Foreground="#CBD5E1" FontSize="9"/>
                                    <TextBlock Text="Final = Answer 3 × (1 + Profit%)" Foreground="#22C55E" FontWeight="Bold" FontSize="9"/>
                                </StackPanel>
                            </Border>

                            <!-- Result Display -->
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Final SQM Price" FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock Text="{Binding CalculatedPrice, StringFormat='AED {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#15803D"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="→ USE" Command="{Binding UseCalculatedPriceCommand}" 
                                            Padding="12,6" Background="#15803D" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Calculate Button -->
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="🧮 CALCULATE" Command="{Binding CalculatePriceCommand}" Padding="8,8"/>
                        </StackPanel>
                    </Border>

                    <!-- LARGE SIZE SURCHARGE -->
                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#DC2626" BorderThickness="2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="LARGE SIZE SURCHARGE" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Threshold (SQM)" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SurchargeThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Surcharge %" Style="{StaticResource CalcLabelStyle}"/>
                                    <TextBox Text="{Binding SurchargePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CalcInputStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#FEF2F2" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="How it works:" FontSize="9" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,4"/>
                                    <TextBlock Text="• If SQM >= Threshold → Price + Surcharge%" FontSize="8" Foreground="#991B1B" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Example: Price=125, SQM=4, Surcharge=10% → Final=137" FontSize="8" Foreground="#991B1B" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Applies per row independently" FontSize="8" Foreground="#991B1B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SAVED FILES LIST -->
                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📁 RECENT INVOICES" Style="{StaticResource SectionHeaderStyle}"/>
                            <ItemsControl ItemsSource="{Binding SavedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.LoadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding FilePath}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <TextBlock Text="{Binding InvoiceNo}" FontSize="10" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding InvoiceDate, StringFormat='dd MMM yyyy'}" FontSize="8" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== -->
        <!-- RIGHT CONTENT AREA -->
        <!-- ==================== -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="INVOICE:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Invoice.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}" MinWidth="150" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="TOGGLE LM" Command="{Binding ToggleLMCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="PREVIEW" Click="PrintPreview_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="PRINT" Command="{Binding PrintCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Header -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Side - Company Info Card -->
                            <Border Grid.Column="0" 
                Background="#F8FAFC"
                CornerRadius="12" 
                Padding="20" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                Margin="0,0,20,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Company Name - Large & Bold -->
                                    <TextBox Grid.Row="0" 
                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="24" 
                         FontWeight="Bold" 
                         Foreground="#1E40AF"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0,0,0,12"/>

                                    <!-- TRN Badge -->
                                    <Border Grid.Row="1" 
                        HorizontalAlignment="Left"
                        Background="#EFF6FF" 
                        CornerRadius="6" 
                        Padding="12,6" 
                        Margin="0,0,0,12"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TRN:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding CompanyTRN, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="11" 
                                 FontWeight="SemiBold"
                                 Foreground="#1E40AF"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Contact Info Row -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Location with Icon -->
                                        <Border Grid.Column="0" 
                            Background="#F0FDF4" 
                            CornerRadius="20" 
                            Padding="10,6" 
                            Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="10" 
                                     FontWeight="Medium"
                                     Foreground="#166534"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     MinWidth="80"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Phone with Icon -->
                                        <Border Grid.Column="2" 
                            Background="#FEF2F2" 
                            CornerRadius="20" 
                            Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📞" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="10" 
                                     FontWeight="Medium"
                                     Foreground="#991B1B"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     MinWidth="100"
                                     PreviewTextInput="PhoneNumber_PreviewTextInput"
                                     GotFocus="PhoneNumber_GotFocus"
                                     LostFocus="PhoneNumber_LostFocus"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right Side - Invoice Info -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <!-- Invoice Title Badge -->
                                <Border Background="#1E40AF" 
                    CornerRadius="12" 
                    Padding="24,14"
                    Margin="0,0,0,16">
                                    <TextBlock Text="PROFORMA INVOICE" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Date Fields -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="📅" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Date:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <DatePicker SelectedDate="{Binding Invoice.InvoiceDate}" Width="120"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏰" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Valid Until:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <DatePicker SelectedDate="{Binding Invoice.ValidUntil}" Width="120"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Customer & Project & Other Details -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CUSTOMER DETAILS -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER DETAILS" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>

                                <TextBlock Text="Company Name *" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     Margin="0,0,0,8"
                     ToolTip="Enter company name"/>

                                <TextBlock Text="TRN Number" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.CustomerTRN, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     Margin="0,0,0,8"
                     ToolTip="Enter TRN number (e.g., 100458979400003)"/>

                                <TextBlock Text="Address" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.CustomerAddress, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     Height="60"
                     ToolTip="Enter full address"/>
                            </StackPanel>
                        </Border>

                        <!-- PROJECT DETAILS -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="PROJECT DETAILS" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>

                                <TextBlock Text="Project Name *" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.ProjectName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     Margin="0,0,0,8"
                     ToolTip="Enter project name"/>

                                <TextBlock Text="Location *" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.ProjectLocation, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     ToolTip="Enter project location (e.g., Dubai, Abu Dhabi)"/>
                            </StackPanel>
                        </Border>

                        <!-- OTHER DETAILS -->
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="OTHER DETAILS" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>

                                <TextBlock Text="LPO No." FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.LPONo, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     Margin="0,0,0,8"
                     ToolTip="Enter LPO number"/>

                                <TextBlock Text="Attention Name" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.AttentionName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}" 
                     Margin="0,0,0,8"
                     ToolTip="Enter contact person name"/>

                                <TextBlock Text="Contact No. (Phone)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Invoice.ContactNo, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     ToolTip="Enter phone number (e.g., +971-50-123-4567)"
                     PreviewTextInput="PhoneNumber_PreviewTextInput"
                     GotFocus="PhoneNumber_GotFocus"
                     LostFocus="PhoneNumber_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Specifications Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SPECIFICATIONS" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ ADD SPECIFICATION" Command="{Binding AddSpecificationCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource DangerButtonStyle}" Content="- REMOVE" Command="{Binding RemoveSpecificationCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Specifications List -->
                    <ItemsControl ItemsSource="{Binding Invoice.Specifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10" BorderBrush="#1E40AF" BorderThickness="2" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Specification Header -->
                                        <Border Grid.Row="0" Background="#1E40AF" CornerRadius="8,8,0,0" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SPECIFICATION:" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SpecificationName}" 
             Background="White" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold"
             MinWidth="150" Padding="8,4" VerticalAlignment="Center"/>

                                                <!-- BASE PRICE INPUT -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                                                    <TextBlock Text="BASE PRICE:" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                 Width="80" Padding="8,4" FontSize="12" Background="#FEF9C3" Foreground="#0F172A" FontWeight="Bold"
                 VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="+ ADD ROW" Style="{StaticResource SecondaryButtonStyle}" 
            Click="AddRow_Click" Tag="{Binding}" Padding="12,6"/>
                                            </Grid>
                                        </Border>

                                        <!-- DataGrid in Grid.Row="1" with Border wrapper -->
                                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <DataGrid ItemsSource="{Binding Items}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  BorderThickness="0" 
                                  Background="White"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  GridLinesVisibility="All" 
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="#E2E8F0"
                                  HeadersVisibility="Column"
                                  RowHeight="36"
                                  MinHeight="72"
                                  SelectionUnit="Cell"
                                  FocusVisualStyle="{x:Null}"
                                  PreviewKeyDown="DataGrid_PreviewKeyDown">
                                                <DataGrid.Columns>
                                                    <!-- SR No -->
                                                    <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="50" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Glass Ref -->
                                                    <DataGridTextColumn Header="GLASS REF" Binding="{Binding GlassRef}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="4,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Padding" Value="4,0"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Width 1 -->
                                                    <DataGridTextColumn Header="W1 (mm)" Binding="{Binding Width1, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Height 1 -->
                                                    <DataGridTextColumn Header="H1 (mm)" Binding="{Binding Height1, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Width 2 -->
                                                    <DataGridTextColumn Header="W2 (mm)" Binding="{Binding Width2, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Height 2 -->
                                                    <DataGridTextColumn Header="H2 (mm)" Binding="{Binding Height2, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- QTY -->
                                                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="60">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- SQM (Read Only) -->
                                                    <DataGridTextColumn Header="SQM" Binding="{Binding SQM, StringFormat=N4}" Width="85" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Total SQM (Read Only) -->
                                                    <DataGridTextColumn Header="TOTAL SQM" Binding="{Binding TotalSQM, StringFormat=N4}" Width="100" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="#BAE6FD"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- LM (Read Only) -->
                                                    <DataGridTemplateColumn Header="LM" Width="70">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding LM, StringFormat=N4}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Background="#D1FAE5"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Total LM (Read Only) -->
                                                    <DataGridTemplateColumn Header="TOTAL LM" Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding TotalLM, StringFormat=N4}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Background="#6EE7B7" 
                           FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Price (Read Only - Shows Display Price with Surcharge) -->
                                                    <DataGridTextColumn Header="PRICE/AED" Binding="{Binding DisplayPrice, StringFormat=N2}" Width="100" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Total Price (Read Only) -->
                                                    <DataGridTextColumn Header="TOTAL AED" Binding="{Binding TotalPrice, StringFormat=N2}" Width="110" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>

                                                    <!-- Delete Button -->
                                                    <DataGridTemplateColumn Header="" Width="50">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="X" 
                    FontSize="12" 
                    FontWeight="Bold" 
                    Foreground="#EF4444"
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Padding="0" 
                    Click="DeleteRow_Click" 
                    Tag="{Binding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Focusable="False"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>

                                        <!-- Specification Totals -->
                                        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,10,10" Padding="16,12">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="SPECIFICATION TOTAL" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,40,0">
                                                        <TextBlock Text="Total Qty:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecTotalQty}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,40,0">
                                                        <TextBlock Text="Total SQM:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecTotalSQM, StringFormat=N4}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,40,0">
                                                        <TextBlock Text="Total LM:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecTotalLM, StringFormat=N4}" FontSize="12" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <TextBlock Text="Total AED:" FontSize="11" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecTotalPrice, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Grand Totals Section -->
                    <Border Background="#1E40AF" CornerRadius="10" Padding="24" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>

                            <!-- Terms -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TERMS &amp; CONDITIONS" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,0,0,8"/>
                                <TextBlock Text="• Prices are in AED (Dirhams)" FontSize="10" Foreground="#BFDBFE"/>
                                <TextBlock Text="• Quote valid for 30 days from date" FontSize="10" Foreground="#BFDBFE"/>
                                <TextBlock Text="• 5% VAT included in total" FontSize="10" Foreground="#BFDBFE"/>
                            </StackPanel>

                            <!-- Totals Table -->
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total SQM -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total SQM:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Invoice.TotalSQM, StringFormat=N4}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>

                                    <!-- Total Qty -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Quantity:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Invoice.TotalQty}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>

                                    <!-- Total LM -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total LM:" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Invoice.TotalLM, StringFormat=N4}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>

                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,12"/>

                                    <!-- Sub Total -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sub Total (AED):" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Invoice.GrandTotal, StringFormat=N2}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>

                                    <!-- VAT -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="VAT (5%):" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Invoice.VatAmount, StringFormat=N2}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>

                                    <!-- Net Total -->
                                    <Border Grid.Row="6" Grid.ColumnSpan="2" Background="#1E40AF" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NET TOTAL (AED):" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotal, StringFormat=N2}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Thank you for your business!" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="File:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding CurrentFileName}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text=" *" FontSize="10" FontWeight="Bold" Foreground="#EF4444" Margin="4,0,0,0"
                       Visibility="{Binding Invoice.IsDirty, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="(Unsaved)" FontSize="10" Foreground="#F59E0B" Margin="4,0,0,0"
                       Visibility="{Binding Invoice.IsDirty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                        <TextBlock Text="LM:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding IsLMToggleText}" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="10" Foreground="#64748B" 
                   VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>