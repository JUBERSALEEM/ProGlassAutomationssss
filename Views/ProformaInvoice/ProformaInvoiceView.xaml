                                                    <TextBlock Grid.Column="10" Text="{Binding SpecTotalPrice, Mode=OneWay, StringFormat=N2}" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
