                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0">
                                                            <TextBlock Text="AED:" FontSize="8" Foreground="{StaticResource TextSecondary}" Margin="0,0,3,0" VerticalAlignment="Center"/>
