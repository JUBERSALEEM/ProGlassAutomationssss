                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROFIT %" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding DGUProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- LAM CONFIGURATION -->
                    <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,8"
                            Visibility="{Binding IsLAMSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Border Background="#666666" Padding="8,5">
                                <TextBlock Text="LAM CONFIGURATION" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <StackPanel Margin="8">
                                <!-- Outer Glass -->
                                <TextBlock Text="OUTER GLASS" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="THICKNESS" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMOuterThickness}" Style="{StaticResource IndComboBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="COLOR" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding LAMOuterColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource IndComboBox}" StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PRICE" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Work Type -->
                                <TextBlock Text="WORK TYPE" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" IsChecked="{Binding IsLAMAnnealedSelected}" Content="Annealed" Cursor="Hand"/>
                                    <RadioButton Grid.Column="2" IsChecked="{Binding IsLAMFTSelected}" Content="FT Glass" Cursor="Hand"/>
                                </Grid>

                                <!-- PVB Layer -->
                                <TextBlock Text="PVB LAYER" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PVB THICKNESS" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox Style="{StaticResource IndComboBox}">
                                            <ComboBoxItem Content="0.76mm" IsSelected="True"/>
                                            <ComboBoxItem Content="1.52mm"/>
                                            <ComboBoxItem Content="2.28mm"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PVB COLOR" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox Style="{StaticResource IndComboBox}">
                                            <ComboBoxItem Content="Clear" IsSelected="True"/>
                                            <ComboBoxItem Content="White"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PVB PRICE" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Inner Glass -->
                                <TextBlock Text="INNER GLASS" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="THICKNESS" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMInnerThickness}" Style="{StaticResource IndComboBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="COLOR" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding LAMInnerColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource IndComboBox}" StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PRICE" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMInnerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Cutting & Tempering -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUTTING" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMCutting, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TEMPERING" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMTempering, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Waste & Profit -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WASTE" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROFIT %" FontSize="7" Foreground="#666666" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Padding="4,3" FontSize="10" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CALCULATED RESULT -->
                    <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="#1A1A1A" Padding="8,5">
                                <TextBlock Text="CALCULATED RESULT" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <StackPanel Margin="8">
                                <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding GeneratedDescription, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="6,4" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Border Background="#228B22" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="TOTAL PRICE" FontSize="8" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="AED" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CalculatedPrice, Mode=OneWay, StringFormat=N2}" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding PriceCalculationSummary, Mode=OneWay}" FontSize="8" Foreground="#666666" FontFamily="Consolas" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                </Border>

                                <Button Content="GENERATE PRICE" Style="{StaticResource IndButtonPrimary}" Command="{Binding CalculatePriceCommand}" Padding="10,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TARGET SPECIFICATION -->
                    <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="#666666" Padding="8,5">
                                <TextBlock Text="TARGET SPECIFICATION" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <StackPanel Margin="8">
                                <TextBlock Text="Select spec to apply price" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Invoice.Specifications}" 
                                          SelectedItem="{Binding SelectedTargetSpecification}"
                                          DisplayMemberPath="SpecificationName" 
                                          Style="{StaticResource IndComboBox}" Margin="0,0,0,8"/>

                                <Button Content="INCLUDE IN SPEC" Style="{StaticResource IndButtonPrimary}" Command="{Binding IncludeInSpecificationCommand}" Padding="10,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT - FILE MANAGEMENT ==================== -->
        <Border Grid.Column="2" Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Operations -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8">
                    <StackPanel>
                        <Border Background="#1A1A1A" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Text="FILE OPERATIONS" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="SAVE" Style="{StaticResource IndButtonPrimary}" Command="{Binding SaveInvoiceCommand}" Padding="8,6"/>
                            <Button Grid.Column="2" Content="OPEN" Style="{StaticResource IndButton}" Command="{Binding OpenInvoiceCommand}" Padding="8,6"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="NEW" Style="{StaticResource IndButton}" Command="{Binding NewInvoiceCommand}" Padding="8,6"/>
                            <Button Grid.Column="2" Content="DELETE" Style="{StaticResource IndButtonDanger}" Command="{Binding DeleteInvoiceCommand}" Padding="8,6"/>
                        </Grid>

                        <Separator Margin="0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="EXPORT" Style="{StaticResource IndButton}" Command="{Binding ExportCsvCommand}" Padding="8,6"/>
                            <Button Grid.Column="2" Content="IMPORT" Style="{StaticResource IndButton}" Command="{Binding ImportCsvCommand}" Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Invoices -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D2D" Padding="8,5">
                        <TextBlock Text="RECENT INVOICES" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedFiles}" Background="#FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InvoiceNo}" FontSize="9" FontWeight="Bold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="8" Foreground="#666666" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="7" Foreground="#999999" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasSavedFiles, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No saved invoices" FontSize="8" Foreground="#999999" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>