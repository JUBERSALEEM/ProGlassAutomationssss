                                        <ComboBoxItem Content="6mm" IsSelected="True"/>
                                        <ComboBoxItem Content="8mm"/>
                                        <ComboBoxItem Content="10mm"/>
                                        <ComboBoxItem Content="12mm"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ASP PRICE (AED)" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DGUASPPrice, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Section Title - U-Insert -->
                            <TextBlock Text="INCLUDE IN SPEC (U-INSERT)" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" IsChecked="{Binding IsDGUIncludeInSpec}" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="#F8FAFC" CornerRadius="6" Padding="8,6" BorderThickness="1" BorderBrush="#E2E8F0">
                                                <TextBlock Text="YES - Include" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#059669"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <RadioButton Grid.Column="2" IsChecked="{Binding IsDGUInternalOnly}" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="#F8FAFC" CornerRadius="6" Padding="8,6" BorderThickness="1" BorderBrush="#E2E8F0">
                                                <TextBlock Text="NO - Internal Only" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>

                            <!-- Section Title - Inner Glass -->
                            <TextBlock Text="INNER GLASS" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THICKNESS" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUInnerThickness}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COLOR" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox IsEditable="True"
                                      ItemsSource="{Binding ColorHistory}"
                                      Text="{Binding DGUInnerColor, UpdateSourceTrigger=LostFocus}"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"
                                      StaysOpenOnEdit="True"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRICE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DGUInnerPrice, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Waste & Profit -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="WASTE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DGUWasteFactor, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PROFIT %" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding DGUProfitPercent, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LAM CONFIGURATION CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding IsLAMSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#7C3AED" CornerRadius="6" Padding="8,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="LAM CONFIGURATION" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Section Title - Outer Glass -->
                            <TextBlock Text="OUTER GLASS" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THICKNESS" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMOuterThickness}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COLOR" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox IsEditable="True"
                                      ItemsSource="{Binding ColorHistory}"
                                      Text="{Binding LAMOuterColor, UpdateSourceTrigger=LostFocus}"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"
                                      StaysOpenOnEdit="True"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRICE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Section Title - Work Type -->
                            <TextBlock Text="WORK TYPE" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" IsChecked="{Binding IsLAMAnnealedSelected}" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="#F8FAFC" CornerRadius="6" Padding="8,6" BorderThickness="1" BorderBrush="#E2E8F0">
                                                <TextBlock Text="Annealed" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <RadioButton Grid.Column="2" IsChecked="{Binding IsLAMFTSelected}" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="#F8FAFC" CornerRadius="6" Padding="8,6" BorderThickness="1" BorderBrush="#E2E8F0">
                                                <TextBlock Text="FT Glass" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#64748B"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#7C3AED"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#7C3AED"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>

                            <!-- Section Title - PVB Layer -->
                            <TextBlock Text="PVB LAYER" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PVB THICKNESS" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10">
                                        <ComboBoxItem Content="0.76mm" IsSelected="True"/>
                                        <ComboBoxItem Content="1.52mm"/>
                                        <ComboBoxItem Content="2.28mm"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PVB COLOR" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10">
                                        <ComboBoxItem Content="Clear" IsSelected="True"/>
                                        <ComboBoxItem Content="White"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PVB PRICE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Section Title - Inner Glass -->
                            <TextBlock Text="INNER GLASS" FontSize="9" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THICKNESS" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMInnerThickness}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COLOR" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox IsEditable="True"
                                      ItemsSource="{Binding ColorHistory}"
                                      Text="{Binding LAMInnerColor, UpdateSourceTrigger=LostFocus}"
                                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10"
                                      StaysOpenOnEdit="True"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PRICE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMInnerPrice, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,5" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Cutting & Tempering -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CUTTING" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMCutting, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TEMPERING" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMTempering, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Waste & Profit -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="WASTE" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PROFIT %" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=PropertyChanged}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CALCULATED RESULT CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#059669" CornerRadius="6" Padding="8,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="CALCULATED RESULT" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Description -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="DESCRIPTION" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding GeneratedDescription, Mode=OneWay}" IsReadOnly="True" Background="#F0FDF4" BorderBrush="#6EE7B7" BorderThickness="1" Padding="8,6" FontSize="10" FontWeight="SemiBold" Foreground="#059669" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Price Box -->
                            <Border Background="#059669" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TOTAL PRICE" FontSize="9" FontWeight="SemiBold" Foreground="White" Opacity="0.9" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="AED" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CalculatedPrice, Mode=OneWay, StringFormat=N2}" FontSize="24" FontWeight="ExtraBold" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Calculation Summary -->
                            <Border Background="#F0FDF4" CornerRadius="8" Padding="8,6" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#6EE7B7">
                                <TextBlock Text="{Binding PriceCalculationSummary, Mode=OneWay}" FontSize="9" Foreground="#64748B" FontFamily="Consolas" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Generate Button -->
                            <Button Command="{Binding CalculatePriceCommand}" Cursor="Hand" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#1E40AF" CornerRadius="8" Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🧮" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="GENERATE PRICE" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- TARGET SPECIFICATION CARD -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="#7C3AED" CornerRadius="6" Padding="8,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="TARGET SPECIFICATION" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Select Spec -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Select spec to apply price" FontSize="8" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Invoice.Specifications}" 
                                  SelectedItem="{Binding SelectedTargetSpecification}"
                                  DisplayMemberPath="SpecificationName" 
                                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" FontSize="10"/>
                            </StackPanel>

                            <!-- Include Button -->
                            <Button Command="{Binding IncludeInSpecificationCommand}" Cursor="Hand" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#7C3AED" CornerRadius="8" Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="✅" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="INCLUDE IN SPEC" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT - FILE MANAGEMENT ==================== -->
        <Border Grid.Column="2" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Management Card -->
                <Border Grid.Row="0" Background="White" CornerRadius="0" Padding="10" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource PrimaryBlueLight}" CornerRadius="6" Padding="5,3" Margin="0,0,6,0">
                                <TextBlock Text="📁" FontSize="11"/>
                            </Border>
                            <TextBlock Text="FILE MANAGEMENT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="SAVE" Command="{Binding SaveInvoiceCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="OPEN" Command="{Binding OpenInvoiceCommand}" Padding="6,6"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="NEW" Command="{Binding NewInvoiceCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="DELETE" Command="{Binding DeleteInvoiceCommand}" Padding="6,6"/>
                        </Grid>

                        <Separator Margin="0,6"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="EXPORT" Command="{Binding ExportCsvCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="IMPORT" Command="{Binding ImportCsvCommand}" Padding="6,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Invoices -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PrimaryBlueDark}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="RECENT INVOICES" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedFiles}" Background="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InvoiceNo}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="8" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="7" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasSavedFiles, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No saved invoices" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>