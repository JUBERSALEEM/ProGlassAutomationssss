                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total Qty" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceTotalQty, Mode=OneWay, StringFormat=N0}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="Amounts" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Grand Total" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceGrandTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJobOrder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="VAT (5%)" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceVatAmount, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="12" Foreground="#6B7280"/>
                                        </Grid>
                                        <Separator Margin="0,8">
                                            <Separator.Style>
                                                <Style TargetType="Separator">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJobOrder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Separator.Style>
                                        </Separator>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJobOrder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="NET TOTAL" FontSize="14" FontWeight="Bold" Foreground="#1E3A5F"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceNetTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#4A6FA5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Terms and Conditions" Style="{StaticResource SectionHeader}"/>
                            <StackPanel>
                                <TextBlock Text="- Prices in AED (UAE Dirhams)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBlock Text="- Quote valid for 30 days from invoice date" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBlock Text="- 5% VAT included in all prices" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBlock Text="- Payment terms: As per agreement" FontSize="12" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E3A5F" Padding="16,12" CornerRadius="6" Margin="0,0,0,24">
                        <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= CENTER SECTION: OPTIMIZATION ================= -->
        <Border Grid.Column="1" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="6" Background="#FFFFFF" Margin="7,0,7,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                        <TextBlock Text="⚙ GLASS CUT OPTIMIZER" FontSize="18" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- Stock Sheets Manager -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Stock Sheets" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Width (mm)" FontSize="10" Foreground="#6B7280"/>
                                        <TextBox x:Name="txtSheetWidth" Text="3210" Style="{StaticResource FormTextBox}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Height (mm)" FontSize="10" Foreground="#6B7280"/>
                                        <TextBox x:Name="txtSheetHeight" Text="2250" Style="{StaticResource FormTextBox}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Vertical">
                                        <TextBlock Text="Qty" FontSize="10" Foreground="#6B7280"/>
                                        <TextBox x:Name="txtSheetQty" Text="99999" Style="{StaticResource FormTextBox}" FontSize="13" FontWeight="SemiBold" Width="70" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Add Additional Sheet" FontSize="11" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtExtraSheetWidth" Width="80" Style="{StaticResource FormTextBox}"/>
                                            <TextBox x:Name="txtExtraSheetHeight" Width="80" Margin="8,0,0,0" Style="{StaticResource FormTextBox}"/>
                                            <TextBox x:Name="txtExtraSheetQty" Width="60" Margin="8,0,0,0" Style="{StaticResource FormTextBox}"/>
                                            <Button x:Name="btnAddExtraSheet" Content="Add" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="8,4"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Defined Sheets" FontSize="11" Foreground="#6B7280" Margin="0,0,0,6"/>
                                        <ListBox x:Name="lstStockSheets" Height="80" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnLoadDefaultSheet" Content="Load Default" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0"/>
                                    <Button x:Name="btnClearSheets" Content="Clear" Style="{StaticResource DangerButton}" Padding="10,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Thickness -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Glass Thickness" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbThickness" SelectedIndex="0" Style="{StaticResource FormComboBox}" FontSize="14">
                                    <ComboBoxItem Content="6mm"/>
                                    <ComboBoxItem Content="8mm"/>
                                    <ComboBoxItem Content="10mm"/>
                                    <ComboBoxItem Content="12mm"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Results -->
                        <Border Background="#1E3A5F" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Optimization Results" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Utilization" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtUtilization" Text="--" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Sheets Used" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtSheetsUsed" Text="--" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                    <CheckBox x:Name="chkSortBestFirst" Content="Sort Best First" Foreground="White" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="chkSpecWise" Content="Specification-wise" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="Dims:" Foreground="White" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbDimsW1H1" GroupName="Dims" IsChecked="True" Content="W1/H1" Foreground="White" Margin="0,0,6,0"/>
                                        <RadioButton x:Name="rbDimsW2H2" GroupName="Dims" Content="W2/H2" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sheet-wise Results" FontSize="11" Foreground="#DBEAFE" Margin="0,0,0,6"/>
                                        <ListBox x:Name="lstResults" Height="100" Background="#0F1724" BorderBrush="#0B1220" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Total Summary" FontSize="11" Foreground="#DBEAFE" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="txtTotalSummary" Text="--" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Specification selection area -->
                                <Border Background="#F3F4F6" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Select Specifications to Optimize" FontSize="11" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,6"/>
                                        <ListBox x:Name="lstSpecSelect" ItemsSource="{Binding Invoice.Specifications}" DisplayMemberPath="SpecificationName" SelectionMode="Multiple" Height="100"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button x:Name="btnSelectAllSpecs" Content="Select All" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0"/>
                                            <Button x:Name="btnClearSpecSelection" Content="Clear" Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                                            <TextBlock Text="Dimension source:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="rbUseW1H1" GroupName="SpecDims" IsChecked="True" Content="W1/H1" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="rbUseW2H2" GroupName="SpecDims" Content="W2/H2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Run Buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="▶ RUN" Click="RunOptimization_Click" Padding="12,14" FontSize="13" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6 0 0 6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2" Content="📐 VIEW" Click="ViewOptimizationLayouts_Click" Padding="12,14" FontSize="13" Background="#1E3A5F" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0 6 6 0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Specification & Options -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                            <TextBlock Text="Spec:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbSpecFilter" ItemsSource="{Binding Invoice.Specifications}" DisplayMemberPath="SpecificationName" SelectedItem="{Binding SelectedTargetSpecification}" Width="160" Style="{StaticResource FormComboBox}"/>
                            <CheckBox x:Name="chkSpecOnly" Content="Apply Spec Only" VerticalAlignment="Center" Foreground="#6B7280" Margin="8,0,0,0"/>
                            <CheckBox x:Name="chkOptimizeRightSide" Content="Optimize Right Side Separately" VerticalAlignment="Center" Foreground="#6B7280" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="txtOptStatus" Text="Enter sheet size and click Run" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= RIGHT SECTION: CONFIGURATION (Blue Header) ================= -->
        <Border Grid.Column="2" BorderBrush="#1E3A8A" BorderThickness="2" CornerRadius="6" Background="White" Margin="7,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" PanningMode="VerticalOnly">
                <StackPanel>

                    <!-- File Operations with expandable panel -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16">
                        <StackPanel>
                            <Button Content="📁 FILE OPERATIONS" Style="{StaticResource ModuleButtonFILE}" Click="ToggleFilePanel_Click" Margin="0,0,0,8"/>
                            <Border x:Name="FileContent" Visibility="Collapsed" Background="#FFFFFF" Padding="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveInvoiceCommand}" Padding="12,8"/>
                                        <Button Grid.Column="2" Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInvoiceCommand}" Padding="12,8"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewInvoiceCommand}" Padding="12,8"/>
                                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteInvoiceCommand}" Padding="12,8"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Export" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" Padding="12,8"/>
                                        <Button Grid.Column="2" Content="Import" Style="{StaticResource SecondaryButton}" Command="{Binding ImportCsvCommand}" Padding="12,8"/>
                                    </Grid>
                                    <Separator Margin="0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Preview" Style="{StaticResource SecondaryButton}" Command="{Binding PrintPreviewCommand}" Padding="12,8"/>
                                        <Button Grid.Column="2" Content="Print" Style="{StaticResource PrimaryButton}" Command="{Binding PrintInvoiceCommand}" Padding="12,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Module Selection Buttons -->
                    <StackPanel Margin="16">
                        <TextBlock Text="Module Selection" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="SGU" Style="{StaticResource ModuleButtonSGU}" Click="ToggleSGUPanel_Click"/>
                            <Button Grid.Column="2" Content="DGU" Style="{StaticResource ModuleButtonDGU}" Click="ToggleDGUPanel_Click"/>
                            <Button Grid.Column="4" Content="LAM" Style="{StaticResource ModuleButtonLAM}" Click="ToggleLAMPanel_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Calculation (collapsible): contains SGU / DGU / LAM panels -->
                    <Expander Header="Calculation" IsExpanded="False" Margin="8,0,8,8">
                        <StackPanel>
                            <!-- SGU Configuration Panel -->
                            <Border x:Name="SGUContent" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,8" Visibility="{Binding IsSGUSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SGU Configuration" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,0,10"/>
                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding SelectedThickness}" Style="{StaticResource FormComboBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding SelectedColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormComboBox}" StaysOpenOnEdit="True" Margin="0,0,0,10"/>
                            <TextBlock Text="Work Type" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton IsChecked="{Binding IsAnnealedSelected}" Content="Annealed" Margin="0,0,16,0"/>
                                <RadioButton IsChecked="{Binding IsFTSelected}" Content="FT Glass"/>
                            </StackPanel>
                            <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SGUSheetPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cutting" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding SGUCutting, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tempering" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding SGUTempering, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Waste Factor" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding SGUWasteFactor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Profit %" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding SGUProfitPercent, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                            <!-- DGU Configuration Panel -->
                            <Border x:Name="DGUContent" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,8" Visibility="{Binding IsDGUSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="DGU Configuration" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,10"/>
                            <TextBlock Text="Outer Glass" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUOuterThickness}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding DGUOuterColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormComboBox}" StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding DGUOuterPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Work Type" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton IsChecked="{Binding IsDGUAnnealedSelected}" Content="Annealed" Margin="0,0,16,0"/>
                                <RadioButton IsChecked="{Binding IsDGUFTSelected}" Content="FT Glass"/>
                            </StackPanel>
                            <TextBlock Text="Air Spacer" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding AirSpacerThicknessOptions}" SelectedItem="{Binding DGUAirSpacerThickness}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Type" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding AirSpacerTypeOptions}" SelectedItem="{Binding DGUAirSpacerType}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Auto Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding DGUASPPrice, Mode=OneWay}" IsReadOnly="True" Background="#DBEAFE" BorderBrush="#D1D5DB" BorderThickness="1" Padding="6,4" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#E8F4FD" BorderBrush="#B3D7F5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox IsChecked="{Binding IsDGUIncludeInSpec}" Content="Include U-Insert" FontSize="11" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="(Warm Edge Technology)" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="U-Insert improves thermal insulation by reducing heat transfer through the spacer." FontSize="9" Foreground="#6B7280" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Inner Glass" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUInnerThickness}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding DGUInnerColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormComboBox}" StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding DGUInnerPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Waste Factor" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding DGUWasteFactor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Profit %" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding DGUProfitPercent, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                            <!-- LAM Configuration Panel -->
                            <Border x:Name="LAMContent" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,8" Visibility="{Binding IsLAMSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="LAM Configuration" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED" Margin="0,0,0,10"/>
                            <TextBlock Text="Outer Glass" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMOuterThickness}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding LAMOuterColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormComboBox}" StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Work Type" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton IsChecked="{Binding IsLAMAnnealedSelected}" Content="Annealed" Margin="0,0,16,0"/>
                                <RadioButton IsChecked="{Binding IsLAMFTSelected}" Content="FT Glass"/>
                            </StackPanel>
                            <TextBlock Text="PVB Layer" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PVB Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox SelectedValue="{Binding LAMPVBThickness}" SelectedValuePath="Content" Style="{StaticResource FormComboBox}">
                                        <ComboBoxItem Content="0.38"/>
                                        <ComboBoxItem Content="0.76"/>
                                        <ComboBoxItem Content="1.14"/>
                                        <ComboBoxItem Content="1.52"/>
                                        <ComboBoxItem Content="2.28"/>
                                        <ComboBoxItem Content="3.04"/>
                                        <ComboBoxItem Content="Acoustic 0.76"/>
                                        <ComboBoxItem Content="Acoustic 1.52"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PVB Color" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox SelectedValue="{Binding LAMPVBColor}" SelectedValuePath="Content" Style="{StaticResource FormComboBox}">
                                        <ComboBoxItem Content="Clear"/>
                                        <ComboBoxItem Content="White"/>
                                        <ComboBoxItem Content="Black"/>
                                        <ComboBoxItem Content="Grey"/>
                                        <ComboBoxItem Content="Brown"/>
                                        <ComboBoxItem Content="Blue"/>
                                        <ComboBoxItem Content="Green"/>
                                        <ComboBoxItem Content="Red"/>
                                        <ComboBoxItem Content="EVA Clear"/>
                                        <ComboBoxItem Content="EVA White"/>
                                        <ComboBoxItem Content="EVA Black"/>
                                        <ComboBoxItem Content="Acoustic Clear"/>
                                        <ComboBoxItem Content="Acoustic White"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PVB Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Inner Glass" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thickness" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMInnerThickness}" Style="{StaticResource FormComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Color" FontSize="10" Foreground="#6B7280"/>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ColorHistory}" Text="{Binding LAMInnerColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormComboBox}" StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Price" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMInnerPrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cutting" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMCutting, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tempering" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMTempering, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Waste Factor" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Profit %" FontSize="10" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FormTextBox}" Padding="6,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Calculated Result -->
                    <Border Background="#1E3A8A" CornerRadius="6" Padding="16" Margin="16,8,16,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL PRICE" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="AED" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CalculatedPrice, Mode=OneWay, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Calculate Button -->
                    <Button Content="Calculate Price" Style="{StaticResource PrimaryButton}" Command="{Binding CalculatePriceCommand}" Padding="12,10" Margin="16,0,16,16"/>

                    <!-- Target Specification -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Target Specification" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10"/>
                            <TextBlock Text="Select spec to apply price" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Invoice.Specifications}" SelectedItem="{Binding SelectedTargetSpecification}" DisplayMemberPath="SpecificationName" Style="{StaticResource FormComboBox}" Margin="0,0,0,10"/>
                            <Button Content="Include in Spec" Style="{StaticResource PrimaryButton}" Command="{Binding IncludeInSpecificationCommand}" Padding="12,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimization Panel -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16">
                        <StackPanel>
                            <Button Content="⚙ OPTIMIZATION" Style="{StaticResource ModuleButtonOPT}" Click="ToggleOptPanel_Click" Margin="0,0,0,8"/>
                            <Border x:Name="OptContent" Visibility="Collapsed" Background="#FFFFFF" Padding="0,8,0,0">
                                <opt:GlassOptimizationPanel/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Recent Invoices -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16">
                        <StackPanel>
                            <Button Content="📋 RECENT INVOICES" Style="{StaticResource ModuleButtonSUMMARY}" Click="ToggleRecentInvoices_Click" Margin="0,0,0,8"/>
                            <Border x:Name="RecentInvoicesContent" Visibility="Collapsed" Background="#FFFFFF" Padding="0,8,0,0">
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding SavedFiles}" 
                                            Background="#FFFFFF" 
                                            BorderThickness="1" 
                                            BorderBrush="#E5E7EB" 
                                            MaxHeight="200"
                                            VirtualizingStackPanel.IsVirtualizing="True"
                                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                                            ScrollViewer.CanContentScroll="True">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding InvoiceNo}" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                                                        <TextBlock Text="{Binding CustomerName}" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding DateDisplay}" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="{Binding HasSavedFiles, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="No saved invoices" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>