                        <TextBlock Text="📋 RECENT INVOICES" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedFiles}" Background="#FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#00B4D8" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8F4F8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InvoiceNo}" FontSize="10" FontWeight="Bold" Foreground="#023E8A" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource IndustrialFont}"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="9" Foreground="#0077B6" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontFamily="{StaticResource IndustrialFont}"/>
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="8" Foreground="#00B4D8" Margin="0,3,0,0" FontFamily="{StaticResource IndustrialFont}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasSavedFiles, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="📂" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No saved invoices" FontSize="9" Foreground="#0077B6" HorizontalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>