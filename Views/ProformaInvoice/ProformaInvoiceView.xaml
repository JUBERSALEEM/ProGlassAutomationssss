                <StackPanel Margin="8">

                    <!-- MODULE SELECTION -->
                    <Border Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="#1A1A1A" Padding="8,5">
                                <TextBlock Text="MODULE SELECTION" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SelectSGUCommand}" Cursor="Hand" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,8">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="SGU" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1A1A1A"/>
                                                    <TextBlock Text="Single Glass" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#D0D0D0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding SelectDGUCommand}" Cursor="Hand" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,8">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="DGU" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1A1A1A"/>
                                                    <TextBlock Text="Double Glass" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
