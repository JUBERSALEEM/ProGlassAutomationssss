                                                        <Button Grid.Column="5" Content="👁" FontSize="9" Cursor="Hand" Padding="4,2" Background="Transparent" BorderThickness="0" ToolTip="Toggle LM" Click="ToggleLM_Click" VerticalAlignment="Center"/>
