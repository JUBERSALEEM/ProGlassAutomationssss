                                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Invoice.Specifications, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding LinkedSpecIndex, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="SpecIndex" DisplayMemberPath="SpecificationName" Style="{StaticResource IndComboBox}" Margin="0,0,4,0" FontSize="9"/>

                                                <Border Grid.Column="3" Background="#E0E0E0" Padding="4,2" Margin="0,0,4,0">
