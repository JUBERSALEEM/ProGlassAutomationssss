                                            <TextBlock Text="Spacer" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="6mm" IsSelected="True"/>
                                                <ComboBoxItem Content="8mm"/>
                                                <ComboBoxItem Content="10mm"/>
                                                <ComboBoxItem Content="12mm"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ASP Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding DGUASPPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inner Glass -->
                                    <TextBlock Text="Inner Glass" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding DGUInnerThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="Clear" IsSelected="True"/>
                                                <ComboBoxItem Content="Grey"/>
                                                <ComboBoxItem Content="Green"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding DGUInnerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Waste & Profit -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding DGUWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Profit %" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding DGUProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== -->
                            <!-- LAM SECTION -->
                            <!-- ==================== -->
                            <Border Background="{StaticResource PrimaryBlueLight}" CornerRadius="12" Padding="14" Margin="0,0,0,8" BorderBrush="#BFDBFE" BorderThickness="1" Visibility="{Binding IsLAMSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- Outer Glass -->
                                    <TextBlock Text="Outer Glass" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMOuterThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="Clear" IsSelected="True"/>
                                                <ComboBoxItem Content="Grey"/>
                                                <ComboBoxItem Content="Green"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- PVB Interlayer -->
                                    <TextBlock Text="PVB Interlayer" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PVB Thickness" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="0.38mm"/>
                                                <ComboBoxItem Content="0.76mm"/>
                                                <ComboBoxItem Content="1.14mm"/>
                                                <ComboBoxItem Content="1.52mm" IsSelected="True"/>
                                                <ComboBoxItem Content="2.28mm"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PVB Color" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="Clear" IsSelected="True"/>
                                                <ComboBoxItem Content="White"/>
                                                <ComboBoxItem Content="Grey"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="PVB Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inner Glass -->
                                    <TextBlock Text="Inner Glass" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thickness" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding LAMInnerThickness}" Style="{StaticResource SmallComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="Clear" IsSelected="True"/>
                                                <ComboBoxItem Content="Grey"/>
                                                <ComboBoxItem Content="Green"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMInnerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Additional Costs -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cutting (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMCutting, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tempering (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMTempering, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Profit -->
                                    <TextBlock Text="Profit %" Style="{StaticResource SmallLabelStyle}"/>
                                    <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}" Margin="0,0,0,12"/>
                                </StackPanel>
                            </Border>

                            <!-- ==================== -->
                            <!-- CALCULATION RESULT -->
                            <!-- ==================== -->
                            <Border Background="{StaticResource SuccessGreenLight}" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="GENERATED SPECIFICATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding GeneratedDescription}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CALCULATED PRICE (AED/SQM)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CalculatedPrice, StringFormat='AED {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                            <TextBlock Text="{Binding PriceCalculationSummary}" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ==================== -->
                            <!-- ACTION BUTTONS -->
                            <!-- ==================== -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="🧮 GENERATE" Command="{Binding CalculatePriceCommand}" Padding="12,10"/>
                                <Button Grid.Column="2" Style="{StaticResource SuccessButtonStyle}" Content="✓ INCLUDE IN SPEC" Command="{Binding IncludeInSpecificationCommand}" Padding="12,10"/>
                            </Grid>

                            <!-- ==================== -->
                            <!-- TARGET SPECIFICATION SELECTOR -->
                            <!-- ==================== -->
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="TARGET SPECIFICATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding Invoice.Specifications}" SelectedItem="{Binding SelectedTargetSpecification}" Style="{StaticResource SmallComboBoxStyle}" DisplayMemberPath="SpecificationName"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ==================== -->
                    <!-- RECENT INVOICES CARD -->
                    <!-- ==================== -->
                    <Border Background="White" CornerRadius="16" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.04" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBlueLight}" CornerRadius="8" Padding="8,6" Margin="0,0,10,0">
                                    <TextBlock Text="📋" FontSize="14"/>
                                </Border>
                                <TextBlock Text="RECENT INVOICES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDark}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SavedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFC" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.LoadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding FilePath}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding InvoiceNo}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding InvoiceDate, StringFormat='dd MMM yyyy'}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="→" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>