                                                </Border>

                                                <TextBox Grid.Column="4" Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,4,0" Padding="4,2" FontSize="9" TextAlignment="Center" GotFocus="TextBox_GotFocus" MouseLeftButtonDown="TextBox_PreviewMouseDown"/>

                                                <Border Grid.Column="5" Background="#1A1A1A" Padding="4,2">
