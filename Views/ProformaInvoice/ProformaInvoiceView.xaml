                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="INVOICE SUMMARY" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT - Quantities -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="QUANTITIES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDark}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total SQM" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="11" FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total LM" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalLM, Mode=OneWay, StringFormat=N4}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Qty" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalQty, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT - Amounts -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="AMOUNTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDark}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sub Total" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.GrandTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="11" FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VAT (5%)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.VatAmount, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="11"/>
                                    </Grid>

                                    <Separator Margin="0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="NET TOTAL" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= TERMS & CONDITIONS ================= -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Header -->
                        <Border Background="{StaticResource SuccessGreen}" Padding="12" CornerRadius="12,12,0,0" Margin="-16,-16,-16,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="TERMS &amp; CONDITIONS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="• Prices in AED (UAE Dirhams)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• Quote valid for 30 days from invoice date" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• 5% VAT included in all prices" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• Payment terms: As per agreement" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= FOOTER ================= -->
                <Border Background="{StaticResource PrimaryBlueDark}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Thank you for your business!" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== CENTER - SPECS & PRICE GENERATOR ==================== -->
