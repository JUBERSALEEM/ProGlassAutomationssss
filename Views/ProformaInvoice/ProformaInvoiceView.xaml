<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#E8F4F8">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- OCEAN THEME COLORS -->
        <SolidColorBrush x:Key="OceanDark" Color="#023E8A"/>
        <SolidColorBrush x:Key="OceanMedium" Color="#0077B6"/>
        <SolidColorBrush x:Key="OceanLight" Color="#00B4D8"/>
        <SolidColorBrush x:Key="OceanPale" Color="#90E0EF"/>
        <SolidColorBrush x:Key="OceanBg" Color="#CAF0F8"/>
        <SolidColorBrush x:Key="DarkHeader" Color="#023E8A"/>
        <SolidColorBrush x:Key="DarkSecondary" Color="#0077B6"/>
        <SolidColorBrush x:Key="LightGray" Color="#ADE8F4"/>
        <SolidColorBrush x:Key="MediumGray" Color="#48CAE4"/>
        <SolidColorBrush x:Key="WhiteBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2D9E32"/>
        <SolidColorBrush x:Key="AccentRed" Color="#D62828"/>

        <!-- INDUSTRIAL FONT - Segoe UI for professional look -->
        <FontFamily x:Key="IndustrialFont">Segoe UI, Arial, sans-serif</FontFamily>

        <!-- INDUSTRIAL BUTTON STYLE - Ocean Theme -->
        <Style x:Key="IndButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#023E8A"/>
            <Setter Property="BorderBrush" Value="#0077B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0077B6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#023E8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndButtonPrimary" TargetType="Button" BasedOn="{StaticResource IndButton}">
            <Setter Property="Background" Value="#023E8A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#023E8A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0077B6"/>
                    <Setter Property="BorderBrush" Value="#0077B6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndButtonSuccess" TargetType="Button" BasedOn="{StaticResource IndButton}">
            <Setter Property="Background" Value="#00B4D8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00B4D8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0096C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndButtonDanger" TargetType="Button" BasedOn="{StaticResource IndButton}">
            <Setter Property="Background" Value="#D62828"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D62828"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E63946"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- INDUSTRIAL TEXTBOX - Ocean Theme with GotFocus -->
        <Style x:Key="IndTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0077B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Setter Property="Foreground" Value="#023E8A"/>
            <Setter Property="CaretBrush" Value="#023E8A"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#023E8A"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INDUSTRIAL DATAGRID - Ocean Theme -->
        <Style x:Key="IndDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#023E8A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#0077B6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="IndDataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#ADE8F4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#90E0EF"/>
                    <Setter Property="Foreground" Value="#023E8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndDataGridRow" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#ADE8F4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E8F4F8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#90E0EF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- INDUSTRIAL COMBOBOX -->
        <Style x:Key="IndComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0077B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Setter Property="Foreground" Value="#023E8A"/>
        </Style>

        <!-- LABEL -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
            <Setter Property="Foreground" Value="#0077B6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT - PROFORMA INVOICE ==================== -->
        <Border Grid.Column="0" Background="#E8F4F8" Margin="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- HEADER BAR -->
                    <Border Background="#023E8A" Padding="12,10" Margin="0,0,0,6" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="PROFORMA INVOICE" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="NEW" Style="{StaticResource IndButton}" Command="{Binding NewInvoiceCommand}" Padding="10,5" Margin="0,0,4,0"/>
                                <Button Content="SAVE" Style="{StaticResource IndButtonPrimary}" Command="{Binding SaveInvoiceCommand}" Padding="10,5" Margin="0,0,4,0"/>
                                <Button Content="OPEN" Style="{StaticResource IndButton}" Command="{Binding OpenInvoiceCommand}" Padding="10,5" Margin="0,0,4,0"/>
                                <Button Content="PREVIEW" Style="{StaticResource IndButton}" Click="PrintPreview_Click" Padding="10,5" Margin="0,0,4,0"/>
                                <Button Content="PRINT" Style="{StaticResource IndButton}" Click="PrintInvoice_Click" Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- COMPANY DETAILS -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                <TextBlock Text="🏢 COMPANY DETAILS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                            </Border>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="COMPANY NAME" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TRN NUMBER" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CompanyTRN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="LOCATION" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- INVOICE INFO -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                <TextBlock Text="📄 INVOICE INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                            </Border>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="INVOICE NO" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding Invoice.InvoiceDate}" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="VALID UNTIL" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding Invoice.ValidUntil}" Padding="6,4"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CUSTOMER & PROJECT -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Customer -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                    <TextBlock Text="👤 CUSTOMER DETAILS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                                </Border>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="COMPANY NAME *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.CustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,0,6"/>
                                    <TextBlock Text="TRN NUMBER" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.CustomerTRN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,0,6"/>
                                    <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.CustomerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="40"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Project -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                    <TextBlock Text="🏗️ PROJECT DETAILS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                                </Border>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="PROJECT NAME *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.ProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,0,6"/>
                                    <TextBlock Text="LOCATION *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.ProjectLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Other -->
                        <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                    <TextBlock Text="📞 OTHER DETAILS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                                </Border>
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="LPO NO." Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.LPONo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,0,6"/>
                                    <TextBlock Text="ATTENTION" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.AttentionName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}" Margin="0,0,0,6"/>
                                    <TextBlock Text="CONTACT NO." Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Invoice.ContactNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndTextBox}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SPECIFICATIONS -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#023E8A" Padding="10,6" CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="SPECIFICATIONS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ ADD" Style="{StaticResource IndButtonSuccess}" Command="{Binding AddSpecificationCommand}" Padding="12,5" Margin="0,0,6,0"/>
                                        <Button Content="- REMOVE" Style="{StaticResource IndButtonDanger}" Command="{Binding RemoveSpecificationCommand}" Padding="12,5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Specifications List -->
                            <ItemsControl ItemsSource="{Binding Invoice.Specifications}" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#00B4D8" BorderThickness="2" Margin="0,0,0,10" CornerRadius="6" Background="#FFFFFF">
                                            <StackPanel>
                                                <!-- Spec Header - CORRECTED -->
                                                <Border Background="#E8F4F8" Padding="10,8" CornerRadius="6,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="SPEC:" FontSize="12" FontWeight="Bold" Foreground="#023E8A" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{StaticResource IndustrialFont}"/>

                                                        <!-- TextBox WITHOUT CornerRadius -->
                                                        <TextBox Grid.Column="1" 
                 Text="{Binding SpecificationName, UpdateSourceTrigger=PropertyChanged}" 
                 Background="#FFFFFF" 
                 FontSize="13" 
                 FontWeight="SemiBold" 
                 MinWidth="120" 
                 Padding="8,6" 
                 VerticalAlignment="Center" 
                 BorderBrush="#0077B6" 
                 BorderThickness="1"
                 FontFamily="{StaticResource IndustrialFont}"/>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                                                            <TextBlock Text="BASE:" FontSize="12" FontWeight="Bold" Foreground="#023E8A" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="{StaticResource IndustrialFont}"/>

                                                            <!-- TextBox WITHOUT CornerRadius -->
                                                            <TextBox Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                     Width="90" 
                     Padding="8,6" 
                     FontSize="13" 
                     Background="#E8F4F8" 
                     FontWeight="Bold" 
                     BorderBrush="#0077B6" 
                     BorderThickness="1"
                     GotFocus="TextBox_GotFocus" 
                     MouseLeftButtonDown="TextBox_PreviewMouseDown" 
                     FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                                                            <TextBlock Text="SUR%:" FontSize="12" FontWeight="Bold" Foreground="#023E8A" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="{StaticResource IndustrialFont}"/>

                                                            <!-- TextBox WITHOUT CornerRadius -->
                                                            <TextBox Text="{Binding SurchargePercent, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" 
                     Width="70" 
                     Padding="8,6" 
                     FontSize="13" 
                     Background="#E8F4F8" 
                     FontWeight="Bold" 
                     BorderBrush="#0077B6" 
                     BorderThickness="1"
                     GotFocus="TextBox_GotFocus" 
                     MouseLeftButtonDown="TextBox_PreviewMouseDown" 
                     FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="4" Content="+ ROW" Style="{StaticResource IndButtonPrimary}" Click="AddRow_Click" Tag="{Binding}" Padding="12,6"/>
                                                    </Grid>
                                                </Border>

                                                <!-- DataGrid -->
                                                <DataGrid ItemsSource="{Binding Items}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      BorderThickness="0" 
                                      Background="#FFFFFF" 
                                      Margin="0" 
                                      Padding="0"
                                      ColumnHeaderStyle="{StaticResource IndDataGridHeader}" 
                                      CellStyle="{StaticResource IndDataGridCell}" 
                                      RowStyle="{StaticResource IndDataGridRow}" 
                                      GridLinesVisibility="All" 
                                      HorizontalGridLinesBrush="#ADE8F4" 
                                      VerticalGridLinesBrush="#ADE8F4" 
                                      HeadersVisibility="Column" 
                                      RowHeight="32" 
                                      MinHeight="64" 
                                      SelectionUnit="Cell" 
                                      AlternationCount="2" 
                                      FocusVisualStyle="{x:Null}" 
                                      PreviewKeyDown="DataGrid_PreviewKeyDown"
                                      HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="50" IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Background" Value="#E8F4F8"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="GLASS REF" Binding="{Binding GlassRef, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Padding" Value="8,0"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="Padding" Value="6,0"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="W1" Binding="{Binding Width1, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="H1" Binding="{Binding Height1, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="W2" Binding="{Binding Width2, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="H2" Binding="{Binding Height2, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="QTY" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="60">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                            <DataGridTextColumn.EditingElementStyle>
                                                                <Style TargetType="TextBox">
                                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.EditingElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="SQM" Binding="{Binding SQM, Mode=OneWay, StringFormat=N4}" Width="85" IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Background" Value="#90E0EF"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="TOTAL SQM" Binding="{Binding TotalSQM, Mode=OneWay, StringFormat=N4}" Width="95" IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Background" Value="#00B4D8"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="PRICE" Binding="{Binding DisplayPrice, Mode=OneWay, StringFormat=N2}" Width="90" IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Foreground" Value="#023E8A"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, Mode=OneWay, StringFormat=N2}" Width="100" IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Padding" Value="0,0,6,0"/>
                                                                    <Setter Property="Background" Value="#90E0EF"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Setter Property="FontFamily" Value="{StaticResource IndustrialFont}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTemplateColumn Header="" Width="45">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="✕" 
                                                        FontSize="13" 
                                                        FontWeight="Bold" 
                                                        Foreground="#D62828" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Cursor="Hand" 
                                                        Padding="0" 
                                                        Click="DeleteRow_Click" 
                                                        Tag="{Binding}" 
                                                        HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center" 
                                                        Focusable="False"
                                                        FontFamily="{StaticResource IndustrialFont}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <!-- Spec Totals -->
                                                <Border Background="#023E8A" Padding="12,8" CornerRadius="0,0,6,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="SPEC TOTAL" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                                                            <TextBlock Text="Qty:" FontSize="12" Foreground="#90E0EF" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                            <TextBlock Text="{Binding SpecTotalQty, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                                                            <TextBlock Text="SQM:" FontSize="12" Foreground="#90E0EF" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                            <TextBlock Text="{Binding SpecTotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                                                            <TextBlock Text="LM:" FontSize="12" Foreground="#90E0EF" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                            <TextBlock Text="{Binding SpecTotalLM, Mode=OneWay, StringFormat=N4}" FontSize="12" FontWeight="Bold" Foreground="#00B4D8" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                            <TextBlock Text="AED:" FontSize="12" Foreground="#90E0EF" Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                            <TextBlock Text="{Binding SpecTotalPrice, Mode=OneWay, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="#00B4D8" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- OTHER CHARGES -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#0077B6" Padding="10,6" CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="OTHER CHARGES" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ ADD" Style="{StaticResource IndButtonSuccess}" Command="{Binding AddOtherChargeCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Add new charge to selected spec"/>
                                        <Button Content="+ SPEC" Style="{StaticResource IndButton}" Command="{Binding AddSpecToChargeCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Add spec to selected charge"/>
                                        <Button Content="- SPEC" Style="{StaticResource IndButton}" Command="{Binding RemoveSpecFromChargeCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Remove spec from selected charge"/>
                                        <Button Content="⟳ TOGGLE" Style="{StaticResource IndButton}" Command="{Binding ToggleSpecForChargeCommand}" Padding="8,4" ToolTip="Toggle specs for selected charge"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Charges Header -->
                            <Grid Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CHARGE" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="LINKED SPECS" FontSize="9" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Comma-separated spec indices"/>
                                <TextBlock Grid.Column="3" Text="SPEC" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="VALUE" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="RATE" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="AMOUNT" FontSize="10" FontWeight="Bold" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Charges List -->
                            <ItemsControl ItemsSource="{Binding SelectedSpecificationOtherCharges}" Margin="10,0,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#00B4D8" BorderThickness="1" Padding="6,4" Margin="0,0,0,4" Background="#F0F9FF" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Charge Name -->
                                                <TextBox Grid.Column="0" 
             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
             Style="{StaticResource IndTextBox}" 
             Margin="0,0,3,0" 
             Padding="4,3" 
             FontSize="9" 
             GotFocus="TextBox_GotFocus" 
             MouseLeftButtonDown="TextBox_PreviewMouseDown" 
             FontFamily="{StaticResource IndustrialFont}"/>

                                                <!-- Charge Type Dropdown -->
                                                <ComboBox Grid.Column="1" 
              ItemsSource="{Binding DataContext.ChargeTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" 
              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" 
              SelectedValuePath="Value" 
              DisplayMemberPath="Label" 
              Style="{StaticResource IndComboBox}" 
              Margin="0,0,3,0" 
              FontSize="9" 
              FontFamily="{StaticResource IndustrialFont}"/>

                                                <!-- Linked Specs (comma-separated indices) -->
                                                <Border Grid.Column="2" Background="#E8F4F8" BorderBrush="#0077B6" BorderThickness="1" Padding="4,2" Margin="0,0,3,0" CornerRadius="2">
                                                    <TextBox Text="{Binding LinkedSpecIndices, UpdateSourceTrigger=PropertyChanged}" 
                 Background="Transparent" 
                 BorderThickness="0" 
                 FontSize="9" 
                 FontWeight="Bold" 
                 Foreground="#023E8A" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center" 
                 GotFocus="TextBox_GotFocus"
                 ToolTip="Enter comma-separated spec indices (e.g., 0,1,2)"
                 FontFamily="{StaticResource IndustrialFont}"/>
                                                </Border>

                                                <!-- Spec Dropdown (Short Names) -->
                                                <ComboBox Grid.Column="3" 
              ItemsSource="{Binding DataContext.Invoice.Specifications, RelativeSource={RelativeSource AncestorType=UserControl}}" 
              SelectedValue="{Binding LinkedSpecIndex, UpdateSourceTrigger=PropertyChanged}" 
              SelectedValuePath="SpecIndex" 
              Style="{StaticResource IndComboBox}" 
              Margin="0,0,3,0" 
              FontSize="9" 
              FontFamily="{StaticResource IndustrialFont}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ShortName}" FontSize="9" FontFamily="{StaticResource IndustrialFont}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- Value Display -->
                                                <Border Grid.Column="4" Background="#90E0EF" Padding="3,2" Margin="0,0,3,0" CornerRadius="2">
                                                    <TextBlock Text="{Binding ValueDisplay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                </Border>

                                                <!-- Rate Input -->
                                                <TextBox Grid.Column="5" 
             Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" 
             Style="{StaticResource IndTextBox}" 
             Margin="0,0,3,0" 
             Padding="3,2" 
             FontSize="10" 
             TextAlignment="Center" 
             GotFocus="TextBox_GotFocus" 
             MouseLeftButtonDown="TextBox_PreviewMouseDown" 
             FontFamily="{StaticResource IndustrialFont}"/>

                                                <!-- Amount Display -->
                                                <Border Grid.Column="6" Background="#023E8A" Padding="4,2" CornerRadius="2">
                                                    <TextBlock Text="{Binding AmountDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                                </Border>

                                                <!-- Delete Button -->
                                                <Button Grid.Column="7" 
            Content="✕" 
            FontSize="11" 
            FontWeight="Bold" 
            Foreground="#D62828" 
            Background="Transparent" 
            BorderThickness="0" 
            Cursor="Hand" 
            Padding="2" 
            VerticalAlignment="Center" 
            Command="{Binding DataContext.RemoveOtherChargeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            CommandParameter="{Binding}" 
            FontFamily="{StaticResource IndustrialFont}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- INVOICE SUMMARY -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#023E8A" Padding="8,5" CornerRadius="4,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="INVOICE SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Quantities -->
                                <Border Grid.Column="0" Background="#E8F4F8" BorderBrush="#00B4D8" BorderThickness="1" Padding="10" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="📐 QUANTITIES" FontSize="10" FontWeight="Bold" Foreground="#023E8A" Margin="0,0,0,8" FontFamily="{StaticResource IndustrialFont}"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total SQM" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="11" FontWeight="Bold" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total LM" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalLM, Mode=OneWay, StringFormat=N4}" FontSize="11" FontWeight="Bold" Foreground="#00B4D8" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total Qty" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalQty, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Amounts -->
                                <Border Grid.Column="2" Background="#E8F4F8" BorderBrush="#00B4D8" BorderThickness="1" Padding="10" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="💵 AMOUNTS" FontSize="10" FontWeight="Bold" Foreground="#023E8A" Margin="0,0,0,8" FontFamily="{StaticResource IndustrialFont}"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sub Total" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.GrandTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="11" FontWeight="Bold" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="VAT (5%)" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.VatAmount, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="11" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>

                                        <Separator Margin="0,4"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="NET TOTAL" FontSize="14" FontWeight="Bold" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.NetTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#00B4D8" FontFamily="{StaticResource IndustrialFont}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TERMS -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#0077B6" Padding="8,5" CornerRadius="4,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="TERMS &amp; CONDITIONS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="• Prices in AED (UAE Dirhams)" FontSize="10" Foreground="#0077B6" Margin="0,0,0,4" FontFamily="{StaticResource IndustrialFont}"/>
                                <TextBlock Text="• Quote valid for 30 days from invoice date" FontSize="10" Foreground="#0077B6" Margin="0,0,0,4" FontFamily="{StaticResource IndustrialFont}"/>
                                <TextBlock Text="• 5% VAT included in all prices" FontSize="10" Foreground="#0077B6" Margin="0,0,0,4" FontFamily="{StaticResource IndustrialFont}"/>
                                <TextBlock Text="• Payment terms: As per agreement" FontSize="10" Foreground="#0077B6" FontFamily="{StaticResource IndustrialFont}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FOOTER -->
                    <Border Background="#023E8A" Padding="12,8" CornerRadius="4">
                        <TextBlock Text="🏭 PROGLASS AUTOMATION | Dubai, UAE" FontSize="10" Foreground="#90E0EF" HorizontalAlignment="Center" FontFamily="{StaticResource IndustrialFont}"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== CENTER - MODULE SELECTION & PRICE GENERATOR ==================== -->
        <Border Grid.Column="1" Background="#CAF0F8" BorderBrush="#0077B6" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">

                    <!-- MODULE SELECTION -->
                    <Border Background="#FFFFFF" BorderBrush="#0077B6" BorderThickness="1" Margin="0,0,0,6" CornerRadius="4">
                        <StackPanel>
                            <Border Background="#023E8A" Padding="8,5" CornerRadius="4,4,0,0">
                                <TextBlock Text="🔧 MODULE SELECTION" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource IndustrialFont}"/>
                            </Border>
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SelectSGUCommand}" Cursor="Hand" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#E8F4F8" BorderBrush="#0077B6" BorderThickness="1" Padding="8,10" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="SGU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                                    <TextBlock Text="Single Glass" FontSize="9" Foreground="#0077B6" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{StaticResource IndustrialFont}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0077B6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding SelectDGUCommand}" Cursor="Hand" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#E8F4F8" BorderBrush="#0077B6" BorderThickness="1" Padding="8,10" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="DGU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                                    <TextBlock Text="Double Glass" FontSize="9" Foreground="#0077B6" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{StaticResource IndustrialFont}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0077B6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="4" Command="{Binding SelectLAMCommand}" Cursor="Hand" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#E8F4F8" BorderBrush="#0077B6" BorderThickness="1" Padding="8,10" CornerRadius="4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="LAM" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#023E8A" FontFamily="{StaticResource IndustrialFont}"/>
                                                    <TextBlock Text="Laminated" FontSize="9" Foreground="#0077B6" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{StaticResource IndustrialFont}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0077B6"/>
