                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total Qty" FontSize="11" Foreground="#333333"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.TotalQty, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Amounts -->
                                <Border Grid.Column="2" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="AMOUNTS" FontSize="9" FontWeight="Bold" Foreground="#666666" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sub Total" FontSize="11" Foreground="#333333"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice.GrandTotal, Mode=OneWay, StringFormat='AED {0:N2}'}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
