                                            <TextBox Text="{Binding LAMOuterPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="PVB Layer" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PVB Thickness" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="0.76mm" IsSelected="True"/>
                                                <ComboBoxItem Content="1.52mm"/>
                                                <ComboBoxItem Content="2.28mm"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Color" Style="{StaticResource SmallLabelStyle}"/>
                                            <ComboBox Style="{StaticResource SmallComboBoxStyle}">
                                                <ComboBoxItem Content="Clear" IsSelected="True"/>
                                                <ComboBoxItem Content="White"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Price (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMPVBPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Inner Glass" Style="{StaticResource SmallLabelStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cutting (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMCutting, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tempering (AED)" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMTempering, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Waste Factor" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMWasteFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Profit %" Style="{StaticResource SmallLabelStyle}"/>
                                            <TextBox Text="{Binding LAMProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallInputStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Generated Output -->
                            <Border Background="{StaticResource SuccessGreenLight}" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#6EE7B7" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="GENERATED DESCRIPTION" FontSize="8" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GeneratedDescription, Mode=OneWay}" IsReadOnly="True" Background="White" BorderBrush="#A7F3D0" FontSize="9" FontWeight="SemiBold" Padding="6,4"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CALCULATED PRICE (AED)" FontSize="8" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,4"/>
                                            <Border Background="White" CornerRadius="6" Padding="8,6" BorderBrush="#A7F3D0" BorderThickness="1">
                                                <TextBlock Text="{Binding CalculatedPrice, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                            <Button Style="{StaticResource SuccessButtonStyle}" Content="GENERATE" Command="{Binding CalculatePriceCommand}" Padding="12,8" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding PriceCalculationSummary}" FontSize="7" Foreground="#166534" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>

                            <!-- Target Specification -->
                            <TextBlock Text="TARGET SPECIFICATION" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Invoice.Specifications}" SelectedItem="{Binding SelectedTargetSpecification}" DisplayMemberPath="SpecificationName" Style="{StaticResource SmallComboBoxStyle}" Margin="0,0,0,8"/>

                            <!-- Include Button -->
                            <Button Style="{StaticResource SuccessButtonStyle}" Content="INCLUDE IN SPEC" Command="{Binding IncludeInSpecificationCommand}" Padding="10,8" FontSize="10"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== RIGHT - FILE MANAGEMENT ==================== -->
        <Border Grid.Column="2" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Management Card -->
                <Border Grid.Row="0" Background="White" CornerRadius="0" Padding="10" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource PrimaryBlueLight}" CornerRadius="6" Padding="5,3" Margin="0,0,6,0">
                                <TextBlock Text="📁" FontSize="11"/>
                            </Border>
                            <TextBlock Text="FILE MANAGEMENT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueDark}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="SAVE" Command="{Binding SaveInvoiceCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="OPEN" Command="{Binding OpenInvoiceCommand}" Padding="6,6"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="NEW" Command="{Binding NewInvoiceCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="DELETE" Padding="6,6"/>
                        </Grid>

                        <Separator Margin="0,6"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="EXPORT" Command="{Binding ExportCsvCommand}" Padding="6,6"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="IMPORT" Command="{Binding ImportCsvCommand}" Padding="6,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Invoices -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PrimaryBlueDark}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="RECENT INVOICES" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedFiles}" Background="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InvoiceNo}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueDark}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="8" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="7" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding SavedFiles.Count, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}">
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No saved invoices" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>