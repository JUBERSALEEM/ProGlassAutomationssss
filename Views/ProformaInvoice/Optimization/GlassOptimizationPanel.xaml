<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Optimization.GlassOptimizationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Optimization">

    <UserControl.DataContext>
        <vm:GlassOptimizationSectionViewModel/>
    </UserControl.DataContext>

    <Border Background="#F8FAFC" CornerRadius="12" Padding="20">
        <StackPanel>
            <!-- Header -->
            <Border Background="#1E3A5F" CornerRadius="12" Padding="20" Margin="-20,-20,-20,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Glass Optimization" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="(Price × 100 ÷ SQM) − (Price ÷ 0.85)" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddSheetCommand}" 
                            Background="#10B981" Foreground="White" Padding="16,8" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Sheets -->
            <ItemsControl ItemsSource="{Binding Sheets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Row 1: Badge + Price + SQM -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sheet Circle Badge -->
                                    <Border Grid.Column="0" Background="#E0E7FF" CornerRadius="25" Width="50" Height="50" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding SheetName}" FontSize="12" FontWeight="Bold" Foreground="#3730A3" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Price Input -->
                                    <StackPanel Grid.Column="1" Margin="6,0">
                                        <TextBlock Text="SHEET PRICE" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="25"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="AED" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" 
                                                        FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" 
                                                        Background="Transparent" BorderThickness="0" 
                                                        VerticalContentAlignment="Center" Padding="4,8"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- SQM Input -->
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="UTILIZATION (SQM)" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,0">
                                            <TextBox Text="{Binding OptimizationText, UpdateSourceTrigger=PropertyChanged}" 
                                                    FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" 
                                                    Background="Transparent" BorderThickness="0" 
                                                    VerticalContentAlignment="Center" Padding="8,8"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Results -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Result 1 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="RESULT 1" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <Border Background="#ECFDF5" CornerRadius="8" BorderBrush="#86EFAC" BorderThickness="1" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="AED " FontSize="12" Foreground="#059669" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Result1Text}" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Result 2 -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="RESULT 2" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <Border Background="#FEF2F2" CornerRadius="8" BorderBrush="#FCA5A5" BorderThickness="1" Padding="12,10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="AED " FontSize="12" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Result2Text}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Base Result Card -->
            <Border Background="#059669" CornerRadius="12" Padding="24,20" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="BASE RESULT" FontSize="13" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                        <TextBlock Text="Result 1 − Result 2" FontSize="11" Foreground="#6EE7B7" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TotalBaseResultText, StringFormat='AED {0:N2}'}" 
                               Foreground="White" FontSize="28" FontWeight="Bold"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>