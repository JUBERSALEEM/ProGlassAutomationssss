<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F1F5F9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ==================== MAIN DATA GRID STYLE ==================== -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ==================== CELL STYLE ==================== -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== ROW STYLE ==================== -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== COLUMN HEADER STYLE ==================== -->
        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#1E3A8A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- ==================== STATS CARD STYLE ==================== -->
        <Style x:Key="StatsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ==================== TEXT STYLES ==================== -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellTextBold" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellDate" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellCompany" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellAmount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0891B2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- ==================== BUTTON STYLES ==================== -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonNew" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButtonRefresh" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Background" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickFilterBtn" TargetType="Button">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnView" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <Style x:Key="BtnEdit" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>

        <Style x:Key="BtnDelete" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <Style x:Key="BtnJO" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#8B5CF6"/>
        </Style>

        <Style x:Key="FilterCombobox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FilterCheckbox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER SECTION ==================== -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="#1E40AF" CornerRadius="10" Padding="20,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#1E40AF"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,14,0">
                        <TextBlock Text="📄" FontSize="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PROFORMA INVOICES" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#FEF9C3" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Create, Track and Manage Invoices" FontSize="12" Foreground="#BFDBFE" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Filters & Search -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Quick Filters -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Button Content="Today" Style="{StaticResource QuickFilterBtn}" Command="{Binding QuickFilterTodayCommand}"/>
                        <Button Content="Week" Style="{StaticResource QuickFilterBtn}" Command="{Binding QuickFilterThisWeekCommand}"/>
                        <Button Content="Month" Style="{StaticResource QuickFilterBtn}" Command="{Binding QuickFilterThisMonthCommand}"/>
                        <Button Content="Year" Style="{StaticResource QuickFilterBtn}" Command="{Binding QuickFilterThisYearCommand}"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Border Background="White" CornerRadius="6" Padding="4" MinWidth="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#3B82F6" CornerRadius="4" Padding="8,6" Margin="2">
                                <TextBlock Text="🔍" FontSize="14"/>
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                    BorderThickness="0" VerticalAlignment="Center" Padding="8,6" FontSize="13" Background="Transparent"
                                    GotFocus="SearchTextBox_GotFocus"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ New" Style="{StaticResource HeaderButtonNew}" Command="{Binding NewInvoiceCommand}" Margin="0,0,6,0"/>
                    <Button Content="Export" Style="{StaticResource HeaderButton}" Command="{Binding ExportAllCommand}" Margin="0,0,6,0"/>
                    <Button Content="Refresh" Style="{StaticResource HeaderButtonRefresh}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== FILTER BAR ==================== -->
        <Border Grid.Row="1" Margin="0,0,0,12" Background="White" CornerRadius="10" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="CUSTOMER" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombobox}" ItemsSource="{Binding CustomerOptions}" 
                             SelectedValue="{Binding SelectedCustomer}" SelectedValuePath="Name" DisplayMemberPath="Name"/>
                </StackPanel>

                <!-- Salesman Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="SALESMAN" Style="{StaticResource FilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombobox}" ItemsSource="{Binding SalesmanOptions}" 
                             SelectedValue="{Binding SelectedSalesman}" SelectedValuePath="Name" DisplayMemberPath="Name"/>
                </StackPanel>

                <!-- Date Range -->
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="DATE RANGE" Style="{StaticResource FilterLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Width="100" Margin="0,0,6,0" Background="White" BorderBrush="#CBD5E1"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Width="100" Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>

                <!-- Clear Button -->
                <Button Grid.Column="4" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" 
                        Padding="16,10" Background="#EF4444" Foreground="White" FontWeight="SemiBold" 
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== DATA GRID ==================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding FilteredInvoices}" 
                      SelectedItem="{Binding SelectedInvoice}" 
                      Style="{StaticResource ModernDataGrid}" 
                      CellStyle="{StaticResource GridCell}" 
                      RowStyle="{StaticResource GridRow}"
                      BorderThickness="0"
                      AlternationCount="2"
                      MouseDoubleClick="DataGrid_MouseDoubleClick" 
                      PreviewKeyDown="DataGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <!-- PI NO -->
                    <DataGridTemplateColumn Header="PI NO" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceNo}" Style="{StaticResource CellTextBold}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- DATE -->
                    <DataGridTemplateColumn Header="DATE" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Style="{StaticResource CellDate}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- CUSTOMER -->
                    <DataGridTemplateColumn Header="CUSTOMER" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CustomerName}" Style="{StaticResource CellCompany}" ToolTip="{Binding CustomerName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- CUST REF -->
                    <DataGridTemplateColumn Header="CUST REF" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CustomerReference}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- PROJECT -->
                    <DataGridTemplateColumn Header="PROJECT" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProjectName}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- SALESMAN -->
                    <DataGridTemplateColumn Header="SALESMAN" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Salesman}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- STATUS -->
                    <DataGridTemplateColumn Header="STATUS" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.EditableStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         SelectedItem="{Binding Status, Mode=OneWay}" 
                                         BorderBrush="#3B82F6" 
                                         BorderThickness="1" 
                                         Padding="6,4" 
                                         FontSize="11" 
                                         MinHeight="28" 
                                         Background="White"
                                         IsEditable="False" 
                                         SelectionChanged="StatusComboBox_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- AMOUNT -->
                    <DataGridTemplateColumn Header="AMOUNT" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GrandTotal, StringFormat=N0}" Style="{StaticResource CellAmount}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="View" Style="{StaticResource BtnView}" 
                                           Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"/>
                                    <Button Content="Edit" Style="{StaticResource BtnEdit}" 
                                           Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"/>
                                    <Button Content="Del" Style="{StaticResource BtnDelete}" 
                                           Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"/>
                                    <Button Content="JO" Style="{StaticResource BtnJO}" 
                                           Command="{Binding DataContext.CreateJobOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ==================== STATS BAR ==================== -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="White" CornerRadius="10" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL -->
                <Border Grid.Column="0" Style="{StaticResource StatsCard}" Background="#DBEAFE">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#3B82F6"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalInvoiceCount}" Style="{StaticResource StatValue}" Foreground="#1E40AF"/>
                        <TextBlock Text="TOTAL" Style="{StaticResource StatLabel}" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>

                <!-- FILTERED -->
                <Border Grid.Column="1" Style="{StaticResource StatsCard}" Background="#E0F2FE">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#0EA5E9"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FilteredInvoices.Count}" Style="{StaticResource StatValue}" Foreground="#0284C7"/>
                        <TextBlock Text="FILTERED" Style="{StaticResource StatLabel}" Foreground="#0369A1"/>
                    </StackPanel>
                </Border>

                <!-- DRAFT -->
                <Border Grid.Column="2" Style="{StaticResource StatsCard}" Background="#F1F5F9">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#64748B"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DraftCount}" Style="{StaticResource StatValue}" Foreground="#475569"/>
                        <TextBlock Text="DRAFT" Style="{StaticResource StatLabel}" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- SENT -->
                <Border Grid.Column="3" Style="{StaticResource StatsCard}" Background="#FEF3C7">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#F59E0B"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SentCount}" Style="{StaticResource StatValue}" Foreground="#B45309"/>
                        <TextBlock Text="SENT" Style="{StaticResource StatLabel}" Foreground="#92400E"/>
                    </StackPanel>
                </Border>

                <!-- CONFIRMED -->
                <Border Grid.Column="4" Style="{StaticResource StatsCard}" Background="#D1FAE5">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#059669"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ConfirmedCount}" Style="{StaticResource StatValue}" Foreground="#047857"/>
                        <TextBlock Text="CONFIRMED" Style="{StaticResource StatLabel}" Foreground="#065F46"/>
                    </StackPanel>
                </Border>

                <!-- CONVERTED -->
                <Border Grid.Column="5" Style="{StaticResource StatsCard}" Background="#EDE9FE" Margin="0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#8B5CF6"/>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ConvertedToJOCount}" Style="{StaticResource StatValue}" Foreground="#7C3AED"/>
                        <TextBlock Text="CONVERTED" Style="{StaticResource StatLabel}" Foreground="#6D28D9"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== LOADING OVERLAY ==================== -->
        <Border Grid.RowSpan="4" Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading..." FontSize="24" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>