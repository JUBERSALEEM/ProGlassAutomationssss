<UserControl x:Class="ProGlassAutomation.Views.Profile.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ProGlassAutomation.Models"
             Background="#F8FAFC"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.DataContext>
        <models:ProfileViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Sharp Enterprise Palette -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1E40AF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="BorderSharp" Color="#CBD5E1"/>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>

        <!-- Crisp Form Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
        </Style>

        <!-- Premium TextBox (Fixed Trigger Syntax) -->
        <Style x:Key="SharpTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSharp}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <!-- 1. PAGE TITLE -->
            <TextBlock Text="USER PROFILE" FontSize="28" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,20"/>

            <!-- 2. STATUS MESSAGE -->
            <Border CornerRadius="10" Padding="15" Margin="0,0,0,20" Background="#DBEAFE" Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                </StackPanel>
            </Border>

            <!-- 3. PROFILE HEADER (Large Soft-Square Avatar) -->
            <Border CornerRadius="18" Padding="35" Margin="0,0,0,25" Background="{StaticResource PrimaryBlue}" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BIG ROUNDED SQUARE AVATAR -->
                    <Grid Width="140" Height="140">
                        <Border x:Name="AvatarBorder" CornerRadius="15" Background="White" Padding="4">
                            <Border CornerRadius="12" Background="{StaticResource AccentBlue}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding AvatarInitials}" Foreground="White" FontSize="48" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding ProfileImage}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                        </Border>
                        <Button Command="{Binding UploadAvatarCommand}" Width="36" Height="36" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-10,-10" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="White" Effect="{StaticResource SoftShadow}">
                                        <TextBlock Text="✎" Foreground="{StaticResource PrimaryBlue}" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="35,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}" FontSize="30" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="{Binding Role}" Foreground="#93C5FD" FontWeight="Black" FontSize="12" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Border Background="#111827" CornerRadius="8" Padding="12,6">
                                <TextBlock Text="{Binding Email}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#FFFFFF30" CornerRadius="8" Padding="12,6" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding MemberSince, StringFormat='Member Since: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. PERSONAL INFORMATION -->
            <Border CornerRadius="15" Background="White" Padding="30" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="PERSONAL INFORMATION" FontSize="14" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,25"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="FIRST NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FirstName}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="LAST NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LastName}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="PHONE NUMBER" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Phone}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="COMPANY" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,10,20">
                            <TextBlock Text="DEPARTMENT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Department}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                        <Button Content="SAVE CHANGES" Command="{Binding SaveProfileCommand}" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Black" Padding="35,14" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="DISCARD" Command="{Binding DiscardCommand}" Background="#F1F5F9" Foreground="{StaticResource PrimaryBlue}" FontWeight="Black" Padding="30,14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. ACCOUNT SECURITY -->
            <Border CornerRadius="15" Background="White" Padding="30" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="SECURITY SETTINGS" FontSize="14" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,25"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewPassword}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ConfirmPassword}" Style="{StaticResource SharpTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="PASSWORD STRENGTH" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <Border Width="50" Height="10" CornerRadius="5" Margin="0,0,5,0" Background="#F1F5F9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="50" Height="10" CornerRadius="5" Margin="0,0,5,0" Background="#F1F5F9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                                                    <Setter Property="Background" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="50" Height="10" CornerRadius="5" Background="#F1F5F9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                                                    <Setter Property="Background" Value="Gold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PasswordStrengthText}" Foreground="{Binding PasswordStrengthColor}" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="UPDATE PASSWORD" Command="{Binding ChangePasswordCommand}" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Black" Padding="30,14" Margin="0,20,0,0" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 6. SYSTEM PREFERENCES -->
            <Border CornerRadius="15" Background="White" Padding="30" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="SYSTEM PREFERENCES" FontSize="14" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,25"/>
                    <TextBlock Text="NOTIFICATIONS" FontSize="11" FontWeight="Black" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <CheckBox Content="Email Alerts" IsChecked="{Binding EmailNotifications}" Margin="0,0,25,0" FontWeight="Bold"/>
                        <CheckBox Content="SMS Alerts" IsChecked="{Binding SmsNotifications}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="INTERFACE LANGUAGE" FontSize="11" FontWeight="Black" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="250" Height="40" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>