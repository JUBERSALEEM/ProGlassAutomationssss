<UserControl x:Class="ProGlassAutomation.Views.Profile.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ProGlassAutomation.Models">

    <UserControl.DataContext>
        <models:ProfileViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.1"/>

        <!-- Modern TextBox with SelectAll on focus -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" CornerRadius="8" Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn" CornerRadius="8" Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="chkBorder" Width="22" Height="22" CornerRadius="6" 
                                    Background="White" BorderBrush="#D1D5DB" BorderThickness="2" 
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="chkMark" Text="✓" FontSize="14" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                  CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True">
        <StackPanel Margin="20">

            <!-- Page Title -->
            <TextBlock Text="Profile" FontSize="28" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,20"/>

            <!-- Status Message -->
            <Border CornerRadius="8" Padding="14" Margin="0,0,0,16" 
                    Background="#DBEAFE" 
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#1E40AF"/>
            </Border>

            <!-- Profile Header -->
            <Border CornerRadius="16" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E40AF" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Border Width="80" Height="80" CornerRadius="40" Background="#60A5FA">
                            <TextBlock Text="{Binding AvatarInitials}" FontSize="28" FontWeight="Bold" 
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Command="{Binding UploadAvatarCommand}" Width="26" Height="26" 
                                VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                                Background="White" Cursor="Hand" Margin="0,0,-4,-4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="13" Background="White">
                                        <TextBlock Text="✎" FontSize="12" Foreground="#3B82F6" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Email}" FontSize="14" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Phone}" FontSize="14" Foreground="#BFDBFE" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="SaddleBrown" CornerRadius="6" Padding="12,5">
                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FFFFFF30" CornerRadius="6" Padding="12,5" Margin="10,0,0,0">
                                <TextBlock FontSize="11" Foreground="#DBEAFE">
                                    <Run Text="📅 "/>
                                    <Run Text="{Binding MemberSince}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Personal Information -->
            <Border CornerRadius="16" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F9FAFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#3B82F6" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="👤" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Personal Information" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1E40AF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Last Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding SaveProfileCommand}" Margin="0,0,12,0"/>
                        <Button Content="Discard" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding DiscardCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Security -->
            <Border CornerRadius="16" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F9FAFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#3B82F6" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="🔐" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Security" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1E40AF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="CurrentPwd" FontSize="14" Padding="12,10" 
                                         BorderBrush="#D1D5DB" BorderThickness="1" Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Password Strength" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="50" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="1">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="50" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="50" Height="6" CornerRadius="3" Background="#E5E7EB" Margin="0,0,3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="50" Height="6" CornerRadius="3" Background="#E5E7EB">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PasswordStrengthText}" FontSize="12" 
                                       Foreground="{Binding PasswordStrengthColor}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Update Password" Style="{StaticResource PrimaryButton}" 
                            Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Preferences -->
            <Border CornerRadius="16" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F9FAFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#3B82F6" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="⚙️" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Preferences" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1E40AF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Notifications" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,12"/>
                    <StackPanel Margin="0,0,0,20">
                        <CheckBox Content="Email Notifications" IsChecked="{Binding EmailNotifications}" 
                                  Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                        <CheckBox Content="SMS Notifications" IsChecked="{Binding SmsNotifications}" 
                                  Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>

                    <TextBlock Text="Language" FontSize="14" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" 
                              Style="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>