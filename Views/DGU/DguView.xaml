<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.DGU"
             Background="#E8F4FC">

    <UserControl.DataContext>
        <vm:DguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0891B2"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#F0F9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <!-- Base Controls -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="12" Padding="15,12" Margin="0,0,0,10"
                    Background="{StaticResource PrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="DGU CALCULATOR" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UNIT PRICE: " FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="80"/>
                            <TextBlock Text=" AED" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Glass Options -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                        <!-- Glass 1 -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="GLASS 1 (OUTER)" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Category"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CategoryOptions}" 
                                          SelectedItem="{Binding Category1, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Category1, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Thickness"/>
                                <ComboBox Height="28" ItemsSource="{Binding ThicknessOptions1}" 
                                          SelectedItem="{Binding Thickness1, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Thickness1, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Color"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding ColorOptions1}" 
                                          SelectedItem="{Binding Color1, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Color1, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Glass 2 -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="GLASS 2 (INNER)" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Category"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding CategoryOptions}" 
                                          SelectedItem="{Binding Category2, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Category2, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Thickness"/>
                                <ComboBox Height="28" ItemsSource="{Binding ThicknessOptions2}" 
                                          SelectedItem="{Binding Thickness2, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Thickness2, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Color"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding ColorOptions2}" 
                                          SelectedItem="{Binding Color2, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Color2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- [NEW] Wastage Consider -->
                        <Border Style="{StaticResource CardBorder}" Background="#FEF3C7" BorderBrush="#FCD34D">
                            <StackPanel>
                                <TextBlock Text="WASTAGE CONSIDER" Style="{StaticResource SectionTitle}"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding WastageOptions}" 
                                          Text="{Binding WastageConsider, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Factor: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageFactorDisplay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="  |  Wastage: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageConsiderDisplay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE: Size & Price -->
                    <StackPanel Grid.Column="1" Margin="8,0">

                        <!-- Size Options -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="SIZE OPTIONS" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Quick Sizes"/>
                                <ComboBox Height="28" ItemsSource="{Binding AvailableSizes}" 
                                          SelectedItem="{Binding SelectedSize, Mode=TwoWay}"/>
                                <Label Content="Width (mm)"/>
                                <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Height (mm)"/>
                                <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Quantity"/>
                                <TextBox Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Size Warning -->
                                <Border Visibility="{Binding SizeWarning, Converter={StaticResource BoolToVis}}" 
                                        Background="#FEF3C7" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SizeWarningMessage}" FontSize="10" Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Spacer Options -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="SPACER OPTIONS" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Spacer Size"/>
                                <ComboBox Height="28" ItemsSource="{Binding SpacerSizeOptions}" 
                                          SelectedItem="{Binding SpacerSize, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Spacer Color"/>
                                <ComboBox Height="28" ItemsSource="{Binding SpacerColorOptions}" 
                                          SelectedItem="{Binding SpacerColor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: Price Section -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- Sheet Prices -->
                        <Border Style="{StaticResource CardBorder}" Background="#EFF6FF" BorderBrush="#93C5FD">
                            <StackPanel>
                                <TextBlock Text="SHEET PRICES (AED/sqm)" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Glass 1 Price"/>
                                <TextBox Text="{Binding Sheet1, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Glass 2 Price"/>
                                <TextBox Text="{Binding Sheet2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- [NEW] Profit Margin -->
                        <Border Style="{StaticResource CardBorder}" Background="#DCFCE7" BorderBrush="#86EFAC">
                            <StackPanel>
                                <TextBlock Text="PROFIT MARGIN" Style="{StaticResource SectionTitle}"/>
                                <ComboBox Height="28" IsEditable="True" IsReadOnly="False"
                                          ItemsSource="{Binding ProfitMarginOptions}" 
                                          Text="{Binding Profit, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Profit: " FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding ProfitDisplay}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                    <TextBlock Text="  |  Factor: " FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding ProfitFactorDisplay}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Total Summary -->
                        <Border Style="{StaticResource CardBorder}" Background="#FEE2E2" BorderBrush="#FECACA">
                            <StackPanel>
                                <TextBlock Text="PRICE SUMMARY" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Total SQM:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalSqm, StringFormat={}{0:N2}}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Text="Total Price:" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="2" Text="VAT (5%):" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VatAmount, StringFormat={}{0:N2}}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="3" Text="Gross Total:" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GrossTotal, StringFormat={}{0:N2}}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save Button -->
                        <Button Content="SAVE" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY SECTION -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="HISTORY" Background="#14B8A6" Foreground="White" FontWeight="Bold" 
                            Padding="12,8" HorizontalAlignment="Left"
                            Command="{Binding ClearCommand}"/>
                    <Button Grid.Column="1" Content="CLEAR" Background="#DC2626" Foreground="White" FontWeight="Bold" 
                            Padding="12,8" Margin="8,0,0,0"
                            Command="{Binding ClearCommand}"/>
                </Grid>

                <Border Background="#F0F9FF" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                        MinHeight="80" MaxHeight="200" BorderBrush="#BAE6FD" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="4"
                                            BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="250">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding CreatedAt}" FontSize="9" Foreground="#64748B"/>

                                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Thickness1}" FontSize="11" Foreground="#334155"/>
                                                <TextBlock Text="{Binding Spacer}" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock FontSize="10" Foreground="#64748B">
                                                    <Run Text="Wastage: "/><Run Text="{Binding Wastage}" FontWeight="Bold"/>
                                                    <Run Text=" | Profit: "/><Run Text="{Binding Profit}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" FontSize="14" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0">
                                                <Run Text="{Binding Result, StringFormat={}{0:N2}}"/><Run Text=" AED"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>