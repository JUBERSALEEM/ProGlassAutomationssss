<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#14B8A6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#E8F4FC">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <TextBlock Text="🧮 DGU CALCULATOR"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- RESULT BOX -->
                    <Border Background="White"
                            CornerRadius="8"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Width="180">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊 RESULT: "
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#1E3A5F"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0891B2"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT ================= -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="16"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#1E3A5F" 
                                      BlurRadius="15" 
                                      ShadowDepth="2" 
                                      Opacity="0.12"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= LEFT COLUMN ================= -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                        <!-- GLASS 1 -->
                        <Border Background="#F0F9FF"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                BorderBrush="#BAE6FD"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="🔷 GLASS 1" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="Thickness (mm)" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessList}"
                                          SelectedItem="{Binding Thickness1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          StaysOpenOnEdit="True"
                                          Height="28"/>
                                <TextBlock Text="Color" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorList}"
                                          SelectedItem="{Binding Color1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="28"/>
                            </StackPanel>
                        </Border>

                        <!-- GLASS 2 -->
                        <Border Background="#F0F9FF"
                                CornerRadius="10"
                                Padding="12"
                                BorderBrush="#BAE6FD"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="🔷 GLASS 2" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="Thickness (mm)" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessList}"
                                          SelectedItem="{Binding Thickness2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="28"/>
                                <TextBlock Text="Color" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorList}"
                                          SelectedItem="{Binding Color2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= MIDDLE COLUMN ================= -->
                    <StackPanel Grid.Column="1" Margin="8,0">

                        <!-- PRICE SECTION -->
                        <Border Background="#F8FAFC"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="💰 PRICE BREAK" Style="{StaticResource SectionHeaderStyle}"/>

                                <TextBlock Text="Glass 1 Sheet Price" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Sheet1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         ToolTip="Glass 1 cost per SQM"/>

                                <TextBlock Text="Glass 2 Sheet Price" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Sheet2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         ToolTip="Glass 2 cost per SQM"/>
                            </StackPanel>
                        </Border>

                        <!-- ASP & PROFIT -->
                        <Border Background="#FEF3C7"
                                CornerRadius="10"
                                Padding="12"
                                BorderBrush="#FCD34D"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="⚙ ASP TYPE" Style="{StaticResource SectionHeaderStyle}"/>
                                <ComboBox ItemsSource="{Binding AspList}"
                                          SelectedItem="{Binding AspType, Mode=TwoWay}"
                                          IsEditable="True"
                                          Height="28"
                                          Margin="0,4,0,0"/>

                                <TextBlock Text="📈 PROFIT MARGIN" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ProfitList}"
                                          SelectedItem="{Binding Profit, Mode=TwoWay}"
                                          IsEditable="True"
                                          Height="28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= RIGHT COLUMN ================= -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- SAVE BUTTON -->
                        <Button Content="💾 SAVE DGU"
                                Command="{Binding SaveCommand}"
                                Background="#1E40AF"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                Height="45"
                                Margin="0,0,0,8"/>

                        <!-- SEARCH -->
                        <Border Background="#F0FDFA"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,8"
                                BorderBrush="#5EEAD4"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="🔍 SEARCH HISTORY" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28"
                                         Margin="0,8,0,0"
                                         ToolTip="Search saved records"/>
                            </StackPanel>
                        </Border>

                        <!-- GUIDE -->
                        <Border Background="#F0FDFA"
                                CornerRadius="10"
                                Padding="12"
                                BorderBrush="#5EEAD4"
                                BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="📘 GUIDE"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#0F766E"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="• Select glass 1 &amp; glass 2 details" FontSize="10" Foreground="#334155"/>
                                <TextBlock Text="• Choose ASP type (Normal/Black)" FontSize="10" Foreground="#334155" Margin="0,3,0,0"/>
                                <TextBlock Text="• Enter sheet prices per SQM" FontSize="10" Foreground="#334155" Margin="0,3,0,0"/>
                                <TextBlock Text="• Set profit margin percentage" FontSize="10" Foreground="#334155" Margin="0,3,0,0"/>
                                <TextBlock Text="• Save to track calculations" FontSize="10" Foreground="#334155" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= HISTORY SECTION (FULL WIDTH AT BOTTOM) ================= -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0">

                <StackPanel>
                    <!-- TOGGLE BUTTON -->
                    <ToggleButton Content="📜 HISTORY"
                                  IsChecked="{Binding IsHistoryVisible}"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  HorizontalAlignment="Stretch"/>

                    <!-- HISTORY PANEL (FULL WIDTH) -->
                    <Border Background="#F0F9FF"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,8,0,0"
                            Height="200"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisConverter}}">

                        <ListBox ItemsSource="{Binding FilteredRecords}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="4"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            MinWidth="280">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="#334155"
                                                   ToolTip="{Binding DisplayText}"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>