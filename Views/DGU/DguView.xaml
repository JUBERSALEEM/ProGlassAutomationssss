<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#D6ECFF">

        <!-- SCROLL -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Width="880"
                        Margin="10"
                        HorizontalAlignment="Center">

                <!-- HEADER -->
                <Border Background="SaddleBrown"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,8">

                    <TextBlock Text="🧮 DGU CALCULATOR"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- GLASS 1 -->
                <Border Background="#FF8C00"
                        CornerRadius="12"
                        Padding="10"
                        Margin="5">

                    <StackPanel>

                        <TextBlock Text="🔷 Glass 1 Thickness (6mm–19mm)"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding ThicknessList}"
                                  SelectedItem="{Binding Thickness1}"
                                  Height="28"
                                  IsEditable="True"/>

                        <TextBlock Text="🎨 Glass 1 Sheet Color"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding ColorList}"
                                  SelectedItem="{Binding Color1}"
                                  Height="28"
                                  Margin="0,3"
                                  IsEditable="True"/>

                        <TextBlock Text="💰 Glass 1 Sheet Price"
                                   FontSize="11"/>

                        <TextBox Text="{Binding Sheet1}"
                                 Height="28"/>

                    </StackPanel>

                </Border>

                <!-- GLASS 2 -->
                <Border Background="#FF8C00"
                        CornerRadius="12"
                        Padding="10"
                        Margin="5">

                    <StackPanel>

                        <TextBlock Text="🔷 Glass 2 Thickness (6mm–19mm)"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding ThicknessList}"
                                  SelectedItem="{Binding Thickness2}"
                                  Height="28"
                                  IsEditable="True"/>

                        <TextBlock Text="🎨 Glass 2 Sheet Color"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding ColorList}"
                                  SelectedItem="{Binding Color2}"
                                  Height="28"
                                  Margin="0,3"
                                  IsEditable="True"/>

                        <TextBlock Text="💰 Glass 2 Sheet Price"
                                   FontSize="11"/>

                        <TextBox Text="{Binding Sheet2}"
                                 Height="28"/>

                    </StackPanel>

                </Border>

                <!-- ASP -->
                <Border Background="#FF8C00"
                        CornerRadius="12"
                        Padding="10"
                        Margin="5">

                    <StackPanel>

                        <TextBlock Text="⚙ ASP TYPE (Normal / Black)"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding AspList}"
                                  SelectedItem="{Binding AspType}"
                                  Height="28"
                                  IsEditable="True"/>

                    </StackPanel>

                </Border>

                <!-- PROFIT -->
                <Border Background="#FF8C00"
                        CornerRadius="12"
                        Padding="10"
                        Margin="5">

                    <StackPanel>

                        <TextBlock Text="📈 PROFIT MARGIN (15%–35%)"
                                   FontSize="11"/>

                        <ComboBox ItemsSource="{Binding ProfitList}"
                                  SelectedItem="{Binding Profit}"
                                  Height="28"
                                  IsEditable="True"/>

                    </StackPanel>

                </Border>

                <!-- RESULT (ICON ADDED) -->
                <Border Background="SaddleBrown"
                        CornerRadius="12"
                        Padding="10"
                        Margin="5">

                    <StackPanel HorizontalAlignment="Center">

                        <!-- ICON LABEL -->
                        <TextBlock Text="📊 DGU RESULT"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <!-- VALUE -->
                        <TextBlock Text="{Binding Result}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- SAVE -->
                <Button Content="💾 SAVE DGU"
                        Height="38"
                        Margin="5"
                        Background="SaddleBrown"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Save_Click"/>

                <!-- HISTORY -->
                <Border Background="SaddleBrown"
                        CornerRadius="14"
                        Padding="8"
                        Margin="5">

                    <TextBlock Text="📜 HISTORY"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Margin="5"/>

                <!-- HISTORY LIST -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="5"
                        Margin="5">

                    <ListBox ItemsSource="{Binding FilteredRecords}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="SaddleBrown"
                                        CornerRadius="8"
                                        Padding="6"
                                        Margin="2">

                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="12"
                                               Foreground="White"/>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</UserControl>