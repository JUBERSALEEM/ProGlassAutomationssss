<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.DGU">

    <UserControl.DataContext>
        <vm:DguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="PrimaryFont">Segoe UI, Inter, sans-serif</FontFamily>

        <!-- Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Card Blue -->
        <Style x:Key="GlassCardBlue" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#DBEAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
        </Style>

        <!-- Glass Card Green -->
        <Style x:Key="GlassCardGreen" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDF4" Offset="0"/>
                        <GradientStop Color="#DCFCE7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
        </Style>

        <!-- Glass Card Orange -->
        <Style x:Key="GlassCardOrange" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFBEB" Offset="0"/>
                        <GradientStop Color="#FEF3C7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FCD34D"/>
        </Style>

        <!-- Glass Card Red -->
        <Style x:Key="GlassCardRed" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FEF2F2" Offset="0"/>
                        <GradientStop Color="#FEE2E2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>

        <!-- Glass Card Purple -->
        <Style x:Key="GlassCardPurple" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAF5FF" Offset="0"/>
                        <GradientStop Color="#F3E8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#C4B5FD"/>
        </Style>

        <!-- Glass Card Teal -->
        <Style x:Key="GlassCardTeal" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDFA" Offset="0"/>
                        <GradientStop Color="#CCFBF1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#5EEAD4"/>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button -->
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#047857" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#DC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DC2626" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button -->
        <Style TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="10" Padding="16,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#14B8A6" Offset="0"/>
                                    <GradientStop Color="#0D9488" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D9488" Offset="0"/>
                                            <GradientStop Color="#0F766E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Small Button for Delete -->
        <Style x:Key="BtnSmallDelete" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Background -->
    <Border Background="#F1F5F9">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER -->
            <!-- ============================================ -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DGU Calculator" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource PrimaryFont}" Foreground="#1E293B"/>
                        <TextBlock Text="Double Glazed Unit Price Calculator" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Result Display -->
                    <Border Grid.Column="1" CornerRadius="16" Padding="20,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0891B2" Offset="0"/>
                                <GradientStop Color="#06B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UNIT PRICE" FontSize="11" FontWeight="Medium" Foreground="#E0F2FE" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource PrimaryFont}"/>
                            <TextBlock Text="AED" FontSize="13" Foreground="#E0F2FE" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- MAIN CONTENT -->
            <!-- ============================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================ -->
                <!-- LEFT: GLASS 1 & GLASS 2 -->
                <!-- ============================================ -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- Glass 1 -->
                    <Border Style="{StaticResource GlassCardBlue}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Glass 1 (Outer)" Foreground="#1E40AF" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding Category1}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions1}" SelectedValue="{Binding Thickness1}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding ColorOptions1}" SelectedValue="{Binding Color1}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding Sheet1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Glass 2 -->
                    <Border Style="{StaticResource GlassCardGreen}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Glass 2 (Inner)" Foreground="#166534" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding Category2}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions2}" SelectedValue="{Binding Thickness2}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding ColorOptions2}" SelectedValue="{Binding Color2}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding Sheet2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================ -->
                <!-- MIDDLE: AIR SPACER & WASTAGE -->
                <!-- ============================================ -->
                <StackPanel Grid.Column="1" Margin="8,0">

                    <!-- Air Spacer -->
                    <Border Style="{StaticResource GlassCardOrange}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Air Spacer (ASP)" Foreground="#B45309" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Spacer Thickness" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SpacerSizeOptions}" SelectedValue="{Binding SpacerSize}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Spacer Color" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding SpacerColorOptions}" SelectedValue="{Binding SpacerColor}" DisplayMemberPath="" SelectedValuePath=""/>

                            <TextBlock Text="Spacer Price (AED)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding SpacerPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Wastage Consider -->
                    <Border Style="{StaticResource GlassCardRed}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Wastage Consider" Foreground="#DC2626" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Wastage %" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding WastageOptions}" SelectedValue="{Binding WastageConsider}" DisplayMemberPath="" SelectedValuePath=""/>

                            <Border Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0" BorderBrush="#FECACA" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Wastage Factor" FontSize="10" Foreground="#991B1B"/>
                                    <TextBlock Text="{Binding WastageFactorDisplay}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" FontFamily="{StaticResource PrimaryFont}"/>
                                    <TextBlock FontSize="9" Foreground="#B91C1C" Margin="0,4,0,0">
                                        <Run Text="(Divide by "/><Run Text="{Binding WastageFactorDisplay, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================ -->
                <!-- RIGHT: PROFIT, ACTIONS, SUMMARY -->
                <!-- ============================================ -->
                <StackPanel Grid.Column="2" Margin="8,0,0,0">

                    <!-- Profit Margin -->
                    <Border Style="{StaticResource GlassCardPurple}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#8B5CF6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Profit Margin" Foreground="#5B21B6" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Select Profit %" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ProfitMarginOptions}" SelectedValue="{Binding ProfitMargin}" DisplayMemberPath="" SelectedValuePath=""/>

                            <Border Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0" BorderBrush="#DDD6FE" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Profit Added" FontSize="10" Foreground="#5B21B6"/>
                                    <TextBlock Text="{Binding ProfitDisplay}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" FontFamily="{StaticResource PrimaryFont}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Actions" Foreground="#334155" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <Button Content="💾 Save DGU" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,0,6"/>
                            <Button Content="📄 Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource BtnSuccess}" Margin="0,0,0,6"/>
                            <Button Content="🗑️ Clear" Command="{Binding ClearCommand}" Style="{StaticResource BtnDanger}"/>
                        </StackPanel>
                    </Border>

                    <!-- Price Summary -->
                    <Border Style="{StaticResource GlassCard}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#ECFDF5" Offset="0"/>
                                <GradientStop Color="#D1FAE5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#6EE7B7"/>
                        </Border.BorderBrush>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Price Summary" Foreground="#065F46" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Unit Price" FontSize="12" Foreground="#047857"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Result, StringFormat={}{0:F2} AED}" FontSize="12" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="VAT (5%)" FontSize="12" Foreground="#047857" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VatAmount, StringFormat={}{0:F2} AED}" FontSize="12" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Right" Margin="0,6,0,0"/>

                                <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="#A7F3D0" Margin="0,10,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL" FontSize="14" FontWeight="Bold" Foreground="#065F46"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GrossTotal, StringFormat={}{0:F2} AED}" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================ -->
            <!-- HISTORY -->
            <!-- ============================================ -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <StackPanel>
                    <ToggleButton Content="📜 Calculation History" IsChecked="{Binding IsHistoryVisible}" HorizontalAlignment="Stretch"/>

                    <Border Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                            <ItemsControl ItemsSource="{Binding Records}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="12" Padding="14" Margin="4" MinWidth="240"
                                                BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="#64748B"/>
                                                    </Border>
                                                    <Button Content="✕" 
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource BtnSmallDelete}"
                                                            HorizontalAlignment="Right"/>
                                                </Grid>

                                                <TextBlock FontSize="11" Foreground="#334155" Margin="0,0,0,2">
                                                    <Run Text="G1: "/><Run Text="{Binding Thickness1}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#334155" Margin="0,0,0,2">
                                                    <Run Text="G2: "/><Run Text="{Binding Thickness2}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="#64748B" Margin="0,0,0,4">
                                                    <Run Text="Wastage: "/><Run Text="{Binding Wastage}"/>
                                                    <Run Text=" | Profit: "/><Run Text="{Binding Profit}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#10B981">
                                                    <Run Text="{Binding Result, StringFormat={}{0:F2}}"/><Run Text=" AED"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>