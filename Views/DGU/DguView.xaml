<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#E8F3FF">

        <StackPanel Width="880" Margin="10" HorizontalAlignment="Center">

            <!-- HEADER -->
            <Border Background="#FF8C00"
                CornerRadius="14"
                Padding="10"
                Margin="0,0,0,8">

                <TextBlock Text="DGU CALCULATOR"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            </Border>

            <!-- ================= GLASS 1 ================= -->
            <Border Background="#C8E6C9"
                CornerRadius="12"
                Padding="10"
                Margin="5">

                <StackPanel>

                    <!-- THICKNESS -->
                    <TextBlock Text="Glass 1 Thickness (6mm–19mm)"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding ThicknessList}"
                          SelectedItem="{Binding Thickness1}"
                          Height="28"
                          IsEditable="True"
                          ToolTip="Select or manually enter thickness (6mm, 8mm, 10mm, 12mm, 15mm, 19mm)"/>

                    <!-- COLOR -->
                    <TextBlock Text="Glass 1 Sheet Color"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding ColorList}"
                          SelectedItem="{Binding Color1}"
                          Height="28"
                          Margin="0,3"
                          IsEditable="True"
                          ToolTip="Select or type sheet color"/>

                    <!-- PRICE -->
                    <TextBlock Text="Glass 1 Sheet Price"
                           FontSize="11"
                           Foreground="Gray"/>

                    <TextBox Text="{Binding Sheet1}"
                         Height="28"
                         ToolTip="Enter sheet price for Glass 1"/>

                </StackPanel>

            </Border>

            <!-- ================= GLASS 2 ================= -->
            <Border Background="#DCEDC8"
                CornerRadius="12"
                Padding="10"
                Margin="5">

                <StackPanel>

                    <!-- THICKNESS -->
                    <TextBlock Text="Glass 2 Thickness (6mm–19mm)"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding ThicknessList}"
                          SelectedItem="{Binding Thickness2}"
                          Height="28"
                          IsEditable="True"
                          ToolTip="Select or manually enter thickness"/>

                    <!-- COLOR -->
                    <TextBlock Text="Glass 2 Sheet Color"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding ColorList}"
                          SelectedItem="{Binding Color2}"
                          Height="28"
                          Margin="0,3"
                          IsEditable="True"
                          ToolTip="Select or type sheet color"/>

                    <!-- PRICE -->
                    <TextBlock Text="Glass 2 Sheet Price"
                           FontSize="11"
                           Foreground="Gray"/>

                    <TextBox Text="{Binding Sheet2}"
                         Height="28"
                         ToolTip="Enter sheet price for Glass 2"/>

                </StackPanel>

            </Border>

            <!-- ================= ASP ================= -->
            <Border Background="#BBDEFB"
                CornerRadius="12"
                Padding="10"
                Margin="5">

                <StackPanel>

                    <TextBlock Text="ASP TYPE (Normal / Black + auto pricing)"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding AspList}"
                          SelectedItem="{Binding AspType}"
                          Height="28"
                          IsEditable="True"
                          ToolTip="ASP type auto adds price based on thickness"/>

                </StackPanel>

            </Border>

            <!-- ================= PROFIT ================= -->
            <Border Background="#BBDEFB"
                CornerRadius="12"
                Padding="10"
                Margin="5">

                <StackPanel>

                    <TextBlock Text="PROFIT MARGIN (15%–35%)"
                           FontSize="11"
                           Foreground="Gray"/>

                    <ComboBox ItemsSource="{Binding ProfitList}"
                          SelectedItem="{Binding Profit}"
                          Height="28"
                          IsEditable="True"
                          ToolTip="Select or manually adjust profit margin"/>

                </StackPanel>

            </Border>

            <!-- RESULT -->
            <Border Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="5">

                <TextBlock Text="{Binding Result}"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            </Border>

            <!-- SAVE -->
            <Button Content="SAVE DGU"
                Height="38"
                Margin="5"
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                ToolTip="Save current calculation to history"
                Click="Save_Click"/>

            <!-- HISTORY HEADER -->
            <Border Background="#FF8C00"
                CornerRadius="14"
                Padding="8"
                Margin="5">

                <TextBlock Text="HISTORY"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            </Border>

            <!-- SEARCH -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Height="28"
                 Margin="5"
                 ToolTip="Search saved DGU records"/>

            <!-- HISTORY LIST -->
            <Border Background="White"
                CornerRadius="12"
                Padding="5"
                Margin="5">

                <ListBox ItemsSource="{Binding FilteredRecords}"
                     Height="120">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="6"
                                Margin="2"
                                ToolTip="Click to view record">

                                <TextBlock Text="{Binding DisplayText}"
                                       FontSize="12"/>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Border>

        </StackPanel>

    </Grid>
</UserControl>