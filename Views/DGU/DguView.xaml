<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels">

    <UserControl.DataContext>
        <vm:DguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="PrimaryFont">Segoe UI, Inter, sans-serif</FontFamily>

        <!-- Base Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CardBlue" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#DBEAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
        </Style>

        <Style x:Key="CardGreen" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDF4" Offset="0"/>
                        <GradientStop Color="#DCFCE7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
        </Style>

        <Style x:Key="CardOrange" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFBEB" Offset="0"/>
                        <GradientStop Color="#FEF3C7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
        </Style>

        <Style x:Key="CardRed" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FEF2F2" Offset="0"/>
                        <GradientStop Color="#FEE2E2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <Style x:Key="CardPurple" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAF5FF" Offset="0"/>
                        <GradientStop Color="#F3E8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#DDD6FE"/>
        </Style>

        <Style x:Key="CardTeal" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDFA" Offset="0"/>
                        <GradientStop Color="#CCFBF1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#99F6E4"/>
        </Style>

        <Style x:Key="CardCyan" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#ECFEFF" Offset="0"/>
                        <GradientStop Color="#CFFAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#A5F3FC"/>
        </Style>

        <Style x:Key="CardIndigo" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EEF2FF" Offset="0"/>
                        <GradientStop Color="#E0E7FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
        </Style>

        <Style x:Key="CardGray" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F9FAFB" Offset="0"/>
                        <GradientStop Color="#F3F4F6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <!-- Pink Card for Gas -->
        <Style x:Key="CardPink" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FDF2F8" Offset="0"/>
                        <GradientStop Color="#FCE7F3" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FBCFE8"/>
        </Style>

        <!-- Amber Card for Sealant -->
        <Style x:Key="CardAmber" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFBEB" Offset="0"/>
                        <GradientStop Color="#FEF3C7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
        </Style>

        <!-- Modern TextBox with Select All -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#374151"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="MaxDropDownHeight" Value="150"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#DC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSmallDelete" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#FEE2E2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F1F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
            <StackPanel>

                <!-- HEADER -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardCyan}">
                        <StackPanel>
                            <TextBlock Text="DGU Calculator" FontSize="20" FontWeight="Bold" Foreground="#0E7490"/>
                            <TextBlock Text="Double Glazed Unit" FontSize="11" Foreground="#0891B2" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardTeal}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="UNIT PRICE" FontSize="9" FontWeight="Medium" Foreground="#0F766E"/>
                                <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="24" FontWeight="Bold" Foreground="#0D9488"/>
                            </StackPanel>
                            <TextBlock Text="AED" FontSize="12" FontWeight="Bold" Foreground="#14B8A6" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MAIN CONTENT -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Outer & Inner Glass -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">

                        <!-- Outer Glass -->
                        <Border Style="{StaticResource CardBlue}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6"/>
                                    <TextBlock Grid.Column="1" Text="Outer Glass" Style="{StaticResource SectionTitle}" Foreground="#1D4ED8" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding OuterCategory}" IsEditable="True" Text="{Binding OuterCategory, Mode=TwoWay}"/>

                                <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedValue="{Binding OuterThickness}" IsEditable="True" Text="{Binding OuterThickness, Mode=TwoWay}"/>

                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedValue="{Binding OuterColor}" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="True" Text="{Binding OuterColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OuterPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Inner Glass -->
                        <Border Style="{StaticResource CardGreen}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E"/>
                                    <TextBlock Grid.Column="1" Text="Inner Glass" Style="{StaticResource SectionTitle}" Foreground="#166534" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding InnerCategory}" IsEditable="True" Text="{Binding InnerCategory, Mode=TwoWay}"/>

                                <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedValue="{Binding InnerThickness}" IsEditable="True" Text="{Binding InnerThickness, Mode=TwoWay}"/>

                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedValue="{Binding InnerColor}" DisplayMemberPath="Name" SelectedValuePath="Name" IsEditable="True" Text="{Binding InnerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding InnerPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE: Spacer & Wastage -->
                    <StackPanel Grid.Column="1" Margin="6,0">

                        <!-- Spacer Settings -->
                        <Border Style="{StaticResource CardOrange}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B"/>
                                    <TextBlock Grid.Column="1" Text="Spacer Settings" Style="{StaticResource SectionTitle}" Foreground="#B45309" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Spacer Thickness" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SpacerOptions}" SelectedValue="{Binding Spacer}"/>

                                <TextBlock Text="Spacer Charge (AED)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding SpacerCharge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Sealant Charge (AED)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding SealantCharge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Gas Charge (AED)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding GasCharge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Wastage -->
                        <Border Style="{StaticResource CardRed}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444"/>
                                    <TextBlock Grid.Column="1" Text="Wastage" Style="{StaticResource SectionTitle}" Foreground="#DC2626" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Wastage %" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WastageOptions}" SelectedValue="{Binding Wastage}"/>

                                <Border Background="White" CornerRadius="8" Padding="8" Margin="0,10,0,0" BorderBrush="#FECACA" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Wastage Factor" FontSize="10" Foreground="#991B1B"/>
                                        <TextBlock Text="{Binding WastageFactorDisplay}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: Profit & Actions -->
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">

                        <!-- Profit Margin -->
                        <Border Style="{StaticResource CardPurple}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#8B5CF6"/>
                                    <TextBlock Grid.Column="1" Text="Profit Margin" Style="{StaticResource SectionTitle}" Foreground="#5B21B6" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Select Profit %" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ProfitMarginOptions}" SelectedValue="{Binding ProfitMargin}"/>

                                <Border Background="White" CornerRadius="8" Padding="8" Margin="0,10,0,0" BorderBrush="#DDD6FE" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Profit Added" FontSize="10" Foreground="#5B21B6"/>
                                        <TextBlock Text="{Binding ProfitMarginDisplay}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Price Summary -->
                        <Border Style="{StaticResource CardGreen}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#10B981"/>
                                    <TextBlock Grid.Column="1" Text="Price Summary" Style="{StaticResource SectionTitle}" Foreground="#166534" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Glass Cost" FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding TotalGlassCost, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Processing" FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding ProcessingCost, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Base Cost" FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding BaseCost, StringFormat={}{0:F2}}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Background="White" CornerRadius="8" Padding="8" Margin="0,8,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="UNIT PRICE" FontSize="9" Foreground="#166534"/>
                                            <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="VAT (5%)" FontSize="9" Foreground="#166534" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding VatAmount, StringFormat={}{0:F2}}" FontSize="12" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="White" CornerRadius="8" Padding="8" Margin="0,6,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="GRAND TOTAL" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                        <TextBlock Text="{Binding GrossTotal, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Actions" Style="{StaticResource SectionTitle}" Foreground="#334155" Margin="8,0,0,0"/>
                                </Grid>

                                <Button Content="Save DGU" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,0,4"/>
                                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource BtnSuccess}" Margin="0,0,0,4"/>
                                <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource BtnDanger}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- HISTORY -->
                <Border Style="{StaticResource CardIndigo}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="History" Style="{StaticResource SectionTitle}"/>
                            <Button Content="Clear" Command="{Binding ClearAllCommand}" Style="{StaticResource BtnDanger}" Padding="8,4" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Background="#EEF2FF" CornerRadius="8" MaxHeight="150"
                                Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#C7D2FE" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Records}" Margin="4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="8" Padding="8" Margin="4" Width="180"
                                                    BorderBrush="#C7D2FE" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding CreatedAt}" FontSize="9" Foreground="#6366F1"/>
                                                        <Button Content="X" 
                                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                CommandParameter="{Binding}" 
                                                                Style="{StaticResource BtnSmallDelete}"
                                                                HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="#4338CA" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="#FEF3C7" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                                            <TextBlock FontSize="9" Foreground="#B45309">
                                                                <Run Text="W: "/><Run Text="{Binding Wastage}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Background="#F3E8FF" CornerRadius="4" Padding="4,2">
                                                            <TextBlock FontSize="9" Foreground="#5B21B6">
                                                                <Run Text="P: "/><Run Text="{Binding ProfitMargin}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                                        <TextBlock Text="AED" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Background="#EEF2FF" CornerRadius="8" Padding="20"
                                Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#C7D2FE" BorderThickness="1">
                            <TextBlock Text="No history yet" FontSize="11" Foreground="#6366F1" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- DGU ADVANCED OPTIONS -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardBlue}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="12" Height="12" CornerRadius="6" Background="#3B82F6"/>
                            <TextBlock Grid.Column="1" Text="DGU Advanced Options" Style="{StaticResource SectionTitle}" Foreground="#1D4ED8" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Optional: Spacer, Gas, Sealant, Airspace details" FontSize="10" Foreground="#60A5FA" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Advanced Options Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Airspace Options -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Style="{StaticResource CardCyan}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Airspace Cavity" FontWeight="Bold" FontSize="11" Foreground="#0891B2" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding AirspaceOptions}" SelectedValue="{Binding Airspace}" IsEditable="True"/>
                                        <TextBlock Text="Distance between glass panes" FontSize="9" Foreground="#67E8F9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Gas Type -->
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <Border Style="{StaticResource CardPink}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Gas Fill Type" FontWeight="Bold" FontSize="11" Foreground="#BE185D" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding GasTypes}" SelectedValue="{Binding GasType}" IsEditable="True"/>
                                        <TextBlock Text="Argon, Krypton, Air, etc." FontSize="9" Foreground="#F472B6" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Sealant Type -->
                            <StackPanel Grid.Column="2" Margin="6,0">
                                <Border Style="{StaticResource CardAmber}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Sealant Type" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SealantTypes}" SelectedValue="{Binding SealantType}" IsEditable="True"/>
                                        <TextBlock Text="Primary/Secondary seal" FontSize="9" Foreground="#FCD34D" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Spacer Type -->
                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <Border Style="{StaticResource CardOrange}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Spacer Type" FontWeight="Bold" FontSize="11" Foreground="#B45309" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SpacerTypes}" SelectedValue="{Binding SpacerType}" IsEditable="True"/>
                                        <TextBlock Text="Aluminum, Warm Edge, Swiss" FontSize="9" Foreground="#FDE68A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Additional Options Row -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Edge Work -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Style="{StaticResource CardPurple}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Edge Work" FontWeight="Bold" FontSize="11" Foreground="#5B21B6" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding EdgeWorkTypes}" SelectedValue="{Binding EdgeWork}" IsEditable="True"/>
                                        <TextBlock Text="Polish, Bevel, CNC, etc." FontSize="9" Foreground="#C4B5FD" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Drilling -->
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <Border Style="{StaticResource CardTeal}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Drilling / Holes" FontWeight="Bold" FontSize="11" Foreground="#0F766E" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding DrillingOptions}" SelectedValue="{Binding Drilling}" IsEditable="True"/>
                                        <TextBlock Text="No Hole, 1-8 Holes, Notches" FontSize="9" Foreground="#5EEAD4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Tempering -->
                            <StackPanel Grid.Column="2" Margin="6,0">
                                <Border Style="{StaticResource CardGreen}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Heat Treatment" FontWeight="Bold" FontSize="11" Foreground="#166534" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding TemperingOptions}" SelectedValue="{Binding Tempering}" IsEditable="True"/>
                                        <TextBlock Text="Annealed, Tempered, HS" FontSize="9" Foreground="#86EFAC" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coating -->
                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <Border Style="{StaticResource CardIndigo}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Coating" FontWeight="Bold" FontSize="11" Foreground="#4338CA" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding CoatingTypes}" SelectedValue="{Binding Coating}" IsEditable="True"/>
                                        <TextBlock Text="Low-E, Solar, AR, etc." FontSize="9" Foreground="#A5B4FC" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Third Row - Surface Treatment & Custom Notes -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Surface Treatment -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Style="{StaticResource CardRed}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Surface Treatment" FontWeight="Bold" FontSize="11" Foreground="#DC2626" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SurfaceTreatments}" SelectedValue="{Binding SurfaceTreatment}" IsEditable="True"/>
                                        <TextBlock Text="Sandblast, Acid Etch, etc." FontSize="9" Foreground="#FCA5A5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Lamination Type -->
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <Border Style="{StaticResource CardPurple}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Lamination" FontWeight="Bold" FontSize="11" Foreground="#5B21B6" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding LaminationTypes}" SelectedValue="{Binding LaminationType}" IsEditable="True"/>
                                        <TextBlock Text="Clear, Tinted, Acoustic, etc." FontSize="9" Foreground="#C4B5FD" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Custom Notes -->
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Custom Notes" FontWeight="Bold" FontSize="11" Foreground="#374151" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding CustomNotes, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" 
                                                 Height="60" 
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True" 
                                                 VerticalContentAlignment="Top"
                                                 Padding="8,6"/>
                                        <TextBlock Text="Additional specifications or requirements" FontSize="9" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Fourth Row - Dimensions & Unit -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Width -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- Height -->
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Column="2" Margin="6,0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, TargetNullValue='1'}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- Unit -->
                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UnitOptions}" SelectedValue="{Binding Unit}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Calculation Details Toggle -->
                        <Border Background="#EFF6FF" CornerRadius="8" Margin="0,10,0,0" Padding="10" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Expander Header="View Calculation Breakdown" IsExpanded="False" Foreground="#1D4ED8">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Outer Glass Details" FontWeight="SemiBold" FontSize="11" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Category:" FontSize="10" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding OuterCategory}" FontSize="10" Foreground="#1D4ED8" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Thickness:" FontSize="10" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding OuterThickness}" FontSize="10" Foreground="#1D4ED8" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Color:" FontSize="10" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding OuterColor}" FontSize="10" Foreground="#1D4ED8" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Price:" FontSize="10" Foreground="#60A5FA"/>
                                                <TextBlock Text="{Binding OuterPrice, StringFormat={}{0:F2} AED}" FontSize="10" Foreground="#1D4ED8" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Inner Glass Details" FontWeight="SemiBold" FontSize="11" Foreground="#166534" Margin="0,0,0,6"/>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Category:" FontSize="10" Foreground="#22C55E"/>
                                                <TextBlock Text="{Binding InnerCategory}" FontSize="10" Foreground="#166534" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Thickness:" FontSize="10" Foreground="#22C55E"/>
                                                <TextBlock Text="{Binding InnerThickness}" FontSize="10" Foreground="#166534" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Color:" FontSize="10" Foreground="#22C55E"/>
                                                <TextBlock Text="{Binding InnerColor}" FontSize="10" Foreground="#166534" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Price:" FontSize="10" Foreground="#22C55E"/>
                                                <TextBlock Text="{Binding InnerPrice, StringFormat={}{0:F2} AED}" FontSize="10" Foreground="#166534" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="White" CornerRadius="6" Padding="8" Margin="0,10,0,0" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Cost Breakdown" FontWeight="SemiBold" FontSize="11" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="1. Glass Cost (Outer + Inner)" FontSize="10" Foreground="#60A5FA"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalGlassCost, StringFormat={}{0:F2}}" FontSize="10" Foreground="#3B82F6" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="2. Processing Cost" FontSize="10" Foreground="#60A5FA"/>
                                                    <TextBlock Text="   (Spacer + Sealant + Gas)" FontSize="9" Foreground="#93C5FD"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessingCost, StringFormat={}{0:F2}}" FontSize="10" Foreground="#3B82F6" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="3. Base Cost" FontSize="10" Foreground="#60A5FA"/>
                                                    <TextBlock Text="   (Glass + Processing) ÷ Wastage Factor" FontSize="9" Foreground="#93C5FD"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding BaseCost, StringFormat={}{0:F2}}" FontSize="10" Foreground="#3B82F6" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="4. Unit Price" FontSize="10" Foreground="#60A5FA"/>
                                                    <TextBlock Text="   Base Cost × Profit Factor" FontSize="9" Foreground="#93C5FD"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quick Reference Section -->
                <Border Style="{StaticResource CardGray}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="DGU Quick Reference" FontWeight="Bold" FontSize="12" Foreground="#374151" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Spacer Reference -->
                            <Border Grid.Column="0" Style="{StaticResource CardOrange}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Common Spacers" FontWeight="SemiBold" FontSize="10" Foreground="#B45309" Margin="0,0,0,4"/>
                                    <TextBlock Text="6mm - 24mm" FontSize="9" Foreground="#FDE68A"/>
                                    <TextBlock Text="Aluminum, Warm Edge" FontSize="9" Foreground="#FCD34D"/>
                                </StackPanel>
                            </Border>

                            <!-- Gas Reference -->
                            <Border Grid.Column="1" Style="{StaticResource CardPink}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Common Gases" FontWeight="SemiBold" FontSize="10" Foreground="#BE185D" Margin="0,0,0,4"/>
                                    <TextBlock Text="Argon 90%, Air" FontSize="9" Foreground="#F472B6"/>
                                    <TextBlock Text="Krypton for high insulation" FontSize="9" Foreground="#F9A8D4"/>
                                </StackPanel>
                            </Border>

                            <!-- Thickness Reference -->
                            <Border Grid.Column="2" Style="{StaticResource CardBlue}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Typical Thickness" FontWeight="SemiBold" FontSize="10" Foreground="#1D4ED8" Margin="0,0,0,4"/>
                                    <TextBlock Text="4mm-6mm per pane" FontSize="9" Foreground="#60A5FA"/>
                                    <TextBlock Text="6.38mm-12.76mm Lami" FontSize="9" Foreground="#93C5FD"/>
                                </StackPanel>
                            </Border>

                            <!-- Sealant Reference -->
                            <Border Grid.Column="3" Style="{StaticResource CardAmber}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Common Sealants" FontWeight="SemiBold" FontSize="10" Foreground="#B45309" Margin="0,0,0,4"/>
                                    <TextBlock Text="Butyl + Polysulfide" FontSize="9" Foreground="#FDE68A"/>
                                    <TextBlock Text="Silicone secondary" FontSize="9" Foreground="#FCD34D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>