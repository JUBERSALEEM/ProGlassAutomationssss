<UserControl x:Class="ProGlassAutomation.Views.DGU.DguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#D6ECFF">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- OUTER CARD -->
            <Border Width="900"
                    Padding="20"
                    CornerRadius="25"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,20">

                <StackPanel>

                    <!-- HEADER -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,0,10">

                        <TextBlock Text="🧮 DGU CALCULATOR"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ================= GLASS 1 ================= -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="5">

                        <StackPanel>

                            <TextBlock Text="🔷 Glass 1 Thickness (6mm–19mm)"
                                       Foreground="White"
                                       FontSize="11"/>

                            <!-- FIXED: Editable + dropdown -->
                            <ComboBox ItemsSource="{Binding ThicknessList}"
                                      SelectedItem="{Binding Thickness1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Height="28"
                                      ToolTip="Enter or select thickness (6mm–19mm)"/>

                            <TextBlock Text="🎨 Glass 1 Sheet Color"
                                       Foreground="White"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                            <!-- FIXED: Editable -->
                            <ComboBox ItemsSource="{Binding ColorList}"
                                      SelectedItem="{Binding Color1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Height="28"
                                      ToolTip="Enter or select glass color"/>

                            <TextBlock Text="💰 Glass 1 Sheet Price"
                                       Foreground="White"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                            <TextBox Text="{Binding Sheet1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     ToolTip="Enter sheet price"/>

                        </StackPanel>

                    </Border>

                    <!-- ================= GLASS 2 ================= -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="5">

                        <StackPanel>

                            <TextBlock Text="🔷 Glass 2 Thickness (6mm–19mm)"
                                       Foreground="White"
                                       FontSize="11"/>

                            <ComboBox ItemsSource="{Binding ThicknessList}"
                                      SelectedItem="{Binding Thickness2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Height="28"
                                      ToolTip="Enter or select thickness"/>

                            <TextBlock Text="🎨 Glass 2 Sheet Color"
                                       Foreground="White"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                            <ComboBox ItemsSource="{Binding ColorList}"
                                      SelectedItem="{Binding Color2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Height="28"
                                      ToolTip="Enter or select color"/>

                            <TextBlock Text="💰 Glass 2 Sheet Price"
                                       Foreground="White"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                            <TextBox Text="{Binding Sheet2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     ToolTip="Enter sheet price"/>

                        </StackPanel>

                    </Border>

                    <!-- ASP -->
                    <Border Background="#0854A0"
                            CornerRadius="14"
                            Padding="10"
                            Margin="5">

                        <StackPanel>

                            <TextBlock Text="⚙ ASP TYPE (Normal / Black)"
                                       Foreground="White"
                                       FontSize="11"/>

                            <ComboBox ItemsSource="{Binding AspList}"
                                      SelectedItem="{Binding AspType, Mode=TwoWay}"
                                      IsEditable="True"
                                      Height="28"
                                      ToolTip="Select ASP type"/>

                        </StackPanel>

                    </Border>

                    <!-- PROFIT -->
                    <Border Background="#0854A0"
                            CornerRadius="14"
                            Padding="10"
                            Margin="5">

                        <StackPanel>

                            <TextBlock Text="📈 PROFIT MARGIN (15%–35%)"
                                       Foreground="White"
                                       FontSize="11"/>

                            <ComboBox ItemsSource="{Binding ProfitList}"
                                      SelectedItem="{Binding Profit, Mode=TwoWay}"
                                      IsEditable="True"
                                      Height="28"
                                      ToolTip="Select profit margin"/>

                        </StackPanel>

                    </Border>

                    <!-- RESULT -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="15"
                            Margin="5">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="📊 DGU RESULT"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding Result}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- SAVE -->
                    <Button Content="💾 SAVE DGU"
                            Height="40"
                            Margin="5"
                            Background="#0854A0"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="Save_Click"
                            ToolTip="Save DGU calculation"/>

                    <!-- HISTORY HEADER -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="8"
                            Margin="5">

                        <TextBlock Text="📜 HISTORY"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- SEARCH -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Margin="5"
                             ToolTip="Search history"/>

                    <!-- HISTORY LIST -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="5"
                            Margin="5">

                        <ListBox ItemsSource="{Binding FilteredRecords}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#0A6ED1"
                                            CornerRadius="10"
                                            Padding="6"
                                            Margin="2">

                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="White"/>
                                    </Border>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>
</UserControl>