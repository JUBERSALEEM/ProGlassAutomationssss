<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F1F5F9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderPill" TargetType="Border">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Background="#1E40AF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HeaderPill}">
                        <TextBlock Text="🧾" FontSize="20" Foreground="White"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="TAX INVOICE MANAGEMENT" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Generate, record payments, and track tax invoices based on delivered orders" FontSize="11" Foreground="#93C5FD" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Style="{StaticResource ActionBtn}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- INVOICES LIST -->
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" Width="150"/>
                        <DataGridTextColumn Header="CLIENT NAME" Binding="{Binding ClientName}" Width="250"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}" Width="120"/>
                        <DataGridTextColumn Header="TOTAL AMOUNT (AED)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="150"/>
                        <DataGridTextColumn Header="PAID AMOUNT (AED)" Binding="{Binding PaidAmount, StringFormat=N2}" Width="150"/>
                        <DataGridTextColumn Header="BALANCE (AED)" Binding="{Binding BalanceAmount, StringFormat=N2}" Width="150"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- POPUP EDITOR -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="12" Padding="24" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="550" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🧾 GENERATE TAX INVOICE" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="INVOICE NUMBER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingInvoice.InvoiceNumber}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="CLIENT NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingInvoice.ClientName}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="INVOICE DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditingInvoice.InvoiceDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="DUE DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditingInvoice.DueDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="SUB TOTAL (AED)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingInvoice.SubTotal, StringFormat=N2}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="TOTAL AMOUNT (AED)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingInvoice.TotalAmount, StringFormat=N2}" IsReadOnly="True" FontWeight="Bold" Foreground="#1E40AF"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingInvoice.Notes}" TextWrapping="Wrap" MinHeight="50"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Style="{StaticResource ActionBtn}" Command="{Binding CancelCommand}" Background="#64748B" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Save Invoice" Style="{StaticResource ActionBtn}" Command="{Binding SaveCommand}" Background="#10B981" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
