<Window x:Class="ProGlassAutomation.Views.Print.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProGlassAutomation.Views.Print"
        xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
        Title="Print Preview" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="PrintButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Print" Style="{StaticResource PrintButton}" Click="BtnPrint_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource PrintButton}" Background="#6B7280" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Background="White" Margin="20" Padding="40" BorderBrush="#E5E7EB" BorderThickness="1" x:Name="PrintBorder">
                <StackPanel MaxWidth="900">

                    <!-- Company Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CompanyName}" FontSize="18" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="TRN: "/><Run Text="{Binding CompanyTRN}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CompanyLocation}" FontSize="10" Foreground="#6B7280"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DocumentType}" FontSize="14" FontWeight="SemiBold" Foreground="#1E3A5F"/>
                            <TextBlock FontSize="11" Foreground="#6B7280">
                                <Run Text="No: "/><Run Text="{Binding DocumentNumber}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Date: "/><Run Text="{Binding DocumentDate, StringFormat=dd MMM yyyy}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#1E3A5F" Margin="0,0,0,20"/>

                    <!-- Customer Info -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECEIVER" FontSize="10" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="TRN: "/><Run Text="{Binding CustomerTRN}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CustomerAddress}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Ref: "/><Run Text="{Binding CustomerReference}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Project: "/><Run Text="{Binding ProjectName}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Project No: "/><Run Text="{Binding ProjectNo}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Location: "/><Run Text="{Binding ProjectLocation}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280" Margin="0,8,0,0">
                                <Run Text="LPO No: "/><Run Text="{Binding LPONo}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Att: "/><Run Text="{Binding AttentionName}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Contact: "/><Run Text="{Binding ContactNo}"/>
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#6B7280">
                                <Run Text="Salesman: "/><Run Text="{Binding Salesman}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Specifications -->
                    <TextBlock Text="SPECIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,8"/>

                    <!-- Table Header -->
                    <Border Background="#1E3A5F" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SR" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="GLASS REF" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="W1" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="H1" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="W2" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="H2" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="QTY" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="SQM" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="TOTAL SQM" Foreground="White" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Items -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SrNo}" FontSize="9"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GlassRef}" FontSize="9"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Width1, StringFormat=N0}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Height1, StringFormat=N0}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Width2, StringFormat=N0}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Height2, StringFormat=N0}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Qty, StringFormat=N0}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding SQM, StringFormat=N4}" FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="{Binding TotalSQM, StringFormat=N4}" FontSize="9" FontWeight="Bold" TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Totals -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                        <TextBlock Text="TOTALS: " FontSize="11" FontWeight="Bold" Foreground="#1E3A5F"/>
                        <TextBlock FontSize="11" Margin="20,0">
                            <Run Text="Qty: "/><Run Text="{Binding TotalQty, StringFormat=N0}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="11">
                            <Run Text="Total SQM: "/><Run Text="{Binding TotalSQM, StringFormat=N4}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,20">
                        <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Notes}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Footer -->
                    <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>