<Window x:Class="ProGlassAutomation.Views.About.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About - ProGlass ERP"
        Height="520" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Border Margin="20" CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Logo Card -->
                <Border Background="#0A6ED1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="12" Padding="16" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="PROGLASS" FontSize="12" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                                <TextBlock Text="ERP" FontSize="28" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                                <Border Height="1" Background="#0A6ED1" Margin="12,4"/>
                                <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Version 1.0.0" FontSize="12" Foreground="#D1E9F9" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Glass Processing Automation Platform" FontSize="11" Foreground="#D1E9F9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- About App Section -->
                <Border CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#7C3AED" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="ABOUT APP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="ProGlass ERP System is a comprehensive glass processing automation platform designed for modern glass fabrication businesses. It provides advanced calculators for SGU, DGU, Lamination, and optimization tools to streamline your workflow." 
                                   FontSize="11" Foreground="#1F1F1F" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Developer Section -->
                <Border CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#0A6ED1" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="DEVELOPER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#F0F9FF" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Developer:" FontSize="11" Foreground="#6A6D70" Width="80"/>
                                    <TextBlock Text="Juber Saleem" FontSize="11" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Location:" FontSize="11" Foreground="#6A6D70" Width="80"/>
                                    <TextBlock Text="Dubai, UAE" FontSize="11" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Mobile:" FontSize="11" Foreground="#6A6D70" Width="80"/>
                                    <TextBlock Text="+971-559117727" FontSize="11" Foreground="#0A6ED1" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Contact Section -->
                <Border CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#10B981" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="CONTACT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <StackPanel>
                            <Button Click="Email_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✉" FontSize="14"/>
                                                <TextBlock Text="Jubersaleem01@gmail.com" FontSize="11" Foreground="#0A6ED1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="WhatsApp_Click" Cursor="Hand" Margin="0,6,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💬" FontSize="14"/>
                                                <TextBlock Text="WhatsApp Support" FontSize="11" Foreground="#0A6ED1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Close Button -->
                <Button Click="Close_Click" Cursor="Hand" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E5E7EB" CornerRadius="10" Padding="24,12">
                                <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>