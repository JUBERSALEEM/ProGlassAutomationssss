<!-- PATCH 108: Add keyboard shortcuts -->
<UserControl x:Class="ProGlassAutomation.Views.DailyWorksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             xmlns:local="clr-namespace:ProGlassAutomation.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#F1F5F9"
             Focusable="True"
             KeyDown="UserControl_KeyDown"
             Loaded="UserControl_Loaded">

    <!-- DataContext set in code-behind constructor -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- SIMPLE DATA GRID -->
        <Style x:Key="SimpleDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalGridLinesBrush" Value="#CBD5E1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>

        <!-- SIMPLE CELL -->
        <Style x:Key="SimpleCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SIMPLE ROW -->
        <Style x:Key="SimpleRow" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
                <!-- PATCH 128: Row colors by production status -->
                <DataTrigger Binding="{Binding ProductionStatus}" Value="COMPLETED">
                    <Setter Property="Background" Value="#D1FAE5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductionStatus}" Value="IN PROGRESS">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductionStatus}" Value="PENDING">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- SIMPLE HEADER -->
        <Style x:Key="SimpleHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Path x:Name="SortArrow" Grid.Column="1" 
                          Data="M 0,4 L 4,0 L 8,4" 
                          Fill="White" Visibility="Collapsed" 
                          Margin="4,0,4,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COLUMN TEXT STYLES -->
        <Style x:Key="TextDate" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextCompany" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="TextPINumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextCustRef" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0891B2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextType" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D97706"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextProduction" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0D9488"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextQty" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextSQM" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65A30D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextSalesman" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EA580C"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextColor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DB2777"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextNotes" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78716C"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- PATCH 127: Search Highlight Text -->
        <Style x:Key="HighlightText" TargetType="TextBlock">
            <Setter Property="Background" Value="#FEF08A"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER OUTLINE BUTTON -->
        <Style x:Key="DangerOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WARNING BUTTON -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN COMBOBOX -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- MODERN TEXTBOX -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- MODERN DATEPICKER -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#1E40AF" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="12,10" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DAILY WORKS" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,4" Margin="12,0,0,0" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="PRODUCTION" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Manufacturing Order Management System" FontSize="11" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search & Date Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Search Box - Separated for better layout -->
                    <Grid Width="280" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon + Input -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="4" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1E40AF" CornerRadius="8" Padding="8,6" Margin="2">
                                    <TextBlock Text="🔍" FontSize="12"/>
                                </Border>
                                <ComboBox x:Name="SearchTextBox"
    KeyDown="SearchTextBox_KeyDown"
                                    Grid.Column="1"
                                    IsEditable="True"
                                    ItemsSource="{Binding RecentSearches}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                    BorderThickness="0" 
                                    VerticalAlignment="Center" 
                                    Padding="8,6" 
                                    FontSize="12"
                                    Background="Transparent"
                                    MinWidth="150"/>
                            </Grid>
                        </Border>

                        <!-- Toggle Buttons - Clean Row -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Instant Search -->
                            <CheckBox Content="⚡" 
                                     ToolTip="Instant Search"
                                     IsChecked="{Binding InstantSearch}" 
                                     Foreground="White" 
                                     Background="#10B981"
                                     Padding="6,4"
                                     FontWeight="Bold"/>

                            <!-- Dark Mode -->
                            <Button Click="ToggleDarkMode_Click"
                                    Background="#1F2937" 
                                    BorderThickness="0"
                                    Padding="8,6" 
                                    Margin="6,0,0,0" 
                                    Cursor="Hand"
                                    ToolTip="Toggle Dark Mode">
                                <TextBlock Text="🌙" FontSize="14" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Date From -->
                    <Border Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,8,0" BorderBrush="#10B981" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="FROM" FontSize="9" FontWeight="Bold" Foreground="#059669"/>
                                <DatePicker SelectedDate="{Binding FilterStartDate, UpdateSourceTrigger=LostFocus}" 
                                           BorderThickness="0" 
                                           Background="Transparent" 
                                           FontSize="12"
                                           Foreground="#334155"/>
                            </StackPanel>
                            <Border Width="1" Background="#10B981" Opacity="0.3" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Date To -->
                    <Border Background="White" CornerRadius="10" Padding="12,8" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TO" FontSize="9" FontWeight="Bold" Foreground="#D97706"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate, UpdateSourceTrigger=LostFocus}" 
                                       BorderThickness="0" 
                                       Background="Transparent" 
                                       FontSize="12"
                                       Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Add" Style="{StaticResource SuccessButton}" Command="{Binding AddNewCommand}" Margin="0,0,6,0"/>
                    <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                    <Button Content="🖨️ Print" Style="{StaticResource SecondaryButton}" Click="PrintButton_Click" Margin="0,0,6,0"/>
                    <Button Content="👁️ Preview" Style="{StaticResource SecondaryButton}" Click="PrintPreviewButton_Click" Margin="0,0,6,0"/>
                    <Button Content="📄 Export" Style="{StaticResource SecondaryButton}" Command="{Binding ExportToCsvCommand}" Margin="0,0,6,0"/>
                    <Button Content="📊 Export Selected" Style="{StaticResource SecondaryButton}" Command="{Binding ExportSelectedToCsvCommand}" Margin="0,0,6,0"/>
                    <Button Content="📥 Import CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ImportFromCsvCommand}" Margin="0,0,6,0"/>
                    <Button Content="📋 Load to Invoice" 
                    Style="{StaticResource WarningButton}" 
                    Click="LoadToInvoice_Click"
                    CommandParameter="{Binding ElementName=MainDataGrid}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. FILTER BAR -->
        <Border Grid.Row="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12"
        BorderBrush="#3B82F6" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DBEAFE" Offset="0"/>
                    <GradientStop Color="#BFDBFE" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter: Company -->
                <Border Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="COMPANY" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CompanyOptions}" 
                         SelectedItem="{Binding FilterCompany, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: PI Number -->
                <Border Grid.Column="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PI NUMBER" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PINumberOptions}" 
                         SelectedItem="{Binding FilterPINumber, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Customer Reference -->
                <Border Grid.Column="2" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CUST REF" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CustomerReferenceOptions}" 
                         SelectedItem="{Binding FilterCustomerReference, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Type of Work -->
                <Border Grid.Column="3" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TYPE OF WORK" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TypeOfWorkOptions}" 
                         SelectedItem="{Binding FilterTypeOfWork, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Status -->
                <Border Grid.Column="4" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" 
                         SelectedItem="{Binding FilterStatus, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- PATCH 106: Filter: Production Status -->
                <Border Grid.Column="5" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PRODUCTION" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProductionStatusOptions}" 
                         SelectedItem="{Binding FilterProductionStatus, UpdateSourceTrigger=LostFocus}"
                         Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- PATCH 41-44: Quick Filter Buttons + Clear All -->
                <Border Grid.Column="6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Week" 
                        Style="{StaticResource PrimaryButton}" 
                        Command="{Binding QuickFilterThisWeekCommand}" 
                        Padding="8,6" Margin="0,0,4,0" FontSize="9"/>
                        <Button Content="Month" 
                        Style="{StaticResource PrimaryButton}" 
                        Command="{Binding QuickFilterThisMonthCommand}" 
                        Padding="8,6" Margin="0,0,4,0" FontSize="9"/>
                        <Button Content="All" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding QuickFilterAllTimeCommand}" 
                        Padding="8,6" Margin="0,0,8,0" FontSize="9"/>
                        <Button Content="Clear" 
        Style="{StaticResource DangerButton}" 
        Command="{Binding ClearFiltersCommand}" 
        Padding="12,6" FontSize="9"/>
                        <!-- PATCH 95: Auto-Refresh Toggle + Interval -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <Border Background="#7C3AED" CornerRadius="6" Padding="4" Margin="0,0,4,0">
                                <CheckBox Content="🔄 Auto" 
                  IsChecked="{Binding AutoRefreshEnabled}" 
                  Foreground="White" 
                  FontSize="9" 
                  FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="White" CornerRadius="6" Padding="4" BorderBrush="#7C3AED" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding AutoRefreshSeconds}" 
                    Width="40" 
                    FontSize="9" 
                    Padding="2"
                    Background="Transparent"
                    BorderThickness="0"/>
                                    <TextBlock Text="sec" Foreground="#7C3AED" FontSize="9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. DATA GRID -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <!-- PATCH 86, 87: Enable UI virtualization and recycling for 60fps performance -->
                <!-- PATCH 110: Save column widths on change -->
                <DataGrid x:Name="MainDataGrid"
                          AlternationCount="100"
                          ItemsSource="{Binding FilteredDataView}" 
                          SelectedItem="{Binding SelectedItem}"
                          Loaded="MainDataGrid_Loaded"
                          MouseLeftButtonUp="MainDataGrid_MouseLeftButtonUp"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          Style="{StaticResource SimpleDataGrid}" 
                          CellStyle="{StaticResource SimpleCell}"
                          RowStyle="{StaticResource SimpleRow}"
                          SelectionChanged="MainDataGrid_SelectionChanged"
                          BorderThickness="0"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizing="True">
                    <!-- PATCH 135: Column visibility toggle -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Show Columns">
                                <MenuItem Header="Date" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Company" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="PI Number" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Color" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Cust Ref" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Type of Work" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Production" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="QTY" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="SQM" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Status" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Salesman" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                                <MenuItem Header="Notes" IsCheckable="True" IsChecked="True" Click="ToggleColumn_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>

                        <!-- PATCH 136: Row Number -->
                        <DataGridTemplateColumn Header="#" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex)}" 
                       HorizontalAlignment="Center" Foreground="#64748B" FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- SELECT CHECKBOX -->
                        <DataGridTemplateColumn Header="" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" 
                                             IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=OneWay}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="SelectAllCheckBox" Click="HeaderSelectAll_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>

                        <!-- DATE - Blue - PATCH 109: Add Sorting -->
                        <DataGridTemplateColumn Header="DATE" Width="100" SortMemberPath="Date">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Date, StringFormat=dd-MM-yyyy}" Style="{StaticResource TextDate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- COMPANY - Dark Gray -->
                        <DataGridTemplateColumn Header="COMPANY" Width="130" SortMemberPath="Company">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Company}" Style="{StaticResource TextCompany}" ToolTip="{Binding Company}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="PI NUMBER" Width="110" SortMemberPath="PiNumber">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PiNumber}" Style="{StaticResource TextPINumber}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="COLOR" Width="80" SortMemberPath="Color">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Color}" Style="{StaticResource TextColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CUST REF" Width="100" SortMemberPath="CustomerReference">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CustomerReference}" Style="{StaticResource TextCustRef}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- TYPE OF WORK - Amber -->
                        <DataGridTemplateColumn Header="TYPE OF WORK" Width="110" SortMemberPath="TypeOfWork">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeOfWork}" Style="{StaticResource TextType}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- PRODUCTION STATUS - Teal -->
                        <DataGridTemplateColumn Header="PRODUCTION" Width="100" SortMemberPath="ProductionStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductionStatus}" Style="{StaticResource TextProduction}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- QTY - Emerald Green -->
                        <DataGridTemplateColumn Header="QTY" Width="70" SortMemberPath="Qty">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Qty}" Style="{StaticResource TextQty}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- SQM - Lime -->
                        <DataGridTemplateColumn Header="SQM" Width="70" SortMemberPath="Sqm">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sqm, StringFormat=N2}" Style="{StaticResource TextSQM}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- STATUS - Purple -->
                        <DataGridTemplateColumn Header="STATUS" Width="100" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource TextStatus}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- SALESMAN - Orange -->
                        <DataGridTemplateColumn Header="SALESMAN" Width="100" SortMemberPath="Salesman">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Salesman}" Style="{StaticResource TextSalesman}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                        <!-- NOTES - Stone Gray -->
                        <DataGridTemplateColumn Header="NOTES" Width="*" SortMemberPath="Notes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource TextNotes}" ToolTip="{Binding Notes}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SimpleHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- PATCH 90: Loading overlay -->
                <Border Background="#80FFFFFF" 
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳ Loading..." FontSize="18" FontWeight="Bold" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 4. STATS BAR -->
        <Border Grid.Row="3" CornerRadius="12" Padding="12" Margin="0,12,0,0" Background="White"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL STATS -->
                <Border Grid.Column="0" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                        BorderBrush="#3B82F6" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Background="#1E40AF" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="TOTAL STATS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="REC" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalRecords}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="QTY" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalQty}" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#65A30D" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SQM" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalSQM, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="#65A30D" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#7C3AED" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="COMP" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCompanies}" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="4,3" BorderBrush="#D97706" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PI" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalPINumbers}" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FILTERED STATS -->
                <Border Grid.Column="1" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                        BorderBrush="#3B82F6" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="FILTERED STATS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Records -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RECORDS" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredRecords}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- QTY -->
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="QTY" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredQty}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- SQM -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SQM" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredSQM, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- PATCH 133: DONE -->
                            <Border Grid.Column="3" Background="#F0FDF4" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#22C55E" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DONE" FontSize="7" Foreground="#15803D" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CompletedCount}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- PATCH 133: PENDING -->
                            <Border Grid.Column="4" Background="#FEFCE8" CornerRadius="8" Padding="6,4" BorderBrush="#EAB308" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PENDING" FontSize="7" Foreground="#A16207" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PendingCount}" FontSize="14" FontWeight="Bold" Foreground="#CA8A04" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SELECTED + ACTIONS -->
                <Border Grid.Column="2" CornerRadius="10" Padding="12"
                        BorderBrush="#7C3AED" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F5F3FF" Offset="0"/>
                            <GradientStop Color="#EDE9FE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selected Count -->
                        <Border Background="#7C3AED" CornerRadius="10" Padding="12,8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCount}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- PATCH 107: Action Buttons with Bulk Production Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="Edit" Style="{StaticResource PrimaryButton}" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedItem}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <Button Content="📋 Invoice" 
        Style="{StaticResource WarningButton}" 
        Click="LoadToInvoice_Click"
        CommandParameter="{Binding ElementName=MainDataGrid}"
        Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <!-- PATCH 120: Batch Clone button -->
                                <Button Content="Clone Selected" Style="{StaticResource WarningButton}" Command="{Binding BatchCloneCommand}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <!-- PATCH 107: Bulk Production Status Update -->
                                <ComboBox ItemsSource="{Binding ProductionStatusOptions}" 
                 SelectedItem="{Binding BulkProductionStatus, UpdateSourceTrigger=LostFocus}"
                 Width="110" Padding="8,4" FontSize="9" Background="White"/>
                                <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding BulkUpdateProductionStatusCommand}" Padding="10,5" FontSize="9"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 5. EDIT POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="80,40" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="800"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="✏️ WORK ORDER DETAILS" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text=" - " FontSize="20" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EditingWork.PiNumber}" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding EditingWork.Date}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding CompanyOptions}" 
                                     Text="{Binding EditingWork.Company, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="PI NUMBER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingWork.PINumber}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="CUST REF" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding CustomerReferenceOptions}" 
                                     Text="{Binding EditingWork.CustomerReference, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="TYPE OF WORK" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding TypeOfWorkOptions}" 
                                     Text="{Binding EditingWork.TypeOfWork, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="PRODUCTION STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding ProductionStatusOptions}" 
                                     Text="{Binding EditingWork.ProductionStatus, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding StatusOptions}" 
                                     Text="{Binding EditingWork.Status, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="SALESMAN" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding SalesmanOptions}" 
                                     Text="{Binding EditingWork.Salesman, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="QTY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingWork.Qty}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="SQM" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingWork.Sqm, StringFormat=N2}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding ColorOptions}" 
                                     Text="{Binding EditingWork.Color, UpdateSourceTrigger=LostFocus}"
                                     IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 3 - Notes -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" 
                                    Text="{Binding EditingWork.Notes}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="60"/>
                        </StackPanel>

                        <!-- Row 4 - Info Bar -->
                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" 
                                Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                                BorderBrush="#CBD5E1" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Created:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.CreatedDate, StringFormat=dd-MM-yyyy HH:mm}" FontSize="10" Foreground="#3B82F6" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Updated:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.UpdateDate, StringFormat=dd-MM-yyyy}" FontSize="10" Foreground="#8B5CF6" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="ID:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.Id}" FontSize="10" Foreground="#EA580C" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total SQM:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.Sqm, StringFormat=N2}" FontSize="10" Foreground="#059669" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Duplicate Warning -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,16,0,0" 
                            BorderBrush="#F59E0B" BorderThickness="1"
                            Visibility="{Binding IsDuplicateWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DuplicateMessage}" FontSize="12" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Save Record" Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>