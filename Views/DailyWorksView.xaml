    <!-- MAIN LAYOUT -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. INDUSTRIAL HEADER -->
        <Border Grid.Row="0" CornerRadius="4" Padding="20" Margin="0,0,0,12"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#334155" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title Section -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,30,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DAILY WORKS" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI, Arial"/>
                        <Border Background="#D97706" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRODUCTION" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manufacturing Order Management System" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Search & Date Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="White" CornerRadius="4" Padding="4" Margin="0,0,12,0" BorderBrush="#475569" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#059669" CornerRadius="3" Padding="10,8" Margin="2">
                                <TextBlock Text="search" FontSize="10" Foreground="White"/>
                            </Border>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" 
                                     VerticalAlignment="Center" 
                                     Padding="8,6" 
                                     FontSize="11"
                                     Background="Transparent"
                                     Width="200"/>
                        </Grid>
                    </Border>

                    <!-- Date From -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="DATE FROM" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Border Background="White" CornerRadius="4" Padding="8,6" BorderBrush="#475569" BorderThickness="1">
                            <DatePicker SelectedDate="{Binding FilterStartDate, UpdateSourceTrigger=PropertyChanged}" 
                                       BorderThickness="0" 
                                       Background="Transparent" 
                                       FontSize="11"
                                       Foreground="#334155"/>
                        </Border>
                    </StackPanel>

                    <!-- Date To -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="DATE TO" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Border Background="White" CornerRadius="4" Padding="8,6" BorderBrush="#475569" BorderThickness="1">
                            <DatePicker SelectedDate="{Binding FilterEndDate, UpdateSourceTrigger=PropertyChanged}" 
                                       BorderThickness="0" 
                                       Background="Transparent" 
                                       FontSize="11"
                                       Foreground="#334155"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ ADD NEW" Style="{StaticResource IndustrialSuccess}" Command="{Binding AddNewCommand}" Margin="0,0,8,0"/>
                    <Button Content="REFRESH" Style="{StaticResource IndustrialPrimary}" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"/>
                    <Button Content="PRINT" Style="{StaticResource IndustrialSecondary}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                    <Button Content="EXPORT" Style="{StaticResource IndustrialSecondary}" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. INDUSTRIAL FILTERS BAR -->
        <Border Grid.Row="1" CornerRadius="4" Padding="16" Margin="0,0,0,12"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F8FAFC" Offset="0"/>
                    <GradientStop Color="#E2E8F0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Filter: Company -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="COMPANY" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding CompanyOptions}" 
                              Text="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: PI Number -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="PI NUMBER" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding PINumberOptions}" 
                              Text="{Binding FilterPINumber, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Customer Reference -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="CUST REF" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding CustomerReferenceOptions}" 
                              Text="{Binding FilterCustomerReference, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Type of Work -->
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="TYPE OF WORK" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding TypeOfWorkOptions}" 
                              Text="{Binding FilterTypeOfWork, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Production Status -->
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="PRODUCTION STATUS" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding ProductionStatusOptions}" 
                              Text="{Binding FilterProductionStatus, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Status -->
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="STATUS" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding StatusOptions}" 
                              Text="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Salesman -->
                <StackPanel Grid.Column="6" Margin="0,0,8,0">
                    <TextBlock Text="SALESMAN" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding SalesmanOptions}" 
                              Text="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Filter: Color -->
                <StackPanel Grid.Column="7" Margin="0,0,0,0">
                    <TextBlock Text="COLOR" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource IndustrialComboBox}" 
                              ItemsSource="{Binding ColorOptions}" 
                              Text="{Binding FilterColor, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. INDUSTRIAL DATA GRID WITH UNIQUE COLORS -->
        <Border Grid.Row="2" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
            <DataGrid x:Name="MainDataGrid"
                      ItemsSource="{Binding FilteredDataView}" 
                      SelectedItem="{Binding SelectedDataRowView}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Style="{StaticResource IndustrialDataGrid}" 
                      CellStyle="{StaticResource IndustrialCell}"
                      RowStyle="{StaticResource IndustrialRow}"
                      SelectionChanged="MainDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridTemplateColumn Header="" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" 
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=OneWay}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="SelectAllCheckBox" Click="HeaderSelectAll_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>

                    <!-- DATE - Blue -->
                    <DataGridTemplateColumn Header="DATE" Width="100" HeaderStyle="{StaticResource IndHeaderBlue}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#EFF6FF" CornerRadius="3" Padding="6,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Date, StringFormat=dd-MM-yyyy}" FontSize="11" Foreground="#1D4ED8" FontWeight="Medium"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COMPANY - Purple -->
                    <DataGridTemplateColumn Header="COMPANY" Width="150" HeaderStyle="{StaticResource IndHeaderPurple}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Company}" FontSize="11" Foreground="#7C3AED" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PI NUMBER - Indigo -->
                    <DataGridTemplateColumn Header="PI NUMBER" Width="130" HeaderStyle="{StaticResource IndHeaderIndigo}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PINumber}" FontSize="11" Foreground="#4F46E5" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CUST REF - Cyan -->
                    <DataGridTemplateColumn Header="CUST REF" Width="120" HeaderStyle="{StaticResource IndHeaderCyan}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CustomerReference}" FontSize="11" Foreground="#0891B2" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TYPE OF WORK - Amber -->
                    <DataGridTemplateColumn Header="TYPE OF WORK" Width="130" HeaderStyle="{StaticResource IndHeaderAmber}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#FEF3C7" CornerRadius="3" Padding="6,3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TypeOfWork}" FontSize="10" Foreground="#D97706" FontWeight="Medium"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PRODUCTION - Teal -->
                    <DataGridTemplateColumn Header="PRODUCTION" Width="120" HeaderStyle="{StaticResource IndHeaderTeal}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductionStatus}" FontSize="11" Foreground="#0D9488" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- QTY - Emerald -->
                    <DataGridTemplateColumn Header="QTY" Width="70" HeaderStyle="{StaticResource IndHeaderEmerald}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Qty}" FontSize="12" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SQM - Lime -->
                    <DataGridTemplateColumn Header="SQM" Width="80" HeaderStyle="{StaticResource IndHeaderLime}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SQM, StringFormat=N2}" FontSize="12" Foreground="#65A30D" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STATUS - Rose (Dynamic) -->
                    <DataGridTemplateColumn Header="STATUS" Width="110" HeaderStyle="{StaticResource IndHeaderRose}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Release">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Hold">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E11D48"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Release">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Hold">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SALESMAN - Orange -->
                    <DataGridTemplateColumn Header="SALESMAN" Width="110" HeaderStyle="{StaticResource IndHeaderOrange}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Salesman}" FontSize="11" Foreground="#EA580C" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COLOR - Pink -->
                    <DataGridTemplateColumn Header="COLOR" Width="90" HeaderStyle="{StaticResource IndHeaderPink}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Color}" FontSize="11" Foreground="#DB2777" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NOTES - Stone -->
                    <DataGridTemplateColumn Header="NOTES" Width="*" HeaderStyle="{StaticResource IndHeaderStone}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="#78716C" TextTrimming="CharacterEllipsis" MaxWidth="180" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. INDUSTRIAL FOOTER STATS BAR -->
        <Border Grid.Row="3" CornerRadius="4" Padding="20" Margin="0,12,0,0"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#334155" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Total Records - Blue -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="1. TOTAL RECORDS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding TotalRecords}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6"/>
                </StackPanel>

                <!-- 2. Total Qty - Emerald -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="2. TOTAL QTY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding TotalQty}" FontSize="28" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>

                <!-- 3. Total SQM - Lime -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="3. TOTAL SQM" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding TotalSQM, StringFormat=N2}" FontSize="28" FontWeight="Bold" Foreground="#84CC16"/>
                </StackPanel>

                <!-- 4. Filtered Records - Purple -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="4. FILTERED" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding FilteredRecords}" FontSize="28" FontWeight="Bold" Foreground="#8B5CF6"/>
                </StackPanel>

                <!-- 5. Filter Qty - Teal -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="5. FILTER QTY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding FilteredQty}" FontSize="28" FontWeight="Bold" Foreground="#14B8A6"/>
                </StackPanel>

                <!-- 6. Filter SQM - Amber -->
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock Text="6. FILTER SQM" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding FilteredSQM, StringFormat=N2}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>

                <!-- Selected Count - Red -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0">
                    <Border Background="#334155" CornerRadius="4" Padding="12,8" BorderBrush="#475569" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SELECTED:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedCount}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="EDIT" Style="{StaticResource IndustrialPrimary}" 
                            Command="{Binding EditCommand}" 
                            CommandParameter="{Binding SelectedDataRowView}" 
                            Margin="0,0,8,0"/>
                    <Button Content="DELETE SELECTED" Style="{StaticResource IndustrialWarning}" 
                            Command="{Binding DeleteSelectedCommand}" 
                            CommandParameter="{Binding ElementName=MainDataGrid}"
                            Margin="0,0,8,0"/>
                    <Button Content="DELETE" Style="{StaticResource IndustrialDanger}" 
                            Command="{Binding DeleteCommand}" 
                            CommandParameter="{Binding SelectedDataRowView}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. INDUSTRIAL EDIT POPUP MODAL -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" 
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="6" Padding="30" Margin="60,30" Background="White" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="800"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="16,12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WORK ORDER DETAILS" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Manufacturing Order Entry Form" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#DC2626" CornerRadius="3" Padding="10,6">
                                <TextBlock Text="EDIT MODE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Duplicate Warning -->
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="12" Margin="0,0,0,16" 
                            BorderBrush="#D97706" BorderThickness="1"
                            Visibility="{Binding IsDuplicateWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="#92400E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DuplicateMessage}" Foreground="#92400E" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Form Fields Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="DATE" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource IndustrialDatePicker}" SelectedDate="{Binding EditingWork.Date}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="COMPANY" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding CompanyOptions}" 
                                      Text="{Binding EditingWork.Company, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="PI NUMBER" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingWork.PINumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndustrialTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="CUST REF" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding CustomerReferenceOptions}" 
                                      Text="{Binding EditingWork.CustomerReference, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="TYPE OF WORK" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding TypeOfWorkOptions}" 
                                      Text="{Binding EditingWork.TypeOfWork, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="PRODUCTION STATUS" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding ProductionStatusOptions}" 
                                      Text="{Binding EditingWork.ProductionStatus, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding StatusOptions}" 
                                      Text="{Binding EditingWork.Status, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="SALESMAN" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding SalesmanOptions}" 
                                      Text="{Binding EditingWork.Salesman, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="QTY" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingQtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndustrialTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="SQM" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingSqmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IndustrialTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,10,12">
                            <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding ColorOptions}" 
                                      Text="{Binding EditingWork.Color, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource IndustrialComboBox}" 
                                      ItemsSource="{Binding NotesOptions}" 
                                      Text="{Binding EditingWork.Notes, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      MaxDropDownHeight="120"/>
                        </StackPanel>

                        <!-- Row 3 - Info Bar -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" 
                                Background="#F1F5F9" CornerRadius="4" Padding="12" Margin="0,8,0,0"
                                BorderBrush="#CBD5E1" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Created:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.CreatedDate, StringFormat=dd-MM-yyyy HH:mm}" FontSize="10" Foreground="#3B82F6" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Updated:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.UpdateDate, StringFormat=dd-MM-yyyy}" FontSize="10" Foreground="#8B5CF6" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="ID:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingWork.Id}" FontSize="10" Foreground="#EA580C" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total SQM:" FontSize="10" Foreground="#64748B" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EditingSqmText}" FontSize="10" Foreground="#059669" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Modal Footer -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tip: Double-click a row in the grid to edit directly" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="CANCEL" Style="{StaticResource IndustrialSecondary}" 
                                        Command="{Binding CancelCommand}" 
                                        Margin="0,0,10,0" Padding="20,10"/>
                                <Button Content="SAVE RECORD" Style="{StaticResource IndustrialSuccess}" 
                                        Command="{Binding SaveCommand}" 
                                        Padding="20,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
