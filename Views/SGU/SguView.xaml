<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels">

    <UserControl.DataContext>
        <vm:SguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="PrimaryFont">Segoe UI, Inter, sans-serif</FontFamily>

        <!-- Base Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CardBlue" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#DBEAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardGreen" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDF4" Offset="0"/>
                        <GradientStop Color="#DCFCE7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardPurple" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAF5FF" Offset="0"/>
                        <GradientStop Color="#F3E8FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardOrange" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFBEB" Offset="0"/>
                        <GradientStop Color="#FEF3C7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTeal" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0FDFA" Offset="0"/>
                        <GradientStop Color="#CCFBF1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardCyan" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#ECFEFF" Offset="0"/>
                        <GradientStop Color="#CFFAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardIndigo" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EEF2FF" Offset="0"/>
                        <GradientStop Color="#E0E7FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox - Select All on Click, Empty by Default -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#374151"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="MaxDropDownHeight" Value="150"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#DC2626" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSmallDelete" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#FEE2E2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F1F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>

                <!-- HEADER -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardCyan}">
                        <StackPanel>
                            <TextBlock Text="SGU Calculator" FontSize="20" FontWeight="Bold" Foreground="#0E7490"/>
                            <TextBlock Text="Single Glazed Unit" FontSize="11" Foreground="#0891B2" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardTeal}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="UNIT PRICE" FontSize="9" FontWeight="Medium" Foreground="#0F766E"/>
                                <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="24" FontWeight="Bold" Foreground="#0D9488"/>
                            </StackPanel>
                            <TextBlock Text="AED" FontSize="12" FontWeight="Bold" Foreground="#14B8A6" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- INVENTORY AVAILABLE QTY -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBlue}" Margin="0,0,6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Category" FontSize="11" FontWeight="Medium" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryTotalQty}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardGreen}" Margin="6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Thickness Type" FontSize="11" FontWeight="Medium" Foreground="#166534" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ThicknessTotalQty}" FontSize="28" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardPurple}" Margin="6,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Color Type" FontSize="11" FontWeight="Medium" Foreground="#5B21B6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ColorTotalQty}" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MAIN CONTENT -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glass Selection -->
                    <Border Grid.Column="0" Style="{StaticResource CardBlue}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Glass Selection" Style="{StaticResource SectionTitle}" Foreground="#1D4ED8"/>

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding Category}"/>

                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedValue="{Binding Thickness}"/>

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}" SelectedValue="{Binding ColorName}" DisplayMemberPath="Name" SelectedValuePath="Name"/>
                        </StackPanel>
                    </Border>

                    <!-- Price Details -->
                    <Border Grid.Column="1" Style="{StaticResource CardGreen}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Price Details" Style="{StaticResource SectionTitle}" Foreground="#166534"/>

                            <TextBlock Text="Sheet Price (AED)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SheetPriceBox" Style="{StaticResource ModernTextBox}" 
                                     Text="{Binding SheetPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                            <TextBlock Text="Cutting (AED)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <TextBox x:Name="CuttingBox" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Cutting, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                            <TextBlock Text="Tempering (AED)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <TextBox x:Name="TemperingBox" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding Tempering, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,10,0,0" BorderBrush="#BBF7D0" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="Subtotal" FontSize="10" Foreground="#166534" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Subtotal, StringFormat={}{0:F2}}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Grid.Column="2" Style="{StaticResource CardOrange}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Wastage" Style="{StaticResource SectionTitle}" Foreground="#B45309"/>
                            <ComboBox ItemsSource="{Binding WastageOptions}" SelectedValue="{Binding WastageConsider}"/>

                            <TextBlock Text="Profit Margin" Style="{StaticResource SectionTitle}" Foreground="#5B21B6" Margin="0,10,0,0"/>
                            <ComboBox ItemsSource="{Binding ProfitMarginOptions}" SelectedValue="{Binding ProfitMargin}"/>

                            <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,0,4"/>
                            <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource BtnSuccess}" Margin="0,0,0,4"/>
                            <Button Content="Clear History" Command="{Binding ClearAllCommand}" Style="{StaticResource BtnDanger}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- HISTORY -->
                <Border Style="{StaticResource CardIndigo}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="History" FontSize="12" FontWeight="Bold"/>
                            <Button Content="Clear" Command="{Binding ClearAllCommand}" Style="{StaticResource BtnDanger}" Padding="8,4" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Background="#EEF2FF" CornerRadius="8" MaxHeight="150"
                            Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#C7D2FE" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Records}" Margin="4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="8" Padding="8" Margin="4" Width="180"
                                                BorderBrush="#C7D2FE" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding CreatedAt}" FontSize="9" Foreground="#6366F1"/>
                                                        <Button Content="X" 
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding}" 
                                                            Style="{StaticResource BtnSmallDelete}"
                                                            HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="#4338CA" TextWrapping="Wrap"/>
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Result, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                                        <TextBlock Text="AED" FontSize="10" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Background="#EEF2FF" CornerRadius="8" Padding="20"
                            Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#C7D2FE" BorderThickness="1">
                            <TextBlock Text="No history yet" FontSize="11" Foreground="#6366F1" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>