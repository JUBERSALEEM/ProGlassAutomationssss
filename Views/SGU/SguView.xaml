<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.SGU">

    <UserControl.DataContext>
        <vm:SguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding Background.(SolidColorBrush.Color), RelativeSource={RelativeSource AncestorType=Border}}" BlurRadius="15" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="0.5"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#2563EB" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="White" CornerRadius="10" Padding="10">
                            <TextBlock Text="📊" FontSize="24"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SGU CALCULATOR" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Single Glass Unit Pricing" FontSize="11" Foreground="#BFDBFE"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="16,10" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="18"/>
                            <TextBlock Text="RESULT:" FontWeight="Bold" FontSize="14" Foreground="#1F2937" Margin="8,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result, StringFormat='{}{0:F2} AED'}" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <!-- Glass Specification -->
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#3B82F6" CornerRadius="8" Padding="8">
                                        <TextBlock Text="🪟" FontSize="16"/>
                                    </Border>
                                    <TextBlock Text="GLASS SPECIFICATION" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Thickness (mm)" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" 
                                          SelectedItem="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" StaysOpenOnEdit="True" Height="36"/>
                                <TextBlock Text="Color" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" 
                                          SelectedItem="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" Height="36"/>
                            </StackPanel>
                        </Border>

                        <!-- Base Price -->
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#10B981" CornerRadius="8" Padding="8">
                                        <TextBlock Text="📐" FontSize="16"/>
                                    </Border>
                                    <TextBlock Text="BASE PRICE" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:F2} AED'}" Style="{StaticResource ValueStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE COLUMN -->
                    <StackPanel Grid.Column="1" Margin="5,0">
                        <!-- Price Input -->
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#F59E0B" CornerRadius="8" Padding="8">
                                        <TextBlock Text="💰" FontSize="16"/>
                                    </Border>
                                    <TextBlock Text="PRICE INPUT (AED)" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Sheet Price" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Sheet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" ToolTip="Sheet price in AED"/>
                                <TextBlock Text="Cutting Charge" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Cutting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" ToolTip="Cutting charge in AED"/>
                                <TextBlock Text="Tempering Charge" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Tempering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" ToolTip="Tempering charge in AED"/>
                                <TextBlock Text="Profit Margin" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding ProfitOptions}" 
                                          SelectedItem="{Binding Profit, Mode=TwoWay}" 
                                          IsEditable="True" Height="36"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <!-- Action Buttons -->
                        <Button Content="💾 SAVE SGU" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}" Background="#1E40AF" Margin="0,0,0,8">
                            <Button.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>
                        <Button Content="📄 EXPORT TO PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ActionButton}" Background="#059669" Margin="0,0,0,8">
                            <Button.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>
                        <Button Content="🗑️ CLEAR ALL" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}" Background="#DC2626" Margin="0,0,0,12">
                            <Button.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>

                        <!-- Live Calculation -->
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#6366F1" CornerRadius="8" Padding="8">
                                        <TextBlock Text="💡" FontSize="16"/>
                                    </Border>
                                    <TextBlock Text="LIVE CALCULATION" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Sheet" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Sheet, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Cutting" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Cutting, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Tempering" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Tempering, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,4,0,10">
                                    <TextBlock Text="Profit" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Profit}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>
                                <Border Background="#2563EB" CornerRadius="10" Padding="12,10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2563EB" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding Result, StringFormat='{}{0:F2} AED'}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Guide -->
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#8B5CF6" CornerRadius="8" Padding="8">
                                        <TextBlock Text="📘" FontSize="16"/>
                                    </Border>
                                    <TextBlock Text="GUIDE" FontWeight="Bold" FontSize="12" Foreground="#7C3AED" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="• Select glass thickness" FontSize="10" Foreground="#374151"/>
                                <TextBlock Text="• Choose color type" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                                <TextBlock Text="• Enter sheet price" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                                <TextBlock Text="• Add cutting charge" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                                <TextBlock Text="• Add tempering charge" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                                <TextBlock Text="• Set profit margin" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                                <TextBlock Text="• Save to track" FontSize="10" Foreground="#374151" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY SECTION -->
            <Border Grid.Row="2" Margin="0,12,0,0">
                <StackPanel>
                    <ToggleButton Content="📜 HISTORY" IsChecked="{Binding IsHistoryVisible}" Style="{StaticResource ToggleButtonStyle}" HorizontalAlignment="Stretch"/>
                    <Border Background="White" CornerRadius="14" Padding="16" Margin="0,10,0,0" Height="200" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                        </Border.Effect>
                        <ListBox ItemsSource="{Binding Records}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="280">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11" Foreground="#1F2937" ToolTip="{Binding DisplayText}"/>
                                            <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="11" FontWeight="Bold" 
                                                    Background="#FEE2E2" Foreground="#DC2626" Cursor="Hand" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>