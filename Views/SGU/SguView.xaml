<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Background="#D6ECFF">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- ✅ UNIFIED SAP WIDTH (MATCH DGU + LAMINATION = 900) -->
            <Border Width="900"
                    Padding="20"
                    CornerRadius="25"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="10">

                <StackPanel>

                    <!-- HEADER -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,0,10">

                        <TextBlock Text="📊 SGU CALCULATOR"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- THICKNESS -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,5,0,10">

                        <StackPanel>

                            <TextBlock Text="📏 Thickness"
                                       Foreground="White"
                                       FontWeight="Bold"/>

                            <ComboBox SelectedItem="{Binding Thickness, Mode=TwoWay}"
                                      IsEditable="True"
                                      Height="30">

                                <sys:String>6mm</sys:String>
                                <sys:String>8mm</sys:String>
                                <sys:String>10mm</sys:String>
                                <sys:String>12mm</sys:String>
                                <sys:String>15mm</sys:String>
                                <sys:String>19mm</sys:String>

                            </ComboBox>

                        </StackPanel>

                    </Border>

                    <!-- COLOR -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="🎨 Color"
                                       Foreground="White"
                                       FontWeight="Bold"/>

                            <ComboBox SelectedItem="{Binding Color, Mode=TwoWay}"
                                      IsEditable="True"
                                      Height="30">

                                <sys:String>Clear</sys:String>
                                <sys:String>HD Grey</sys:String>
                                <sys:String>HD Blue</sys:String>
                                <sys:String>HD Green</sys:String>
                                <sys:String>HD Bronze</sys:String>

                            </ComboBox>

                        </StackPanel>

                    </Border>

                    <!-- INPUTS -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="💰 Sheet Price" Foreground="White"/>
                            <TextBox Text="{Binding Sheet}" Height="30"/>

                            <TextBlock Text="✂ Cutting" Foreground="White"/>
                            <TextBox Text="{Binding Cutting}" Height="30"/>

                            <TextBlock Text="🔥 Tempering" Foreground="White"/>
                            <TextBox Text="{Binding Tempering}" Height="30"/>

                            <TextBlock Text="📈 Profit %" Foreground="White"/>
                            <TextBox Text="{Binding Profit}" Height="30"/>

                        </StackPanel>

                    </Border>

                    <!-- RESULT -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="15"
                            Margin="5">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="📊 RESULT"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding Result}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- SAVE -->
                    <Button Content="💾 SAVE SGU"
                            Background="#0854A0"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="45"
                            Margin="5"
                            Click="Save_Click"/>

                    <!-- HISTORY -->
                    <Border Background="#0A6ED1"
                            CornerRadius="14"
                            Padding="8"
                            Margin="5">

                        <TextBlock Text="📜 HISTORY"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ListBox ItemsSource="{Binding Records}"
                             Height="160">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#0A6ED1"
                                        CornerRadius="10"
                                        Padding="8"
                                        Margin="3">

                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</UserControl>