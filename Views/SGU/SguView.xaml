<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Background="#FF8C00">

        <!-- MAIN CARD -->
        <Border Width="650"
                Padding="20"
                CornerRadius="25"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- TITLE -->
                <TextBlock Text="SGU CALCULATOR"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- THICKNESS -->
                <Border Background="#F5F5F5"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,5,0,10">

                    <StackPanel>

                        <TextBlock Text="Thickness"
                                   FontWeight="Bold"/>

                        <ComboBox SelectedItem="{Binding Thickness, Mode=TwoWay}"
                                  IsEditable="True"
                                  Height="30">

                            <sys:String>6mm</sys:String>
                            <sys:String>8mm</sys:String>
                            <sys:String>10mm</sys:String>
                            <sys:String>12mm</sys:String>
                            <sys:String>15mm</sys:String>
                            <sys:String>19mm</sys:String>

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- COLOR -->
                <Border Background="#F5F5F5"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="Color"
                                   FontWeight="Bold"/>

                        <ComboBox SelectedItem="{Binding Color, Mode=TwoWay}"
                                  IsEditable="True"
                                  Height="30">

                            <sys:String>Clear</sys:String>
                            <sys:String>HD Grey</sys:String>
                            <sys:String>HD Blue</sys:String>
                            <sys:String>HD Green</sys:String>
                            <sys:String>HD Bronze</sys:String>

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- INPUTS -->
                <Border Background="#F5F5F5"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="Sheet Price"/>
                        <TextBox Text="{Binding Sheet, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="Cutting"/>
                        <TextBox Text="{Binding Cutting, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="Tempering"/>
                        <TextBox Text="{Binding Tempering, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="Profit %"/>
                        <TextBox Text="{Binding Profit, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                    </StackPanel>

                </Border>

                <!-- RESULT -->
                <Border Background="#FFF3E0"
                        CornerRadius="15"
                        Padding="15"
                        Margin="0,0,0,10">

                    <TextBlock Text="{Binding Result}"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </Border>

                <!-- SAVE -->
                <Button Content="SAVE SGU"
                        Background="#FF8C00"
                        Height="45"
                        FontWeight="Bold"
                        Click="Save_Click"
                        Margin="0,0,0,10"/>

                <!-- HISTORY TITLE -->
                <TextBlock Text="SGU HISTORY"
                           FontWeight="Bold"
                           Margin="0,5,0,5"/>

                <!-- HISTORY LIST (KEPT EXACTLY AS YOU WANTED) -->
                <ListBox ItemsSource="{Binding Records}"
                         Height="160">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#F5F5F5"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,3">

                                <TextBlock Text="{Binding DisplayText}"
                                           FontWeight="SemiBold"/>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>