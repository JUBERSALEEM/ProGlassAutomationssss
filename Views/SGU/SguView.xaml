<UserControl x:Class="ProGlassAutomation.Views.SGUView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <!-- ================= RESOURCES ================= -->
    <UserControl.Resources>

        <!-- SHADOW -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Opacity="0.18"
                          Color="#000000"/>

        <!-- SAP FIORI CARD STYLE -->
        <Style x:Key="FioriCard" TargetType="Border">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- HOVER -->
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.04"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.04"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- LEAVE -->
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1"
                                             Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- CLICK FEEL -->
                <EventTrigger RoutedEvent="MouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.97"
                                             Duration="0:0:0.05"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.97"
                                             Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <!-- ================= MAIN GRID ================= -->
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER (MATCH MAIN SAP BLUE UI) ================= -->
        <Border Background="#0A6ED1"
                CornerRadius="14"
                Padding="12"
                Effect="{StaticResource CardShadow}">

            <Grid>

                <TextBlock Text="📊 SGU PRODUCTION DASHBOARD"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>

                <TextBlock Text="SAP FIORI GLASS ERP"
                           Foreground="#DCEBFF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

            </Grid>

        </Border>

        <!-- ================= KPI CARDS ================= -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <!-- TOTAL SQM -->
            <Border Style="{StaticResource FioriCard}"
                    Width="180">

                <StackPanel>
                    <TextBlock Text="TOTAL SQM"
                               Foreground="#0A6ED1"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalSQM}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <!-- PRODUCTION -->
            <Border Style="{StaticResource FioriCard}"
                    Width="180">

                <StackPanel>
                    <TextBlock Text="PRODUCTION"
                               Foreground="#0A6ED1"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Production}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <!-- WASTE -->
            <Border Style="{StaticResource FioriCard}"
                    Width="180">

                <StackPanel>
                    <TextBlock Text="WASTE"
                               Foreground="#0A6ED1"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Waste}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

        </StackPanel>

        <!-- ================= INPUT SECTION ================= -->
        <Border Grid.Row="2"
                Style="{StaticResource FioriCard}"
                Margin="0,10,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- JOB -->
                <StackPanel>
                    <TextBlock Text="JOB NO" Foreground="#0A6ED1"/>
                    <TextBox Text="{Binding JobNo}" Height="32"/>
                </StackPanel>

                <!-- PROJECT -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PROJECT NO" Foreground="#0A6ED1"/>
                    <TextBox Text="{Binding ProjectNo}" Height="32"/>
                </StackPanel>

                <!-- DATE -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DATE" Foreground="#0A6ED1"/>
                    <TextBox Text="{Binding Date}" Height="32"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- ================= TABLE ================= -->
        <Border Grid.Row="3"
                Style="{StaticResource FioriCard}"
                Margin="0,10,0,0">

            <DataGrid ItemsSource="{Binding SGUList}"
                      AutoGenerateColumns="False"
                      Background="White"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="STYLE" Binding="{Binding Style}" Width="*"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="100"/>
                    <DataGridTextColumn Header="SQM" Binding="{Binding SQM}" Width="100"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>