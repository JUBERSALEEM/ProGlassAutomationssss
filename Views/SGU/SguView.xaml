<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Background="#D6ECFF">

        <!-- MAIN CARD -->
        <Border Width="650"
                Padding="20"
                CornerRadius="25"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- HEADER -->
                <Border Background="SaddleBrown"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,8">

                    <TextBlock Text="📊 SGU CALCULATOR"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- THICKNESS (FIXED DROPDOWN) -->
                <Border Background="#FF8C00"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,5,0,10">

                    <StackPanel>

                        <TextBlock Text="📏 Thickness"
                                   FontWeight="Bold"/>

                        <ComboBox SelectedItem="{Binding Thickness, Mode=TwoWay}"
                                  IsEditable="True"
                                  Height="30">

                            <!-- RESTORED ITEMS -->
                            <sys:String>6mm</sys:String>
                            <sys:String>8mm</sys:String>
                            <sys:String>10mm</sys:String>
                            <sys:String>12mm</sys:String>
                            <sys:String>15mm</sys:String>
                            <sys:String>19mm</sys:String>

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- COLOR (FIXED DROPDOWN) -->
                <Border Background="#FF8C00"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="🎨 Color"
                                   FontWeight="Bold"/>

                        <ComboBox SelectedItem="{Binding Color, Mode=TwoWay}"
                                  IsEditable="True"
                                  Height="30">

                            <!-- RESTORED ITEMS -->
                            <sys:String>Clear</sys:String>
                            <sys:String>HD Grey</sys:String>
                            <sys:String>HD Blue</sys:String>
                            <sys:String>HD Green</sys:String>
                            <sys:String>HD Bronze</sys:String>

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- INPUTS -->
                <Border Background="#FF8C00"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="💰 Sheet Price"/>
                        <TextBox Text="{Binding Sheet, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="✂ Cutting"/>
                        <TextBox Text="{Binding Cutting, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="🔥 Tempering"/>
                        <TextBox Text="{Binding Tempering, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                        <TextBlock Text="📈 Profit %"/>
                        <TextBox Text="{Binding Profit, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"/>

                    </StackPanel>

                </Border>

                <!-- RESULT -->
                <Border Background="#FF8C00"
                        CornerRadius="15"
                        Padding="15"
                        Margin="0,0,0,10">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="📊 RESULT"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding Result}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <!-- SAVE -->
                <Button Content="💾 SAVE SGU"
                        Background="SaddleBrown"
                        Height="45"
                        FontWeight="Bold"
                        Click="Save_Click"
                        Margin="0,0,0,10"/>

                <!-- HISTORY -->
                <Border Background="SaddleBrown"
                        CornerRadius="14"
                        Padding="8"
                        Margin="5">

                    <TextBlock Text="📜 HISTORY"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <ListBox ItemsSource="{Binding Records}"
                         Height="160">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="SaddleBrown"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,3">

                                <TextBlock Text="{Binding DisplayText}"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>