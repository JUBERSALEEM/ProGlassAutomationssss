<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.SGU">

    <UserControl.DataContext>
        <vm:SguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E3A5F" Offset="0"/>
                            <GradientStop Color="#2563EB" Offset="0.5"/>
                            <GradientStop Color="#1E40AF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Background="White" CornerRadius="10" Padding="10">
                                <TextBlock Text="📊" FontSize="24"/>
                            </Border>
                            <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SGU CALCULATOR" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Single Glass Unit Pricing" FontSize="11" Foreground="#BFDBFE"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="White" CornerRadius="12" Padding="16,10" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="18"/>
                                <TextBlock Text="RESULT:" FontWeight="Bold" FontSize="14" Foreground="#1F2937" Margin="8,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Result, StringFormat='{}{0:F2} AED'}" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN - Glass Specification -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#3B82F6" CornerRadius="8" Padding="8">
                                            <TextBlock Text="🪟" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="GLASS SPECIFICATION" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Category (Brand)" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" 
                                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              IsEditable="True" Height="36"/>

                                    <TextBlock Text="Thickness (mm)" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                                    <ComboBox ItemsSource="{Binding ThicknessOptions}" 
                                              SelectedItem="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              IsEditable="True" StaysOpenOnEdit="True" Height="36"/>

                                    <TextBlock Text="Color Type" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                                    <ComboBox ItemsSource="{Binding ColorOptions}" 
                                              SelectedItem="{Binding ColorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              IsEditable="True" Height="36"/>

                                    <Border Background="#DBEAFE" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" FontSize="14"/>
                                            <TextBlock Text="Price auto-loaded from Sheet Store" FontSize="10" Foreground="#1E40AF" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- MIDDLE COLUMN - Price Input -->
                        <StackPanel Grid.Column="1" Margin="5,0">
                            <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#F59E0B" CornerRadius="8" Padding="8">
                                            <TextBlock Text="💰" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="PRICE INPUT (AED)" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Sheet Price (Auto + Editable)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding SheetPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" ToolTip="Auto-loaded from Sheet Store, can be edited"/>

                                    <TextBlock Text="Cutting Charge" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Cutting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36"/>

                                    <TextBlock Text="Tempering Charge" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Tempering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36"/>

                                    <TextBlock Text="Profit Margin" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                    <ComboBox ItemsSource="{Binding ProfitOptions}" 
                                              SelectedItem="{Binding Profit, Mode=TwoWay}" 
                                              IsEditable="True" Height="36"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN - Actions & Calculation -->
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <Button Content="💾 SAVE SGU" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}" Background="#1E40AF" Margin="0,0,0,8"/>
                            <Button Content="📄 EXPORT TO PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ActionButton}" Background="#059669" Margin="0,0,0,8"/>
                            <Button Content="🗑️ CLEAR ALL" Command="{Binding ClearCommand}" Style="{StaticResource ActionButton}" Background="#DC2626" Margin="0,0,0,12"/>

                            <Border Background="#F8FAFC" CornerRadius="14" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#6366F1" CornerRadius="8" Padding="8">
                                            <TextBlock Text="💡" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="LIVE CALCULATION" Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Sheet" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding SheetPrice, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Cutting" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding Cutting, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Tempering" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding Tempering, StringFormat='+ {0:F2}'}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,10">
                                        <TextBlock Text="Profit" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="{Binding Profit}" FontSize="11" Foreground="#374151" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="#2563EB" CornerRadius="10" Padding="12,10">
                                        <TextBlock Text="{Binding Result, StringFormat='{}{0:F2} AED'}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- HISTORY SECTION -->
                <Border Grid.Row="2">
                    <StackPanel>
                        <ToggleButton Content="📜 HISTORY" IsChecked="{Binding IsHistoryVisible}" Style="{StaticResource ToggleButtonStyle}" HorizontalAlignment="Stretch"/>
                        <Border Background="White" CornerRadius="14" Padding="16" Margin="0,10,0,0" Height="200" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisConverter}}">
                            <ListBox ItemsSource="{Binding Records}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="280">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11" Foreground="#1F2937" ToolTip="{Binding DisplayText}"/>
                                                <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="11" FontWeight="Bold" 
                                                        Background="#FEE2E2" Foreground="#DC2626" Cursor="Hand" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>