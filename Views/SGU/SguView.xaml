<UserControl x:Class="ProGlassAutomation.Views.SGU.SguView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.SGU"
             Background="#E8F4FC">

    <UserControl.DataContext>
        <vm:SguViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0891B2"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#F0F9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <!-- Base TextBox Style -->
        <Style TargetType="TextBox" x:Key="BaseTextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Select All TextBox Style -->
        <Style TargetType="TextBox" x:Key="SelectAllTextBox" BasedOn="{StaticResource BaseTextBox}">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="12" Padding="15,12" Margin="0,0,0,10"
                    Background="{StaticResource PrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SGU CALCULATOR" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RESULT: " FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="80"/>
                            <TextBlock Text=" AED" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Glass Options -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                        <!-- Glass Selection -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="GLASS SELECTION" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Category"/>
                                <ComboBox ItemsSource="{Binding CategoryOptions}" 
                                          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Thickness (mm)"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" 
                                          SelectedItem="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Color"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" 
                                          SelectedItem="{Binding ColorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding ColorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Wastage Consider -->
                        <Border Style="{StaticResource CardBorder}" Background="#FEF3C7" BorderBrush="#FCD34D">
                            <StackPanel>
                                <TextBlock Text="WASTAGE CONSIDER" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding WastageOptions}" 
                                          Text="{Binding WastageConsider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsReadOnly="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Factor: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageFactorDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="  |  Wastage: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageConsiderDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Profit Margin -->
                        <Border Style="{StaticResource CardBorder}" Background="#DCFCE7" BorderBrush="#86EFAC">
                            <StackPanel>
                                <TextBlock Text="PROFIT MARGIN" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding ProfitMarginOptions}" 
                                          Text="{Binding ProfitMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsReadOnly="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Margin: " FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding ProfitMarginDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE: Price Section -->
                    <StackPanel Grid.Column="1" Margin="8,0">

                        <!-- Sheet Price -->
                        <Border Style="{StaticResource CardBorder}" Background="#EFF6FF" BorderBrush="#93C5FD">
                            <StackPanel>
                                <TextBlock Text="PRICE SECTION" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Sheet Price (AED)"/>
                                <TextBox Text="{Binding SheetPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource SelectAllTextBox}"/>
                                <Label Content="Cutting Charge (AED)"/>
                                <TextBox Text="{Binding Cutting, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource SelectAllTextBox}"/>
                                <Label Content="Tempering Charge (AED)"/>
                                <TextBox Text="{Binding Tempering, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource SelectAllTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Calculation Preview -->
                        <Border Style="{StaticResource CardBorder}" Background="#F8FAFC" BorderBrush="#E2E8F0">
                            <StackPanel>
                                <TextBlock Text="CALCULATION PREVIEW" Style="{StaticResource SectionTitle}" Foreground="#1E40AF"/>

                                <!-- INPUT VALUES -->
                                <Border Background="#F0FDF4" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#86EFAC" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="INPUT VALUES" FontWeight="Bold" FontSize="10" Foreground="#166534" Margin="0,0,0,6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Sheet Price:" FontSize="10" Foreground="#64748B"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF">
                                                <Run Text="{Binding SheetPrice, Mode=OneWay, StringFormat={}{0:N2}}"/><Run Text=" AED"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="1" Text="Wastage Factor:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#92400E" Margin="0,2,0,0">
                                                <Run Text="{Binding WastageFactorDisplay, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Text="Cutting:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0">
                                                <Run Text="{Binding Cutting, Mode=OneWay, StringFormat={}{0:N2}}"/><Run Text=" AED"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="3" Text="Tempering:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0">
                                                <Run Text="{Binding Tempering, Mode=OneWay, StringFormat={}{0:N2}}"/><Run Text=" AED"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="4" Text="Profit Margin:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0">
                                                <Run Text="{Binding ProfitMarginDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CALCULATION STEPS -->
                                <Border Background="#ECFDF5" CornerRadius="6" Padding="8" BorderBrush="#6EE7B7" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CALCULATION STEPS" FontWeight="Bold" FontSize="10" Foreground="#047857" Margin="0,0,0,6"/>

                                        <!-- Step 1 -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 1:" FontWeight="Bold" FontSize="10" Foreground="#047857"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#047857">
                                                <Run Text="SheetPrice / WastageFactor = "/>
                                                <Run Text="{Binding BaseCost, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                <Run Text=" AED"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Step 2 -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 2:" FontWeight="Bold" FontSize="10" Foreground="#047857"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#047857">
                                                <Run Text="{Binding BaseCost, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                <Run Text=" + "/>
                                                <Run Text="{Binding ProcessingCost, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                <Run Text=" = "/>
                                                <Run Text="{Binding Subtotal, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                <Run Text=" AED"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Step 3 -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 3:" FontWeight="Bold" FontSize="10" Foreground="#047857"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#047857">
                                                <Run Text="{Binding Subtotal, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                <Run Text=" + ProfitMargin("/>
                                                <Run Text="{Binding ProfitMarginDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#166534"/>
                                                <Run Text=") = "/>
                                                <Run Text="{Binding Result, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="#059669"/>
                                                <Run Text=" AED"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Final Result -->
                                <Border Background="#FEE2E2" CornerRadius="6" Padding="10" Margin="0,8,0,0" BorderBrush="#FECACA" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="FINAL RESULT" FontWeight="Bold" FontSize="10" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Result, Mode=OneWay, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                            <TextBlock Text=" AED" FontSize="14" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: Actions & Info -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- Quick Spec -->
                        <Border Style="{StaticResource CardBorder}" Background="#FEF3C7" BorderBrush="#FCD34D">
                            <StackPanel>
                                <TextBlock Text="SPECIFICATION" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Spec}" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitle}"/>
                                <Button Content="SAVE" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveCommand}"/>
                                <Button Content="EXPORT PDF" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportPdfCommand}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Data Status -->
                        <Border Style="{StaticResource CardBorder}" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="DATA STATUS" FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Text="Categories:" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryOptions.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Text="Thickness:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThicknessOptions.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0"/>

                                    <TextBlock Grid.Row="2" Text="Colors:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ColorOptions.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cache Active" FontSize="10" Foreground="#16A34A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY SECTION -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="HISTORY" Background="#14B8A6" Foreground="White" FontWeight="Bold" 
                            Padding="12,8" HorizontalAlignment="Left"
                            Command="{Binding ClearCommand}"/>
                    <Button Grid.Column="1" Content="CLEAR" Background="#DC2626" Foreground="White" FontWeight="Bold" 
                            Padding="12,8" Margin="8,0,0,0"
                            Command="{Binding ClearCommand}"/>
                    <Button Grid.Column="2" Content="CLEAR ALL" Background="#DC2626" Foreground="White" FontWeight="Bold" 
                            Padding="12,8" Margin="8,0,0,0"
                            Command="{Binding ClearAllCommand}"/>
                </Grid>

                <Border Background="#F0F9FF" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                        MinHeight="100" MaxHeight="200" BorderBrush="#BAE6FD" BorderThickness="1"
                        Visibility="{Binding IsHistoryVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Records, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="4"
                                            BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="260" MaxWidth="320">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding DisplayText, Mode=OneWay}" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Wastage, Mode=OneWay}" FontSize="9" Foreground="#92400E" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ProfitMargin, Mode=OneWay}" FontSize="9" Foreground="#166534"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>