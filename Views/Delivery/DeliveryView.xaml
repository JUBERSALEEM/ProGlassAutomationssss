<UserControl x:Class="ProGlassAutomation.Views.Delivery.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.DataContext>
        <vm:DeliveryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>

        <!-- MODERN DATA GRID -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Black"/>
            <Setter Property="VerticalGridLinesBrush" Value="Black"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="40"/>
        </Style>

        <!-- MODERN CELL -->
        <Style x:Key="ModernCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- MODERN ROW -->
        <Style x:Key="ModernRowStyle" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER OUTLINE BUTTON -->
        <Style x:Key="DangerOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WARNING BUTTON -->
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN COMBOBOX -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- MODERN TEXTBOX -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- MODERN DATEPICKER -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- BLUE HEADER -->
        <Style x:Key="HeaderBlue" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- GREEN HEADER -->
        <Style x:Key="HeaderGreen" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- SLATE HEADER -->
        <Style x:Key="HeaderSlate" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#1E40AF" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DBEAFE" CornerRadius="10" Padding="12,10" Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DELIVERIES" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,4" Margin="12,0,0,0" BorderBrush="#F59E0B" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="PRODUCTION" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Auto-sync from confirmed orders" FontSize="11" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search & Date Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="White" CornerRadius="10" Padding="4" Margin="0,0,12,0" BorderBrush="#3B82F6" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E40AF" CornerRadius="8" Padding="10,8" Margin="2">
                                <TextBlock Text="🔍" FontSize="12"/>
                            </Border>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" 
                                     VerticalAlignment="Center" 
                                     Padding="10,6" 
                                     FontSize="12"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Date From -->
                    <Border Background="White" CornerRadius="10" Padding="12,8" Margin="0,0,8,0" BorderBrush="#10B981" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="FROM" FontSize="9" FontWeight="Bold" Foreground="#059669"/>
                                <DatePicker SelectedDate="{Binding FilterStartDate, UpdateSourceTrigger=PropertyChanged}" 
                                           BorderThickness="0" 
                                           Background="Transparent" 
                                           FontSize="12"
                                           Foreground="#334155"/>
                            </StackPanel>
                            <Border Width="1" Background="#10B981" Opacity="0.3" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Date To -->
                    <Border Background="White" CornerRadius="10" Padding="12,8" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TO" FontSize="9" FontWeight="Bold" Foreground="#D97706"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate, UpdateSourceTrigger=PropertyChanged}" 
                                       BorderThickness="0" 
                                       Background="Transparent" 
                                       FontSize="12"
                                       Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Import" Style="{StaticResource WarningButton}" Command="{Binding ImportConfirmedCommand}" Margin="0,0,6,0"/>
                    <Button Content="📋 Log" Style="{StaticResource PrimaryButton}" Command="{Binding ViewImportLogCommand}" Margin="0,0,6,0"/>
                    <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding ClearFiltersCommand}" Margin="0,0,6,0"/>
                    <Button Content="🖨️ Print" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" Margin="0,0,6,0"/>
                    <Button Content="Export CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. FILTER BAR -->
        <Border Grid.Row="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="#3B82F6" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DBEAFE" Offset="0"/>
                    <GradientStop Color="#BFDBFE" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter: Company -->
                <Border Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="COMPANY" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CompanyOptions}" 
                                 SelectedItem="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Type of Work -->
                <Border Grid.Column="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TYPE OF WORK" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TypeOfWorkOptions}" 
                                 SelectedItem="{Binding FilterTypeOfWork, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Status -->
                <Border Grid.Column="2" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" 
                                 SelectedItem="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Salesman -->
                <Border Grid.Column="3" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SALESMAN" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SalesmanOptions}" 
                                 SelectedItem="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Filter: Color -->
                <Border Grid.Column="4" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ColorOptions}" 
                                 SelectedItem="{Binding FilterColor, UpdateSourceTrigger=PropertyChanged}"
                                 Background="White" BorderBrush="#93C5FD" BorderThickness="1" Padding="10,8" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Clear All Button -->
                <Border Grid.Column="5" CornerRadius="10" Background="#1E40AF" VerticalAlignment="Bottom">
                    <Button Content="Clear All" 
                            Command="{Binding ClearFiltersCommand}" 
                            Padding="20,10"
                            MinWidth="100"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3. DATA GRID -->
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid x:Name="MainDataGrid"
                      ItemsSource="{Binding FilteredDataView}" 
                      SelectedItem="{Binding SelectedDataRowView}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                      Style="{StaticResource ModernDataGrid}" 
                      CellStyle="{StaticResource ModernCell}"
                      RowStyle="{StaticResource ModernRowStyle}"
                      SelectionChanged="MainDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <!-- SELECT CHECKBOX -->
                    <DataGridTemplateColumn Header="" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" 
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=OneWay}"
                                          PreviewMouseDown="CheckBox_PreviewMouseDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="SelectAllCheckBox" Click="HeaderSelectAll_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>

                    <!-- DATE -->
                    <DataGridTemplateColumn Header="DATE" Width="100" HeaderStyle="{StaticResource HeaderGreen}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#D1FAE5" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="11" Foreground="#065F46" FontWeight="Medium"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COMPANY -->
                    <DataGridTemplateColumn Header="COMPANY" Width="150" HeaderStyle="{StaticResource HeaderBlue}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Company}" FontSize="11" Foreground="#1E40AF" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PI NUMBER -->
                    <DataGridTemplateColumn Header="PI NUMBER" Width="130" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PINumber}" FontSize="11" Foreground="#475569" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TYPE -->
                    <DataGridTemplateColumn Header="TYPE" Width="130" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TypeOfWork}" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COLOR -->
                    <DataGridTemplateColumn Header="COLOR" Width="100" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDF2F8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Color}" Value="Clear">
                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Color}" Value="Bronze">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Color}" Value="Grey">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Color}" Value="Blue">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Color}" Value="Green">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Color}" Value="Black">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Color}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#BE185D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Color}" Value="Clear">
                                                        <Setter Property="Foreground" Value="#0369A1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Color}" Value="Bronze">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Color}" Value="Grey">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Color}" Value="Blue">
                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Color}" Value="Green">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Color}" Value="Black">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ORDER QTY -->
                    <DataGridTemplateColumn Header="ORDER QTY" Width="100" HeaderStyle="{StaticResource HeaderBlue}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrderQty}" FontSize="12" Foreground="#1E40AF" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- DELIVERED -->
                    <DataGridTemplateColumn Header="DELIVERED" Width="100" HeaderStyle="{StaticResource HeaderGreen}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalDelivered}" FontSize="12" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- RETURNED -->
                    <DataGridTemplateColumn Header="RETURNED" Width="90" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalReturned}" FontSize="12" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- BALANCE -->
                    <DataGridTemplateColumn Header="BALANCE" Width="90" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Balance}"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Balance}" Value="0">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SQM -->
                    <DataGridTemplateColumn Header="SQM" Width="80" HeaderStyle="{StaticResource HeaderBlue}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrderSQM, StringFormat=N2}" FontSize="12" Foreground="#3B82F6" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SALESMAN -->
                    <DataGridTemplateColumn Header="SALESMAN" Width="120" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Salesman}" FontSize="11" Foreground="#475569" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STATUS -->
                    <DataGridTemplateColumn Header="STATUS" Width="120" HeaderStyle="{StaticResource HeaderGreen}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Partially Delivered">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partially Delivered">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NOTES -->
                    <DataGridTemplateColumn Header="NOTES" Width="80" HeaderStyle="{StaticResource HeaderSlate}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📋 View" 
                                        FontSize="10" 
                                        Padding="8,4"
                                        Command="{Binding DataContext.ViewNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Notes}"
                                        Background="#F1F5F9"
                                        Foreground="#475569"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. STATS BAR -->
        <Border Grid.Row="3" CornerRadius="12" Padding="12" Margin="0,12,0,0" Background="White"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL STATS -->
                <Border Grid.Column="0" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                        BorderBrush="#3B82F6" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Background="#1E40AF" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="TOTAL STATS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="REC" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalRecords}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ORDER" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOrderQty}" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DEL" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalDelivered}" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#DC2626" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RET" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalReturned}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="4,3" Margin="0,0,3,0" BorderBrush="#F59E0B" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="BAL" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalBalance}" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Background="White" CornerRadius="6" Padding="4,3" BorderBrush="#64748B" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SQM" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOrderSQM, StringFormat=N2}" FontSize="13" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FILTERED STATS -->
                <Border Grid.Column="1" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                        BorderBrush="#3B82F6" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Background="#3B82F6" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="FILTERED STATS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RECORDS" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredRecords}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="6,4" Margin="0,0,4,0" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ORDER QTY" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredOrderQty}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="6,4" BorderBrush="#3B82F6" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DELIVERED" FontSize="7" Foreground="#1E40AF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredDelivered}" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SELECTED + ACTIONS -->
                <Border Grid.Column="2" CornerRadius="10" Padding="12"
                        BorderBrush="#7C3AED" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F5F3FF" Offset="0"/>
                            <GradientStop Color="#EDE9FE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selected Count -->
                        <Border Background="#7C3AED" CornerRadius="10" Padding="12,8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="#DDD6FE" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCount}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="Details" Style="{StaticResource PrimaryButton}" Command="{Binding ViewDetailsCommand}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <Button Content="Add" Style="{StaticResource SuccessButton}" Command="{Binding AddDeliveryCommand}" IsEnabled="{Binding SelectedOrder, Converter={StaticResource NullToBoolConverter}}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <Button Content="Edit" Style="{StaticResource PrimaryButton}" Command="{Binding EditCommand}" CommandParameter="{Binding SelectedDataRowView}" Padding="10,5" Margin="0,0,4,0" FontSize="9"/>
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedDataRowView}" Padding="10,5" FontSize="9"/>
                            </WrapPanel>
                            <Button Content="Delete Selected" Style="{StaticResource DangerOutlineButton}" Command="{Binding DeleteSelectedCommand}" CommandParameter="{Binding ElementName=MainDataGrid}" Padding="10,5" FontSize="9"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- VIEW DETAILS POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsViewingDetails, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="60,30" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="800" MaxWidth="1000"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📦 DELIVERY DETAILS" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text=" - " FontSize="20" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedOrder.PINumber}" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="8" Background="#DBEAFE" Padding="16" Margin="0,0,0,16" BorderBrush="#3B82F6" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COMPANY" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.Company}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ORDER QTY" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.OrderQty}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DELIVERED" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.TotalDelivered}" FontSize="14" FontWeight="Bold" Foreground="#059669"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="RETURNED" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.TotalReturned}" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="BALANCE" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.Balance}" FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="SQM" FontSize="9" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedOrder.OrderSQM, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="#475569"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1E40AF" CornerRadius="8,8,0,0" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DATE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="DELIVERED" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="RETURNED" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="3" Text="DRIVER" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="4" Text="VEHICLE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="5" Text="NOTES" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Grid.Column="6" Text="ACTION" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <ItemsControl ItemsSource="{Binding SelectedOrder.DeliveryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DeliveryDate, StringFormat='{}{0:dd-MM-yyyy}'}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DeliveredQty}" FontSize="12" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ReturnedQty}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Driver}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Vehicle}" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Notes}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="✏️" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.EditDeliveryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Edit"/>
                                                        <Button Content="🗑️" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.DeleteDeliveryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Delete"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕ Add Delivery" Style="{StaticResource SuccessButton}" 
                                Command="{Binding AddDeliveryCommand}" 
                                Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding CancelCommand}" 
                                Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ADD DELIVERY POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsAddingDelivery, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="100,60" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="450"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="➕ ADD DELIVERY" FontSize="20" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="DELIVERY DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding EditingDeliveryItem.DeliveryDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="DELIVERED QTY *" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItem.DeliveredQty}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="RETURNED QTY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItem.ReturnedQty}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="DRIVER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding DriverOptions}" 
                                     SelectedItem="{Binding EditingDeliveryItem.Driver}"
                                     IsEditable="True"
                                     Text="{Binding EditingDeliveryItem.Driver, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="VEHICLE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding VehicleOptions}" 
                                     SelectedItem="{Binding EditingDeliveryItem.Vehicle}"
                                     IsEditable="True"
                                     Text="{Binding EditingDeliveryItem.Vehicle, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItem.Notes}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="8" Background="#FEF3C7" Padding="12" Margin="0,0,0,12"
                                BorderBrush="#F59E0B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Info: Current Balance" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#D97706">
                                    <Run Text="{Binding SelectedOrder.Balance, Mode=OneWay}"/>
                                    <Run Text=" pcs remaining"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Save Delivery" Style="{StaticResource SuccessButton}" Command="{Binding SaveDeliveryCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- EDIT POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="80,40" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="650"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✏️ EDIT ORDER" FontSize="20" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding EditingOrder.Date}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingOrder.Company}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="PI NUMBER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingOrder.PINumber}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="TYPE OF WORK" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding TypeOfWorkOptions}" 
                                     SelectedItem="{Binding EditingOrder.TypeOfWork}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding ColorOptions}" 
                                     SelectedItem="{Binding EditingOrder.Color}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="ORDER QTY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingOrder.OrderQty}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="ORDER SQM" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingOrder.OrderSQM}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,12">
                            <TextBlock Text="SALESMAN" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding SalesmanOptions}" 
                                     SelectedItem="{Binding EditingOrder.Salesman}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding StatusOptions}" 
                                     SelectedItem="{Binding EditingOrder.Status}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" 
                                    Text="{Binding EditingOrder.Notes}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="60"
                                    GotFocus="TextBox_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Save" Style="{StaticResource SuccessButton}" Command="{Binding SaveCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- NOTES VIEW POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsViewingNotes, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="500" MaxWidth="700"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📋 ORDER NOTES" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text=" - " FontSize="20" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedOrder.PINumber}" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>

                    <Border CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="20" Margin="0,0,0,20">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ViewNotesContent}" 
                                       FontSize="14" 
                                       Foreground="#1E293B" 
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseNotesCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DELETE CONFIRM POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsDeletingDeliveryItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="400"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⚠️ CONFIRM DELETE" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,20"/>

                    <Border CornerRadius="8" Background="#FEE2E2" Padding="16" Margin="0,0,0,20" BorderBrush="#DC2626" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Are you sure you want to delete this delivery record?" FontSize="14" Foreground="#991B1B" FontWeight="Medium" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date:" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfirmDeleteItem.DeliveryDate, StringFormat='{}{0:dd-MM-yyyy}'}" Foreground="#1E293B" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Delivered:" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfirmDeleteItem.DeliveredQty}" Foreground="#059669" FontWeight="Bold" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Returned:" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfirmDeleteItem.ReturnedQty}" Foreground="#DC2626" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="This action cannot be undone. The order balance will be updated accordingly." FontSize="12" Foreground="#64748B" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteDeliveryItemCommand}" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding ConfirmDeleteDeliveryItemCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- EDIT DELIVERY ITEM POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsEditingDeliveryItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="100,60" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="450"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✏️ EDIT DELIVERY" FontSize="20" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="DELIVERY DATE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding EditingDeliveryItemFromDb.DeliveryDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="DELIVERED QTY *" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItemFromDb.DeliveredQty}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="RETURNED QTY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItemFromDb.ReturnedQty}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="DRIVER" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding DriverOptions}" 
                                     SelectedItem="{Binding EditingDeliveryItemFromDb.Driver}"
                                     IsEditable="True"
                                     Text="{Binding EditingDeliveryItemFromDb.Driver, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="VEHICLE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                     ItemsSource="{Binding VehicleOptions}" 
                                     SelectedItem="{Binding EditingDeliveryItemFromDb.Vehicle}"
                                     IsEditable="True"
                                     Text="{Binding EditingDeliveryItemFromDb.Vehicle, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditingDeliveryItemFromDb.Notes}" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="8" Background="#FEF3C7" Padding="12" Margin="0,0,0,12"
                                BorderBrush="#F59E0B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Info: Order Balance" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#D97706">
                                    <Run Text="{Binding SelectedOrder.Balance, Mode=OneWay}"/>
                                    <Run Text=" pcs remaining"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditDeliveryItemCommand}" Margin="0,0,12,0" Padding="20,10"/>
                        <Button Content="Save Changes" Style="{StaticResource SuccessButton}" Command="{Binding SaveEditDeliveryItemCommand}" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- IMPORT LOG POPUP -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsViewingImportLog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="12" Padding="30" Margin="40,20" Background="White" VerticalAlignment="Stretch"
                    BorderBrush="#CBD5E1" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 IMPORT HISTORY" FontSize="22" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock Text=" - " FontSize="22" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ImportHistory.Count, StringFormat='{}{0} sessions'}" FontSize="16" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Complete history of all import changes" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ImportHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#1E40AF" CornerRadius="8,8,0,0" Padding="20,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SessionDateTime, StringFormat='{}{0:dd-MM-yyyy HH:mm:ss}'}" 
                                                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Border Background="White" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                                                                <TextBlock Foreground="#1E40AF" FontSize="11" FontWeight="Bold">
                                                                    <Run Text="{Binding UpdatedOrders, Mode=OneWay}"/>
                                                                    <Run Text=" orders updated"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <Border Background="#059669" CornerRadius="12" Padding="10,4">
                                                                <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                                    <Run Text="{Binding TotalChanges, Mode=OneWay}"/>
                                                                    <Run Text=" changes"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBox Grid.Column="1" 
                                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="250" 
                                                             Padding="12,10" 
                                                             FontSize="12"
                                                             BorderThickness="0"
                                                             Background="#DBEAFE"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,16">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="10,6" Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding PINumber}" FontSize="13" FontWeight="Bold" Foreground="#92400E"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Company}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" | " FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ImportDateTime, StringFormat='{}{0:HH:mm:ss}'}" 
                                                                               FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Changes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#F8FAFC" CornerRadius="4" Padding="12,8" Margin="0,0,0,6"
                                                                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="130"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" 
                                                                                               FontWeight="Bold" Foreground="#475569" 
                                                                                               VerticalAlignment="Center"/>

                                                                                    <TextBlock Grid.Column="1" 
                                                                                               Text="{Binding OldValue}" 
                                                                                               Foreground="#DC2626" 
                                                                                               TextDecorations="Strikethrough"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="10,0"/>

                                                                                    <TextBlock Grid.Column="2" Text="→" 
                                                                                               FontSize="14" FontWeight="Bold" 
                                                                                               Foreground="#64748B" 
                                                                                               VerticalAlignment="Center" 
                                                                                               Margin="10,0"/>

                                                                                    <TextBlock Grid.Column="3" 
                                                                                               Text="{Binding NewValue}" 
                                                                                               FontWeight="Bold" Foreground="#059669" 
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Border Background="#DBEAFE" CornerRadius="8" Padding="16,12" Margin="0,0,16,0" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock FontSize="12" Foreground="#1E40AF">
                                <Run Text="Total: "/>
                                <Run Text="{Binding ImportHistory.Count, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text=" import sessions"/>
                            </TextBlock>
                        </Border>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding CloseImportLogCommand}" Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>