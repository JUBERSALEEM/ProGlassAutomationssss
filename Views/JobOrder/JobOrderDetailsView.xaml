<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White" Padding="20,16" 
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" 
                        Command="{Binding BackCommand}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Back to List"/>
                    </StackPanel>
                </Button>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Job Order Details" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#2563EB" CornerRadius="6" Padding="8,4" Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentJobOrder.JobNumber}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="View and manage job order information" FontSize="12" Foreground="#64748B" Margin="26,4,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🖨️ Print" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                    <Button Content="📤 Export" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
                    <Button Content="✏️ Edit" Style="{StaticResource ModernButton}" 
                            Command="{Binding EditCommand}" Margin="0,0,8,0"/>
                    <Button Content="🚚 Convert to Delivery" Style="{StaticResource SuccessButton}" 
                            Command="{Binding ConvertToDeliveryCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== LEFT COLUMN ==================== -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">

                        <!-- Job Order Info Card -->
                        <Border Style="{StaticResource InfoCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📋 JOB ORDER INFORMATION" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Job Number -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Job Number" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.JobNumber}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Date -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="Date" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.Date, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Customer -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Customer" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.CustomerName}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Salesman -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="Salesman" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.Salesman}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Status -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Status" Style="{StaticResource LabelText}"/>
                                        <Border CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentJobOrder.Status}" Value="In Progress">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurrentJobOrder.Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CurrentJobOrder.Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentJobOrder.Status}" Value="In Progress">
                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentJobOrder.Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Priority -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="Priority" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.Priority}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Notes -->
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                        <TextBlock Text="Notes" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding CurrentJobOrder.Notes}" Style="{StaticResource ValueText}" 
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Related Proforma Invoice Card -->
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🧾 RELATED PROFORMA INVOICE" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- PI Number -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="PI Number" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding RelatedProformaInvoice.PINumber}" Style="{StaticResource ValueText}" 
                                                   Foreground="#2563EB" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- PI Date -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="PI Date" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding RelatedProformaInvoice.Date, StringFormat={}{0:dd/MM/yyyy}}" 
                                                   Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- PI Customer -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                        <TextBlock Text="Customer" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding RelatedProformaInvoice.CustomerName}" Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- PI Total -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                        <TextBlock Text="Total Amount" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding RelatedProformaInvoice.TotalAmount, StringFormat={}{0:N2}}" 
                                                   Style="{StaticResource ValueText}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- View PI Button -->
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="👁️ View Full Proforma Invoice" 
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Command="{Binding ViewProformaInvoiceCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== RIGHT COLUMN ==================== -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">

                        <!-- Summary Card -->
                        <Border Style="{StaticResource InfoCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📊 ORDER SUMMARY" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total Qty -->
                                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Total Qty" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentJobOrder.TotalQty}" FontSize="24" FontWeight="Bold" 
                                                       Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Total SQM -->
                                    <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Total SQM" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentJobOrder.TotalSQM, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" 
                                                       Foreground="#059669" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Items List Card -->
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="📦 JOB ORDER ITEMS" Style="{StaticResource SectionTitle}"/>
                                    <Border Background="#2563EB" CornerRadius="10" Padding="8,4" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding CurrentJobOrder.Items.Count}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Items DataGrid -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" MaxHeight="400">
                                    <DataGrid ItemsSource="{Binding CurrentJobOrder.Items}" 
                                              AutoGenerateColumns="False" 
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowBackground="White"
                                              AlternatingRowBackground="#F8FAFC"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="12,10"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.Columns>
                                            <!-- Sr No -->
                                            <DataGridTextColumn Header="Sr No" Binding="{Binding SrNo}" Width="60">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Glass Ref -->
                                            <DataGridTextColumn Header="Glass Ref" Binding="{Binding GlassRef}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Width -->
                                            <DataGridTextColumn Header="Width" Binding="{Binding Width1}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Height -->
                                            <DataGridTextColumn Header="Height" Binding="{Binding Height1}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Qty -->
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- SQM -->
                                            <DataGridTextColumn Header="SQM" Binding="{Binding SQM, StringFormat={}{0:N2}}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Delivered -->
                                            <DataGridTextColumn Header="Delivered" Binding="{Binding DeliveredQty}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Status -->
                                            <DataGridTemplateColumn Header="Status" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>