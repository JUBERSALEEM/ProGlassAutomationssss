<UserControl x:Class="ProGlassAutomation.Views.JobOrder.JobOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- PATCH 5: BoolToVisibilityConverter -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#4A6FA5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#166088"/>
        <SolidColorBrush x:Key="LightBrush" Color="#E8ECF0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D4A6F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2744"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" PanningMode="VerticalOnly" Background="#F5F5F5">
            <StackPanel Margin="24">

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Job Order" FontSize="20" FontWeight="Light" Foreground="#1F2937" FontFamily="{StaticResource PrimaryFont}"/>
                        <TextBlock Text="Create and manage job orders from proforma invoices" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" FontFamily="{StaticResource PrimaryFont}"/>
                    </StackPanel>
                    <!-- PATCH 1: Print Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Print Preview" Style="{StaticResource SecondaryButton}" Command="{Binding PrintPreviewCommand}" Padding="16,10" Margin="0,0,8,0"/>
                        <Button Content="Print" Style="{StaticResource PrimaryButton}" Command="{Binding PrintJobOrderCommand}" Padding="16,10" Margin="0,0,8,0"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveJobOrderCommand}" Padding="16,10" Margin="0,0,8,0"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteJobOrderCommand}" Padding="16,10"/>
                    </StackPanel>
                </Grid>

                <!-- Company Info -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Company Name" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TRN Number" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding CompanyTRN, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Location" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Job Order Info -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Job Order No" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding JobOrderNumber, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Job Date" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding JobOrderDate}" Padding="6,4" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Required Date" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding RequiredDate}" Padding="6,4" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status & Reference -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- PATCH 3: ComboBox SelectedValue with TwoWay -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <ComboBox SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Padding="6,4" FontSize="11">
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="In Progress"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Cancelled"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reference PI" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding PINumber, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Customer and Project Details -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Customer Details -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Customer Details" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                    <TextBlock Text="Company Name" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="TRN Number" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CustomerTRN, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                    <TextBlock Text="Customer Reference" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CustomerReference, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Salesman" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Salesman, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Address" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" TextWrapping="Wrap" Height="28"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Project Details -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Project Details" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Project Name" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Project No." FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ProjectNo, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Location" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ProjectLocation, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Additional Details -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Additional Details" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="LPO No." FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LPONo, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Attention" FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding AttentionName, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Contact No." FontSize="10" Foreground="#6B7280" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ContactNo, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Specifications -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Specifications" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+ Add Spec" Style="{StaticResource PrimaryButton}" Command="{Binding AddSpecificationCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="10"/>
                                <Button Content="- Remove" Style="{StaticResource DangerButton}" Command="{Binding RemoveSpecificationCommand}" Padding="10,4" FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <!-- ItemsControl with Virtualization -->
                        <ItemsControl ItemsSource="{Binding Specifications}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,10" CornerRadius="4" Background="#FAFAFA">
                                        <StackPanel>
                                            <!-- Spec Header -->
                                            <Border Background="#F3F4F6" Padding="8,6" CornerRadius="4,4,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="SPEC:" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SpecificationName, UpdateSourceTrigger=LostFocus}" FontSize="10" Padding="6,3" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FFFFFF" MinWidth="100"/>
                                                    <Button Grid.Column="2" Content="+ Add Row" Style="{StaticResource SecondaryButton}" Click="AddRow_Click" Tag="{Binding}" Padding="8,4" FontSize="10"/>
                                                </Grid>
                                            </Border>

                                            <!-- DataGrid with Virtualization -->
                                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0" Background="#FFFFFF" Margin="0" Padding="0" ColumnHeaderStyle="{StaticResource CleanDataGridHeader}" CellStyle="{StaticResource CleanDataGridCell}" RowStyle="{StaticResource CleanDataGridRow}" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" RowHeight="28" SelectionUnit="Cell" AlternationCount="2" FocusVisualStyle="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="40" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Glass Ref" Binding="{Binding GlassRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="6,0"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="W1" Binding="{Binding Width1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="H1" Binding="{Binding Height1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="W2" Binding="{Binding Width2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="H2" Binding="{Binding Height2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="55">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="45">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="SQM" Binding="{Binding SQM1, Mode=OneWay, StringFormat=N4}" Width="65" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Total SQM" Binding="{Binding TotalSQM, Mode=OneWay, StringFormat=N4}" Width="75" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Background" Value="#1E3A5F"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="" Width="30">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="X" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Click="DeleteRow_Click" Tag="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Spec Footer -->
                                            <Border Background="#1E3A5F" Padding="5,4" CornerRadius="0,0,4,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="" FontSize="8" Foreground="#FFFFFF"/>
                                                    <TextBlock Grid.Column="1" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="" FontSize="8" Foreground="#FFFFFF"/>
                                                    <TextBlock Grid.Column="3" Text="" FontSize="8" Foreground="#FFFFFF"/>
                                                    <TextBlock Grid.Column="4" Text="" FontSize="8" Foreground="#FFFFFF"/>
                                                    <TextBlock Grid.Column="5" Text="" FontSize="8" Foreground="#FFFFFF"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Items.Count, Mode=OneWay, StringFormat=N0}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding TotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding TotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Other Charges -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Other Charges" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0"/>
                            <Button Grid.Column="1" Content="+ Add Charge" Command="{Binding AddOtherChargeCommand}" Padding="12,6" FontSize="11" Background="#1E3A5F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Other Charges Header -->
                        <Grid Background="#F3F4F6" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Charge Name" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="Type" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Value" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
                            <TextBlock Grid.Column="4" Text="Linked Specs" FontSize="10" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="5" Text="" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- PATCH 5: Other Charges ItemsControl with AlternationCount -->
                        <ItemsControl ItemsSource="{Binding AllOtherCharges}" AlternationCount="100">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,2" Padding="8" Background="White" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="8,6" Margin="4,0" VerticalAlignment="Center" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                            <!-- PATCH 3: ComboBox SelectedValue with TwoWay -->
                                            <ComboBox Grid.Column="2" SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" FontSize="11" Padding="8,6" Margin="4,0" VerticalAlignment="Center" HorizontalContentAlignment="Center">
                                                <ComboBoxItem Content="LM" Tag="lm"/>
                                                <ComboBoxItem Content="SQM" Tag="sqm"/>
                                                <ComboBoxItem Content="QTY" Tag="qty"/>
                                            </ComboBox>
                                            <TextBox Grid.Column="3" Text="{Binding Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="8,6" Margin="4,0" VerticalAlignment="Center" HorizontalContentAlignment="Right" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <CheckBox Content="All Specs" IsChecked="{Binding TargetsAllSpecs}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="5" Content="X" Command="{Binding DataContext.DeleteOtherChargeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="28" Height="28" FontSize="11" FontWeight="Bold" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- PATCH 5: HasNoCharges with converter -->
                        <TextBlock Text="No other charges added" FontSize="11" Foreground="#9CA3AF" FontStyle="Italic" Margin="8,12" HorizontalAlignment="Center" Visibility="{Binding HasNoCharges, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- PATCH 5: Other Charges Total with HasOtherCharges -->
                        <Border Background="#1E3A5F" Padding="12,8" CornerRadius="4" Margin="0,8,0,0" Visibility="{Binding HasOtherCharges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total Other Charges" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AllOtherChargesTotal, StringFormat='AED {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Summary -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Job Order Summary" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="Total Quantities" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total SQM" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSQM, Mode=OneWay, StringFormat=N4}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total LM" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalLM, Mode=OneWay, StringFormat=N4}" FontSize="12" FontWeight="SemiBold" Foreground="#4A6FA5"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Qty" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalQty, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="Glass 2 (DGU)" FontSize="12" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total SQM" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSQM2, Mode=OneWay, StringFormat=N4}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </Grid>
                                    <!-- Glass 2 LM - removed, LM is now combined (LM1 + LM2) -->
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notes" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,12"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,8" FontSize="13" Foreground="#1F2937" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border Background="#1E3A5F" Padding="16,12" CornerRadius="6" Margin="0,0,0,24">
                    <TextBlock Text="PROGLASS AUTOMATION | Dubai, UAE" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>