<UserControl x:Class="ProGlassAutomation.Views.DGULamination.DGULaminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters">

    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
    </UserControl.Resources>

    <Grid Background="#D6ECFF">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <Grid>

                <Border Background="White"
                        CornerRadius="25"
                        Padding="20"
                        Margin="10"
                        BorderBrush="#DCEBFF"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================= LEFT SIDE (LOCKED UI) ================= -->
                        <StackPanel Grid.Column="0">

                            <Border Background="#0A6ED1"
                                    CornerRadius="14"
                                    Padding="10"
                                    Margin="5">

                                <TextBlock Text="🧩 DGU + LAMINATION CALCULATOR"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- OUTER GLASS -->
                            <Border Background="#0A6ED1" CornerRadius="14" Padding="10" Margin="5">
                                <StackPanel>

                                    <TextBlock Text="🪟 OUTER GLASS"
                                               Foreground="White"/>

                                    <TextBlock Text="📏 THICKNESS"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding GlassThicknessOptions}"
                                              SelectedItem="{Binding Thickness1, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="🎨 COLOR"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding ColorOptions}"
                                              SelectedItem="{Binding Color1, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="💰 PRICE"
                                               Foreground="White"/>

                                    <TextBox Text="{Binding Sheet1, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"/>

                                </StackPanel>
                            </Border>

                            <!-- INNER GLASS -->
                            <Border Background="#0A6ED1" CornerRadius="14" Padding="10" Margin="5">
                                <StackPanel>

                                    <TextBlock Text="🪟 INNER GLASS"
                                               Foreground="White"/>

                                    <TextBlock Text="📏 THICKNESS"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding GlassThicknessOptions}"
                                              SelectedItem="{Binding Thickness2, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="🎨 COLOR"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding ColorOptions}"
                                              SelectedItem="{Binding Color2, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="💰 PRICE"
                                               Foreground="White"/>

                                    <TextBox Text="{Binding Sheet2, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"/>

                                </StackPanel>
                            </Border>

                            <!-- LAMINATION -->
                            <Border Background="#0854A0" CornerRadius="14" Padding="10" Margin="5">
                                <StackPanel>

                                    <TextBlock Text="🧪 LAMINATION GLASS"
                                               Foreground="White"/>

                                    <TextBlock Text="📏 THICKNESS"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding GlassThicknessOptions}"
                                              SelectedItem="{Binding Thickness3, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="🎨 COLOR"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding ColorOptions}"
                                              SelectedItem="{Binding Color3, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="💰 PRICE"
                                               Foreground="White"/>

                                    <TextBox Text="{Binding Sheet3, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"/>

                                </StackPanel>
                            </Border>

                            <!-- ASP MODULE -->
                            <Border Background="#0854A0" CornerRadius="14" Padding="10" Margin="5">
                                <StackPanel>

                                    <TextBlock Text="⚙ ASP MODULE"
                                               Foreground="White"/>

                                    <TextBlock Text="📏 THICKNESS"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding AspThicknessOptions}"
                                              SelectedItem="{Binding AspThickness, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="⚙ ASP TYPE"
                                               Foreground="White"/>

                                    <ComboBox ItemsSource="{Binding AspTypeOptions}"
                                              SelectedItem="{Binding AspType, Mode=TwoWay}"
                                              Height="30"/>

                                    <TextBlock Text="💰 ASP PRICE"
                                               Foreground="White"/>

                                    <TextBox Text="{Binding AspPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"/>

                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ================= RIGHT SIDE (GUIDE + STATUS ADDED) ================= -->
                        <StackPanel Grid.Column="1">

                            <!-- RESULT -->
                            <Border Background="#0A6ED1"
                                    CornerRadius="14"
                                    Padding="10"
                                    Margin="5">

                                <TextBlock Text="{Binding Result}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- HISTORY -->
                            <Border Background="#0A6ED1"
                                    CornerRadius="14"
                                    Padding="8"
                                    Margin="5">

                                <TextBlock Text="📜 HISTORY"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- REDUCED HEIGHT HISTORY BOX -->
                            <ListBox ItemsSource="{Binding Records}"
                                     Height="160"/>

                            <!-- PROFIT MARGIN WITH HEADER & TOOLTIP -->
                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="5"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1">

                                <StackPanel>
                                    <TextBlock Text="💹 PROFIT MARGIN"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               ToolTip="Set your desired profit percentage (15%-35%). This will be automatically applied to the total cost calculation."/>

                                    <ComboBox IsEditable="True"
                                              Text="{Binding ProfitMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Height="30">
                                        <ComboBoxItem Content="15%"/>
                                        <ComboBoxItem Content="20%"/>
                                        <ComboBoxItem Content="25%"/>
                                        <ComboBoxItem Content="30%"/>
                                        <ComboBoxItem Content="35%"/>
                                    </ComboBox>
                                </StackPanel>

                            </Border>

                            <!-- OUTSOURCE PVB WITH HEADER & TOOLTIP -->
                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="5"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1">

                                <StackPanel>
                                    <TextBlock Text="📤 OUTSOURCE PVB"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Margin="0,0,0,5"
                                               ToolTip="Enter additional outsource costs for PVB lamination bonding, transportation, or special processing fees."/>

                                    <TextBox Text="{Binding OutsourcePrice, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"/>
                                </StackPanel>

                            </Border>

                            <!-- ================= GUIDE (NEW LOCKED FEATURE) ================= -->
                            <Border Background="#F8FAFC"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="5"
                                    BorderBrush="#D0D0D0"
                                    BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="📘 STEP GUIDE"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="1️⃣ Select glass thickness for each layer"/>
                                    <TextBlock Text="2️⃣ Choose color type (clear/grey/tinted)"/>
                                    <TextBlock Text="3️⃣ Enter price per sheet manually"/>
                                    <TextBlock Text="4️⃣ Configure ASP spacer system"/>
                                    <TextBlock Text="5️⃣ Set lamination PVB bonding value"/>
                                    <TextBlock Text="6️⃣ Apply profit margin (15%–35%)"/>
                                    <TextBlock Text="7️⃣ Add outsource cost if applicable"/>

                                </StackPanel>

                            </Border>

                            <!-- ================= MODULE STATUS (COLORFUL BALLS - STYLISH) ================= -->
                            <Border Background="#E8F1FF"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="5">

                                <StackPanel>

                                    <TextBlock Text="📊 MODULE STATUS"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Margin="0,0,12,12"/>

                                    <!-- Outer Glass - GREEN -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="#10B981"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#059669" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="Outer Glass" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Inner Glass - YELLOW -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="#F59E0B"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#D97706" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="Inner Glass" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Lamination - RED -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="#EF4444"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#DC2626" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="Lamination" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- ASP Module - GREEN -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="#10B981"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#059669" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="ASP Module" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>