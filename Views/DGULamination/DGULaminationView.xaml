<UserControl x:Class="ProGlassAutomation.Views.DGULamination.DGULaminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.DGULamination">

    <UserControl.DataContext>
        <vm:DGULaminationViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#14B8A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style - Manual Edit + Dropdown -->
        <Style x:Key="EditCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="IsEditable" Value="True"/>
        </Style>

        <Style x:Key="ThemedBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="SecBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#E8F4FC" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER + RESULT -->
            <Border Grid.Row="0" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A5F" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🧩 DGU + LAMINATION CALCULATOR" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Double Glazed Unit with Lamination" Foreground="#BFDBFE" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Width="180">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊 RESULT: " FontWeight="Bold" FontSize="14" Foreground="#1E3A5F" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result}" FontSize="18" FontWeight="Bold" Foreground="#0891B2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT - GLASS SELECTION -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Style="{StaticResource SecBorder}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                            <StackPanel>
                                <TextBlock Text="🪟 OUTER GLASS" FontWeight="Bold" FontSize="14" Foreground="#1E3A5F" Margin="0,0,0,6"/>
                                <TextBlock Text="Thickness" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding GlassThicknessOptions}" 
                                          SelectedItem="{Binding Thickness1}" 
                                          Text="{Binding Thickness1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                                <TextBlock Text="Color" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" 
                                          SelectedItem="{Binding Color1}" 
                                          Text="{Binding Color1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecBorder}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                            <StackPanel>
                                <TextBlock Text="🪟 INNER GLASS" FontWeight="Bold" FontSize="14" Foreground="#1E3A5F" Margin="0,0,0,6"/>
                                <TextBlock Text="Thickness" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding GlassThicknessOptions}" 
                                          SelectedItem="{Binding Thickness2}" 
                                          Text="{Binding Thickness2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                                <TextBlock Text="Color" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" 
                                          SelectedItem="{Binding Color2}" 
                                          Text="{Binding Color2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecBorder}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                            <StackPanel>
                                <TextBlock Text="🧪 LAMINATION GLASS" FontWeight="Bold" FontSize="14" Foreground="#1E3A5F" Margin="0,0,0,6"/>
                                <TextBlock Text="Thickness" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding GlassThicknessOptions}" 
                                          SelectedItem="{Binding Thickness3}" 
                                          Text="{Binding Thickness3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                                <TextBlock Text="Color" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" 
                                          SelectedItem="{Binding Color3}" 
                                          Text="{Binding Color3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE - PRICE INPUT -->
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <Border Style="{StaticResource SecBorder}" Background="#FEF9C3" BorderBrush="#FCD34D" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="💰 PRICE INPUT (AED)" FontWeight="Bold" FontSize="13" Foreground="#92400E" Margin="0,0,0,8"/>
                                <TextBlock Text="Outer Glass Price" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding Sheet1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedBox}"/>
                                <TextBlock Text="Inner Glass Price" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding Sheet2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedBox}"/>
                                <TextBlock Text="Lamination Price" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding Sheet3, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedBox}"/>
                                <TextBlock Text="ASP Price" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding AspPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedBox}"/>
                                <TextBlock Text="Outsource PVB Cost" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding OutsourcePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ThemedBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecBorder}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                            <StackPanel>
                                <TextBlock Text="⚙ ASP MODULE" FontWeight="Bold" FontSize="14" Foreground="#1E3A5F" Margin="0,0,0,6"/>
                                <TextBlock Text="Thickness" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding AspThicknessOptions}" 
                                          SelectedItem="{Binding AspThickness}" 
                                          Text="{Binding AspThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                                <TextBlock Text="Type" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding AspTypeOptions}" 
                                          SelectedItem="{Binding AspType}" 
                                          Text="{Binding AspType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT - PROFIT + SAVE + GUIDE + STATUS -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- PROFIT MARGIN -->
                        <Border Style="{StaticResource SecBorder}" Background="#F0FDFA" BorderBrush="#5EEAD4">
                            <StackPanel>
                                <TextBlock Text="📈 PROFIT MARGIN" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding ProfitOptions}" 
                                          SelectedItem="{Binding ProfitMargin}" 
                                          Text="{Binding ProfitMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{StaticResource EditCombo}"/>
                            </StackPanel>
                        </Border>

                        <!-- SAVE BUTTON -->
                        <Button Content="💾 SAVE RECORD" Command="{Binding SaveCommand}" Background="#1E40AF" Foreground="White" FontWeight="Bold" FontSize="13" Height="40" Margin="0,0,0,10"/>

                        <!-- STEP GUIDE -->
                        <Border Style="{StaticResource SecBorder}" Background="#F0FDFA" BorderBrush="#5EEAD4">
                            <StackPanel>
                                <TextBlock Text="📘 STEP GUIDE" FontWeight="Bold" FontSize="12" Foreground="#0F766E" Margin="0,0,0,8"/>
                                <TextBlock Text="1️⃣ Select glass thickness" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="2️⃣ Choose color type" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="3️⃣ Enter price per sheet" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="4️⃣ Configure ASP system" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="5️⃣ Set PVB bonding" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="6️⃣ Apply profit margin" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                                <TextBlock Text="7️⃣ Add outsource cost" FontSize="11" Foreground="#334155" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- MODULE STATUS -->
                        <Border Style="{StaticResource SecBorder}" Background="#E0F2FE" BorderBrush="#7DD3FC">
                            <StackPanel>
                                <TextBlock Text="📊 MODULE STATUS" FontWeight="Bold" FontSize="13" Foreground="#0369A1" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="Outer Glass" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="14" Height="14" Fill="#F59E0B" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="Inner Glass" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="14" Height="14" Fill="#EF4444" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="Lamination" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="White" StrokeThickness="2"/>
                                    <TextBlock Text="ASP Module" FontWeight="SemiBold" FontSize="12" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY SECTION -->
            <Border Grid.Row="2" Margin="0,10,0,0">
                <StackPanel>
                    <ToggleButton Content="📜 HISTORY RECORDS" IsChecked="{Binding IsHistoryVisible}" Style="{StaticResource ToggleBtn}" HorizontalAlignment="Stretch"/>
                    <Border Background="#F0F9FF" CornerRadius="10" Padding="12" Margin="0,10,0,0" Height="150" BorderBrush="#BAE6FD" BorderThickness="1" Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisConverter}}">
                        <ListBox ItemsSource="{Binding Records}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="280">
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>