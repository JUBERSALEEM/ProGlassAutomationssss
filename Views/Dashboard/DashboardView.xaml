<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.Dashboard"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             Background="#F4F7FB">

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SalesPink" Color="#EC4899"/>
        <SolidColorBrush x:Key="PurpleAccent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="SheetStoreBlue" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="DeliveryOrange" Color="#F97316"/>

        <!-- Card Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="4" Opacity="0.05" Direction="270"/>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#EFF6FF"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- HEADER -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title -->
                        <StackPanel>
                            <TextBlock Text="Sales Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Track revenue, compare salesmen and monitor performance growth" 
                                       FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Right: Filter -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" 
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="FilterComboBox" Style="{StaticResource FilterComboBox}" Width="160" 
                                      SelectionChanged="FilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="Today"/>
                                <ComboBoxItem Content="This Week" IsSelected="True"/>
                                <ComboBoxItem Content="This Month"/>
                                <ComboBoxItem Content="This Year"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- STATS GRID -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Revenue -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,9,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Total Revenue" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Border Grid.Column="1" Style="{StaticResource StatIcon}">
                                    <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock Text="{Binding TotalRevenue}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="{Binding RevenueGrowth}" FontSize="13" FontWeight="SemiBold" 
                                          Foreground="{StaticResource SuccessGreen}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Orders -->
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,9,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Orders" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Border Grid.Column="1" Style="{StaticResource StatIcon}">
                                    <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Orders}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="{Binding OrdersGrowth}" FontSize="13" FontWeight="SemiBold" 
                                          Foreground="{StaticResource SuccessGreen}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Salesmen -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0,0,9,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Salesmen" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Border Grid.Column="1" Style="{StaticResource StatIcon}">
                                    <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock Text="{Binding Salesmen}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Active Team" FontSize="13" FontWeight="SemiBold" 
                                          Foreground="{StaticResource SuccessGreen}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pending Quotes -->
                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Pending Quotes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <Border Grid.Column="1" Style="{StaticResource StatIcon}">
                                    <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock Text="{Binding PendingQuotes}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource WarningOrange}"/>
                                <TextBlock Text="Awaiting Approval" FontSize="13" FontWeight="SemiBold" 
                                          Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- MAIN GRID: CHART + SALESMAN -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CHART CARD -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Sales Analytics" FontSize="20" FontWeight="Bold" 
                                      Foreground="{StaticResource TextDark}" Margin="0,0,0,20"/>

                            <Border Grid.Row="1" Background="#FAFBFC" CornerRadius="12" Padding="10" MinHeight="420">
                                <Grid>
                                    <lvc:CartesianChart Series="{Binding ChartSeries}" 
                                                       XAxes="{Binding ChartXAxes}" 
                                                       YAxes="{Binding ChartYAxes}"/>

                                    <!-- Empty State -->
                                    <StackPanel x:Name="ChartEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No sales data available" FontSize="16" Foreground="{StaticResource TextMuted}" 
                                                 HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="Create proforma invoices to see the chart" FontSize="13" 
                                                 Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SALESMAN CARD -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Salesman Comparison" FontSize="20" FontWeight="Bold" 
                                      Foreground="{StaticResource TextDark}" Margin="0,0,0,20"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- 1. Mr Pradeep (TOP) -->
                                    <Border Background="#FDF2F8" CornerRadius="14" Padding="14" Margin="0,0,0,12" BorderBrush="#EC4899" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👑" FontSize="12"/>
                                                    <TextBlock Text="Mr Pradeep" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SalesPink}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[0]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#EC4899" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[0]}" 
                                                      FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Mr Sooraj -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Sooraj" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[1]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#3B82F6" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[1]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Mr Aftab Akram -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Aftab Akram" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[2]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#10B981" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[2]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Ms Maya Ibrahim -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👩" FontSize="12"/>
                                                    <TextBlock Text="Ms Maya Ibrahim" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[3]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#8B5CF6" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[3]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Mr Najim -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Najim" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[4]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#F59E0B" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[4]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Mr Bilal -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Bilal" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[5]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#06B6D4" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[5]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 7. Mr Salman (Sunny) -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="☀️" FontSize="12"/>
                                                    <TextBlock Text="Mr Salman (Sunny)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[6]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#EF4444" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[6]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 8. Mr Harvinder -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Harvinder" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[7]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#84CC16" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[7]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 9. Mr Talha -->
                                    <Border Background="#F9FAFB" CornerRadius="14" Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="👨" FontSize="12"/>
                                                    <TextBlock Text="Mr Talha" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SalesmanAmounts[8]}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="8" Background="#E5E7EB" CornerRadius="30" Margin="0,10,0,0">
                                                <Border Height="8" Background="#F97316" CornerRadius="30" 
                                                       HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                            <TextBlock Text="{Binding SalesmanDiffs[8]}" 
                                                      FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- KEY MODULES -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <TextBlock Text="📦 KEY MODULES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                <!-- 1. SALES - FULL WIDTH TOP PANEL -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" BorderBrush="{StaticResource SalesPink}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Title -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#FDF2F8">
                                <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SALES" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SalesPink}"/>
                                <TextBlock Text="Proforma Invoices &amp; Quotations" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Stats -->
                        <Grid Grid.Column="1" Margin="40,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Total Invoices" FontSize="12" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PITotal}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SalesPink}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Confirmed" FontSize="12" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PIConfirmed}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Pending" FontSize="12" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PIPending}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Total Value" FontSize="12" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PIValue}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Right: Button -->
                        <Button Grid.Column="2" Content="📄 View Sales" Click="ProformaInvoice_Click"
                              Style="{StaticResource PrimaryButton}" Background="#EC4899" Height="48" Padding="20,10" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- 2. OTHER MODULES ROW (3 COLUMNS) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- JOB ORDERS -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" BorderBrush="{StaticResource PurpleAccent}" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#EDE9FE">
                                    <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="JOB ORDERS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PurpleAccent}"/>
                                    <TextBlock Text="Work Orders" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding JOTotal}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PurpleAccent}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="In Progress" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding JOInProgress}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Completed" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding JOCompleted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2" Content="📋 View Jobs" Click="JobOrders_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#8B5CF6" Height="44" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- DELIVERIES -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0" BorderBrush="{StaticResource DeliveryOrange}" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#FFF7ED">
                                    <TextBlock Text="🚚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DELIVERIES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DeliveryOrange}"/>
                                    <TextBlock Text="Order Tracking" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Pending" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DelPending}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Completed" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DelCompleted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding DelTotal}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2" Content="🚚 View Deliveries" Click="Deliveries_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#F97316" Height="44" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- SHEET STORE -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{StaticResource SheetStoreBlue}" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="48" Height="48" CornerRadius="12" Background="#E0F2FE">
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SHEET STORE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SheetStoreBlue}"/>
                                    <TextBlock Text="Inventory" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Stock" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding SheetTotal}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SheetStoreBlue}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Available" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding SheetAvailable}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Types" FontSize="10" Foreground="{StaticResource TextMuted}" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding SheetTypes}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2" Content="📦 View Store" Click="SheetStore_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#0EA5E9" Height="44" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- BALANCE OVERVIEW -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <TextBlock Text="💰 BALANCE OVERVIEW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Daily Balance -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#D1FAE5" Margin="0,0,0,10">
                                <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Today's Balance" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DailyBalance}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Rev: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding TodayRevenue}" FontSize="10" Foreground="{StaticResource SuccessGreen}"/>
                                <TextBlock Text=" | Exp: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding TodayExpenses}" FontSize="10" Foreground="{StaticResource DangerRed}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Monthly Balance -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#DBEAFE" Margin="0,0,0,10">
                                <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="This Month" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonthlyBalance}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MonthlyChange}" FontSize="10" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Annual Balance -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#EDE9FE" Margin="0,0,0,10">
                                <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="This Year" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AnnualBalance}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PurpleAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AnnualChange}" FontSize="10" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔄 Sync Now" Click="SyncBalance_Click"
                              Style="{StaticResource PrimaryButton}" Height="42" Padding="16,8"/>
                        <Button Content="📊 View Reports" Click="ViewBalanceReports_Click"
                              Background="Transparent" Foreground="{StaticResource PrimaryBlue}"
                              FontWeight="SemiBold" FontSize="12" Padding="16,8" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <!-- ACTIVITY & STATUS -->
                <!-- ══════════════════════════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Activity Log -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📜" FontSize="14"/>
                                <TextBlock Text="Recent Activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                            </StackPanel>

                            <ListBox x:Name="ActivityLogList" BorderThickness="0" MaxHeight="180" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="📭 No recent activity" FontSize="10" Foreground="{StaticResource TextMuted}" 
                                     HorizontalAlignment="Center" Margin="0,10,0,0"/>

                            <Button Content="🔄 Refresh All" Click="Refresh_Click"
                                  Style="{StaticResource PrimaryButton}" FontSize="10" Padding="12,6" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Service Status Sidebar -->
                    <StackPanel Grid.Column="1">

                        <!-- Service Status -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🔗" FontSize="14"/>
                                    <TextBlock Text="Service Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,10">
                                        <TextBlock Text="Connection" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}"/>
                                            <TextBlock Text="Online" FontSize="10" Foreground="{StaticResource SuccessGreen}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="Balance Feed" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}"/>
                                            <TextBlock Text="Active" FontSize="10" Foreground="{StaticResource SuccessGreen}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,10">
                                        <TextBlock Text="Pending Deliveries" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding DelPending}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningOrange}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Text="Completed Today" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding DelCompleted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,6,0">
                                        <TextBlock Text="Transactions" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="2">
                                        <TextBlock Text="Last Sync" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding LastSync}" FontSize="10" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding LastUpdate}" 
                                           FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- License Status -->
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource DangerRed}" BorderThickness="2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🛡️" FontSize="14"/>
                                    <TextBlock Text="License Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <Border Background="#FEE2E2" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="⚠️ ACTION REQUIRED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                                </Border>

                                <TextBlock Text="SYSTEM INACTIVE" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="License validation failed" FontSize="10" Foreground="{StaticResource DangerRed}" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DangerRed}"/>
                                    <TextBlock Text="Remaining: " FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"/>
                                    <TextBlock Text="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                                    <TextBlock Text=" days" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>

                                <Button Content="🚀 Activate Now" Click="ActivateNow_Click" 
                                      Style="{StaticResource PrimaryButton}" FontSize="11" Padding="16,10" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>