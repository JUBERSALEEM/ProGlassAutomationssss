<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.Dashboard"
             Background="#F0F4F8">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="PurpleAccent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SheetStoreBlue" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="DailyWorksGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="DeliveryOrange" Color="#F97316"/>

        <DropShadowEffect x:Key="GlassShadow" BlurRadius="15" ShadowDepth="4" Opacity="0.08" Direction="270"/>

        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        </Style>

        <Style x:Key="HighlightCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        </Style>

        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">

                <!-- HEADER -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BlueGradient}">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Operations Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <Border Background="#ECFDF5" CornerRadius="10" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LiveIndicator" Width="8" Height="8" Fill="{StaticResource SuccessGreen}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:1" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Real-time production monitoring &amp; analytics" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource MetricCard}" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionIndicator" Width="6" Height="6" Fill="{StaticResource DangerRed}"/>
                                    <TextBlock x:Name="ConnectionStatusText" Text="Offline" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="12"/>
                                    <TextBlock x:Name="SubscriptionStatusText" Text="Inactive" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DangerRed}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KEY MODULES HEADER -->
                <TextBlock Text="📦 KEY MODULES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                <!-- MODULE CARDS ROW -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SHEET STORE -->
                    <Border Grid.Column="0" Style="{StaticResource HighlightCard}" Margin="0,0,6,0" BorderBrush="{StaticResource SheetStoreBlue}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="44" Height="44" CornerRadius="10" Background="#E0F2FE">
                                    <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="SHEET STORE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SheetStoreBlue}"/>
                                    <TextBlock Text="Inventory Management" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Total Stock" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="SheetTotalStock" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SheetStoreBlue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Available" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="SheetBalance" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1">
                                    <TextBlock Text="Types" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="SheetTypes" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Value" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="SheetValue" Text="$0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="SheetStoreBtn" Grid.Row="2" Content="📦 View Store" Click="SheetStore_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#0EA5E9"/>
                        </Grid>
                    </Border>

                    <!-- DAILY WORKS -->
                    <Border Grid.Column="1" Style="{StaticResource HighlightCard}" Margin="0,0,6,0" BorderBrush="{StaticResource DailyWorksGreen}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="44" Height="44" CornerRadius="10" Background="#DCFCE7">
                                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="DAILY WORKS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DailyWorksGreen}"/>
                                    <TextBlock Text="Production Orders" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Today Orders" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="WorksTodayCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DailyWorksGreen}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Today SQM" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="WorksTodaySQM" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1">
                                    <TextBlock Text="Total Records" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="WorksTotalRecords" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Total SQM" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="WorksTotalSQM" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PurpleAccent}"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="DailyWorksBtn" Grid.Row="2" Content="📋 View Works" Click="DailyWorks_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#22C55E"/>
                        </Grid>
                    </Border>

                    <!-- DELIVERIES -->
                    <Border Grid.Column="2" Style="{StaticResource HighlightCard}" BorderBrush="{StaticResource DeliveryOrange}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="44" Height="44" CornerRadius="10" Background="#FFF7ED">
                                    <TextBlock Text="🚚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="DELIVERIES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DeliveryOrange}"/>
                                    <TextBlock Text="Order Tracking" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Pending" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DeliveriesPending" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningOrange}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Completed" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DeliveriesCompleted" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1">
                                    <TextBlock Text="Total Orders" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DeliveriesTotal" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="1">
                                    <TextBlock Text="Balance" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DeliveriesBalance" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerRed}"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="DeliveriesBtn" Grid.Row="2" Content="🚚 View Deliveries" Click="Deliveries_Click"
                                  Style="{StaticResource PrimaryButton}" Background="#F97316"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- QUICK METRICS HEADER -->
                <TextBlock Text="📊 QUICK METRICS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,8,0,10"/>

                <!-- METRICS ROW -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Production -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource IconBadge}" Background="#DBEAFE">
                                    <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Production" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LiveProductionText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            <TextBlock Text="sqm today" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="ProductionChangeText" Text="▲ +0%" FontSize="9" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Efficiency -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource IconBadge}" Background="#D1FAE5">
                                    <TextBlock Text="🎯" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Efficiency" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="EfficiencyText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                            <ProgressBar x:Name="EfficiencyBar" Height="4" Margin="0,6,0,0" Background="#F1F5F9" Foreground="{StaticResource SuccessGreen}" Value="0" Maximum="100"/>
                        </StackPanel>
                    </Border>

                    <!-- Uptime -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource IconBadge}" Background="#FEF3C7">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Uptime" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="UptimeText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningOrange}"/>
                            <TextBlock Text="24h average" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Calculations -->
                    <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource IconBadge}" Background="#EDE9FE">
                                    <TextBlock Text="🧮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Calculations" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CalculationsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PurpleAccent}"/>
                            <TextBlock Text="this session" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Balance -->
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource IconBadge}" Background="#CFFAFE">
                                    <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Balance" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DailyBalanceText" Text="$0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                            <TextBlock Text="today" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- LICENSE + MODULES ROW -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LICENSE CARD -->
                    <Border x:Name="SubscriptionCard" Style="{StaticResource Card}" BorderBrush="{StaticResource DangerRed}" BorderThickness="2" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Background="#FEE2E2" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="⚠️ LICENSE REQUIRED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                            </Border>
                            <TextBlock x:Name="StatusText" Text="INACTIVE" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="{StaticResource DangerRed}"/>
                                <TextBlock Text="⏰" FontSize="12" Margin="6,0,0,0"/>
                                <TextBlock Text="Remaining: " FontSize="10" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0"/>
                                <TextBlock x:Name="DaysText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                                <TextBlock Text=" days" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <Button x:Name="ActivateBtn" Content="🚀 Activate System" Click="ActivateNow_Click" 
                                  Background="{StaticResource BlueGradient}" Foreground="White" FontWeight="SemiBold" 
                                  FontSize="11" Padding="16,8" Margin="0,10,0,0" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- MODULES GRID -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SGU Module -->
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource MetricCard}" Margin="0,0,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource BlueGradient}">
                                    <TextBlock Text="🧮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SGU Calculator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="SguLiveCounter" Text="" FontSize="9" Foreground="{StaticResource SuccessGreen}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Single glass unit" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="SguCountText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <Border x:Name="SguStatus" Style="{StaticResource StatusBadge}" Background="#FEE2E2">
                                        <TextBlock x:Name="SguStatusText" Text="🔒" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DGU Module -->
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource MetricCard}" Margin="0,0,6,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource BlueGradient}">
                                    <TextBlock Text="📑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DGU Calculator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="DguLiveCounter" Text="" FontSize="9" Foreground="{StaticResource SuccessGreen}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Double glass unit" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DguCountText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <Border x:Name="DguStatus" Style="{StaticResource StatusBadge}" Background="#FEE2E2">
                                        <TextBlock x:Name="DguStatusText" Text="🔒" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lamination Module -->
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource MetricCard}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource BlueGradient}">
                                    <TextBlock Text="🔳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Lamination" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <TextBlock x:Name="LamLiveCounter" Text="" FontSize="9" Foreground="{StaticResource SuccessGreen}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Safety glass layering" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="LamCountText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                    <Border x:Name="LamStatus" Style="{StaticResource StatusBadge}" Background="#FEE2E2">
                                        <TextBlock x:Name="LamStatusText" Text="🔒" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DGU + Lamination Module -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource BlueGradient}">
                                    <TextBlock Text="🪟" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DGU + Lamination" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                        <Border Background="#ECFDF5" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="⭐" FontSize="8" Foreground="{StaticResource SuccessGreen}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Laminated insulated units" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="DguLamStatus" Style="{StaticResource StatusBadge}" Background="#FEE2E2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DguLamStatusText" Text="🔒" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Optimization Module -->
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource BlueGradient}">
                                    <TextBlock Text="✂️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="Optimization" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Cutting optimizer" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="OptStatus" Style="{StaticResource StatusBadge}" Background="#FEE2E2" VerticalAlignment="Center">
                                    <TextBlock x:Name="OptStatusText" Text="🔒" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- MODULE COUNT + BALANCE ROW -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: BALANCE SECTION -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">

                        <!-- Module Count Card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="#DBEAFE">
                                    <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Active Modules" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="ModuleCountText" Text="0/5 Active" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SguTotalText" Text="SGU: 0 sqm" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DguTotalText" Text="DGU: 0 sqm" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="LamTotalText" Text="Lam: 0 sqm" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Balance Overview -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#D1FAE5" Margin="0,0,0,6">
                                        <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Daily" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DailyBalanceText2" Text="AED 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#DBEAFE" Margin="0,0,0,6">
                                        <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Monthly" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MonthlyBalanceText" Text="AED 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#EDE9FE" Margin="0,0,0,6">
                                        <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Annual" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AnnualBalanceText" Text="AED 0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PurpleAccent}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Balance Details -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="💵 Revenue" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TodayRevenueText" Text="AED 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="💸 Expenses" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TodayExpensesText" Text="AED 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📊 Net" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="NetIncomeText" Text="AED 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="🔢 Transactions" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TransactionsText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="🔄 Sync Now" Click="SyncBalance_Click"
                                  Background="{StaticResource BlueGradient}" Foreground="White"
                                  FontWeight="SemiBold" FontSize="10" Padding="14,6" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="📊 View Reports" Click="ViewBalanceReports_Click"
                                  Background="Transparent" Foreground="{StaticResource PrimaryBlue}"
                                  FontWeight="SemiBold" FontSize="10" Padding="14,6" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- RIGHT: SIDEBAR -->
                    <StackPanel Grid.Column="1">

                        <!-- Activity Log -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📜" FontSize="14"/>
                                    <TextBlock Text="Recent Activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <ListBox x:Name="ActivityLogList" BorderThickness="0" MaxHeight="150" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="4" Padding="8,6" Margin="0,0,0,3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="8" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="NoActivityText" Text="📭 No recent activity" FontSize="10" Foreground="{StaticResource TextMuted}" 
                                         HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Service Status -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🔗" FontSize="14"/>
                                    <TextBlock Text="Service Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,8">
                                        <TextBlock Text="Live Feed" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Ellipse x:Name="BalanceServiceIndicator" Width="6" Height="6" Fill="{StaticResource DangerRed}"/>
                                            <TextBlock x:Name="BalanceServiceStatusText" Text="Offline" FontSize="10" Foreground="{StaticResource DangerRed}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Last Sync" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="LastSyncText" Text="--:--:--" FontSize="10" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1">
                                        <TextBlock Text="⏳ Pending" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="PendingDeliveriesText" Text="0" FontSize="10" Foreground="{StaticResource WarningOrange}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1">
                                        <TextBlock Text="✅ Completed" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="CompletedTodayText" Text="0" FontSize="10" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="LastUpdateText" Text="Last update: --:--:--" 
                                           FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>