<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             Background="#F1F5F9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- HEADER -->
            <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x25EB;" FontSize="20" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProGlass Automation" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Analytics Dashboard" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" CornerRadius="20" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastUpdate}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6 KPI CARDS -->
            <UniformGrid Columns="6" Margin="0,0,0,20">
                <!-- Card 1 -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#3B82F6" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Proforma Invoices" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ProformaCard.Value}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#1E293B" Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+12.4%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="vs last month" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#DBEAFE" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F4C4;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2 -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#10B981" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Job Orders" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding JobOrdersCard.Value}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#1E293B" Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+8.2%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="vs last month" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#D1FAE5" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F4CB;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3 -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#8B5CF6" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Avg Optimization" FontSize="11" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="{Binding OptimizationCard.Value}" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="%" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+3.1%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="vs last month" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#EDE9FE" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x26A1;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4 -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#F59E0B" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Daily Output" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding DailyOutputCard.Value}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#1E293B" Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="-2.1%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#EF4444" Margin="0,0,4,0"/>
                                <TextBlock Text="vs yesterday" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FEF3C7" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F3ED;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 5 -->
                <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#F43F5E" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Deliveries Today" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding DeliveriesCard.Value}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#1E293B" Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+6.3%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="vs yesterday" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FFE4E6" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F69A;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 6 -->
                <Border Background="White" CornerRadius="16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Border Height="4" Background="#06B6D4" VerticalAlignment="Top" 
                                Margin="-20,-20,-20,10" CornerRadius="2,2,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Sheet Inventory" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InventoryCard.Value}" FontSize="24" FontWeight="Bold" 
                                       Foreground="#1E293B" Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="-4.5%" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="#EF4444" Margin="0,0,4,0"/>
                                <TextBlock Text="vs last week" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#CFFAFE" 
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F4E6;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- CHARTS ROW 1 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Daily Production Trend" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Last 30 days" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Series="{Binding DailyTrendSeries}" 
                                           XAxes="{Binding DailyTrendXAxes}" 
                                           YAxes="{Binding DailyTrendYAxes}" 
                                           Height="280"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Weekly Job Orders" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Completed vs In Progress vs Pending" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Series="{Binding WeeklyJobSeries}" 
                                           XAxes="{Binding WeeklyJobXAxes}" 
                                           YAxes="{Binding WeeklyJobYAxes}" 
                                           Height="280"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CHARTS ROW 2 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Product Mix" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="By glass type" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                        <lvc:PieChart Series="{Binding ProductMixSeries}" Height="260"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Machine Utilization" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Average %" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                        <lvc:CartesianChart Series="{Binding MachineUtilSeries}" 
                                           XAxes="{Binding MachineUtilXAxes}" 
                                           YAxes="{Binding MachineUtilYAxes}" 
                                           Height="260"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Delivery Status" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="This month" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                        <lvc:PieChart Series="{Binding DeliveryStatusSeries}" Height="260"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- OPTIMIZATION CHART -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Optimization Efficiency" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text="Efficiency % and waste tracking" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                    <lvc:CartesianChart Series="{Binding OptimizationSeries}" 
                                       XAxes="{Binding OptimizationXAxes}" 
                                       YAxes="{Binding OptimizationYAxes}" 
                                       Height="280"/>
                </StackPanel>
            </Border>

            <!-- DAILY WORKS DATA TABLE - READ ONLY -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Daily Work Records" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding DailyWorksCount}" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#3B82F6" Margin="12,0,0,0"/>
                            <TextBlock Text="records from DailyWorks" FontSize="14" Foreground="#64748B" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh Data" Command="{Binding RefreshCommand}" 
                                Background="#2563EB" Foreground="White" Padding="16,8" BorderThickness="0"/>
                    </Grid>

                    <!-- Data Grid - Read Only -->
                    <DataGrid ItemsSource="{Binding DailyWorkRecords}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="48"
                              Background="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsHitTestVisible="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="180"/>
                            <DataGridTextColumn Header="PI Number" Binding="{Binding PiNumber}" Width="120"/>
                            <DataGridTextColumn Header="Customer Ref" Binding="{Binding CustomerReference}" Width="130"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeOfWork}" Width="110"/>
                            <DataGridTextColumn Header="Production" Binding="{Binding ProductionStatus}" Width="100"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="60"/>
                            <DataGridTextColumn Header="SQM" Binding="{Binding Sqm}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Salesman" Binding="{Binding Salesman}" Width="120"/>
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- DELIVERY SECTION - READ ONLY -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Delivery Orders" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding DeliveryCount}" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#F59E0B" Margin="12,0,0,0"/>
                            <TextBlock Text="orders" FontSize="14" Foreground="#64748B" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#F0FDF4" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock FontSize="12">
                                    <Run Text="Balance: " Foreground="#64748B"/>
                                    <Run Text="{Binding TotalBalanceQty}" FontWeight="SemiBold" Foreground="#10B981"/>
                                </TextBlock>
                            </Border>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                                    Background="#2563EB" Foreground="White" Padding="16,8" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Delivery Stats Cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Order Qty" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalDeliveryQty}" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Delivered" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalDeliveredQty}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Balance" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalBalanceQty}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Total SQM" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalDeliverySQM, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Delivery Trend Chart -->
                    <Border Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Delivery Trend" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                            <lvc:CartesianChart Series="{Binding DeliveryTrendSeries}" 
                                               XAxes="{Binding DeliveryTrendXAxes}" 
                                               YAxes="{Binding DeliveryTrendYAxes}" 
                                               Height="200"/>
                        </StackPanel>
                    </Border>

                    <!-- Delivery Data Grid -->
                    <DataGrid ItemsSource="{Binding DeliveryRecords}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="44"
                              Background="White"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="90"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="160"/>
                            <DataGridTextColumn Header="PI Number" Binding="{Binding PINumber}" Width="110"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeOfWork}" Width="100"/>
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                            <DataGridTextColumn Header="Order Qty" Binding="{Binding OrderQty}" Width="80"/>
                            <DataGridTextColumn Header="Delivered" Binding="{Binding TotalDelivered}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SQM" Binding="{Binding OrderSQM, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Salesman" Binding="{Binding Salesman}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <TextBlock Text="ProGlass Automation 2024" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>