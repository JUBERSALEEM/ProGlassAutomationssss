<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- HEADER SECTION -->
            <!-- ════════════════════════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="📊 Dashboard" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Sales performance overview and analytics" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Today" Padding="16,8" Margin="0,0,8,0" 
                                Background="{Binding DayFilterBg}" Foreground="{Binding DayFilterFg}"
                                BorderThickness="0" Cursor="Hand" Command="{Binding DayFilterCommand}"/>
                        <Button Content="This Week" Padding="16,8" Margin="0,0,8,0" 
                                Background="{Binding WeekFilterBg}" Foreground="{Binding WeekFilterFg}"
                                BorderThickness="0" Cursor="Hand" Command="{Binding WeekFilterCommand}"/>
                        <Button Content="This Month" Padding="16,8" Margin="0,0,8,0" 
                                Background="{Binding MonthFilterBg}" Foreground="{Binding MonthFilterFg}"
                                BorderThickness="0" Cursor="Hand" Command="{Binding MonthFilterCommand}"/>
                        <Button Content="This Year" Padding="16,8" 
                                Background="{Binding YearFilterBg}" Foreground="{Binding YearFilterFg}"
                                BorderThickness="0" Cursor="Hand" Command="{Binding YearFilterCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- MAIN STATS CARDS -->
            <!-- ════════════════════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue Card -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#DBEAFE">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Revenue" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding RevenueGrowth}" FontSize="12" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- Orders Card -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#F1F5F9">
                                <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Orders" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Orders}" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding OrdersGrowth}" FontSize="12" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- Salesmen Card -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#F1F5F9">
                                <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Salesmen" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Salesmen}" FontSize="28" FontWeight="Bold" Foreground="#1E293B" Margin="0,12,0,4"/>
                        <TextBlock Text="Active team" FontSize="12" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- Pending Quotes Card -->
                <Border Grid.Column="3" Background="White" CornerRadius="16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FEF3C7">
                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pending" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingQuotes}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,12,0,4"/>
                        <TextBlock Text="Awaiting approval" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- CHARTS SECTION -->
            <!-- ════════════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sales Trend Chart -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📈 Sales Trend" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="10" Height="260">
                            <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Height="240"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Salesman Performance Chart -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🏆 Salesman Performance" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="10" Height="260">
                            <lvc:CartesianChart Series="{Binding SalesmanChartSeries}" XAxes="{Binding SalesmanChartXAxes}" YAxes="{Binding SalesmanChartYAxes}" Height="240"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- SALESMAN LIST -->
            <!-- ════════════════════════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👥 Sales Team" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Salesman 1 -->
                        <Border Grid.Column="0" Background="#FDF2F8" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[0].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#EC4899" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[0].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 2 -->
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[1].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[1].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 3 -->
                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[2].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[2].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 4 -->
                        <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[3].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[3].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 5 -->
                        <Border Grid.Column="4" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[4].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[4].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 6 -->
                        <Border Grid.Column="5" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[5].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[5].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 7 -->
                        <Border Grid.Column="6" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[6].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[6].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 8 -->
                        <Border Grid.Column="7" Background="#F1F5F9" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[7].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[7].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Salesman 9 -->
                        <Border Grid.Column="8" Background="#F1F5F9" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanList[8].Name}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SalesmanList[8].Amount}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- KEY MODULES -->
            <!-- ════════════════════════════════════════════════════════════════════ -->
            <TextBlock Text="🔑 KEY MODULES" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

            <!-- MODULES GRID -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SALES MODULE -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0" BorderBrush="#EC4899" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FDF2F8">
                                <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="SALES" FontSize="15" FontWeight="Bold" Foreground="#EC4899"/>
                                <TextBlock Text="Proforma Invoices" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PITotal}" FontSize="22" FontWeight="Bold" Foreground="#EC4899" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Confirmed" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PIConfirmed}" FontSize="22" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pending" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PIPending}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- JOB ORDERS MODULE -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0" BorderBrush="#8B5CF6" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#EDE9FE">
                                <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="JOB ORDERS" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6"/>
                                <TextBlock Text="Work Orders" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOTotal}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="In Progress" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOInProgress}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Completed" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOCompleted}" FontSize="22" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DELIVERIES MODULE -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20" BorderBrush="#F97316" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF7ED">
                                <TextBlock Text="🚚" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="DELIVERIES" FontSize="15" FontWeight="Bold" Foreground="#F97316"/>
                                <TextBlock Text="Order Tracking" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pending" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelPending}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Completed" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelCompleted}" FontSize="22" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total" FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelTotal}" FontSize="22" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- BALANCE OVERVIEW -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <TextBlock Text="💵 BALANCE OVERVIEW" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Daily Balance -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#D1FAE5" Margin="0,0,0,10">
                            <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Today" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DailyBalance}" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Monthly Balance -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#DBEAFE" Margin="0,0,0,10">
                            <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="This Month" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MonthlyBalance}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Annual Balance -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#EDE9FE" Margin="0,0,0,10">
                            <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="This Year" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AnnualBalance}" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- QUICK ACTIONS -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔄 Sync Data" Background="#2563EB" Foreground="White" Padding="18,10" FontWeight="SemiBold" Cursor="Hand" Click="SyncBalance_Click"/>
                    <Button Content="👥 Salesmen List" Background="#8B5CF6" Foreground="White" Padding="18,10" FontWeight="SemiBold" Margin="10,0,0,0" Click="ShowSalesmen_Click"/>
                    <Button Content="📊 Refresh All" Background="#10B981" Foreground="White" Padding="18,10" FontWeight="SemiBold" Margin="10,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════════════ -->
            <!-- STATUS SECTION -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Database Stats -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📊 Database Stats" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock x:Name="DbStatsText" Text="Loading..." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" MinHeight="60"/>
                    </StackPanel>
                </Border>

                <!-- Service Status -->
                <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔌 Service Status" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#10B981"/>
                            <TextBlock Text="Database Online" FontSize="11" Foreground="#10B981" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="#10B981"/>
                            <TextBlock Text="System Active" FontSize="11" Foreground="#10B981" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastUpdate}" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>