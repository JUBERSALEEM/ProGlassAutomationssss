<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Modern Filter Button Style -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Sync, Sales Team) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern KPI Card Style -->
        <Style x:Key="KPICard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- ============ HERO HEADER ============ -->
            <Border Background="#FFFFFF" CornerRadius="20" Padding="28" Margin="0,0,0,20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.08" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="PG" FontSize="18" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="ProGlass Automation" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Operational analytics · Invoices · Jobs · Delivery · Inventory"
                                           FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Live/Syncing/Synced indicator -->
                        <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1"
                                CornerRadius="20" Padding="12,6" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" Margin="0,0,6,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.3" Duration="0:0:0.6"
                                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusTextColor}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastUpdate}" FontSize="11" Foreground="#94A3B8"
                                   HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedFilter}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2563EB" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ FILTER BAR ============ -->
            <Border Background="#FFFFFF" CornerRadius="16" Padding="20" Margin="0,0,0,20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Today" Style="{StaticResource FilterButton}"
                                Background="{Binding DayFilterBg}" Foreground="{Binding DayFilterFg}"
                                Command="{Binding DayFilterCommand}"/>
                        <Button Content="This Week" Style="{StaticResource FilterButton}"
                                Background="{Binding WeekFilterBg}" Foreground="{Binding WeekFilterFg}"
                                Command="{Binding WeekFilterCommand}"/>
                        <Button Content="This Month" Style="{StaticResource FilterButton}"
                                Background="{Binding MonthFilterBg}" Foreground="{Binding MonthFilterFg}"
                                Command="{Binding MonthFilterCommand}"/>
                        <Button Content="This Year" Style="{StaticResource FilterButton}"
                                Background="{Binding YearFilterBg}" Foreground="{Binding YearFilterFg}"
                                Command="{Binding YearFilterCommand}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- SYNC BUTTON (with syncing + success states) -->
                        <Button Style="{StaticResource ActionButton}"
                                Background="{Binding SyncButtonBackground}"
                                Command="{Binding SyncCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Sync all data from database">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SyncButtonIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1.2"
                                                                                 RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.RenderTransform>
                                        <RotateTransform/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding SyncButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Content="👥  Sales Team" Style="{StaticResource ActionButton}"
                                Background="#8B5CF6"
                                Click="ShowSalesmen_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ KPI ROW (Main Metrics) ============ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Revenue -->
                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#DBEAFE">
                                <TextBlock Text="💰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Revenue" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRevenue}" Margin="0,0,0,6" Foreground="#2563EB" FontSize="26" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▲ " FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RevenueGrowth}" FontSize="11" Foreground="#059669" FontWeight="SemiBold"/>
                            <TextBlock Text=" vs last period" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Orders -->
                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#D1FAE5">
                                <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Orders" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Orders}" Margin="0,0,0,6" Foreground="#0F172A" FontSize="26" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▲ " FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                            <TextBlock Text="{Binding OrdersGrowth}" FontSize="11" Foreground="#059669" FontWeight="SemiBold"/>
                            <TextBlock Text=" vs last period" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Salesmen -->
                <Border Grid.Column="2" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#EDE9FE">
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Salesmen" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Salesmen}" Margin="0,0,0,6" Foreground="#7C3AED" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Active team members" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Pending Quotes -->
                <Border Grid.Column="3" Style="{StaticResource KPICard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FEF3C7">
                                <TextBlock Text="⏰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pending Quotes" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingQuotes}" Margin="0,0,0,6" Foreground="#D97706" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Awaiting approval" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ DELIVERY SUMMARY ============ -->
            <TextBlock Text="DELIVERY SUMMARY" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FEF3C7">
                                <TextBlock Text="⏳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PENDING DELIVERIES" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DelPending}" FontSize="32" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock Text="In progress" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#D1FAE5">
                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#059669"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="COMPLETED DELIVERIES" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DelCompleted}" FontSize="32" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="Delivered successfully" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KPICard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="📋" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TOTAL DELIVERIES" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DelTotal}" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="All orders" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ DELIVERY QUANTITIES ============ -->
            <TextBlock Text="DELIVERY QUANTITIES" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Order Qty" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DeliveryTotalQty}" FontSize="28" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="{Binding DelTotal, StringFormat='{}{0} orders'}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#D1FAE5" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#059669"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Delivered" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DeliveryTotalDelivered}" FontSize="28" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="items delivered" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#FEE2E2" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="↩" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Returned" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DeliveryTotalReturned}" FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="items returned" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource KPICard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="32" Height="32" CornerRadius="8" Background="#FEF3C7" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="⏳" FontSize="14" FontWeight="Bold" Foreground="#D97706"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Pending/Balance" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DeliveryTotalBalance}" FontSize="28" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock Text="remaining to deliver" FontSize="11" Foreground="#F59E0B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ CHARTS ============ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Production Trend" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Daily delivery + job order quantities" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,18"/>
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="12" Height="280" BorderBrush="#E2E8F0" BorderThickness="1">
                            <lvc:CartesianChart Series="{Binding DailyTrendSeries}"
                                                XAxes="{Binding DailyTrendXAxes}"
                                                YAxes="{Binding DailyTrendYAxes}"
                                                Height="260"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Salesman Performance" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Confirmed PI revenue by team member" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,18"/>
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="12" Height="280" BorderBrush="#E2E8F0" BorderThickness="1">
                            <lvc:CartesianChart Series="{Binding SalesmanChartSeries}"
                                                XAxes="{Binding SalesmanChartXAxes}"
                                                YAxes="{Binding SalesmanChartYAxes}"
                                                Height="260"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ SALES TEAM ============ -->
            <Border Background="#FFFFFF" CornerRadius="16" Padding="20" Margin="0,0,0,20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Sales Team" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding SalesmanList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Margin="0,0,10,10" Padding="14"
                                        Background="#F8FAFC" CornerRadius="12"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#DBEAFE" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialConverter}}"
                                                       FontSize="12" FontWeight="Bold" Foreground="#2563EB"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Amount}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#2563EB" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ MODULES ============ -->
            <TextBlock Text="KEY MODULES" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Proforma Invoices -->
                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0"
                        BorderBrush="#EC4899" BorderThickness="0,0,0,3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FCE7F3">
                                <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Proforma Invoices" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Invoice pipeline" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding PITotal}" FontSize="24" FontWeight="Bold" Foreground="#DB2777" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CONFIRMED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding PIConfirmed}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding PIPending}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#FDF2F8" CornerRadius="8" Padding="10,6" Margin="0,14,0,0">
                            <TextBlock Text="{Binding PIValue}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#BE185D" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Job Orders -->
                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,10,0"
                        BorderBrush="#8B5CF6" BorderThickness="0,0,0,3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#EDE9FE">
                                <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Job Orders" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Work order flow" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding JOTotal}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IN PROGRESS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding JOInProgress}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding JOCompleted}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Deliveries -->
                <Border Grid.Column="2" Style="{StaticResource KPICard}"
                        BorderBrush="#F97316" BorderThickness="0,0,0,3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFEDD5">
                                <TextBlock Text="🚚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Deliveries" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Order tracking" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DelPending}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DelCompleted}" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DelTotal}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ BALANCE OVERVIEW ============ -->
            <TextBlock Text="BALANCE OVERVIEW" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#D1FAE5">
                                <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Today" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DailyBalance}" FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="This Month" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthlyBalance}" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KPICard}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE">
                                <TextBlock Text="📈" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="This Year" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AnnualBalance}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="ProGlass Automation © 2024 · v1.0"
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>