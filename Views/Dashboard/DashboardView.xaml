<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Blue & White Professional Palette -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1E40AF"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Premium Soft-Square Card Style -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="OPERATIONS DASHBOARD" FontSize="28" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="System status and active production modules" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="MODULES" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="ModuleCountText" Text="0/5 Active" FontSize="16" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="SubscriptionStatusText" Text="Inactive" FontSize="16" FontWeight="Black" Foreground="{StaticResource DangerRed}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 1. SUBSCRIPTION CARD (Synced Names) -->
                <Border x:Name="SubscriptionCard" Style="{StaticResource DashboardCardStyle}" BorderBrush="{StaticResource DangerRed}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SYSTEM LICENSING" FontSize="11" FontWeight="Black" Foreground="{StaticResource DangerRed}"/>
                            <TextBlock x:Name="StatusText" Text="INACTIVE" FontSize="32" FontWeight="Black" Foreground="{StaticResource TextDark}" Margin="0,10"/>

                            <Border x:Name="DaysCounterBg" Background="#FEF2F2" CornerRadius="12" Padding="20,15" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Remaining Time: " FontSize="14" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                                    <TextBlock x:Name="DaysText" Text="0" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerRed}"/>
                                    <TextBlock Text=" Days" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ActivateBtn" Content="ACTIVATE FULL SYSTEM" Click="ActivateNow_Click" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Black" FontSize="14" Padding="35,15" Margin="0,20,0,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <Border x:Name="StatusIndicator" Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{StaticResource DangerRed}" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <TextBlock Text="PRODUCTION TOOLS" FontSize="12" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="5,10,0,18"/>

                <!-- MODULE SGU -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="12" Background="{StaticResource PrimaryBlue}">
                            <TextBlock Text="🧮" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="SGU CALCULATOR" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Single Glass Unit pricing &amp; edgework" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>

                        <!-- Status Border Synced with C# Loop logic -->
                        <Border x:Name="SguStatus" Grid.Column="2" Background="#FEE2E2" CornerRadius="10" Padding="15,8" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z" Fill="{StaticResource DangerRed}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCKED" Foreground="{StaticResource DangerRed}" FontWeight="Black" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MODULE DGU -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="12" Background="{StaticResource PrimaryBlue}">
                            <TextBlock Text="📑" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="DGU CALCULATOR" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Double Glass Unit processing" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>
                        <Border x:Name="DguStatus" Grid.Column="2" Background="#FEE2E2" CornerRadius="10" Padding="15,8" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z" Fill="{StaticResource DangerRed}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCKED" Foreground="{StaticResource DangerRed}" FontWeight="Black" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MODULE LAMINATION -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="12" Background="{StaticResource PrimaryBlue}">
                            <TextBlock Text="🔳" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="LAMINATION" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Safety glass layering &amp; PVB" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>
                        <Border x:Name="LamStatus" Grid.Column="2" Background="#FEE2E2" CornerRadius="10" Padding="15,8" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z" Fill="{StaticResource DangerRed}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCKED" Foreground="{StaticResource DangerRed}" FontWeight="Black" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MODULE DGU + LAM -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="12" Background="{StaticResource PrimaryBlue}">
                            <TextBlock Text="🪟" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="DGU + LAMINATION" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Combo high-performance units" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>
                        <Border x:Name="DguLamStatus" Grid.Column="2" Background="#FEE2E2" CornerRadius="10" Padding="15,8" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z" Fill="{StaticResource DangerRed}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCKED" Foreground="{StaticResource DangerRed}" FontWeight="Black" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MODULE OPTIMIZATION -->
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="12" Background="{StaticResource PrimaryBlue}">
                            <TextBlock Text="✂️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="OPTIMIZATION" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                            <TextBlock Text="Cutting patterns &amp; waste control" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        </StackPanel>
                        <Border x:Name="OptStatus" Grid.Column="2" Background="#FEE2E2" CornerRadius="10" Padding="15,8" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z" Fill="{StaticResource DangerRed}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCKED" Foreground="{StaticResource DangerRed}" FontWeight="Black" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>