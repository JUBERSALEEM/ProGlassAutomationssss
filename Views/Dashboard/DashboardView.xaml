<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <!-- Vibrant Color Palette -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryBlueDark" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="SuccessGreenLight" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningOrangeLight" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerRedLight" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="PurpleAccent" Color="#A855F7"/>
        <SolidColorBrush x:Key="PurpleAccentLight" Color="#F3E8FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundMain" Color="#F8FAFC"/>

        <!-- Vibrant Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SguGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DguGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#0891B2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LamGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A855F7" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ComGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22C55E" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OptGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#EAB308" Offset="1"/>
        </LinearGradientBrush>

        <!-- Subtle Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.08" Direction="270" Color="Black"/>
        <DropShadowEffect x:Key="IconShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270" Color="Black"/>

        <!-- Modern Button Style -->
        <Style x:Key="ActivateButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="28,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBlueDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Active -->
        <Style x:Key="StatusActive" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessGreenLight}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Status Badge Locked -->
        <Style x:Key="StatusLocked" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DangerRedLight}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Feature Item Style -->
        <Style x:Key="FeatureItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Module Card Style -->
        <Style x:Key="ModuleCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </UserControl.Resources>

    <!-- Main Background -->
    <Grid Background="{StaticResource BackgroundMain}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="16" Background="{StaticResource HeaderGradient}" Effect="{StaticResource IconShadow}">
                        <Path Data="M12,2L2,7V17L12,22L22,17V7L12,2Z" 
                              Fill="White" 
                              Width="28" Height="28"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PROGLASS ERP" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Glass Processing Automation Platform" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Modules Count -->
                    <Border Background="White" CornerRadius="14" Padding="20,14" Margin="0,0,14,0" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#EFF6FF">
                                <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.31,8.63L12,2L9.69,8.63L2,9.24L7.46,13.97L5.82,21L12,17.27Z" 
                                      Fill="{StaticResource PrimaryBlue}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Modules" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="ModuleCountText" Text="0/5 Active" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Subscription Status -->
                    <Border Background="White" CornerRadius="14" Padding="20,14" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#DCFCE7">
                                <Path Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17z" 
                                      Fill="{StaticResource SuccessGreen}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Subscription" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="SubscriptionStatusText" Text="Inactive" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ==================== MAIN CONTENT ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ==================== SUBSCRIPTION CARD ==================== -->
                    <Border x:Name="SubscriptionCard" Style="{StaticResource ModuleCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SUBSCRIPTION STATUS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="StatusText" Text="INACTIVE" FontSize="32" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- Status Indicator Dot -->
                                <Border x:Name="StatusIndicator" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource DangerRed}" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- Days Counter -->
                            <Border x:Name="DaysCounterBg" Grid.Row="1" Background="#FEE2E2" CornerRadius="14" Padding="24,20" Margin="0,24,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Days Remaining" FontSize="14" Foreground="{StaticResource TextSecondary}" FontWeight="Medium"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="DaysText" Text="0" FontSize="48" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                                            <TextBlock Text=" days" FontSize="18" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Icon -->
                                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="32" Background="#FECACA" VerticalAlignment="Center">
                                        <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" 
                                              Fill="{StaticResource DangerRed}"
                                              Width="30" Height="30"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Activate Button -->
                            <Button x:Name="ActivateBtn" 
                                    Grid.Row="2" 
                                    Content="ACTIVATE SUBSCRIPTION" 
                                    Style="{StaticResource ActivateButton}"
                                    Height="56"
                                    Margin="0,24,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ==================== MODULES HEADER ==================== -->
                    <TextBlock Text="AVAILABLE MODULES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,8,0,20"/>

                    <!-- ==================== MODULE 1: SGU CALCULATOR ==================== -->
                    <Border Style="{StaticResource ModuleCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Module Header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Badge -->
                                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SguGradient}" Effect="{StaticResource IconShadow}">
                                    <TextBlock Text="SGU" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SGU Calculator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Single Glass Unit - Edge Work &amp; Tempering" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border x:Name="SguStatus" Grid.Column="2" Style="{StaticResource StatusLocked}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H18M18,2H6A2,2 0 0,0 4,4V20H6V10H18V4A2,2 0 0,0 18,2Z" 
                                              Fill="{StaticResource DangerRed}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="LOCKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderLight}" Margin="0,24,0,0"/>

                            <!-- Features Grid -->
                            <Grid Grid.Row="2" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Single pane glass calculations" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edge work cost per meter" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edge work cost per meter" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tempering options &amp; pricing" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sandblasting patterns" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Holes and cutouts" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Custom shape pricing" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ==================== MODULE 2: DGU CALCULATOR ==================== -->
                    <Border Style="{StaticResource ModuleCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource DguGradient}" Effect="{StaticResource IconShadow}">
                                    <TextBlock Text="DGU" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DGU Calculator" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Double Glass Unit - Spacer &amp; Gas Fill" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border x:Name="DguStatus" Grid.Column="2" Style="{StaticResource StatusLocked}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H18M18,2H6A2,2 0 0,0 4,4V20H6V10H18V4A2,2 0 0,0 18,2Z" 
                                              Fill="{StaticResource DangerRed}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="LOCKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderLight}" Margin="0,24,0,0"/>

                            <Grid Grid.Row="2" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Two glass layers config" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Aluminum spacer options" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Foam spacer technology" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Argon gas fill calculation" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Krypton gas fill option" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Warm edge spacer tech" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ==================== MODULE 3: LAMINATION ==================== -->
                    <Border Style="{StaticResource ModuleCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource LamGradient}" Effect="{StaticResource IconShadow}">
                                    <TextBlock Text="LAM" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Lamination" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Safety Glass - PVB, SGP, EVA Layers" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border x:Name="LamStatus" Grid.Column="2" Style="{StaticResource StatusLocked}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H18M18,2H6A2,2 0 0,0 4,4V20H6V10H18V4A2,2 0 0,0 18,2Z" 
                                              Fill="{StaticResource DangerRed}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="LOCKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderLight}" Margin="0,24,0,0"/>

                            <Grid Grid.Row="2" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="PVB interlayer (standard)" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="SGP interlayer (strong)" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="EVA interlayer (outdoor)" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Safety glass certification" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Security glass options" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FeatureItem}">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PurpleAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="UV protection layers" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ==================== MODULE 4: DGU + LAMINATION ==================== -->
                    <Border Style="{StaticResource ModuleCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource ComGradient}" Effect="{StaticResource IconShadow}">
                                    <TextBlock Text="COM" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

