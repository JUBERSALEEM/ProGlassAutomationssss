<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="2" Opacity="0.18"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="PROGLASS ERP DASHBOARD" FontSize="22" FontWeight="Bold" Foreground="#0A6ED1" HorizontalAlignment="Center"/>
                <TextBlock Text="Glass Processing Automation Platform" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column - Status Cards -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <!-- Subscription Status Card -->
                <Border x:Name="SubscriptionStatusCard" Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,10" BorderBrush="#FCA5A5" BorderThickness="2" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SUBSCRIPTION STATUS" FontSize="9" Foreground="#6B7280"/>
                            <TextBlock x:Name="StatusText" Text="NOT ACTIVE" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DAYS REMAINING" FontSize="9" Foreground="#6B7280"/>
                            <TextBlock x:Name="DaysText" Text="0" FontSize="16" FontWeight="Bold" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button x:Name="ActivateBtn" Grid.Column="2" Content="ACTIVATE LICENSE" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="10" Height="35" Padding="14,0" Cursor="Hand" Click="ActivateNow_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- SGU Module Card -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#0A6ED1" VerticalAlignment="Center">
                            <TextBlock Text="SGU" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SGU CALCULATOR" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Single Glass Unit - Edge work and tempering" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="SguStatus" Grid.Column="2" Background="#DC2626" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- DGU Module Card -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#0854A0" VerticalAlignment="Center">
                            <TextBlock Text="DGU" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DGU CALCULATOR" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Double Glass Unit - Spacer and gas fill" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="DguStatus" Grid.Column="2" Background="#DC2626" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- LAMINATION Module Card -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1E88E5" VerticalAlignment="Center">
                            <TextBlock Text="LAM" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LAMINATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Safety Glass - PVB, SGP, EVA layers" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="LamStatus" Grid.Column="2" Background="#DC2626" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- DGU+LAM Module Card -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#D32F2F" VerticalAlignment="Center">
                            <TextBlock Text="COM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DGU + LAMINATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Combo Unit - High-performance IGU" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="DguLamStatus" Grid.Column="2" Background="#DC2626" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- OPTIMIZATION Module Card -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,6" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#7C3AED" VerticalAlignment="Center">
                            <TextBlock Text="OPT" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIMIZATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="Glass Cut - Minimize waste" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="OptStatus" Grid.Column="2" Background="#DC2626" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Column - Module Details -->
            <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16" Margin="8,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MODULE DETAILS" FontSize="12" FontWeight="Bold" Foreground="#0A6ED1" Margin="0,0,0,14"/>

                        <!-- SGU Details -->
                        <Border Background="#F3F4F6" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#0A6ED1">
                                        <TextBlock Text="1" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="SGU CALCULATOR" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="38,8,0,0">
                                    <TextBlock Text="- Single pane glass calculations" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Edge work cost per meter" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Tempering options and pricing" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Sandblasting and holes" FontSize="10" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DGU Details -->
                        <Border Background="#F3F4F6" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#0854A0">
                                        <TextBlock Text="2" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="DGU CALCULATOR" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="38,8,0,0">
                                    <TextBlock Text="- Two glass layers configuration" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Aluminum and foam spacer" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Argon, Krypton gas fill" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Warm edge spacer technology" FontSize="10" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- LAMINATION Details -->
                        <Border Background="#F3F4F6" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#1E88E5">
                                        <TextBlock Text="3" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="LAMINATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="38,8,0,0">
                                    <TextBlock Text="- PVB interlayer (standard)" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- SGP interlayer (strong)" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- EVA interlayer (outdoor)" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Safety and security glass" FontSize="10" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- DGU+LAM Details -->
                        <Border Background="#F3F4F6" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#D32F2F">
                                        <TextBlock Text="4" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="DGU + LAMINATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="38,8,0,0">
                                    <TextBlock Text="- Laminated outer glass and inner" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- High-performance insulation" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Maximum safety and thermal" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Premium acoustic control" FontSize="10" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OPTIMIZATION Details -->
                        <Border Background="#F3F4F6" CornerRadius="10" Padding="12" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#7C3AED">
                                        <TextBlock Text="5" FontSize="12" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="OPTIMIZATION" FontSize="12" FontWeight="Bold" Foreground="#1F2937" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="38,8,0,0">
                                    <TextBlock Text="- Standard sheet sizes (3210x2250)" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Auto-cutting pattern generator" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Waste percentage calculator" FontSize="10" Foreground="#374151" Margin="0,0,0,3"/>
                                    <TextBlock Text="- Cost optimization report" FontSize="10" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>