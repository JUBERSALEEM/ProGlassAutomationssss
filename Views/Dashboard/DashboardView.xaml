<UserControl x:Class="ProGlassAutomation.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F4F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- HEADER -->
            <Border Background="White" CornerRadius="18" Padding="22" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Sales Dashboard" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                        <TextBlock Text="Track revenue, compare salesmen and monitor performance" FontSize="14" Foreground="#6B7280" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter" FontSize="14" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Width="160" Padding="14,0" SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Today"/>
                            <ComboBoxItem Content="This Week" IsSelected="True"/>
                            <ComboBoxItem Content="This Month"/>
                            <ComboBoxItem Content="This Year"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATS GRID -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Total Revenue" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="34" FontWeight="Bold" Foreground="#2563EB" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding RevenueGrowth}" FontSize="13" Foreground="#10B981" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="22" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Orders" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Orders}" FontSize="34" FontWeight="Bold" Foreground="#1F2937" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding OrdersGrowth}" FontSize="13" Foreground="#10B981" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="22" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Salesmen" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding Salesmen}" FontSize="34" FontWeight="Bold" Foreground="#1F2937" Margin="0,18,0,0"/>
                        <TextBlock Text="Active Team" FontSize="13" Foreground="#10B981" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Pending Quotes" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding PendingQuotes}" FontSize="34" FontWeight="Bold" Foreground="#F59E0B" Margin="0,18,0,0"/>
                        <TextBlock Text="Awaiting Approval" FontSize="13" Foreground="#6B7280" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CHART + SALESMAN -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Sales Analytics" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>
                        <Border Background="#FAFBFC" CornerRadius="12" Padding="10" MinHeight="420">
                            <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DYNAMIC SALESMAN COMPARISON -->
                <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="22" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Salesman Comparison" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>

                        <Border Background="#FDF2F8" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[0]}" FontSize="14" FontWeight="Bold" Foreground="#EC4899"/>
                                <TextBlock Text="{Binding SalesmanAmounts[0]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[1]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[1]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[2]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[2]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[3]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[3]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[4]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[4]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[5]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[5]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[6]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[6]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[7]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[7]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding SalesmanNames[8]}" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                                <TextBlock Text="{Binding SalesmanAmounts[8]}" FontSize="14" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KEY MODULES -->
            <TextBlock Text="KEY MODULES" FontSize="13" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>

            <!-- SALES -->
            <Border Background="White" CornerRadius="18" Padding="22" Margin="0,0,0,20" BorderBrush="#EC4899" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="14" Background="#FDF2F8">
                            <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SALES" FontSize="18" FontWeight="Bold" Foreground="#EC4899"/>
                            <TextBlock Text="Proforma Invoices" FontSize="11" Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Total" FontSize="12" Foreground="#6B7280" TextAlignment="Center"/>
                            <TextBlock Text="{Binding PITotal}" FontSize="28" FontWeight="Bold" Foreground="#EC4899" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Confirmed" FontSize="12" Foreground="#6B7280" TextAlignment="Center"/>
                            <TextBlock Text="{Binding PIConfirmed}" FontSize="28" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Pending" FontSize="12" Foreground="#6B7280" TextAlignment="Center"/>
                            <TextBlock Text="{Binding PIPending}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Value" FontSize="12" Foreground="#6B7280" TextAlignment="Center"/>
                            <TextBlock Text="{Binding PIValue}" FontSize="28" FontWeight="Bold" Foreground="#2563EB" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Content="View Sales" Background="#EC4899" Foreground="White" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- OTHER MODULES -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" Margin="0,0,10,0" BorderBrush="#8B5CF6" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#EDE9FE">
                                <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="JOB ORDERS" FontSize="14" FontWeight="Bold" Foreground="#8B5CF6"/>
                                <TextBlock Text="Work Orders" FontSize="10" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOTotal}" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="In Progress" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOInProgress}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Completed" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding JOCompleted}" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="22" Margin="0,0,10,0" BorderBrush="#F97316" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#FFF7ED">
                                <TextBlock Text="🚚" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DELIVERIES" FontSize="14" FontWeight="Bold" Foreground="#F97316"/>
                                <TextBlock Text="Order Tracking" FontSize="10" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pending" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelPending}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Completed" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelCompleted}" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DelTotal}" FontSize="20" FontWeight="Bold" Foreground="#1F2937" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="22" BorderBrush="#0EA5E9" BorderThickness="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#E0F2FE">
                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SHEET STORE" FontSize="14" FontWeight="Bold" Foreground="#0EA5E9"/>
                                <TextBlock Text="Inventory" FontSize="10" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding SheetTotal}" FontSize="20" FontWeight="Bold" Foreground="#0EA5E9" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Available" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding SheetAvailable}" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Types" FontSize="10" Foreground="#6B7280" TextAlignment="Center"/>
                                <TextBlock Text="{Binding SheetTypes}" FontSize="20" FontWeight="Bold" Foreground="#1F2937" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BALANCE OVERVIEW -->
            <TextBlock Text="BALANCE OVERVIEW" FontSize="13" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#D1FAE5" Margin="0,0,0,10">
                            <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Today's Balance" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DailyBalance}" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="22" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#DBEAFE" Margin="0,0,0,10">
                            <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="This Month" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MonthlyBalance}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="22">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#EDE9FE" Margin="0,0,0,10">
                            <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="This Year" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AnnualBalance}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- QUICK ACTIONS -->
            <Border Background="White" CornerRadius="18" Padding="22" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔄 Sync Now" Background="#2563EB" Foreground="White" Padding="16,10" FontWeight="SemiBold" Cursor="Hand" Click="SyncBalance_Click"/>
                    <Button Content="👥 Show Salesmen" Background="#8B5CF6" Foreground="White" Padding="16,10" FontWeight="SemiBold" Margin="8,0,0,0" Click="ShowSalesmen_Click"/>
                </StackPanel>
            </Border>

            <!-- ACTIVITY & STATUS -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Activity Log -->
                <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Database Stats" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10"/>
                        <TextBlock x:Name="DbStatsText" Text="Loading..." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                        <Button Content="🔄 Refresh All" Background="#2563EB" Foreground="White" Padding="12,6" Margin="0,10,0,0" Click="Refresh_Click"/>
                    </StackPanel>
                </Border>

                <!-- Service Status + License -->
                <StackPanel Grid.Column="1">
                    <Border Background="White" CornerRadius="18" Padding="22" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Service Status" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                <TextBlock Text="Online" FontSize="11" Foreground="#10B981" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="#10B981"/>
                                <TextBlock Text="Active" FontSize="11" Foreground="#10B981" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastUpdate}" FontSize="10" Foreground="#6B7280"/>
                        </StackPanel>
                    </Border>

                    <!-- License Status -->
                    <Border Background="White" CornerRadius="18" Padding="22" BorderBrush="#EF4444" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="🛡️ License Status" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,8"/>
                            <Border Background="#FEE2E2" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="⚠️ ACTION REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#EF4444"/>
                            </Border>
                            <TextBlock Text="SYSTEM INACTIVE" FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock Text="License validation failed" FontSize="10" Foreground="#EF4444" Margin="0,4,0,0"/>
                            <Button Content="🚀 Activate Now" Background="#2563EB" Foreground="White" Padding="16,10" Margin="0,12,0,0" Click="ActivateNow_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>