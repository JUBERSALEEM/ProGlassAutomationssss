<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid Margin="20,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E40AF" CornerRadius="10" Padding="14,10">
                        <TextBlock Text="📦" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="Sheet Store" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Glass inventory management system" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📜 History" Click="ViewHistory_Click" Background="White" Padding="14,10" BorderBrush="#CBD5E1" Margin="0,0,10,0"/>
                    <Button Click="AddSheet_Click" Background="#2563EB" Foreground="White" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Add Sheet"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATS -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SHOWING" FontSize="9" Foreground="#64748B"/>
                        <TextBlock x:Name="TotalSheetsText" Text="0" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#A7F3D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL STOCK" FontSize="9" Foreground="#059669"/>
                        <TextBlock x:Name="TotalStockText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#FECACA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="USED" FontSize="9" Foreground="#DC2626"/>
                        <TextBlock x:Name="UsedSheetsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FFFBEB" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#FDE68A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BALANCE" FontSize="9" Foreground="#D97706"/>
                        <TextBlock x:Name="BalanceSheetsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#F5F3FF" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#DDD6FE" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LAST PURCHASE" FontSize="9" Foreground="#7C3AED"/>
                        <TextBlock x:Name="LastPurchaseText" Text="-" FontSize="13" FontWeight="Bold" Foreground="#7C3AED"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Background="#F0F9FF" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#BAE6FD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LAST UPDATE" FontSize="9" Foreground="#0284C7"/>
                        <TextBlock x:Name="LastUpdateText" Text="-" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#F1F5F9" CornerRadius="10" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL ALL" FontSize="9" Foreground="#475569"/>
                        <TextBlock x:Name="TotalAllText" Text="0" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Border Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Margin="16">
                        <TextBlock Text="⚡ Quick Actions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Button Content="➕ Add New Sheet" Click="AddSheet_Click" Background="#2563EB" Foreground="White" Padding="12" Margin="0,0,0,8" BorderThickness="0"/>
                        <Button Content="💰 Update Prices" Click="UpdatePurchasePrice_Click" Background="#16A34A" Foreground="White" Padding="12" Margin="0,0,0,8" BorderThickness="0"/>
                        <Button Content="📤 Export Excel" Click="ExportExcel_Click" Background="White" Padding="12" Margin="0,0,0,8" BorderBrush="#CBD5E1"/>
                        <Button Content="📥 Import Excel" Click="ImportExcel_Click" Background="White" Padding="12" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Margin="16">
                        <TextBlock Text="📋 Categories" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListBox x:Name="CategoryListBox" Background="Transparent" BorderThickness="0" SelectionChanged="CategoryListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="10,8"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="❌ Clear Filter" Click="ClearCategoryFilter_Click" Background="Transparent" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- GRID -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Margin="16,12">
                            <TextBlock Text="📋 All Sheets Inventory" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Width="250" HorizontalAlignment="Right" Padding="10,8" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="SheetGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                              RowHeight="44" BorderThickness="0" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="THICKNESS" Binding="{Binding Thickness}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="COLOR" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" Background="{Binding ColorBrush}"/>
                                            <TextBlock Text="{Binding Color}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="WIDTH" Binding="{Binding Width}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="HEIGHT" Binding="{Binding Height}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SQM" Binding="{Binding SquareMeter, StringFormat=N2}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PURCHASE" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SELL" Binding="{Binding SellPrice, StringFormat=N2}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="STOCK" Binding="{Binding TotalStock}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="USED" Binding="{Binding UsedSheets}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="BAL" Binding="{Binding BalanceSheets}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#D97706"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="ACTIONS" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Buy" Click="BuySheet_Click" Tag="{Binding Id}" Background="#2563EB" Foreground="White" Padding="8,4" FontSize="10" BorderThickness="0"/>
                                            <Button Content="Edit" Click="EditSheet_Click" Tag="{Binding Id}" Background="#F1F5F9" Padding="8,4" FontSize="10" Margin="4,0,0,0" BorderThickness="0"/>
                                            <Button Content="✕" Click="DeleteSheet_Click" Tag="{Binding Id}" Background="#FEF2F2" Foreground="#DC2626" Padding="6,4" FontSize="10" Margin="4,0,0,0" BorderThickness="0" Width="28"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid Margin="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Showing" Foreground="#64748B"/>
                    <TextBlock x:Name="ShowingCountText" Text="0" FontWeight="Bold" Margin="6,0"/>
                    <TextBlock Text="of" Foreground="#64748B"/>
                    <TextBlock x:Name="TotalEntriesText" Text="0" FontWeight="Bold" Margin="6,0"/>
                    <TextBlock Text="entries" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ Prev" Click="PreviousPage_Click" Padding="12,6" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"/>
                    <TextBlock Text="Page 1" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Content="Next ▶" Click="NextPage_Click" Padding="12,6" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>