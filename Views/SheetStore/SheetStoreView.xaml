<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.DataContext>
        <vm:SheetStoreViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>

        <!-- ==================== DATA GRID ==================== -->
        <Style x:Key="SimpleDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalGridLinesBrush" Value="#CBD5E1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>

            <!-- Dynamic full width behavior -->
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="MinColumnWidth" Value="55"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

            <!-- Performance -->
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        </Style>

        <!-- ==================== DATA GRID CELL ==================== -->
        <Style x:Key="SimpleCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== DATA GRID ROW ==================== -->
        <Style x:Key="SimpleRow" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== COLUMN HEADER ==================== -->
        <Style x:Key="SimpleHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontSize="{TemplateBinding FontSize}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Path x:Name="SortArrow"
                                  Grid.Column="1"
                                  Data="M 0,4 L 4,0 L 8,4"
                                  Fill="White"
                                  Visibility="Collapsed"
                                  Margin="2,0,6,0"
                                  VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TEXT STYLES ==================== -->
        <Style x:Key="TextCategory" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0891B2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TextThickness" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextColor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TextSupplier" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="TextSQM" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65A30D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextPurchase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="TextSell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="TextStock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextUsed" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextBalance" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D97706"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== BUTTONS ==================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. HEADER ==================== -->
        <Border Grid.Row="0"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,12"
                BorderBrush="#1E40AF"
                BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#DBEAFE"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="20"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SHEET STORE"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <Border Background="#FEF3C7"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Margin="12,0,0,0"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="INVENTORY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Stock Management &amp; Pricing System"
                                   FontSize="11"
                                   Foreground="#BFDBFE"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            BorderBrush="#3B82F6"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 Items: "
                                       FontSize="11"
                                       Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding FilteredCount}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#1E40AF"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            BorderBrush="#10B981"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ Stock: "
                                       FontSize="11"
                                       Foreground="#059669"/>
                            <TextBlock Text="{Binding TotalStock}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            BorderBrush="#DC2626"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ Used: "
                                       FontSize="11"
                                       Foreground="#DC2626"/>
                            <TextBlock Text="{Binding TotalUsed}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="8"
                            Padding="10,6"
                            BorderBrush="#D97706"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖ Balance: "
                                       FontSize="11"
                                       Foreground="#D97706"/>
                            <TextBlock Text="{Binding BalanceSheets}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="📋 History"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ViewHistoryCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="📄 Export"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportExcelCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="📥 Import"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ImportExcelCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="💰 Prices"
                            Style="{StaticResource WarningButton}"
                            Command="{Binding UpdatePurchasePriceCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="✚ Add New"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddSheetCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. FILTER BAR ==================== -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Padding="12,10"
                Margin="0,0,0,12"
                BorderBrush="#3B82F6"
                BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DBEAFE" Offset="0"/>
                    <GradientStop Color="#BFDBFE" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Category -->
                <Border Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CATEGORY"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Background="White"
                                  BorderBrush="#93C5FD"
                                  BorderThickness="1"
                                  Padding="10,8"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Thickness -->
                <Border Grid.Column="1" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="THICKNESS"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Thicknesses}"
                                  SelectedItem="{Binding SelectedThickness}"
                                  Background="White"
                                  BorderBrush="#93C5FD"
                                  BorderThickness="1"
                                  Padding="10,8"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Color -->
                <Border Grid.Column="2" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="COLOR"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Colors}"
                                  SelectedItem="{Binding SelectedColor}"
                                  Background="White"
                                  BorderBrush="#93C5FD"
                                  BorderThickness="1"
                                  Padding="10,8"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Supplier -->
                <Border Grid.Column="3" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SUPPLIER"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  Background="White"
                                  BorderBrush="#93C5FD"
                                  BorderThickness="1"
                                  Padding="10,8"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Sort -->
                <Border Grid.Column="4" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SORT"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}"
                                  Background="White"
                                  BorderBrush="#93C5FD"
                                  BorderThickness="1"
                                  Padding="10,8"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Column="5" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SEARCH"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#1E40AF"
                                   Margin="4,0,0,4"/>
                        <Border Background="White"
                                CornerRadius="6"
                                BorderBrush="#93C5FD"
                                BorderThickness="1"
                                Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#1E40AF"
                                        CornerRadius="4"
                                        Padding="6,4"
                                        Margin="2">
                                    <TextBlock Text="🔍" FontSize="10"/>
                                </Border>

                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=LostFocus}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="11"
                                         Foreground="#334155"
                                         VerticalAlignment="Center"
                                         Padding="6,4"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Clear + Value -->
                <Border Grid.Column="6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Clear"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding ClearFilterCommand}"
                                Padding="12,6"
                                FontSize="9"
                                Margin="0,0,8,0"/>

                        <Border Background="#0F172A"
                                CornerRadius="8"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💎 Value: "
                                           FontSize="10"
                                           Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalAll, StringFormat=N0, Mode=OneWay}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="White"/>
                                <TextBlock Text=" AED"
                                           FontSize="9"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3. DATA GRID ==================== -->
        <Border Grid.Row="2"
                CornerRadius="12"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding FilteredSheets}"
                      SelectedItem="{Binding SelectedSheet}"
                      Style="{StaticResource SimpleDataGrid}"
                      CellStyle="{StaticResource SimpleCell}"
                      RowStyle="{StaticResource SimpleRow}"
                      ColumnHeaderStyle="{StaticResource SimpleHeader}"
                      BorderThickness="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <!-- # -->
                    <DataGridTemplateColumn Header="#"
                                            Width="45"
                                            MinWidth="45"
                                            MaxWidth="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SrNo}"
                                           HorizontalAlignment="Center"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CATEGORY -->
                    <DataGridTemplateColumn Header="CATEGORY"
                                            Width="1.1*"
                                            MinWidth="100"
                                            SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource TextCategory}"
                                           ToolTip="{Binding Category}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- THICKNESS -->
                    <DataGridTemplateColumn Header="THICK"
                                            Width="0.7*"
                                            MinWidth="70"
                                            SortMemberPath="Thickness">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Thickness}"
                                           Style="{StaticResource TextThickness}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COLOR -->
                    <DataGridTemplateColumn Header="COLOR"
                                            Width="1*"
                                            MinWidth="90"
                                            SortMemberPath="Color">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"
                                            Background="{Binding ColorBrush}"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"/>
                                    <TextBlock Text="{Binding Color}"
                                               Style="{StaticResource TextColor}"
                                               ToolTip="{Binding Color}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SIZE -->
                    <DataGridTemplateColumn Header="SIZE"
                                            Width="1*"
                                            MinWidth="95"
                                            SortMemberPath="Width">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Width}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#1E293B"/>
                                    <TextBlock Text=" × "
                                               FontSize="11"
                                               Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding Height}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="#1E293B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SUPPLIER - requested 145 -->
                    <DataGridTemplateColumn Header="SUPPLIER"
                                            Width="145"
                                            MinWidth="145"
                                            SortMemberPath="Supplier">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Supplier}"
                                           Style="{StaticResource TextSupplier}"
                                           ToolTip="{Binding Supplier}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SQM -->
                    <DataGridTemplateColumn Header="SQM"
                                            Width="0.7*"
                                            MinWidth="65"
                                            SortMemberPath="SquareMeter">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SquareMeter, StringFormat=N2}"
                                           Style="{StaticResource TextSQM}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PURCHASE -->
                    <DataGridTemplateColumn Header="PURCHASE"
                                            Width="0.9*"
                                            MinWidth="85"
                                            SortMemberPath="PurchasePrice">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PurchasePrice, StringFormat=N2}"
                                           Style="{StaticResource TextPurchase}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SELL -->
                    <DataGridTemplateColumn Header="SELL"
                                            Width="0.8*"
                                            MinWidth="75"
                                            SortMemberPath="SellPrice">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SellPrice, StringFormat=N2}"
                                           Style="{StaticResource TextSell}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STOCK -->
                    <DataGridTemplateColumn Header="STOCK"
                                            Width="0.75*"
                                            MinWidth="70"
                                            SortMemberPath="TotalStock">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F0FDF4"
                                        CornerRadius="6"
                                        Padding="6,3"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding TotalStock}"
                                               Style="{StaticResource TextStock}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- USED -->
                    <DataGridTemplateColumn Header="USED"
                                            Width="0.7*"
                                            MinWidth="65"
                                            SortMemberPath="UsedSheets">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#FEF2F2"
                                        CornerRadius="6"
                                        Padding="6,3"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding UsedSheets}"
                                               Style="{StaticResource TextUsed}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- BALANCE -->
                    <DataGridTemplateColumn Header="BAL"
                                            Width="0.7*"
                                            MinWidth="65"
                                            SortMemberPath="BalanceSheets">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#FFFBEB"
                                        CornerRadius="6"
                                        Padding="6,3"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding BalanceSheets}"
                                               Style="{StaticResource TextBalance}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS - requested 150 -->
                    <DataGridTemplateColumn Header="ACTIONS"
                                            Width="150"
                                            MinWidth="150"
                                            MaxWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="Buy"
                                            Command="{Binding DataContext.BuySheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SuccessButton}"
                                            Padding="6,3"
                                            FontSize="9"
                                            Margin="0,0,3,0"
                                            ToolTip="Purchase"/>

                                    <Button Content="Use"
                                            Command="{Binding DataContext.UseSheetsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="6,3"
                                            FontSize="9"
                                            Margin="0,0,3,0"
                                            ToolTip="Use"/>

                                    <Button Content="Edit"
                                            Command="{Binding DataContext.EditSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="6,3"
                                            FontSize="9"
                                            Margin="0,0,3,0"
                                            ToolTip="Edit"/>

                                    <Button Content="Del"
                                            Command="{Binding DataContext.DeleteSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="6,3"
                                            FontSize="9"
                                            ToolTip="Delete"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ==================== 4. STATS BAR ==================== -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Padding="12"
                Margin="0,12,0,0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="1"
                                  Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL STATS -->
                <Border Grid.Column="0"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,6,0"
                        BorderBrush="#3B82F6"
                        BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <Border Background="#1E40AF"
                                CornerRadius="6"
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊"
                                           FontSize="12"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="TOTAL STATS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ITEMS"
                                               FontSize="7"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalSheets}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#1E40AF"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    BorderBrush="#10B981"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="STOCK"
                                               FontSize="7"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalStock}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#059669"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    BorderBrush="#DC2626"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="USED"
                                               FontSize="7"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalUsed}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="4,3"
                                    Margin="0,0,3,0"
                                    BorderBrush="#D97706"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="BAL"
                                               FontSize="7"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BalanceSheets}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#D97706"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Background="White"
                                    CornerRadius="6"
                                    Padding="4,3"
                                    BorderBrush="#7C3AED"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CATG"
                                               FontSize="7"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CategoryTotal}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#7C3AED"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FILTERED STATS -->
                <Border Grid.Column="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,6,0"
                        BorderBrush="#3B82F6"
                        BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DBEAFE" Offset="0"/>
                            <GradientStop Color="#BFDBFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <Border Background="#3B82F6"
                                CornerRadius="6"
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍"
                                           FontSize="12"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="FILTERED STATS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    Margin="0,0,4,0"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SHOW"
                                               FontSize="7"
                                               Foreground="#1E40AF"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredCount}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#F0FDF4"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    Margin="0,0,4,0"
                                    BorderBrush="#22C55E"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="STOCK"
                                               FontSize="7"
                                               Foreground="#15803D"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredStock}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#FEF2F2"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    Margin="0,0,4,0"
                                    BorderBrush="#EF4444"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="USED"
                                               FontSize="7"
                                               Foreground="#B91C1C"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredUsed}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3"
                                    Background="#FFFBEB"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    Margin="0,0,4,0"
                                    BorderBrush="#EAB308"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="BAL"
                                               FontSize="7"
                                               Foreground="#A16207"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredBalance}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#CA8A04"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Background="#F0FDF4"
                                    CornerRadius="8"
                                    Padding="6,4"
                                    BorderBrush="#65A30D"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SQM"
                                               FontSize="7"
                                               Foreground="#3F6212"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredSQM, StringFormat=N1}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#65A30D"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- VALUE + PROFIT -->
                <Border Grid.Column="2"
                        CornerRadius="10"
                        Padding="12"
                        BorderBrush="#7C3AED"
                        BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F5F3FF" Offset="0"/>
                            <GradientStop Color="#EDE9FE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filtered Value -->
                        <Border Background="#7C3AED"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="FILTERED VALUE"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#DDD6FE"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FilteredValue, StringFormat=N0, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="AED"
                                           FontSize="8"
                                           Foreground="#DDD6FE"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Detail mini stats -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="White"
                                        CornerRadius="6"
                                        Padding="6,3"
                                        Margin="0,0,4,0"
                                        BorderBrush="#DC2626"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="COST"
                                                   FontSize="6"
                                                   Foreground="#DC2626"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FilteredPurchaseTotal, StringFormat=N0, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#DC2626"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="White"
                                        CornerRadius="6"
                                        Padding="6,3"
                                        BorderBrush="#059669"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="SELL"
                                                   FontSize="6"
                                                   Foreground="#059669"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FilteredSellTotal, StringFormat=N0, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#059669"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#F0FDF4"
                                    CornerRadius="6"
                                    Padding="6,3"
                                    BorderBrush="#22C55E"
                                    BorderThickness="1"
                                    Margin="0,0,0,4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PROFIT"
                                               FontSize="6"
                                               Foreground="#15803D"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FilteredProfit, StringFormat=N0, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="White"
                                        CornerRadius="6"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        BorderBrush="#A78BFA"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="COLORS"
                                                   FontSize="6"
                                                   Foreground="#7C3AED"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FilteredColors}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#7C3AED"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="White"
                                        CornerRadius="6"
                                        Padding="6,2"
                                        BorderBrush="#EA580C"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="SUPPLIER"
                                                   FontSize="6"
                                                   Foreground="#EA580C"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FilteredSuppliers}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#EA580C"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>