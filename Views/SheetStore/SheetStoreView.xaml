<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A6ED1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="12,10">
                        <TextBlock Text="🪟" FontSize="24"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SHEET STORE" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Glass inventory management" FontSize="12" Foreground="#BFDBFE"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📊 History" Click="ViewHistory_Click"
                            Padding="18,12" Background="White" Foreground="#0A6ED1"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="➕ Add Sheet" Click="AddSheet_Click"
                            Padding="18,12" Background="#10B981" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Cards - Bigger Height -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Sheets -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="📋" FontSize="28"/>
                    <TextBlock Text="TOTAL SHEETS" FontSize="12" Foreground="#6B7280" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBlock x:Name="TotalSheetsText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock Text="items in store" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Categories -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="📁" FontSize="28"/>
                    <TextBlock Text="SERIES" FontSize="12" Foreground="#6B7280" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBlock x:Name="CategoriesCountText" Text="5" FontSize="32" FontWeight="Bold" Foreground="#6D28D9"/>
                    <TextBlock Text="glass types" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thicknesses -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="📐" FontSize="28"/>
                    <TextBlock Text="THICKNESS" FontSize="12" Foreground="#6B7280" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBlock x:Name="ThicknessCountText" Text="7" FontSize="32" FontWeight="Bold" Foreground="#047857"/>
                    <TextBlock Text="mm options" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Colors -->
            <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="🎨" FontSize="28"/>
                    <TextBlock Text="COLORS" FontSize="12" Foreground="#6B7280" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBlock x:Name="ColorsCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text="available" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Last Purchase -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🕐" FontSize="28"/>
                    <TextBlock Text="LAST PURCHASE" FontSize="12" Foreground="#6B7280" FontWeight="Medium" Margin="0,8,0,4"/>
                    <TextBlock x:Name="LastUpdateText" Text="-" FontSize="16" FontWeight="Bold" Foreground="#DC2626" TextWrapping="Wrap"/>
                    <TextBlock Text="recent buy" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thickness Grid - Show All Sizes -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,180,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="📐 THICKNESS OPTIONS" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="4mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="6mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="8mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="10mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="12mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="15mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                        <TextBlock Text="19mm" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="0,70,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="⚡ QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,14"/>

                    <Button Content="💰 Update Prices" Click="UpdatePurchasePrice_Click"
                            Padding="14,12" Background="#0A6ED1" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="📤 Export Excel" Click="ExportExcel_Click"
                            Padding="14,12" Background="#F3F4F6" Foreground="#374151"
                            BorderThickness="0" Cursor="Hand" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"/>

                    <Button Content="📥 Import Excel" Click="ImportExcel_Click"
                            Padding="14,12" Background="#F3F4F6" Foreground="#374151"
                            BorderThickness="0" Cursor="Hand" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"/>

                    <Border Background="#F0FDF4" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="📋 AVAILABLE SERIES" FontSize="10" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,10"/>
                            <TextBlock Text="• HD Series" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="• Belgium Series" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="• PNA" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="• Tinted Series" FontSize="12" Foreground="#374151"/>
                            <TextBlock Text="• Sunlux Series" FontSize="12" Foreground="#374151"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Data Table - Full Width -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#0A6ED1" CornerRadius="10,10,0,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SERIES" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="THICKNESS" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="2" Text="COLOR" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="3" Text="SIZE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="4" Text="PURCHASE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="5" Text="SELL" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="6" Text="LAST PURCHASE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            <TextBlock Grid.Column="7" Text="ACTIONS" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SheetItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Category}" FontWeight="SemiBold" Foreground="#0A6ED1" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Thickness}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Color}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayDimensions}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PurchasePrice, StringFormat='AED {0:N2}'}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding SellPrice, StringFormat='AED {0:N2}'}" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding DisplayPurchaseInfo}" Foreground="#6D28D9" FontSize="11" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Buy" Tag="{Binding Id}" Click="UpdatePurchasePrice_Click"
                                                        Background="#10B981" Foreground="White"
                                                        Padding="12,6" FontSize="11" FontWeight="SemiBold"
                                                        Cursor="Hand" BorderThickness="0"/>
                                                <Button Content="Edit" Tag="{Binding Id}" Click="EditSheet_Click"
                                                        Background="#F3F4F6" Foreground="#374151"
                                                        Padding="10,6" FontSize="11" FontWeight="Medium"
                                                        Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"/>
                                                <Button Content="Delete" Tag="{Binding Id}" Click="DeleteSheet_Click"
                                                        Background="#FEE2E2" Foreground="#DC2626"
                                                        Padding="8,6" FontSize="11" FontWeight="Medium"
                                                        Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>