<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             xmlns:converters="clr-namespace:ProGlassAutomation.Converters"
             Background="#F1F5F9">

    <UserControl.DataContext>
        <vm:SheetStoreViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>

        <!-- ==================== BUTTONS ==================== -->

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#D1FAE5"/>
            <Setter Property="Foreground" Value="#059669"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- ==================== DATA GRID ==================== -->

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
        </Style>

        <Style x:Key="ModernCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernRow" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== COLUMN HEADERS ==================== -->

        <Style x:Key="HeaderBase" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="HeaderGreen" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="Foreground" Value="#166534"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
        </Style>

        <Style x:Key="HeaderBlue" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
        </Style>

        <Style x:Key="HeaderRed" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <Style x:Key="HeaderOrange" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
        </Style>

        <Style x:Key="HeaderPurple" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#FAF5FF"/>
            <Setter Property="Foreground" Value="#6B21A8"/>
            <Setter Property="BorderBrush" Value="#E9D5FF"/>
        </Style>

        <Style x:Key="HeaderTeal" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="Background" Value="#F0FDFA"/>
            <Setter Property="Foreground" Value="#115E59"/>
            <Setter Property="BorderBrush" Value="#99F6E4"/>
        </Style>

        <!-- ==================== BADGES ==================== -->

        <Style x:Key="BadgeGreen" TargetType="Border">
            <Setter Property="Background" Value="#F0FDF4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BadgeRed" TargetType="Border">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BadgeOrange" TargetType="Border">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. COMPACT HEADER ==================== -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                        <TextBlock Text="&#x1F4E6;" FontSize="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SHEET STORE" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#FEF3C7" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="INVENTORY" FontSize="9" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Items: " FontSize="11" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding FilteredCount}" FontWeight="Bold" FontSize="11" Foreground="#1E40AF"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Stock: " FontSize="11" Foreground="#166534"/>
                            <TextBlock Text="{Binding TotalStock}" FontWeight="Bold" FontSize="11" Foreground="#166534"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Used: " FontSize="11" Foreground="#991B1B"/>
                            <TextBlock Text="{Binding TotalUsed}" FontWeight="Bold" FontSize="11" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFBEB" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Balance: " FontSize="11" Foreground="#92400E"/>
                            <TextBlock Text="{Binding BalanceSheets}" FontWeight="Bold" FontSize="11" Foreground="#92400E"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x1F4DC;" Style="{StaticResource SecondaryBtn}" Command="{Binding ViewHistoryCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="View History"/>
                    <Button Content="&#x1F4E4;" Style="{StaticResource SecondaryBtn}" Command="{Binding ExportExcelCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Export"/>
                    <Button Content="&#x1F4E5;" Style="{StaticResource SecondaryBtn}" Command="{Binding ImportExcelCommand}" Padding="10,6" Margin="0,0,6,0" ToolTip="Import"/>
                    <Button Content="&#x1F4B0;" Style="{StaticResource SecondaryBtn}" Command="{Binding UpdatePurchasePriceCommand}" Padding="10,6" Margin="0,0,8,0" ToolTip="Update Prices"/>
                    <Button Content="+ Add" Style="{StaticResource SuccessBtn}" Command="{Binding AddSheetCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN DATA GRID (BIG) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid - Takes Full Width -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar - Compact -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filters -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="CATEGORY" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="130"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="THICKNESS" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding SelectedThickness}" Width="110"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="COLOR" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}" Width="110"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="SUPPLIER" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Width="120"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="SORT" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Width="140"/>
                                </StackPanel>

                                <!-- Search -->
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="SEARCH" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                    <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,4" MinWidth="150">
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="#334155"/>
                                    </Border>
                                </StackPanel>

                                <Button Content="Clear" Style="{StaticResource SecondaryBtn}" Command="{Binding ClearFilterCommand}" Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <!-- Top Right Stats -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Background="#EFF6FF" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last Purchase: " FontSize="10" Foreground="#1E40AF"/>
                                        <TextBlock Text="{Binding MainLastPurchase}" FontWeight="Bold" FontSize="10" Foreground="#1E40AF" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDFA" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last Update: " FontSize="10" Foreground="#115E59"/>
                                        <TextBlock Text="{Binding MainLastUpdate}" FontWeight="Bold" FontSize="10" Foreground="#115E59" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Value: " FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TotalAll, StringFormat=N0}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                        <TextBlock Text=" AED" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- THE DATA GRID -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding FilteredSheets}"
                              SelectedItem="{Binding SelectedSheet}"
                              Style="{StaticResource ModernDataGrid}" 
                              CellStyle="{StaticResource ModernCell}"
                              RowStyle="{StaticResource ModernRow}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- SR -->
                            <DataGridTemplateColumn Header="#" Width="45" HeaderStyle="{StaticResource HeaderBase}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SrNo}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CATEGORY -->
                            <DataGridTemplateColumn Header="CATEGORY" Width="110" HeaderStyle="{StaticResource HeaderTeal}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#115E59"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- THICKNESS -->
                            <DataGridTemplateColumn Header="THICK" Width="70" HeaderStyle="{StaticResource HeaderBlue}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Thickness}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- COLOR -->
                            <DataGridTemplateColumn Header="COLOR" Width="100" HeaderStyle="{StaticResource HeaderPurple}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" Background="{Binding ColorBrush}"/>
                                            <TextBlock Text="{Binding Color}" FontSize="11" Foreground="#6B21A8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SIZE -->
                            <DataGridTemplateColumn Header="SIZE (mm)" Width="100" HeaderStyle="{StaticResource HeaderBase}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Width}" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                            <TextBlock Text=" x " FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Height}" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SUPPLIER -->
                            <DataGridTemplateColumn Header="SUPPLIER" Width="100" HeaderStyle="{StaticResource HeaderBase}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Supplier}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SQM -->
                            <DataGridTemplateColumn Header="SQM" Width="65" HeaderStyle="{StaticResource HeaderBase}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SquareMeter, StringFormat=N2}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- PURCHASE -->
                            <DataGridTemplateColumn Header="PURCHASE" Width="90" HeaderStyle="{StaticResource HeaderRed}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PurchasePrice, StringFormat=N2}" FontSize="11" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SELL -->
                            <DataGridTemplateColumn Header="SELL" Width="85" HeaderStyle="{StaticResource HeaderGreen}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SellPrice, StringFormat=N2}" FontSize="11" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STOCK -->
                            <DataGridTemplateColumn Header="STOCK" Width="70" HeaderStyle="{StaticResource HeaderGreen}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeGreen}">
                                            <TextBlock Text="{Binding TotalStock}" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- USED -->
                            <DataGridTemplateColumn Header="USED" Width="65" HeaderStyle="{StaticResource HeaderRed}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeRed}">
                                            <TextBlock Text="{Binding UsedSheets}" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- BALANCE -->
                            <DataGridTemplateColumn Header="BAL" Width="65" HeaderStyle="{StaticResource HeaderOrange}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeOrange}">
                                            <TextBlock Text="{Binding BalanceSheets}" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACTIONS -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="180" HeaderStyle="{StaticResource HeaderBase}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Buy"
                                                    Command="{Binding DataContext.BuySheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MiniSuccessBtn}"
                                                    ToolTip="Purchase"/>

                                            <Button Content="Use"
                                                    Command="{Binding DataContext.UseSheetsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MiniBtn}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Use"/>

                                            <Button Content="Edit"
                                                    Command="{Binding DataContext.EditSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MiniBtn}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Edit"/>

                                            <Button Content="Del"
                                                    Command="{Binding DataContext.DeleteSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MiniDangerBtn}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Delete"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Hidden Side Panel (Optional - Remove Width="0" and set Width="280" to show) -->
        </Grid>

        <!-- ==================== 3. FOOTER ==================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12,8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Showing " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding FilteredCount}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                    <TextBlock Text=" of " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalSheets}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                    <TextBlock Text=" entries" FontSize="11" Foreground="#64748B"/>

                    <Border Width="1" Height="18" Background="#E2E8F0" Margin="16,0"/>

                    <TextBlock Text="Types: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalSheets}" FontWeight="Bold" FontSize="11" Foreground="#0F172A" Margin="0,0,12,0"/>

                    <TextBlock Text="Categories: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding CategoryTotal}" FontWeight="Bold" FontSize="11" Foreground="#115E59" Margin="0,0,12,0"/>

                    <TextBlock Text="Colors: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ColorTotal}" FontWeight="Bold" FontSize="11" Foreground="#6B21A8" Margin="0,0,12,0"/>

                    <TextBlock Text="Suppliers: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SupplierTotal}" FontWeight="Bold" FontSize="11" Foreground="#92400E" Margin="0,0,12,0"/>

                    <Border Width="1" Height="18" Background="#E2E8F0" Margin="16,0"/>

                    <TextBlock Text="Total Value: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalAll, StringFormat=N0}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                    <TextBlock Text=" AED" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Pagination -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x25C0;" Style="{StaticResource SecondaryBtn}" Padding="10,6"/>
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14,6" Margin="6,0">
                        <TextBlock Text="Page 1" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                    </Border>
                    <Button Content="&#x25B6;" Style="{StaticResource SecondaryBtn}" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>