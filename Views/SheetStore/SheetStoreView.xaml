<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels"
             Background="#F1F5F9">

    <UserControl.DataContext>
        <vm:SheetStoreViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="20,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E40AF" CornerRadius="10" Padding="14,10">
                            <TextBlock Text="📦" FontSize="20"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="Sheet Store" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Glass inventory management system" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📜 History" Command="{Binding ViewHistoryCommand}" 
                                Background="White" Padding="14,10" BorderBrush="#CBD5E1" Margin="0,0,10,0"/>
                        <Button Command="{Binding AddSheetCommand}" Background="#2563EB" Foreground="White" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Sheet"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- INVENTORY STATS -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#93C5FD" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📁 CATEGORIES" FontSize="10" Foreground="#1E40AF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryTotal}" FontSize="28" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Types Available" FontSize="10" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#FCD34D" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📏 THICKNESS" FontSize="10" Foreground="#92400E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ThicknessTotal}" FontSize="28" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Options Available" FontSize="10" Foreground="#B45309" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FCE7F3" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#F9A8D4" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎨 COLORS" FontSize="10" Foreground="#9D174D" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ColorTotal}" FontSize="28" FontWeight="Bold" Foreground="#9D174D" HorizontalAlignment="Center"/>
                            <TextBlock Text="Colors Available" FontSize="10" Foreground="#BE185D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#ECFDF5" CornerRadius="10" Padding="14" BorderBrush="#6EE7B7" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏭 SUPPLIERS" FontSize="10" Foreground="#065F46" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SupplierTotal}" FontSize="28" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center"/>
                            <TextBlock Text="Suppliers Listed" FontSize="10" Foreground="#047857" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SELECTION FILTERS -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Filter -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📁 Category" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="4,0,0,4"/>
                            <ComboBox Grid.Row="1" ItemsSource="{Binding Categories}" 
                                      SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8" FontSize="13" Background="White"/>
                        </Grid>
                    </Border>

                    <!-- Thickness Filter -->
                    <Border Grid.Column="1" Margin="0,0,8,0" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📏 Thickness" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="4,0,0,4"/>
                            <ComboBox Grid.Row="1" ItemsSource="{Binding Thicknesses}" 
                                      SelectedItem="{Binding SelectedThickness, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8" FontSize="13" Background="White"/>
                        </Grid>
                    </Border>

                    <!-- Color Filter -->
                    <Border Grid.Column="2" Margin="0,0,8,0" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🎨 Color" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="4,0,0,4"/>
                            <ComboBox Grid.Row="1" ItemsSource="{Binding Colors}" 
                                      SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8" FontSize="13" Background="White"/>
                        </Grid>
                    </Border>

                    <!-- Supplier Filter -->
                    <Border Grid.Column="3" Margin="0,0,8,0" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid Margin="12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="🏭 Supplier" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" Margin="4,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Suppliers}" 
                                      SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8" FontSize="13" Background="White"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="+" 
                                    Command="{Binding AddSupplierCommand}"
                                    Background="#10B981" Foreground="White" 
                                    Padding="8,6" Margin="4,0,0,0" FontWeight="Bold"
                                    ToolTip="Add New Supplier" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#059669"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clear Button -->
                    <Button Grid.Column="4" Command="{Binding ClearFilterCommand}" 
                            VerticalAlignment="Bottom" Cursor="Hand">
                        <Border Background="#3B82F6" CornerRadius="8" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺" FontSize="14" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <!-- DYNAMIC MAIN STATS -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="FILTER" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap">
                                <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding ThicknessName, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding ColorName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#A7F3D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="STOCK" FontSize="10" Foreground="#059669" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainStock}" FontSize="28" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="USED" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainUsed}" FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FFFBEB" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BALANCE" FontSize="10" Foreground="#D97706" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainBalance}" FontSize="28" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#F5F3FF" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#DDD6FE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LAST PURCHASE" FontSize="10" Foreground="#7C3AED" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainLastPurchase}" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="5" Background="#F0F9FF" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="#BAE6FD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LAST UPDATE" FontSize="10" Foreground="#0284C7" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainLastUpdate}" FontSize="12" FontWeight="Bold" Foreground="#0284C7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#1E293B" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL VALUE" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MainTotalValue, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="AED" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <!-- Quick Actions -->
                    <Border Background="White" CornerRadius="12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Margin="16">
                            <TextBlock Text="⚡ Quick Actions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Button Content="➕ Add New Sheet" Command="{Binding AddSheetCommand}" 
                                    Background="#2563EB" Foreground="White" Padding="12" Margin="0,0,0,8" BorderThickness="0"/>
                            <Button Content="💰 Update Prices" Command="{Binding UpdatePurchasePriceCommand}" 
                                    Background="#16A34A" Foreground="White" Padding="12" Margin="0,0,0,8" BorderThickness="0"/>
                            <Button Content="📤 Export Excel" Command="{Binding ExportExcelCommand}" 
                                    Background="White" Padding="12" Margin="0,0,0,8" BorderBrush="#CBD5E1"/>
                            <Button Content="📥 Import Excel" Command="{Binding ImportExcelCommand}" 
                                    Background="White" Padding="12" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Overall Stats Summary -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Margin="16">
                            <TextBlock Text="📊 Overall Stats" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Types:" Foreground="#64748B" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalSheets}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Stock:" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalStock}" FontWeight="Bold" FontSize="11" Foreground="#059669" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Used:" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalUsed}" FontWeight="Bold" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Balance:" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BalanceSheets}" FontWeight="Bold" FontSize="11" Foreground="#D97706" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </Grid>
                            <Border Height="1" Background="#E2E8F0" Margin="0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Total Value: " FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalAll, StringFormat=N0}" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text=" AED" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DataGrid -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Search + Sort -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📋 Sheets Inventory" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    <Border Background="#E0E7FF" CornerRadius="20" Padding="10,4" Margin="12,0,0,0">
                                        <TextBlock FontSize="11" Foreground="#3730A3">
                                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                                            <Run Text=" items"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Sort:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding SortOptions}" 
                                              SelectedItem="{Binding SelectedSortOption, UpdateSourceTrigger=PropertyChanged}"
                                              Width="200" Padding="10,8" FontSize="11"/>
                                </StackPanel>

                                <TextBox Grid.Column="2" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         Width="200" Padding="10,8"
                                         BorderBrush="#CBD5E1"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding FilteredSheets}"
                                  SelectedItem="{Binding SelectedSheet}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="True" 
                                  RowHeight="48" 
                                  BorderThickness="0" 
                                  Background="White" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  RowHeaderWidth="0">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="12,14"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="THICK" Binding="{Binding Thickness}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="COLOR" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="16" CornerRadius="4" 
                                                        Margin="0,0,10,0" Background="{Binding ColorBrush}"/>
                                                <TextBlock Text="{Binding Color}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="SIZE (mm)" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Width}" FontWeight="SemiBold"/>
                                                <TextBlock Text=" × "/>
                                                <TextBlock Text="{Binding Height}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Supplier}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="SQM" Binding="{Binding SquareMeter, StringFormat=N2}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="PURCHASE (AED)" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="SELL (AED)" Binding="{Binding SellPrice, StringFormat=N2}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="STOCK" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#ECFDF5" CornerRadius="6" Padding="8,4" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalStock}" FontWeight="Bold" Foreground="#059669"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="USED" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEF2F2" CornerRadius="6" Padding="8,4" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UsedSheets}" FontWeight="Bold" Foreground="#DC2626"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="BAL" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFBEB" CornerRadius="6" Padding="8,4" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BalanceSheets}" FontWeight="Bold" Foreground="#D97706"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ACTIONS" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="6,2" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Buy"
                                                            Command="{Binding DataContext.BuySheetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#10B981" Foreground="White" Padding="12,5"
                                                            FontSize="11" BorderThickness="0" FontWeight="SemiBold"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bg" Property="Background" Value="#059669"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Use"
                                                            Command="{Binding DataContext.UseSheetsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#3B82F6" Foreground="White" Padding="12,5"
                                                            FontSize="11" BorderThickness="0" FontWeight="SemiBold"
                                                            Cursor="Hand" Margin="5,0,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="✏️"
                                                            Command="{Binding DataContext.EditSheetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,5" FontSize="11" Margin="8,0,0,0"
                                                            BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" ToolTip="Edit">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bg" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                                                                                    <Setter TargetName="bg" Property="BorderBrush" Value="#CBD5E1"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="🗑️"
                                                            Command="{Binding DataContext.DeleteSheetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,5" FontSize="11" Margin="5,0,0,0"
                                                            BorderBrush="#FEE2E2" BorderThickness="1" Foreground="#EF4444" Cursor="Hand" ToolTip="Delete">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bg" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bg" Property="Background" Value="#FEE2E2"/>
                                                                                    <Setter TargetName="bg" Property="BorderBrush" Value="#FECACA"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="5" Background="White" CornerRadius="12" Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid Margin="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Showing" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FilteredCount}" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="of" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSheets}" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="entries" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="◀ Prev" Padding="12,6" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"/>
                        <TextBlock Text="Page 1" Margin="12,0" VerticalAlignment="Center"/>
                        <Button Content="Next ▶" Padding="12,6" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>