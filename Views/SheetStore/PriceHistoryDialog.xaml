<Window x:Class="ProGlassAutomation.Views.SheetStore.PriceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price History"
        Height="650" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7"
        FontFamily="Segoe UI">

    <Border Background="White"
            CornerRadius="16"
            Margin="12"
            BorderBrush="#E5E7EB"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    CornerRadius="16,16,0,0"
                    Padding="22,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF22"
                            CornerRadius="10"
                            Padding="10"
                            VerticalAlignment="Center">
                        <TextBlock Text="📊"
                                   FontSize="18"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="PRICE HISTORY"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="Track purchase &amp; usage history records"
                                   FontSize="11"
                                   Foreground="#E9D5FF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILTERS -->
            <Border Grid.Row="1"
                    Background="#F8FAFC"
                    Padding="18,14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="CATEGORY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="2,0,0,4"/>
                        <ComboBox x:Name="CategoryFilterCombo"
                                  Padding="10,8"
                                  Background="White"
                                  BorderBrush="#E5E7EB"
                                  SelectionChanged="CategoryFilterCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="DATE RANGE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="2,0,0,4"/>
                        <ComboBox x:Name="DateFilterCombo"
                                  Padding="10,8"
                                  Background="White"
                                  BorderBrush="#E5E7EB"
                                  SelectionChanged="DateFilterCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="HISTORY TYPE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="2,0,0,4"/>
                        <ComboBox x:Name="HistoryTypeCombo"
                                  Padding="10,8"
                                  Background="White"
                                  BorderBrush="#E5E7EB"
                                  SelectionChanged="HistoryTypeCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBox x:Name="SearchBox"
                                 Width="180"
                                 Padding="10,8"
                                 Background="White"
                                 BorderBrush="#E5E7EB"
                                 TextChanged="SearchBox_TextChanged"
                                 Margin="0,0,10,0"/>
                        <Button Content="Export"
                                Click="Export_Click"
                                Background="#4F46E5"
                                Foreground="White"
                                Padding="18,10"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DATA GRID -->
            <Border Grid.Row="2"
                    Background="White"
                    Margin="14"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <DataGrid x:Name="PriceHistoryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="44"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FAFB"
                          HorizontalGridLinesBrush="#EEF2F7">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#111827"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SR" Binding="{Binding SrNo}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="TYPE" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HistoryType}" Value="Purchase">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HistoryType}" Value="Usage">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding HistoryType}" FontWeight="SemiBold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryType}" Value="Purchase">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryType}" Value="Usage">
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="THICKNESS" Binding="{Binding Thickness}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="TOTAL (AED)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Supplier}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DATE" Binding="{Binding HistoryDate, StringFormat=dd-MMM-yyyy}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="NOTES" Binding="{Binding Reason}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- FOOTER SUMMARY -->
            <Border Grid.Row="3"
                    Background="#F8FAFC"
                    CornerRadius="0,0,16,16"
                    Padding="18"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1,1,1,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="TOTAL RECORDS" FontSize="10" Foreground="#6B7280"/>
                        <TextBlock x:Name="TotalCountText"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TOTAL PURCHASE VALUE" FontSize="10" Foreground="#6B7280"/>
                        <TextBlock x:Name="TotalPurchaseText"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TOTAL QUANTITY" FontSize="10" Foreground="#6B7280"/>
                        <TextBlock x:Name="TotalSellText"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Close"
                            Click="Close_Click"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="20,8"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>