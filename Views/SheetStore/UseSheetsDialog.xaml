<Window x:Class="ProGlassAutomation.Views.SheetStore.UseSheetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Sheets" 
        Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="USE SHEETS" FontSize="18" FontWeight="Bold" 
                       Foreground="#DC2626" Margin="0,0,0,20"/>

            <!-- Balance Info -->
            <Border Grid.Row="1" Background="#FEF2F2" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Available: " Foreground="#991B1B" FontSize="14"/>
                    <TextBlock x:Name="BalanceText" Text="0" FontWeight="Bold" FontSize="16" Foreground="#991B1B"/>
                    <TextBlock Text=" sheets" Foreground="#991B1B" FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Quantity -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Quantity:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="QtyTextBox" Text="1" FontSize="16" Padding="8"/>
            </StackPanel>

            <!-- Reason -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Reason:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ReasonTextBox" FontSize="16" Padding="8" Height="60" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Date -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" x:Name="DatePicker" Padding="8"/>
                    <ComboBox Grid.Column="2" x:Name="HourCombo" Width="60" Padding="5"/>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCEL" Width="100" Height="35" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="USE" Width="100" Height="35" Click="Use_Click" 
                        Background="#DC2626" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>