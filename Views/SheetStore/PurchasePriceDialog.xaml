<Window x:Class="ProGlassAutomation.Views.SheetStore.PurchasePriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Prices"
        Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Border Background="White" CornerRadius="12" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Card -->
            <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="12,12,0,0" Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#2563EB" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Update Prices" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="Update purchase and sell prices" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form Card -->
            <StackPanel Grid.Row="1" Margin="18,16">

                <!-- Sheet Selector Card -->
                <Border Background="#F9FAFB" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Select Sheet" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SheetComboBox" Padding="10,10" DisplayMemberPath="DisplayName" 
                                  SelectionChanged="SheetComboBox_SelectionChanged" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Pricing Card -->
                <Border Background="#F9FAFB" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Pricing (AED)" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Purchase" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBox x:Name="PurchasePriceTextBox" Padding="10,10" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Sell" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellPriceTextBox" Padding="10,10" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Supplier Card -->
                <Border Background="#F9FAFB" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Supplier" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="SupplierTextBox" Padding="10,10" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Notes Card -->
                <Border Background="#F9FAFB" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Notes" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="NotesTextBox" Padding="10,10" Height="50" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Buttons Card -->
            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,12,12" Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" 
                            Background="Transparent" Foreground="#374151" 
                            Padding="20,10" BorderThickness="1" BorderBrush="#D1D5DB" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Update" Click="Save_Click" 
                            Background="#2563EB" Foreground="White" 
                            Padding="24,10" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>