<Window x:Class="ProGlassAutomation.Views.SheetStore.PurchasePriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Purchase Prices"
        Height="550" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">

    <Border Background="White" CornerRadius="14" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="10" Padding="12,10">
                        <TextBlock Text="💰" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UPDATE PURCHASE PRICES" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Update pricing for all sheet types" FontSize="11" Foreground="#A7F3D0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- Info -->
                    <Border Background="#ECFDF5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" FontSize="14" Margin="0,0,8,0" Foreground="#065F46"/>
                            <TextBlock Text="Update purchase prices for your glass sheets. New prices will be saved for all selected items." FontSize="12" Foreground="#065F46" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Filter -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FILTER BY CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CategoryFilterCombo" Padding="12,10" FontSize="13" SelectionChanged="CategoryFilterCombo_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Price Update Section -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="NEW PURCHASE PRICE (AED)" FontSize="10" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewPurchasePriceText" Padding="14,12" FontSize="13" Text="0.00"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Per" FontSize="10" Foreground="#6B7280" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PriceUnitCombo" Padding="10,8" Width="80">
                                        <ComboBoxItem Content="Sheet" IsSelected="True"/>
                                        <ComboBoxItem Content="SQM"/>
                                        <ComboBoxItem Content="Sqft"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Percentage Adjustment -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="OR ADJUST BY PERCENTAGE" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="-" Click="DecreasePercent_Click" Background="#FEE2E2" Foreground="#DC2626" Padding="12,8" BorderThickness="0" FontWeight="Bold"/>
                                <TextBox x:Name="PercentText" Grid.Column="1" Text="0" Padding="10,8" FontSize="13" HorizontalContentAlignment="Center" Margin="8,0"/>
                                <Button Grid.Column="2" Content="+" Click="IncreasePercent_Click" Background="#D1FAE5" Foreground="#059669" Padding="12,8" BorderThickness="0" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock Text="%" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview -->
                    <Border Background="#FEF3C7" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Items to update" FontSize="10" Foreground="#92400E"/>
                                    <TextBlock x:Name="ItemsCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Center" Foreground="#92400E" Margin="20,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="New Price" FontSize="10" Foreground="#92400E"/>
                                    <TextBlock x:Name="PreviewPriceText" Text="AED 0.00" FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Apply to All -->
                    <CheckBox x:Name="ApplyToAllCheck" Content="Apply new price to all matching sheets" IsChecked="True" Foreground="#374151" Margin="0,0,0,12"/>

                    <!-- Apply Button -->
                    <Button Content="✓ Apply Changes" Click="Apply_Click" Background="#10B981" Foreground="White" Padding="16,12" BorderThickness="0" FontWeight="SemiBold" FontSize="13"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="Close_Click" Background="White" Foreground="#374151" Padding="20,10" BorderThickness="1" BorderBrush="#E5E7EB"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>