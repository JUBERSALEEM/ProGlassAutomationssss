<Window x:Class="ProGlassAutomation.Views.SheetStore.PurchasePriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Purchase Price"
        Height="550" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A6ED1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="💰" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UPDATE PRICES" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Record new purchase" FontSize="10" Foreground="#BFDBFE"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentDateTimeText" FontSize="10" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White" Padding="20,16">
                <StackPanel>

                    <!-- Sheet Selector -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="🪟 SELECT SHEET" FontSize="10" FontWeight="Bold" Foreground="#0A6ED1" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SheetComboBox" 
                                  Padding="12,10" 
                                  FontSize="14"
                                  Background="White"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="SheetComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Selected Sheet Info -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="22" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="CURRENT SHEET" FontSize="9" Foreground="#6B7280" FontWeight="Medium"/>
                                <TextBlock x:Name="SheetInfoText" Text="Please select a sheet" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0A6ED1"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Purchase Price -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="💵 PURCHASE PRICE (AED)" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,6"/>
                        <TextBox x:Name="PurchasePriceText" FontSize="18" Padding="14,12"
                                 Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Sell Price -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="💰 SELL PRICE (AED)" FontSize="10" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,6"/>
                        <TextBox x:Name="SellPriceText" FontSize="18" Padding="14,12"
                                 Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Supplier -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="🏢 SUPPLIER NAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                        <TextBox x:Name="SupplierText" FontSize="14" Padding="12,10"
                                 Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="📝 NOTES (Optional)" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                        <TextBox x:Name="NotesText" FontSize="13" Padding="12,10"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Info Banner -->
                    <Border Background="#FFFBEB" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🕐" FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Purchase will be recorded with current date &amp; time" FontSize="11" Foreground="#92400E"/>
                                <TextBlock x:Name="TimeHintText" FontSize="10" Foreground="#B45309"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F9FAFB" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="❌ Cancel" Click="Cancel_Click"
                        Padding="20,10"
                        Background="White" Foreground="#374151" 
                        BorderThickness="1" BorderBrush="#D1D5DB"/>

                <Button Grid.Column="1" Content="💾 Save Purchase" Click="Save_Click"
                        Padding="20,10" Margin="10,0,0,0"
                        Background="#10B981" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>