<Window x:Class="ProGlassAutomation.Views.SheetStore.BuySheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Sheets" 
        Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="PURCHASE SHEETS" FontSize="18" FontWeight="Bold" 
                       Foreground="#2563EB" Margin="0,0,0,20"/>

            <!-- Quantity -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Quantity:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="QtyTextBox" Text="1" FontSize="16" Padding="8"/>
            </StackPanel>

            <!-- Unit Price -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Unit Price (AED):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="PriceTextBox" FontSize="16" Padding="8"/>
            </StackPanel>

            <!-- Supplier -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Supplier:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="SupplierTextBox" FontSize="16" Padding="8"/>
            </StackPanel>

            <!-- Date -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Purchase Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" x:Name="DatePicker" Padding="8"/>
                    <ComboBox Grid.Column="2" x:Name="HourCombo" Width="60" Padding="5"/>
                </Grid>
            </StackPanel>

            <!-- Notes -->
            <StackPanel Grid.Row="5" Margin="0,0,0,10">
                <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="NotesTextBox" FontSize="16" Padding="8" Height="60" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCEL" Width="100" Height="35" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="PURCHASE" Width="100" Height="35" Click="Purchase_Click" 
                        Background="#16A34A" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>