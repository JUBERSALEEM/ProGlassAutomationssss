<Window x:Class="ProGlassAutomation.Views.SheetStore.BuySheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Sheets" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="#2563EB" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <TextBlock Text="PURCHASE SHEETS" FontSize="18" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Current Stock Info -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" 
                Background="#FEF3C7" Padding="12" Margin="0,0,0,15" CornerRadius="5">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="14" Foreground="#92400E">
                    <Run Text="{Binding SheetInfo}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Stock: " Foreground="#92400E"/>
                    <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock Text=" | Used: " Foreground="#92400E" Margin="15,0,0,0"/>
                    <TextBlock Text="{Binding UsedSheets}" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock Text=" | Balance: " Foreground="#16A34A" Margin="15,0,0,0"/>
                    <TextBlock Text="{Binding BalanceSheets}" FontWeight="Bold" FontSize="16" Foreground="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Quantity -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quantity:" 
                   VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="QtyTextBox" 
                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16" Padding="8" Margin="0,0,0,12" 
                 BorderBrush="#D1D5DB" BorderThickness="1"/>

        <!-- Unit Price (AED) -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Unit Price:" 
                   VerticalAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="PriceTextBox"
                     Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1"/>
            <TextBlock Grid.Column="1" Text="AED" VerticalAlignment="Center" 
                       Margin="10,0,0,0" FontWeight="Bold" Foreground="#6B7280"/>
        </Grid>

        <!-- Supplier -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Supplier:" 
                   VerticalAlignment="Center" FontWeight="Bold"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="SupplierCombo"
                  Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True" Padding="8" Margin="0,0,0,12" 
                  BorderBrush="#D1D5DB" BorderThickness="1"
                  ItemsSource="{Binding SupplierList}"/>

        <!-- Purchase Date -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Date:" 
                   VerticalAlignment="Center" FontWeight="Bold"/>
        <DatePicker Grid.Row="5" Grid.Column="1" x:Name="DatePicker"
                    SelectedDate="{Binding PurchasedOn}"
                    Padding="8" Margin="0,0,0,12"/>

        <!-- Notes -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Notes:" 
                   VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="NotesTextBox"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 Padding="8" Margin="0,0,0,12" BorderBrush="#D1D5DB" BorderThickness="1"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="CANCEL" Width="100" Height="40" 
                    Click="Cancel_Click" Margin="0,0,10,0"
                    Background="#E5E7EB" FontWeight="Bold"/>
            <Button Content="PURCHASE" Width="120" Height="40" 
                    Click="Purchase_Click" Background="#16A34A" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>