<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Details"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.12"/>

        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A6ED1" Offset="0"/>
            <GradientStop Color="#1E88E5" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="White" CornerRadius="14" Margin="16" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BlueGradient}" CornerRadius="14,14,0,0" Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="10" Padding="12,10">
                        <TextBlock Text="🪟" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderText" Text="ADD NEW SHEET" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Enter sheet specifications" FontSize="11" Foreground="#BFDBFE"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="White" Padding="24,20">
                    <StackPanel>
                        <!-- Series/Category -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="SERIES" FontSize="10" FontWeight="Bold" Foreground="#0A6ED1" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CategoryComboBox" 
                                      FontSize="14" Padding="12,10"
                                      Background="White">
                                <ComboBoxItem Content="HD Series"/>
                                <ComboBoxItem Content="Belgium Series"/>
                                <ComboBoxItem Content="PNA"/>
                                <ComboBoxItem Content="Tinted Series"/>
                                <ComboBoxItem Content="Sunlux Series"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Thickness & Color Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THICKNESS (mm)" FontSize="10" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,6"/>
                                <TextBox x:Name="ThicknessText" FontSize="14" Padding="12,10"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,6"/>
                                <TextBox x:Name="ColorText" FontSize="14" Padding="12,10"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dimensions -->
                        <TextBlock Text="DIMENSIONS" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Width (mm)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="WidthText" FontSize="14" Padding="12,10" Text="2440"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (mm)" FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="HeightText" FontSize="14" Padding="12,10" Text="1830"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Pricing -->
                        <TextBlock Text="PRICING (AED)" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Purchase Price" FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="PurchasePriceText" FontSize="14" Padding="12,10"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sell Price" FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                <TextBox x:Name="SellPriceText" FontSize="14" Padding="12,10"
                                         Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Supplier -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,6"/>
                            <TextBox x:Name="SupplierText" FontSize="14" Padding="12,10"
                                     Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                            <TextBox x:Name="DescriptionText" FontSize="14" Padding="12,10" Height="70"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,14,14" Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click"
                            Padding="24,12" Margin="0,0,10,0"
                            Background="White" Foreground="#374151" BorderThickness="1" BorderBrush="#D1D5DB"/>
                    <Button Content="Save Sheet" Click="Save_Click"
                            Padding="24,12"
                            Background="#0A6ED1" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>