<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Details"
        Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">

    <Border Background="White" CornerRadius="10" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2563EB" CornerRadius="10,10,0,0" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="ADD NEW SHEET" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Enter sheet specifications" FontSize="11" Foreground="White" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- Category & Basic -->
            <StackPanel Grid.Row="1" Margin="15,15,15,0">
                <TextBlock Text="SERIES / CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryComboBox" Padding="10,8"/>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THICKNESS" FontSize="10" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ThicknessComboBox" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ColorComboBox" Padding="10,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Hex}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Details -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="15,15,15,0">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WIDTH (mm)" FontSize="10" FontWeight="Bold" Foreground="#0D9488" Margin="0,0,0,5"/>
                            <ComboBox x:Name="WidthComboBox" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HEIGHT (mm)" FontSize="10" FontWeight="Bold" Foreground="#0D9488" Margin="0,0,0,5"/>
                            <ComboBox x:Name="HeightComboBox" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SQM" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,5"/>
                            <Border Background="#EEF2FF" CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="SqmText" Text="0.00" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PURCHASE (AED)" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,5"/>
                            <TextBox x:Name="PurchasePriceText" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SELL (AED)" FontSize="10" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,5"/>
                            <TextBox x:Name="SellPriceText" Padding="10,8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,5"/>
                            <TextBox x:Name="TotalStockText" Padding="10,8" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="USED" FontSize="10" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,5"/>
                            <TextBox x:Name="UsedSheetsText" Padding="10,8" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="BALANCE" FontSize="10" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,5"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="BalanceText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" Margin="0,0,0,5"/>
                    <TextBox x:Name="SupplierText" Padding="10,8" Margin="0,0,0,15"/>

                    <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescriptionText" Padding="10,8" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#06B6D4" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DatePicker" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TIME" FontSize="10" FontWeight="Bold" Foreground="#06B6D4" Margin="0,0,0,5"/>
                            <TextBox x:Name="TimeText" Text="00:00:00" Padding="10,8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,10,10" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Padding="20,10" Margin="0,0,10,0" Background="White"/>
                    <Button Content="Save Sheet" Click="Save_Click" Background="#2563EB" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>