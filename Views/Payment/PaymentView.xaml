<UserControl x:Class="ProGlassAutomation.Views.Payment.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <!-- Sharp Enterprise Palette -->
        <SolidColorBrush x:Key="DeepBlue" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1E40AF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#059669"/>
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="WarningGold" Color="#D97706"/>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>

        <!-- Premium Payment Card Style -->
        <Style x:Key="PaymentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="35">

            <!-- HEADER -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,35">
                <TextBlock Text="SECURE CHECKOUT" FontSize="28" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center"/>
                <TextBlock Text="Complete your transaction to initialize full enterprise production" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 1. SELECTED PLAN SUMMARY (Synced) -->
            <Border x:Name="SelectedPlanBorder" Background="White" CornerRadius="18" Padding="30" Margin="0,0,0,25" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ORDER SUMMARY" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="PlanNameText" Text="Enterprise Monthly" FontSize="24" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="PlanDaysText" Text="30 Days Access Tier" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DeepBlue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL DUE" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="PlanAmountText" Text="AED 250" FontSize="32" FontWeight="Black" Foreground="{StaticResource TextDark}"/>
                        <TextBlock x:Name="PlanCurrencyText" Text="UAE Dirham (VAT Inclusive)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. PAYMENT METHODS -->
            <TextBlock Text="SELECT PAYMENT METHOD" FontSize="12" FontWeight="Black" Foreground="{StaticResource PrimaryBlue}" Margin="5,0,0,15"/>
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                <!-- PayPal -->
                <Border x:Name="PayPalCard" Style="{StaticResource PaymentCardStyle}" MouseLeftButtonDown="PayPal_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="80" Height="45" Background="#003087" CornerRadius="8">
                            <TextBlock Text="PayPal" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Instant Activation" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Stripe -->
                <Border x:Name="StripeCard" Style="{StaticResource PaymentCardStyle}" MouseLeftButtonDown="Stripe_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="80" Height="45" Background="#635BFF" CornerRadius="8">
                            <TextBlock Text="Stripe" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Credit/Debit Card" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Bank Transfer -->
                <Border x:Name="BankCard" Style="{StaticResource PaymentCardStyle}" MouseLeftButtonDown="BankTransfer_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="80" Height="45" Background="{StaticResource DeepBlue}" CornerRadius="8">
                            <TextBlock Text="BANK" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Direct Transfer" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 3. INSTRUCTIONS -->
            <Border Background="#FFFBEB" CornerRadius="12" Padding="25" Margin="0,0,0,25" BorderBrush="#FDE68A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PROCEDURE GUIDELINES" FontSize="13" FontWeight="Black" Foreground="{StaticResource WarningGold}"/>
                    <TextBlock Text="1. Execute payment via your preferred gateway above." FontSize="12" Foreground="#92400E" Margin="0,10,0,0" FontWeight="Bold"/>
                    <TextBlock Text="2. Send digital receipt to our WhatsApp support (+971-559117727)." FontSize="12" Foreground="#92400E" Margin="0,5,0,0" FontWeight="Bold"/>
                    <TextBlock Text="3. Input the received Engine Key in the console below to finalize." FontSize="12" Foreground="#92400E" Margin="0,5,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 4. KEY ACTIVATION CONSOLE -->
            <Border Background="White" CornerRadius="18" Padding="30" Margin="0,0,0,25" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="2" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="ENGINE ACTIVATION CONSOLE" FontSize="14" FontWeight="Black" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ActivationKeyInput" Height="55" FontSize="22" FontWeight="Black" Padding="20,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Grid.Column="1" Content="ACTIVATE ENGINE" Click="ActivateKey_Click" Background="{StaticResource SuccessGreen}" Foreground="White" FontWeight="Black" Padding="30,0" Margin="15,0,0,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Text="" FontSize="11" FontWeight="Black" Foreground="{StaticResource DangerRed}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 5. FOOTER & CONTACT -->
            <Border Background="{StaticResource PrimaryBlue}" CornerRadius="18" Padding="35" Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="DIRECT PAYMENT ASSISTANCE" FontSize="18" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reach out for manual verification or custom enterprise quotes" Foreground="#BFDBFE" Margin="0,5,0,20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="WHATSAPP: +971-559117727" Click="ContactWhatsApp_Click" Background="White" Foreground="{StaticResource PrimaryBlue}" FontWeight="Black" Padding="25,12" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="EMAIL SALES" Click="ContactEmail_Click" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1.5" FontWeight="Black" Padding="25,12" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- BACK ACTION -->
            <Button Content="← RETURN TO PRODUCTION PLANS" Click="BackToPlans_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>