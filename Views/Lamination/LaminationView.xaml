<UserControl x:Class="ProGlassAutomation.Views.Lamination.LaminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGlassAutomation.Views.Lamination"
             Background="#E8F4FC">

    <UserControl.DataContext>
        <vm:LaminationViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0891B2"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#F0F9FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="HighlightBorderBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="HighlightBgBrush" Color="#EFF6FF"/>

        <!-- Base Controls -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Editable ComboBox Style -->
        <Style x:Key="EditableComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Highlighted Card Style -->
        <Style x:Key="HighlightCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{StaticResource HighlightBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button -->
        <Style x:Key="ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#14B8A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0D9488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" CornerRadius="12" Padding="15,12" Margin="0,0,0,10"
                    Background="{StaticResource PrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="LAMINATION CALCULATOR" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RESULT: " FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result, Mode=OneWay, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="80"/>
                            <TextBlock Text=" AED" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="16"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Glass Options -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                        <!-- Outer Glass -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="OUTER GLASS" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Category"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding CategoryOptions1}" 
                                          SelectedItem="{Binding Category1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Category1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Thickness (mm)"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding ThicknessOptions1}" 
                                          SelectedItem="{Binding Thickness1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Thickness1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Color"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding ColorOptions1}" 
                                          SelectedItem="{Binding Color1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Color1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Inner Glass -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="INNER GLASS" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Category"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding CategoryOptions2}" 
                                          SelectedItem="{Binding Category2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Category2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Thickness (mm)"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding ThicknessOptions2}" 
                                          SelectedItem="{Binding Thickness2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Thickness2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Color"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding ColorOptions2}" 
                                          SelectedItem="{Binding Color2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding Color2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- [NEW] Wastage Consider -->
                        <Border Style="{StaticResource CardBorder}" Background="#FEF3C7" BorderBrush="#FCD34D" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="WASTAGE CONSIDER" Style="{StaticResource SectionTitle}"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding WastageOptions}" 
                                          IsEditable="True"
                                          Text="{Binding WastageConsider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Factor: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageFactorDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="  |  Wastage: " FontSize="10" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding WastageConsiderDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- [NEW] Profit Margin -->
                        <Border Style="{StaticResource CardBorder}" Background="#DCFCE7" BorderBrush="#86EFAC">
                            <StackPanel>
                                <TextBlock Text="PROFIT MARGIN" Style="{StaticResource SectionTitle}"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding ProfitMarginOptions}" 
                                          IsEditable="True"
                                          Text="{Binding ProfitMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Margin: " FontSize="10" Foreground="#166534"/>
                                    <TextBlock Text="{Binding ProfitMarginDisplay, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MIDDLE: Price Section - HIGHLIGHTED -->
                    <StackPanel Grid.Column="1" Margin="8,0">

                        <!-- Price Section -->
                        <Border Style="{StaticResource HighlightCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PRICE SECTION" Style="{StaticResource SectionTitle}" Foreground="#1E40AF"/>
                                <TextBlock Text="Enter all price values below" FontSize="10" Foreground="#64748B" Margin="0,0,0,12"/>

                                <Label Content="Sheet1 (Outer Glass)"/>
                                <TextBox Text="{Binding Sheet1, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                <Label Content="Sheet2 (Inner Glass)"/>
                                <TextBox Text="{Binding Sheet2, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                <Label Content="Cutting Charge"/>
                                <TextBox Text="{Binding Cutting, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                <Label Content="Tempering Charge"/>
                                <TextBox Text="{Binding Tempering, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                <!-- Calculation Preview -->
                                <Border Background="#DBEAFE" CornerRadius="8" Padding="10" Margin="0,12,0,0" BorderBrush="#93C5FD" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="CALCULATION PREVIEW" FontWeight="Bold" FontSize="11" Foreground="#1E40AF" Margin="0,0,0,8"/>

                                        <!-- INPUT VALUES SECTION -->
                                        <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="INPUT VALUES" FontWeight="Bold" FontSize="10" Foreground="#475569" Margin="0,0,0,6"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Row 1: Sheet1 -->
                                                    <TextBlock Grid.Row="0" Text="Sheet1 price:" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right">
                                                        <Run Text="{Binding Sheet1, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>

                                                    <!-- Row 2: Sheet2 -->
                                                    <TextBlock Grid.Row="1" Text="Sheet2 price:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding Sheet2, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>

                                                    <!-- Row 3: Wastage Factor -->
                                                    <TextBlock Grid.Row="2" Text="Wastage Factor:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding WastageFactorDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>

                                                    <!-- Row 4: PVB Price -->
                                                    <TextBlock Grid.Row="3" Text="PVB price:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding PVBPrice, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>

                                                    <!-- Row 5: Cutting -->
                                                    <TextBlock Grid.Row="4" Text="Cutting price:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding Cutting, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>

                                                    <!-- Row 6: Tempering -->
                                                    <TextBlock Grid.Row="5" Text="Tempering price:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding Tempering, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>

                                                    <!-- Row 7: Wastage Consider -->
                                                    <TextBlock Grid.Row="6" Text="Wastage Consider:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding WastageConsiderDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>

                                                    <!-- Row 8: Profit Margin -->
                                                    <TextBlock Grid.Row="7" Text="Profit Margin:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="7" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                        <Run Text="{Binding ProfitMarginDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- CALCULATION STEPS -->
                                        <Border Background="#F0FDF4" CornerRadius="6" Padding="8" BorderBrush="#86EFAC" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="CALCULATION STEPS" FontWeight="Bold" FontSize="10" Foreground="#166534" Margin="0,0,0,6"/>

                                                <!-- Step 1 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Step 1:" FontWeight="Bold" FontSize="10" Foreground="#166534"/>
                                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#166534" TextWrapping="Wrap">
                                                        <Run Text="Sheet1 + Sheet2 = "/>
                                                        <Run Text="{Binding Result1, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Step 2 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Step 2:" FontWeight="Bold" FontSize="10" Foreground="#166534"/>
                                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#166534" TextWrapping="Wrap">
                                                        <Run Text="{Binding Result1, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding WastageFactorDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#92400E"/>
                                                        <Run Text=" = "/>
                                                        <Run Text="{Binding Result2, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Step 3 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Step 3:" FontWeight="Bold" FontSize="10" Foreground="#166534"/>
                                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#166534" TextWrapping="Wrap">
                                                        <Run Text="{Binding Result2, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" + "/>
                                                        <Run Text="{Binding PVBPrice, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" + "/>
                                                        <Run Text="{Binding Cutting, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" + "/>
                                                        <Run Text="{Binding Tempering, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" = "/>
                                                        <Run Text="{Binding Result3, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Step 4 -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Step 4:" FontWeight="Bold" FontSize="10" Foreground="#166534"/>
                                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="#166534" TextWrapping="Wrap">
                                                        <Run Text="{Binding Result3, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                        <Run Text=" x "/>
                                                        <Run Text="{Binding ProfitMarginDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="#166534"/>
                                                        <Run Text=" = "/>
                                                        <Run Text="{Binding Result4, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="#059669"/>
                                                        <Run Text=" AED"/>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Final Result -->
                                        <Border Background="#FEE2E2" CornerRadius="6" Padding="10" Margin="0,8,0,0" BorderBrush="#FECACA" BorderThickness="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="FINAL RESULT" FontWeight="Bold" FontSize="10" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Result, Mode=OneWay, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                                    <TextBlock Text=" AED" FontSize="14" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Save Button -->
                        <Button Content="SAVE" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>

                    <!-- RIGHT: Info -->
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- PVB Layer -->
                        <Border Style="{StaticResource CardBorder}" Background="#F0FDFA" BorderBrush="#5EEAD4" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PVB LAYER" Style="{StaticResource SectionTitle}"/>
                                <Label Content="Price (AED)"/>
                                <TextBox Text="{Binding PVBPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                <Label Content="Type"/>
                                <ComboBox Style="{StaticResource EditableComboBox}"
                                          ItemsSource="{Binding PVBOptions}" 
                                          SelectedItem="{Binding PVBType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Text="{Binding PVBType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Guide -->
                        <Border Style="{StaticResource CardBorder}" Background="#ECFDF5" BorderBrush="#6EE7B7" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="HOW TO USE" FontWeight="Bold" FontSize="12" Foreground="#047857" Margin="0,0,0,6"/>
                                <TextBlock Text="1. Select outer &amp; inner glass category" FontSize="10" Foreground="#374151"/>
                                <TextBlock Text="2. Choose thickness and colors" FontSize="10" Foreground="#374151" Margin="0,2,0,0"/>
                                <TextBlock Text="3. Set wastage factor (default 15%)" FontSize="10" Foreground="#374151" Margin="0,2,0,0"/>
                                <TextBlock Text="4. Set profit margin (default 15%)" FontSize="10" Foreground="#374151" Margin="0,2,0,0"/>
                                <TextBlock Text="5. Enter PVB layer price &amp; type" FontSize="10" Foreground="#374151" Margin="0,2,0,0"/>
                                <TextBlock Text="6. Click SAVE to store calculation" FontSize="10" Foreground="#374151" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Cache Status -->
                        <Border Style="{StaticResource CardBorder}" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="DATA STATUS" FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Text="Categories:" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryOptions1.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Text="Thicknesses:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThicknessOptions1.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0"/>

                                    <TextBlock Grid.Row="2" Text="Colors:" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ColorOptions1.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cache Active" FontSize="10" Foreground="#16A34A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORY SECTION -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Content="HISTORY" IsChecked="{Binding IsHistoryVisible, Mode=TwoWay}" Style="{StaticResource ToggleBtn}"/>
                    <Button Grid.Column="1" Content="CLEAR ALL" Command="{Binding ClearAllCommand}" 
                            Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Background="#F0F9FF" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                        MinHeight="100" MaxHeight="200" BorderBrush="#BAE6FD" BorderThickness="1"
                        Visibility="{Binding IsHistoryVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Records, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="10" Margin="4"
                                            BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="260" MaxWidth="320">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <Button Content="X" 
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="#FEE2E2" Foreground="#DC2626" 
                                                        FontSize="9" FontWeight="Bold" 
                                                        HorizontalAlignment="Right" Padding="4,2"
                                                        Width="20" Height="20"/>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding DisplayText, Mode=OneWay}" TextWrapping="Wrap" FontSize="11" Foreground="#334155" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DetailText, Mode=OneWay}" TextWrapping="Wrap" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Row="2" Background="#ECFDF5" CornerRadius="4" Padding="6,4" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                <TextBlock FontSize="12" Foreground="#059669" FontWeight="Bold">
                                                    <Run Text="{Binding Result, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                                    <Run Text=" AED"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>